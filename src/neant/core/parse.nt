// neant parser, in neant. Consumes nlex tokens (src/neant/core/lex.nt) and produces the AST the compiler walks.
// Nodes are (`kind; ...) lists, identifiers are symbols:
//   (`const;v) (`name;`x) (`verb;"+") (`advb;"/";f) (`mo;f;x) (`dy;f;x;y) (`app;f;x) (`call;f;args) (`list;items)
//   (`assign;`x;e) (`gassign;`x;e) (`iassign;`x;idxs;e) (`return;e) (`fn;params;body) (`if;c;body) (`while;c;body)
//   (`do;n;body) (`cond;args) (`noun;e) (`at;line;stmt)
// Parser state is two globals: pt (tokens) and pi (position), updated with ::.
INFIX: `mod`div`xexp`in`within`vs`sv`ss`write0`each`over`scan`except`inter`union`cross`fill`like`rand`msum`mavg`mmax`mmin`ema`xbar`bin`cut`rotate`sublist`badd`band`bor`bxor`shl`shr
SELKW: ("by";"from";"where")

peek: {[k] $[(pi+k)<count pt; pt[pi+k]; (`eof;" ")]}
isPt: {[t;c] $[t[0]=`punct; t[1]=c; 0]}
isP: {[k;c] isPt[peek k;c]}
isV: {[t;c] $[t[0]=`verb; t[1]=c; 0]}
kw: {[k;w] t: peek k; $[t[0]=`name; t[1]~w; 0]}
fnlike: {[a] $[a[0] in `verb`advb; 1; a[0]=`name; a[1] in INFIX; 0]}
need: {if[0=count x; signal "parse: incomplete expression"]; x}
advf: {$[x="L"; "\\:"; x="R"; "/:"; x]}

// statements up to the closing punct ("\0" = end of input). Empty statements are skipped.
// isStmt: a statement list (lambda/if/while/do body, cond arms, top level), so each member is tagged
// with its line for the line table. A parenthesized list is a value context and is left untagged.
stmts: {[close;isStmt]
  out: ()
  while[1
    t: peek 0
    if[t[0]=`eof; $[close="\0"; :out; signal "parse: missing ",close]]
    if[isPt[t;close]; pi::pi+1; :out]
    if[isPt[t;")"] | isPt[t;"]"] | isPt[t;"}"]; signal "parse: unexpected ",t[1]]   // else expr[] eats nothing and we spin
    if[isPt[t;";"]; pi::pi+1]
    if[not isPt[t;";"]
      ln: plines[pi]
      if[close="\0"; slines:: slines, ln]   // line of each top-level statement, for runtime errors
      e: expr[]
      out,: ,$[isStmt; (`at; ln; e); e]]]}

// the whole rest of the line, or () when empty
// The token index just past the `]` closing the `[` at token index j, or -1 — a scan over punct
// tokens and nothing else. It exists so that `x[i]: v` can be told from `x[i]`, and from
// `while[...]`, WITHOUT parsing the bracket speculatively and throwing the result away. That
// speculation parsed every bracketed block twice, so a block nested d deep was parsed 2^d times:
// measured at 12ms flat and 228ms at depth six for the same 1.6KB of statements. README's "one
// linear pass ... and no backtracking" is what this restores.
pmatch: {[j]
  d: 0; i: j; n: count pt
  while[i<n
    t: pt[i]
    if[t[0]=`punct
      if[t[1] in "[({"; d+:1]
      if[t[1] in "])}"; d-:1; if[d<1; :i+1]]]
    i+:1]
  -1}

expr: {[]
  if[isP[0;":"]; pi::pi+1; :(`return; rhs[])]
  t: peek 0
  if[t[0]=`name
    nm: `$t[1]
    if[isP[1;":"] & isP[2;":"]; pi::pi+3; :(`gassign; nm; rhs[])]
    if[isP[1;":"]; pi::pi+2; :(`assign; nm; rhs[])]
    if[((peek 1)[0]=`verb) & isP[2;":"]; v: (peek 1)[1]; pi::pi+3; :(`assign; nm; (`dy; (`verb; v); (`name; nm); rhs[]))]
    if[isP[1;"["]
      // only look inside the bracket when what FOLLOWS it makes this an indexed assignment
      j: pmatch[pi+1]
      asn: 0b
      if[j>0
        k: j-pi
        if[isP[k;":"]; asn: 1b]
        if[((peek k)[0]=`verb) & isP[k+1;":"]; asn: 1b]]
      if[asn
        save: pi; pi::pi+2; idx: pargs[]
        if[count idx
          if[isP[0;":"]; pi::pi+1; :(`iassign; nm; idx; rhs[])]
          if[((peek 0)[0]=`verb) & isP[1;":"]
            v: (peek 0)[1]; pi::pi+2
            :(`iassign; nm; idx; (`dy; (`verb; v); (`call; (`name; nm); idx); rhs[]))]]
        pi::save]]]
  items: ()
  while[not stop[]; items,: ,primary[]]
  resolve items}
rhs: {[] e: expr[]; if[0=count e; signal "parse: empty assignment"]; e}
stop: {[] t: peek 0; $[t[0]=`eof; 1; t[0]=`punct; t[1] in ";)]}"; 0]}

// [noun verb rest] -> dy, [verb rest] -> mo, [noun rest] -> app; the right operand is the rest of the
// line, which is what makes this right-associative and why it is built from the right end backwards
// rather than recursively from the left. The recursive form cost one stack frame and one copy of the
// remaining items PER TERM: quadratic in the length of an expression, and `'stack: recursion too
// deep` somewhere past a thousand terms. Walking backwards needs only the last two results, since
// the dy rule consumes two items and every other rule consumes one.
//
// Positions the recursive form would have skipped are computed here and thrown away. That is safe,
// not merely cheap: the only one skipped is i+1 after a dy at i, which begins with a verb and so
// takes the mo rule, whose `need` is over exactly the acc[i+2] the dy rule itself needs — so it
// signals if and only if the dy would have.
resolve: {[items]
  n: count items
  if[n<2; :$[n; items[0]; ()]]
  acc2: ()                       // resolve over items[i+2..]
  acc1: items[n-1]               // resolve over items[i+1..]
  i: n-2
  while[not i<0
    h: items[i]
    r: ()
    if[fnlike h; r: (`mo; h; need acc1)]
    if[$[fnlike h; 0b; fnlike items[i+1]]; r: (`dy; items[i+1]; h; need acc2)]
    if[$[fnlike h; 0b; not fnlike items[i+1]]; r: (`app; h; need acc1)]
    acc2: acc1; acc1: r; i-:1]
  acc1}

primary: {[]
  t: peek 0; pi::pi+1; k: t[0]; v: t[1]
  if[k=`eof; signal "parse: unexpected end"]
  if[k=`adv; signal "parse: dangling adverb ",advf v]
  if[k in `num`sym; node: (`const; v)]
  if[k=`str; node: (`const; $[1=count v; first v; v])]
  if[k=`name
    if[((v~"if") | (v~"while") | v~"do") & isP[0;"["]
      pi::pi+1; a: stmts["]";1]
      if[0=count a; signal "parse: ",v," needs a condition"]
      :(`$v; a[0]; 1_a)]
    if[v~"select"; :selectForm[]]
    if[v~"break"; :,`break]
    node: (`name; `$v)]
  if[k=`verb
    if[(v="$") & isP[0;"["]; pi::pi+1; :(`cond; stmts["]";1])]
    node: (`verb; v)]
  if[k=`punct
    if[not v in "({"; signal "parse: unexpected ",v]
    if[v="("; body: stmts[")";0]; node: $[1=count body; $[fnlike body[0]; (`noun; body[0]); body[0]]; (`list; body)]]
    if[v="{"
      hasP: isP[0;"["]
      if[hasP; pi::pi+1; params: paramList[]]
      body: stmts["}";1]
      if[not hasP; params: `x`y`z[til max 1,implicitMax body]]
      node: (`fn; params; body)]]
  while[1; $[(peek 0)[0]=`adv; node: advb node; isP[0;"["]; node: callp node; :node]]}
advb: {[node] t: peek 0; pi::pi+1; (`advb; t[1]; node)}
callp: {[node] pi::pi+1; a: pargs[]; (`call; node; a)}

paramList: {[]
  ps: ()
  while[1
    t: peek 0; pi::pi+1
    if[isPt[t;"]"]; :ps]
    if[t[0]=`name; ps,: `$t[1]]
    if[not (t[0]=`name) | isPt[t;";"]; signal "parse: bad parameter list"]]}

// call arguments after [ ; an empty slot is a null constant (projection)
pargs: {[]
  out: ()
  while[1
    e: expr[]
    t: peek 0; pi::pi+1
    if[isPt[t;";"]; out,: ,$[count e; e; (`const; null)]]
    if[isPt[t;"]"]
      if[count e; out,: ,e]
      if[(0=count e) & 0<count out; out,: ,(`const; null)]
      :out]
    if[not isPt[t;";"] | isPt[t;"]"]; signal "parse: missing ]"]]}

// ---- select cols by keys from t where conds  ->  qsel[t; where-fn; by-dict; col-dict]  (src/neant/stdlib/table.nt)
selectForm: {[]
  cols: $[kw[0;"by"] | kw[0;"from"]; (); selList[]]
  by: (); if[kw[0;"by"]; pi::pi+1; by: selList[]]
  if[not kw[0;"from"]; signal "parse: select needs from"]
  pi::pi+1
  from: selExpr[]; if[0=count from; signal "parse: select needs a table"]
  wh: (); if[kw[0;"where"]; pi::pi+1; wh: {x[1]} each selList[]]
  desugarSelect[cols; by; from; wh]}
// comma-separated [name:] expr items, up to by/from/where or a terminator; each item is (name-or-(); expr)
selList: {[]
  out: ()
  while[1
    nm: ()
    if[((peek 0)[0]=`name) & isP[1;":"]; nm: (peek 0)[1]; pi::pi+2]
    e: selExpr[]; if[0=count e; signal "parse: empty select item"]
    out,: ,(nm; e)
    $[isV[peek 0;","]; pi::pi+1; :out]]}
stopSel: {[] t: peek 0; $[stop[]; 1; isV[t;","]; 1; t[0]=`name; |/ t[1] ~/: SELKW; 0]}   // ~/: because `in` on a string is per char
selExpr: {[] items: (); while[not stopSel[]; items,: ,primary[]]; resolve items}

autoName: {[e] $[e[0]=`name; e[1]; e[0] in `app`mo; autoName e[2]; ()]}
selLam: {[e] (`fn; ,`.t; ,colref e)}
selDict: {[items]
  if[0=count items; :(`const; ())]
  names: (); n: 0; i: 0
  while[i<count items
    it: items[i]; nm: it[0]; auto: autoName it[1]
    an: `$"x",$[n>0; string n; ""]
    if[(0=count nm) & 0=count auto; n+:1]
    names,: $[count nm; `$nm; count auto; auto; an]
    i+:1]
  (`dy; (`verb; "!"); (`const; names); (`list; selLam each {x[1]} each items))}
desugarSelect: {[cols;by;from;wh]
  wl: (`const; ())
  if[count wh; acc: wh[0]; i: 1; while[i<count wh; acc: (`dy; (`verb; "&"); acc; wh[i]); i+:1]; wl: selLam acc]
  (`call; (`name; `qsel); (from; wl; selDict by; selDict cols))}
// every name in a column expression resolves to a column when the table has one, else to the global
colref: {[a]
  k: a[0]
  if[k=`name; if[a[1]=`.t; :a]; :(`cond; ((`dy; (`name; `in); (`const; a[1]); (`app; (`name; `key); (`name; `.t))); (`app; (`name; `.t); (`const; a[1])); a))]
  if[k in `const`verb; :a]
  if[k=`advb; :(`advb; a[1]; colref a[2])]
  if[k in `mo`app; :(k; colref a[1]; colref a[2])]
  if[k=`dy; :(k; colref a[1]; colref a[2]; colref a[3])]
  if[k=`call; :(k; colref a[1]; colref each a[2])]
  if[k in `list`cond; :(k; colref each a[1])]
  if[k in `noun`return; :(k; colref a[1])]
  if[k=`at; :(k; a[1]; colref a[2])]
  if[k=`fn; :(k; a[1]; colref each a[2])]
  if[k in `if`while`do; :(k; colref a[1]; colref each a[2])]
  if[k in `assign`gassign; :(k; a[1]; colref a[2])]
  if[k=`iassign; :(k; a[1]; colref each a[2]; colref a[3])]
  a}

// highest implicit parameter (x=1 y=2 z=3) referenced in a body, not descending into nested lambdas
implicitMax: {[body] max 0, usesXYZ each body}
usesXYZ: {[a]
  k: a[0]
  if[k=`name; :$[a[1]=`x; 1; a[1]=`y; 2; a[1]=`z; 3; 0]]
  if[k in `const`verb`fn; :0]
  if[k in `advb`assign`gassign`at; :usesXYZ a[2]]
  if[k in `noun`return; :usesXYZ a[1]]
  if[k in `mo`app`dy; :max usesXYZ each 1_a]
  if[k=`iassign; :max (usesXYZ each a[2]), usesXYZ a[3]]
  if[k in `list`cond; :max 0, usesXYZ each a[1]]
  if[k in `call`if`while`do; :max (usesXYZ a[1]), usesXYZ each a[2]]
  0}

// errors carry the line of the token being looked at
nparse: {[s]
  pt:: nlex s; pi:: 0; slines:: ()
  @[{stmts["\0";1]}; 0; {$[count plines; signal x," at line ",string plines[pi & -1+count plines]; signal x]}]}
