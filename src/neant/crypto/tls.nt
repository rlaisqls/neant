// TLS 1.3 client (RFC 8446) in neant, on src/neant/crypto/crypto.nt: x25519 key exchange,
// TLS_CHACHA20_POLY1305_SHA256, no resumption, no client certificate.
// Not part of the boot image. tlsConnect needs the verifier, so load all seven, in this order:
//   load "src/neant/crypto/bignum.nt"    load "src/neant/crypto/rsa.nt"
//   load "src/neant/crypto/der.nt"       load "src/neant/crypto/p256.nt"
//   load "src/neant/crypto/x509.nt"      load "src/neant/crypto/verify.nt"
//   load "src/neant/crypto/tls.nt"
// (the key schedule, the record layer and clientHello stand on their own; tlsConnect is what
// reaches for the verifier.)
//
// The server is authenticated. tlsConnect parses the Certificate message, verifies the server's
// CertificateVerify signature over the handshake transcript, verifies the certificate chain to a
// trust store and matches the hostname; any one of those failing closes the connection and signals
// with the reason. Verification is the default and there is no way to reach it by accident:
// tlsConnectOpts[host;port;(enlist `verify)!enlist 0b] is the opt-out, it has to be written at the
// call site, and what it gives you is an encrypted channel to whoever answered the socket.
//
// The ClientHello offers ecdsa_secp256r1_sha256, rsa_pss_rsae_sha256 and rsa_pkcs1_sha256, and
// src/neant/crypto/verify.nt can check all three. A chain that is ECDSA-SHA256 on P-256 the whole
// way up verifies here, and so does a CertificateVerify signed with that key — which is what
// src/main.rs's ECDSA end-to-end handshake against a real openssl s_server proves.
//
// BE PRECISE ABOUT WHAT THAT REACHES, because the version of this comment before ECDSA went in was
// not. It said P-256 was what stood between this client and Google, Cloudflare and the modern CDNs.
// It was not. Connecting to them from this checkout today still fails, and always at the same
// place: their LEAF is ECDSA-SHA256 on P-256 and now verifies, and the INTERMEDIATE above it is
// ecdsa-with-SHA384 signed by a P-384 root —
//   x509: CN=WE2,O=Google Trust Services,C=US is signed with ecdsaSha384 (1.2.840.10045.4.3.3),
//   which this build cannot verify
// — so www.google.com, cloudflare.com, example.com, github.com, www.wikipedia.org and
// news.ycombinator.com are all still refused, while www.amazon.com's RSA chain verifies. P-256
// bought the leaf link of those chains, not the chain. SHA-384 and P-384 are what the rest needs.
//
// What is NOT checked at all: certificate revocation (no CRL, no OCSP), name constraints,
// certificate policies and extendedKeyUsage. There is no client certificate and no server side.
//
// Everything here is a verifier written from scratch to be read rather than a reviewed TLS stack,
// and the AEAD and the key exchange are not constant-time.

// ---- integers on the wire, big-endian; lp<n> prefixes a block with its n-byte length
wu8:   {[n] `byte$ ,n band 255}
wu16:  {[n] `byte$ (n shr 8 0) band 255}
wu24:  {[n] `byte$ (n shr 16 8 0) band 255}
wbe:   {[b] 0 {(256*x)+y}/ `int$b}
wlp8:  {[b] (wu8 count b), b}
wlp16: {[b] (wu16 count b), b}
wlp24: {[b] (wu24 count b), b}
wext:  {[t;b] (wu16 t), wlp16 b}
wdrop: {[n;b] b[n+til (count b)-n]}

// ---- key schedule (RFC 8446 7.1). HkdfLabel = len(2) | "tls13 "+label | context
TLSZ: 32#0x00
hkdfLabel:   {[len;label;ctx] (wu16 len), (wlp8 `byte$"tls13 ",label), wlp8 ctx}
expandLabel: {[secret;label;ctx;len] hkdfExpand[secret; hkdfLabel[len;label;ctx]; len]}
deriveSecret:{[secret;label;msgs] expandLabel[secret; label; sha256 msgs; 32]}
trafficKeys: {[secret] (expandLabel[secret;"key";0x;32]; expandLabel[secret;"iv";0x;12])}

// ---- record layer
recvN: {[h;n]
  b: 0x
  while[(count b)<n
    c: hrecv[h; n-count b]
    if[0=count c; signal "tls: peer closed the connection"]
    b,: c]
  b}
readRec: {[h] hdr: recvN[h;5]; (`int$hdr[0]; hdr; recvN[h; wbe hdr[3 4]])}
sendPlain: {[h;ctype;body] hsend[h; (wu8 ctype), 0x0303, wlp16 body]}
// nonce: the record sequence number as 8 big-endian bytes, right-aligned in 12, xor the static iv
recNonce: {[iv;seq] iv bxor (4#0x00), `byte$ (seq shr 56 48 40 32 24 16 8 0) band 255}
// an encrypted record always claims application_data; the real type is the last non-zero inner byte
sealBody: {[key;iv;seq;ctype;body]
  inner: body, wu8 ctype
  hdr: 0x17, 0x0303, wu16 16+count inner
  r: aeadEncrypt[key; recNonce[iv;seq]; hdr; inner]
  (hdr; hdr, r[0], r[1])}
sealRec: {[h;key;iv;seq;ctype;body] hsend[h; (sealBody[key;iv;seq;ctype;body])[1]]}
openRec: {[key;iv;seq;hdr;body]
  n: (count body)-16
  pt: aeadDecrypt[key; recNonce[iv;seq]; hdr; n#body; body[n+til 16]]
  i: -1+count pt
  while[0=`int$pt[i]; i-:1]
  (`int$pt[i]; i#pt)}

// ---- handshake messages and extensions
findExt: {[b;want]
  i: 0
  while[i<count b
    n: wbe b[(i+2)+til 2]
    if[want=wbe b[i+til 2]; :b[(i+4)+til n]]
    i: i+4+n]
  0x}
// ServerHello body: version(2) random(32) lp8 session_id cipher(2) compression(1) lp16 extensions
shKeyShare: {[b]
  i: 38+`int$b[34]
  e: b[(i+2)+til wbe b[i+til 2]]
  ks: findExt[e; 51]
  if[0=count ks; signal "tls: server sent no key_share"]
  ks[4+til wbe ks[2 3]]}

clientHello: {[host;pub;rnd;sid]
  exts: wext[0; wlp16 0x00, wlp16 `byte$host]                   // server_name
  exts,: wext[10; wlp16 wu16 29]                                // supported_groups: x25519
  // signature_algorithms, most preferred first: ecdsa_secp256r1_sha256 (1027, and first because it
  // is what the public web actually serves), rsa_pss_rsae_sha256 (2052), then rsa_pkcs1_sha256
  // (1025) — which RFC 8446 4.4.3 allows only on a *certificate*, and which is why it is offered at
  // all. Each of the three is one verify.nt can check; a scheme you cannot check is not advertised,
  // because advertising it just means a server with a choice sends the one you have to refuse.
  exts,: wext[13; wlp16 raze wu16 each 1027 2052 1025]          // signature_algorithms
  exts,: wext[43; wlp8 wu16 772]                                // supported_versions: TLS 1.3
  exts,: wext[51; wlp16 (wu16 29), wlp16 pub]                   // key_share
  body: 0x0303, rnd, (wlp8 sid), (wlp16 wu16 4867), 0x0100, wlp16 exts
  0x01, wlp24 body}

// handle -> (client key; client iv; client seq; server key; server iv; server seq)
TLSC: ()!()
// handle -> the server's certificate chain as DER, leaf first, exactly as it arrived
TLSCERT: ()!()

// ---- the server's certificate
// Certificate (RFC 8446 4.4.2): certificate_request_context<0..255>, then a
// certificate_list<0..2^24-1> of (cert_data<1..2^24-1>, extensions<0..2^16-1>). The context is
// empty for server authentication, and anything else means this is not the message we think it
// is. The per-entry extensions — SCTs, a stapled OCSP response — are read past and dropped:
// nothing here checks either, and the header says so rather than leaving a caller to assume it.
parseCerts: {[body]
  if[0=count body; signal "tls: an empty Certificate message"]
  if[0<`int$body[0]
    signal "tls: the server sent a certificate_request_context, which 4.4.2 forbids"]
  b: wdrop[1;body]
  if[(count b)<3; signal "tls: a truncated Certificate message"]
  n: wbe b[til 3]
  b: wdrop[3;b]
  if[not n=count b
    signal "tls: the certificate_list length does not match the Certificate message"]
  out: (); i: 0
  while[i<count b
    if[(count b)<i+3; signal "tls: a truncated certificate entry"]
    cn: wbe b[i+til 3]
    i+:3
    if[0=cn; signal "tls: an empty certificate in the chain"]
    if[(count b)<i+cn; signal "tls: a certificate runs past the end of the Certificate message"]
    out,: enlist b[i+til cn]
    i+:cn
    if[(count b)<i+2; signal "tls: a certificate entry with no extensions"]
    i: (i+2)+wbe b[i+til 2]
    if[(count b)<i; signal "tls: a certificate entry's extensions run past the end of the message"]]
  if[0=count out; signal "tls: the server sent no certificates"]
  out}

// CertificateVerify (RFC 8446 4.4.3): the signature covers 64 octets of 0x20, this exact context
// string, one 0x00 separator, and the transcript hash through the Certificate message. The padding
// and the label are the whole point — they are what stops a signature made by a server for one role
// or one protocol version being replayed as a signature for another.
TLSCVCTX: (64#0x20), (`byte$"TLS 1.3, server CertificateVerify"), 0x00
// 2052 = rsa_pss_rsae_sha256, 2057 = rsa_pss_pss_sha256; both are PSS over SHA-256, which is what
// rsa.nt verifies. 1027 = ecdsa_secp256r1_sha256, which p256.nt verifies, and whose signature is
// the same DER SEQUENCE { r, s } a certificate carries. rsa_pkcs1_* is refused here even though the
// ClientHello offers it, because 4.4.3 says those code points "are not defined for use in signed
// TLS handshake messages"; ed25519 and every other scheme are refused because nothing here can
// check them. The scheme decides which key is acceptable, never the other way round: a server does
// not get to pick a scheme and then hand over a key of some other kind to check it with.
certVerify: {[a]
  spki: a[0]; scheme: a[1]; sig: a[2]; thash: a[3]
  d: sha256 TLSCVCTX, thash
  if[scheme in 2052 2057
    if[not `rsa ~ spki`alg
      m: "tls: CertificateVerify uses signature scheme ",string scheme
      signal m,", but the server's key is not an RSA key"]
    if[not rsaVerifyPss[spki`n; spki`e; d; sig]
      signal "tls: the server's CertificateVerify did not verify"]
    :1b]
  if[scheme=1027
    if[not `ec ~ spki`alg
      signal "tls: CertificateVerify uses ecdsa_secp256r1_sha256, but the server's key is not an EC key"]
    if[not `p256 ~ spki`curve
      m: "tls: CertificateVerify uses ecdsa_secp256r1_sha256, but the server's key is on "
      signal m,$[`unknown ~ spki`curve; "the unnamed curve ",spki`oid; string spki`curve]]
    if[not ecdsaVerifyP256Der[spki`point; d; sig]
      signal "tls: the server's CertificateVerify did not verify"]
    :1b]
  m: "tls: CertificateVerify uses signature scheme ",string scheme
  signal m,", which this build cannot verify"}

// chain + hostname, packaged as one argument so tlsConnect can trap it. Returns the leaf's key,
// which is what CertificateVerify is checked against — binding the handshake to the chain.
checkChain: {[a]
  chain: x509Parse each a[0]
  x509VerifyChain[chain; a[2]; a[1]; a[3]]
  (chain[0])`spki}

// a check whose failure has to take the socket down with it: a connection left open after the peer
// failed to authenticate is a connection someone will go on writing to.
tlsGuard: {[h;f;a]
  r: @[{[p] g: p[0]; (1b; g p[1])}; (f;a); {(0b;x)}]
  if[not r[0]; hclose h; signal r[1]]
  r[1]}

// The system trust store, loaded once and kept: x509LoadRoots is ~230ms over the 146 roots in
// /etc/ssl/certs/ca-certificates.crt, and a program that opens several connections should pay that
// once rather than per handshake.
TLSROOTS: ()!()
tlsRoots: {[]
  if[0=count TLSROOTS; TLSROOTS:: x509SystemRoots[]]
  TLSROOTS}

// ---- the handshake. Returns a handle for tlsSend / tlsRecv / tlsClose.
// tlsConnect verifies. tlsConnectOpts takes a dict that may carry any of:
//   `roots   a store from x509LoadRoots. Default: the system store, x509SystemRoots[], cached
//   `now     the (date;time) to judge validity windows at. Default: the machine clock, UTC
//   `verify  0b to skip EVERY certificate check. UNSAFE, and it means it: the handshake still
//            encrypts, but to whoever answered the socket, which against anyone able to sit in the
//            middle of the connection is the same as no protection at all. Tests only, and only
//            because a test wants to reach the record layer without a trust store.
tlsConnect: {[host;port] tlsConnectOpts[host;port;()!()]}
tlsConnectOpts: {[host;port;opts]
  vfy: 1b; roots: ()!(); nw: (now`date; now`time)
  if[0<count opts
    if[`verify in key opts; vfy: opts`verify]
    if[`roots in key opts; roots: opts`roots]
    if[`now in key opts; nw: opts`now]]
  if[vfy; if[0=count roots; roots: tlsRoots[]]]
  priv: urand 32                                           // `rand` is a reproducible PRNG, never a key
  pub: x25519[priv; X25519BASE]
  ch: clientHello[host; pub; urand 32; urand 32]
  h: hopen host,":",string port
  sendPlain[h; 22; ch]
  tr: ch

  r: readRec h
  if[not r[0]=22; signal "tls: expected a handshake record, got type ",string r[0]]
  sh: r[2]
  if[not 2=`int$sh[0]; signal "tls: expected ServerHello, got handshake type ",string `int$sh[0]]
  tr,: sh
  ecdhe: x25519[priv; shKeyShare wdrop[4;sh]]

  early: hkdfExtract[TLSZ; TLSZ]
  hs: hkdfExtract[deriveSecret[early;"derived";0x]; ecdhe]
  cHS: deriveSecret[hs;"c hs traffic";tr]
  sHS: deriveSecret[hs;"s hs traffic";tr]
  ck: trafficKeys cHS
  sk: trafficKeys sHS

  hbuf: 0x; sseq: 0; fin: 0; spki: ()!(); sawCert: 0; sawCv: 0
  while[not fin
    r: readRec h
    if[r[0]=21; signal "tls: alert from server: ",hex r[2]]
    if[r[0]=23
      d: openRec[sk[0]; sk[1]; sseq; r[1]; r[2]]; sseq+:1
      if[not d[0]=22; signal "tls: expected handshake content, got type ",string d[0]]
      hbuf,: d[1]
      while[3<count hbuf                                  // peel off whole messages only
        n: 4+wbe hbuf[1+til 3]
        if[(count hbuf)<n; break]
        mt: `int$hbuf[0]
        raw: n#hbuf
        // Certificate: parse it, then verify the chain and the hostname before anything else is
        // done with it. Cheap structural refusals come first, inside x509VerifyChain.
        if[mt=11
          certs: tlsGuard[h; parseCerts; wdrop[4;raw]]
          TLSCERT[h]: certs
          sawCert: 1
          if[vfy; spki: tlsGuard[h; checkChain; (certs;host;roots;nw)]]]
        // CertificateVerify: `tr` holds the transcript through the Certificate message, because
        // every message is appended only after it has been handled — which is exactly the hash
        // RFC 8446 4.4.3 signs over.
        if[mt=15
          if[not sawCert; tlsGuard[h; {signal "tls: CertificateVerify before any Certificate"}; 0]]
          cv: wdrop[4;raw]
          if[(count cv)<4; tlsGuard[h; {signal "tls: a truncated CertificateVerify"}; 0]]
          sl: wbe cv[2 3]
          if[not (count cv)=4+sl; tlsGuard[h; {signal "tls: a malformed CertificateVerify"}; 0]]
          if[vfy; tlsGuard[h; certVerify; (spki; wbe cv[0 1]; cv[4+til sl]; sha256 tr)]]
          sawCv: 1]
        if[mt=20
          // A server that simply left the authentication out must not reach the Finished check.
          if[vfy
            if[not sawCert; tlsGuard[h; {signal "tls: the server sent no Certificate"}; 0]]
            if[not sawCv; tlsGuard[h; {signal "tls: the server sent no CertificateVerify"}; 0]]]
          if[not (wdrop[4;raw]) ~ hmac[expandLabel[sHS;"finished";0x;32]; sha256 tr]
            hclose h
            signal "tls: the server's Finished did not verify"]
          fin: 1]
        tr,: raw
        hbuf: wdrop[n;hbuf]]]]

  master: hkdfExtract[deriveSecret[hs;"derived";0x]; TLSZ]
  ak: trafficKeys deriveSecret[master;"c ap traffic";tr]
  bk: trafficKeys deriveSecret[master;"s ap traffic";tr]
  sendPlain[h; 20; ,0x01]                                  // dummy CCS, for middleboxes
  sealRec[h; ck[0]; ck[1]; 0; 22; 0x14, wlp24 hmac[expandLabel[cHS;"finished";0x;32]; sha256 tr]]
  TLSC[h]: (ak[0]; ak[1]; 0; bk[0]; bk[1]; 0)
  h}

tlsSend: {[h;data]
  st: TLSC h
  sealRec[h; st[0]; st[1]; st[2]; 23; $[`byte=type data; data; `byte$data]]
  TLSC[h]: (st[0]; st[1]; st[2]+1; st[3]; st[4]; st[5])
  count data}

// one application-data record, or 0x at end of stream. Post-handshake messages are skipped.
tlsRecv: {[h]
  while[1
    st: TLSC h
    r: readRec h
    if[r[0]=21; :0x]                                       // close_notify or any other alert
    if[r[0]=23
      d: openRec[st[3]; st[4]; st[5]; r[1]; r[2]]
      TLSC[h]: (st[0]; st[1]; st[2]; st[3]; st[4]; st[5]+1)
      if[d[0]=23; :d[1]]]]}

tlsClose: {[h] TLSC[h]: (); hclose h}
// the chain the server sent, as DER, leaf first — already verified by the time tlsConnect returns
tlsCert: {[h] TLSCERT h}
