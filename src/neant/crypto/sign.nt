// RSA signing (RFC 8017 §8), in neant — the other half of rsa.nt, which only ever verified.
//   load "src/neant/crypto/sign.nt"     // after bignum.nt, sha512.nt, rsa.nt, der.nt
//
//   k: rsaKeyLoad "tests/data/pki-sha512-leaf.key"
//   sig: rsaSignPss[k; `sha256; sha256 msg]              // salt from urand, hLen bytes, as RFC 8017 §9.1 wants
//   sig: rsaSignPkcs1[k; `sha256; sha256 msg]            // the deterministic v1.5 form
//
// WHY THIS IS SEPARATE FROM rsa.nt. Verifying uses the public exponent and nothing secret; signing
// uses `d`, and every mistake here leaks a key rather than accepting a bad signature. Keeping the
// two files apart means a program that only verifies — which is every TLS client — never loads the
// code that touches a private key, and the header of the file it does load can go on saying it
// holds no secrets.
//
// RSA SIGNING no longer branches on the private exponent. rsaPriv used to call bnModExp, which is
// square-and-multiply over the exponent's bits, so the time it took counted the ones in dP and dQ;
// it now calls bnModExpCtL, which multiplies at every bit and keeps the result with a mask, over a
// bit count fixed by the modulus half's public width. It also blinds the exponent — dP + r(p-1),
// which is congruent mod p-1 and so leaves the answer alone — so the pattern being walked differs
// at every call and nothing the field arithmetic leaks can be accumulated across signatures onto
// one fixed exponent. RSA-2048 signing goes from 18.3 ms to 31.2 ms, about 1.7x.
//
// WHAT IS STILL OPEN, and it is the reason to keep reading rather than to stop here: THE BASE IS
// NOT BLINDED. bnMontMul's reduction ends in a conditional subtract, whose frequency depends on the
// operands, and an attacker who can choose messages and time the answers is exactly the Brumley-
// Boneh setting that exploits it. The standard fix is to sign (m * r^e) and divide the result by r,
// which needs r^-1 mod n; a binary extended GCD needs a signed representation and bignum.nt has
// none, and Fermat per prime would mean two more full exponentiations. Neither is written. So:
// this is no longer a key read out by timing the exponent, and it is not yet a signer to put in
// front of an attacker who picks the messages.
//
// ECDSA SIGNING IS DIFFERENT, since ecdsaSign was changed to go through ec.nt's ecCtMul: the scalar
// multiply by the nonce is double-and-add-always with masked selection, so no branch depends on k.
// That is the first-order channel and it is closed; the field arithmetic underneath still is not
// constant-time, and ecCtMul's header says exactly which part. `ki: bnModExpL[kv; C`nm2; C`n]`
// below is square-and-multiply over a PUBLIC exponent (n-2) with a secret base, which is the
// ordinary shape and not the one that leaks the exponent.

// ---- private keys. PKCS#8 (BEGIN PRIVATE KEY) wraps an RSAPrivateKey in an OCTET STRING; PKCS#1
// (BEGIN RSA PRIVATE KEY) is that structure on its own.
//   RSAPrivateKey ::= SEQUENCE { version, n, e, d, p, q, dP, dQ, qInv }
// -> `n`e`d`p`q`dp`dq`qinv, every field a byte vector, and `bits
SIGNPEM8: "-----BEGIN PRIVATE KEY-----"
SIGNPEM8E: "-----END PRIVATE KEY-----"
SIGNPEM1: "-----BEGIN RSA PRIVATE KEY-----"
SIGNPEM1E: "-----END RSA PRIVATE KEY-----"
SIGNRSAOID: "1.2.840.113549.1.1.1"

signPem: {[ls;b;e]
  t: {trim x except "\r"} each ls
  i: &{[b;x] x~b}[b] each t
  j: &{[e;x] x~e}[e] each t
  if[0=count i; :0x]
  if[0=count j; signal "sign: a PEM block with no ",e]
  if[(first j)<first i; signal "sign: the PEM markers are in the wrong order"]
  unb64 raze t[(1+first i)+til (first j)-1+first i]}

rsaKeyLoad: {[path] rsaKeyPem read0 path}
rsaKeyPem: {[ls]
  d8: signPem[ls; SIGNPEM8; SIGNPEM8E]
  if[count d8; :rsaKeyPkcs8 d8]
  d1: signPem[ls; SIGNPEM1; SIGNPEM1E]
  if[count d1; :rsaKeyDer d1]
  signal "sign: no ",SIGNPEM8," or ",SIGNPEM1," in the input"}

// PrivateKeyInfo ::= SEQUENCE { version, privateKeyAlgorithm, privateKey OCTET STRING }
rsaKeyPkcs8: {[der]
  top: derParse der
  derWant[top;DERSEQ;1b]
  k: derKids top
  if[3>count k; signal "sign: a PrivateKeyInfo is a version, an algorithm and a key"]
  a: x509Alg k[1]
  if[not (a[0]) ~ SIGNRSAOID; signal "sign: this build signs with RSA only, not ",a[0]]
  rsaKeyDer derOct k[2]}

rsaKeyDer: {[der]
  top: derParse der
  derWant[top;DERSEQ;1b]
  k: derKids top
  if[9>count k; signal "sign: an RSAPrivateKey has nine fields; this one has ",string count k]
  if[not 0=derIntVal k[0]; signal "sign: only a two-prime RSAPrivateKey (version 0) is read here"]
  v: x509Mag each k[1+til 8]
  ky: `n`e`d`p`q`dp`dq`qinv
  r: ky!v
  r[`bits]: bnBits bnFromBytes r`n
  // the key has to be the one it claims to be, because a wrong modulus signs garbage silently
  if[not (bnCmp[bnMul[bnFromBytes r`p; bnFromBytes r`q]; bnFromBytes r`n]) = 0; signal "sign: p*q is not n"]
  r}

// ---- the private operation. m^d mod n, by CRT when the key carries the primes: two exponentiations
// over half-width moduli is about four times the work of one over the full width, and every RSA key
// in a PEM file carries them.
// EXPONENT BLINDING. dP + r(p-1) is congruent to dP mod p-1, so m to that power is m^dP mod p for
// every m — including the one case the congruence does not cover, p dividing m, where both sides
// are zero. What changes is the bit pattern the exponentiation walks, which is different at every
// call, so whatever the field arithmetic underneath still leaks about intermediate values cannot be
// accumulated across signatures into the one fixed exponent that matters. It costs 64 bits out of
// roughly a thousand. It is NOT a substitute for blinding the base, which is what defeats an
// attacker choosing messages and timing the answers; that needs a modular inverse and bignum.nt has
// no signed representation to run a binary extended GCD in, so it is not written. See this file's
// header.
RSABX: 65                                                 // the bits blinding can add: 64, and a carry
rsaBlindExp: {[eb;P] bnAdd[bnFromBytes eb; bnMul[bnFromBytes urand 8; bnSub[P; ,1]]]}

rsaPriv: {[key;m]
  n: bnFromBytes key`n
  x: bnFromBytes m
  if[not (bnCmp[x;n])<0; signal "sign: the encoded message is not less than the modulus"]
  p: bnFromBytes key`p; q: bnFromBytes key`q
  // bnModExpCtL and NOT bnModExp: the exponent here is the private key, and bnModExp branches on
  // its bits. The width walked is the modulus half's, which is public, plus what blinding adds.
  m1: bnModExpCtL[x; rsaBlindExp[key`dp; p]; p; RSABX + bnBits p]
  m2: bnModExpCtL[x; rsaBlindExp[key`dq; q]; q; RSABX + bnBits q]
  // h = qInv * (m1 - m2) mod p, then m = m2 + q*h
  d: bnSubMod[bnMod[bnPad[m1; count p]; p]; bnMod[bnPad[m2; count p]; p]; p]
  h: bnMod[bnMul[bnFromBytes key`qinv; d]; p]
  r: bnAdd[m2; bnMul[q; h]]
  bnBytesN[bnMod[r; n]; ceiling (key`bits) % 8]}

// ---- EMSA-PKCS1-v1_5 (RFC 8017 §9.2): 00 01 FF..FF 00 DigestInfo, to exactly k octets.
// The inverse of what rsaVerifyPkcs1 takes apart, and it uses rsa.nt's own DigestInfo table so the
// two can never disagree about what a hash's prefix is.
rsaSignPkcs1: {[key;hash;digest]
  di: rsaDigestInfo hash
  if[0=count di; signal "sign: no DigestInfo for ",string hash]
  if[not (count digest) = rsaHashLen hash; signal "sign: the digest is the wrong length for ",string hash]
  k: ceiling (key`bits) % 8
  t: di,digest
  if[k < 11 + count t; signal "sign: the key is too small for a ",(string hash)," signature"]
  em: (0x0001), ((k-3)-count t)#0xff
  em,: (0x00),t
  rsaPriv[key; em]}

// ---- EMSA-PSS-ENCODE (RFC 8017 §9.1.1), the exact inverse of rsaVerifyPss's decode.
// The salt is hLen bytes from urand — `rand` is a reproducible PRNG and a predictable salt is a
// weakness the standard's own security proof depends on not having. rsaSignPssSalt takes one
// explicitly, for a test that wants a fixed vector.
rsaSignPss: {[key;hash;digest] rsaSignPssSalt[key;hash;digest; urand rsaHashLen hash]}
rsaSignPssSalt: {[key;hash;digest;salt]
  hLen: rsaHashLen hash
  if[0=hLen; signal "sign: no such hash: ",string hash]
  if[not (count digest) = hLen; signal "sign: the digest is the wrong length for ",string hash]
  sLen: count salt
  emBits: (key`bits) - 1
  emLen: ceiling emBits % 8
  if[emLen < 2+hLen+sLen; signal "sign: the key is too small for a ",(string hash)," PSS signature with a ",(string sLen),"-byte salt"]
  H: rsaHash[hash; ((8#0x00), digest), salt]             // M' = eight zero bytes | mHash | salt
  dbLen: (emLen - hLen) - 1
  db: (((dbLen-sLen)-1)#0x00), (0x01), salt
  masked: db bxor rsaMgf1[hash;H;dbLen]
  nbits: (8*emLen) - emBits                              // the leading bits emBits forces to zero
  masked[0]: `byte$ (`int$ masked[0]) band (2 xexp 8-nbits)-1
  rsaPriv[key; (masked,H),0xbc]}

// ---- and the round trip, which is the only test that means anything: sign, then verify with the
// public half through rsa.nt's own verifier.
rsaSignCheck: {[key;hash;digest;sig] rsaVerifyPss[key`n; key`e; hash; digest; sig]}

// ============================================================================================
// ECDSA (FIPS 186-4), with the nonce from RFC 6979 rather than from a random source.
//   load "src/neant/crypto/ec.nt"; load "src/neant/crypto/p256.nt"   // before this file is used
//   k: ecKeyLoad "ec-key.pem"
//   sig: ecdsaSignDer[P256C; k`d; sha256 msg]        // DER SEQUENCE { r, s }, what TLS and X.509 carry
//
// WHY DETERMINISTIC, and this is the whole reason the extra machinery is here rather than a call to
// `urand`. ECDSA's per-signature nonce k is not a salt: if it ever repeats across two signatures, or
// is biased, or leaks a few bits, the private key falls out by algebra — two signatures with the
// same k give d directly, and a few bits of bias over enough signatures give it to a lattice. That
// has taken real keys, from the PS3 to Bitcoin wallets. RFC 6979 derives k from the key and the
// message with HMAC-DRBG, so there is no random source to get wrong, no state to fail to reseed
// after a fork, and the same message signs to the same bytes — which also means the standard's own
// test vectors pin this implementation exactly, and tests/sign.nt uses them.
//
// The scalar multiply is constant-time (ecCtMul); the rest of the field arithmetic is not. See
// this file's header, and ec.nt's above ecCtMul, for exactly where the line falls.

// RFC 6979 2.3.2 bits2int, for the case this build is in — the digest and the subgroup order are
// the same width (P-256 with SHA-256, P-384 with SHA-384), so it is the octets as an integer.
// 2.3.4 bits2octets is that reduced mod n and written back out at the order's width.
ecNonceOct: {[C;b;len] bnBytesN[bnMod[bnFromBytes b; C`n]; len]}

// RFC 6979 3.2: HMAC-DRBG over SHA-256, seeded with the key and the digest, until it yields a
// k in [1, n-1]. `hmac` is crypto.nt's, which is HMAC-SHA-256.
ecNonce: {[C;d;digest]
  ln: ceiling (bnBits C`n) % 8
  x: bnBytesN[bnFromBytes d; ln]
  h1: ecNonceOct[C; digest; ln]
  v: 32#0x01
  kk: 32#0x00
  kk: hmac[kk; (v, 0x00, x), h1]
  v: hmac[kk; v]
  kk: hmac[kk; (v, 0x01, x), h1]
  v: hmac[kk; v]
  out: 0x
  while[1
    t: 0x
    while[(count t)<ln; v: hmac[kk; v]; t,: v]
    cand: bnFromBytes ln#t
    if[not bnIsZero cand; if[0>bnCmp[cand; C`n]; :ln#t]]
    kk: hmac[kk; v, 0x00]
    v: hmac[kk; v]]
  out}

// (r; s) as big-endian magnitudes at the order's width. `d` is the private scalar, `digest` the
// already-computed hash, which must be C`dgst octets for the same reason ecVerify insists on it.
ecdsaSign: {[C;d;digest]
  if[not (C`dgst) = count digest; signal "sign: the digest is not this curve's hash width"]
  ln: ceiling (bnBits C`n) % 8
  dv: bnFromBytes d
  if[bnIsZero dv; signal "sign: the private scalar is zero"]
  if[not 0>bnCmp[dv; C`n]; signal "sign: the private scalar is not less than the order"]
  e: bnMod[bnFromBytes digest; C`n]
  G: (C`gx; C`gy)
  kb: ecNonce[C;d;digest]
  kv: bnFromBytes kb
  // ecCtMul and NOT ecShamir: k is the secret here, and ecShamir branches on its bits. See the
  // header above ecCtMul in ec.nt for what that costs and what it does and does not fix.
  R: ecCtMul[C; ecBits[C;kv]; G]
  if[bnIsZero R[2]; signal "sign: k*G is the point at infinity"]
  xy: ecToAffine[C;R]
  r: bnMod[efFrom[C;xy[0]]; C`n]
  if[bnIsZero r; signal "sign: r is zero, which RFC 6979's k cannot produce for a real curve"]
  ki: bnModExpL[kv; C`nm2; C`n]                         // k^-1 mod n; n is prime, so Fermat
  s: bnMod[bnMul[ki; bnMod[bnAdd[e; bnMod[bnMul[r;dv]; C`n]]; C`n]]; C`n]
  if[bnIsZero s; signal "sign: s is zero"]
  (bnBytesN[r;ln]; bnBytesN[s;ln])}

// the DER a certificate's signatureValue and a TLS CertificateVerify carry: SEQUENCE { r, s }, each
// a minimally-encoded INTEGER, which means a leading 00 when the top bit would read as a sign bit
ecDerInt: {[b]
  t: crlTrimZ b
  $[127<`int$t[0]; (0x02, wu8b 1+count t), 0x00, t; (0x02, wu8b count t), t]}
crlTrimZ: {[b] i: 0; n: count b; while[$[i<(n-1); 0=`int$b[i]; 0b]; i+:1]; i _ b}
wu8b: {[n] `byte$ n band 255}
ecdsaSignDer: {[C;d;digest]
  rs: ecdsaSign[C;d;digest]
  body: (ecDerInt rs[0]), ecDerInt rs[1]
  (0x30, wu8b count body), body}

// ---- EC private keys. SEC 1 (BEGIN EC PRIVATE KEY) is
//   ECPrivateKey ::= SEQUENCE { version, privateKey OCTET STRING, [0] parameters, [1] publicKey }
// and PKCS#8 wraps that in an OCTET STRING beside an id-ecPublicKey algorithm.
// -> `d`curve`pub, with `d the private scalar as bytes and `pub the SEC 1 point
SIGNECPEM: "-----BEGIN EC PRIVATE KEY-----"
SIGNECPEME: "-----END EC PRIVATE KEY-----"
SIGNECOID: "1.2.840.10045.2.1"

ecKeyLoad: {[path] ecKeyPem read0 path}
ecKeyPem: {[ls]
  d1: signPem[ls; SIGNECPEM; SIGNECPEME]
  if[count d1; :ecKeySec1 d1]
  d8: signPem[ls; SIGNPEM8; SIGNPEM8E]
  if[count d8; :ecKeyPkcs8 d8]
  signal "sign: no ",SIGNECPEM," or ",SIGNPEM8," in the input"}
ecKeyPkcs8: {[der]
  top: derParse der
  derWant[top;DERSEQ;1b]
  k: derKids top
  if[3>count k; signal "sign: a PrivateKeyInfo is a version, an algorithm and a key"]
  a: x509Alg k[1]
  if[not (a[0]) ~ SIGNECOID; signal "sign: not an EC private key, but ",a[0]]
  crv: $[1=count a[1]; derOid (a[1])[0]; ""]
  r: ecKeySec1 derOct k[2]
  if[count crv; r[`oid]: crv]
  r}
ecKeySec1: {[der]
  top: derParse der
  derWant[top;DERSEQ;1b]
  k: derKids top
  if[2>count k; signal "sign: an ECPrivateKey is a version and a private key"]
  if[not 1=derIntVal k[0]; signal "sign: only ECPrivateKey version 1 is read here"]
  dv: derOct k[1]
  oid: ""; pub: 0x
  i: 2
  while[i<count k
    nd: k[i]
    if[`ctx=nd`cls
      if[0=nd`tag; if[1=count derKids nd; oid: derOid (derKids nd)[0]]]
      if[1=nd`tag; if[1=count derKids nd; pub: derBits (derKids nd)[0]]]]
    i+:1]
  `d`oid`pub!(dv; oid; pub)}
