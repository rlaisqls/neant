// The TLS 1.3 server handshake, in neant — the half src/neant/crypto/tls.nt did not have.
//   load "src/neant/crypto/tlsclient.nt"   // the whole client stack, which this builds on
//   load "src/neant/crypto/sign.nt"        // because a server signs, and a client never does
//   load "src/neant/crypto/tlsserver.nt"
//
//   l: hlisten "0.0.0.0:8443"
//   h: tlsAccept[accept l; pemLoad "cert.pem"; rsaKeyLoad "key.pem"]
//   tlsSend[h; "hello"]; tlsRecv h; tlsClose h
//
// The handle it returns is an ordinary tls.nt handle: tlsSend, tlsRecv and tlsClose work on it
// unchanged, because the only thing that differs between the two ends is which traffic secret
// writes and which reads, and that is one swap in the table tls.nt already keeps.
//
// EVERYTHING HERE IS tls.nt's, mirrored. The record layer, the key schedule, the transcript
// discipline and the message framing are its functions called from the other side; what is new is
// the ClientHello parser (the client only ever built one), the ServerHello builder (it only ever
// parsed one), and CertificateVerify signed rather than checked.
//
// SCOPE, and it is narrow on purpose:
//   * one cipher suite, TLS_CHACHA20_POLY1305_SHA256 (0x1303), because crypto.nt has ChaCha20 and
//     Poly1305 and no AES. A ClientHello that does not offer it is refused by name.
//   * one group, x25519. Two signature schemes, chosen by what kind of key you hand it:
//     rsa_pss_rsae_sha256 for an RSA key, ecdsa_secp256r1_sha256 for a P-256 one — which is what
//     the public web actually serves. A key on any other curve is refused with the curve named.
//   * NO client certificates: this never sends a CertificateRequest, so it never authenticates the
//     peer. Whoever connects is anonymous, exactly as a public web server's clients are.
//   * no session resumption, no early data, no HelloRetryRequest. A client whose key_share is not
//     x25519 is refused rather than asked to try again, which is a real interoperability limit and
//     not a security one.
//   * sign.nt is NOT constant-time, and a server is exactly where that matters most: this signs on
//     a machine an attacker may be able to time. Read sign.nt's header before putting this
//     anywhere real.

TLSSCHACHA: 4867                                  // TLS_CHACHA20_POLY1305_SHA256
TLSSX25519: 29
TLSSPSS256: 2052                                  // rsa_pss_rsae_sha256
TLSSECP256: 1027                                  // ecdsa_secp256r1_sha256
TLSSP256OID: "1.2.840.10045.3.1.7"
TLSSCVCTX: (64#0x20), (`byte$"TLS 1.3, server CertificateVerify"), 0x00

// ---- ClientHello, taken apart. The body is
//   version(2) random(32) lp8 session_id lp16 cipher_suites lp8 compression lp16 extensions
// -> `random`sid`suites`exts, with `exts the raw extension block findExt already knows how to read
tlssParseCh: {[msg]
  if[0=count msg; signal "tls: an empty handshake message"]
  if[not 1=`int$msg[0]; signal "tls: expected ClientHello, got handshake type ",string `int$msg[0]]
  b: wdrop[4;msg]
  if[(count b)<38; signal "tls: a truncated ClientHello"]
  rnd: b[2+til 32]
  i: 34
  sl: `int$b[i]; i+:1
  sid: b[i+til sl]; i+:sl
  cl: wbe b[i+til 2]; i+:2
  cs: b[i+til cl]; i+:cl
  ml: `int$b[i]; i+:1+ml
  el: wbe b[i+til 2]; i+:2
  `random`sid`suites`exts!(rnd; sid; cs; b[i+til el])}

// every two-byte code point in a lp16-framed list
tlssU16s: {[b] $[0=count b; (); wbe each {[b;i] b[i+til 2]}[b] each 2*til (count b) div 2]}

// the client's x25519 share, or a signal saying why there is not one
tlssClientShare: {[ch]
  ks: findExt[ch`exts; 51]
  if[0=count ks; signal "tls: the client sent no key_share"]
  b: ks[2+til wbe ks[0 1]]                        // lp16 around the list of shares
  i: 0
  while[i<count b
    g: wbe b[i+til 2]
    n: wbe b[(i+2)+til 2]
    if[g=TLSSX25519; :b[(i+4)+til n]]
    i: i+4+n]
  signal "tls: the client offered no x25519 key_share, and this server has no other group"}

// which scheme this server's key signs with, refusing a key it cannot use BY NAME rather than
// discovering it halfway through a handshake
tlssScheme: {[pk]
  if[`n in key pk; :TLSSPSS256]
  if[not `d in key pk; signal "tls: the key is neither an RSA nor an EC private key"]
  if[not (pk`oid) ~ TLSSP256OID
    signal "tls: this server signs on P-256 only, and the key names the curve ",$[0=count pk`oid; "(none)"; pk`oid]]
  TLSSECP256}
tlssSchemeName: {[sc] $[sc=TLSSPSS256; "rsa_pss_rsae_sha256"; "ecdsa_secp256r1_sha256"]}

tlssCheck: {[ch;sc]
  if[not TLSSCHACHA in tlssU16s ch`suites
    signal "tls: the client offered no TLS_CHACHA20_POLY1305_SHA256, and this server has no other suite"]
  spv: findExt[ch`exts; 43]
  if[0=count spv; signal "tls: the client sent no supported_versions, so it is not TLS 1.3"]
  if[not 772 in tlssU16s spv[1+til `int$spv[0]]; signal "tls: the client did not offer TLS 1.3"]
  sa: findExt[ch`exts; 13]
  if[0=count sa; signal "tls: the client sent no signature_algorithms"]
  if[not sc in tlssU16s sa[2+til wbe sa[0 1]]
    signal "tls: the client offered no ",(tlssSchemeName sc),", which is what this server's key signs with"]
  1b}

// ---- ServerHello. Its supported_versions carries the version alone, where the ClientHello's
// carries a list of them, and its key_share one share where the ClientHello's carries a list.
tlssServerHello: {[rnd;sid;pub]
  exts: wext[43; wu16 772]
  exts,: wext[51; (wu16 TLSSX25519), wlp16 pub]
  body: 0x0303, rnd, (wlp8 sid), (wu16 TLSSCHACHA), 0x00, wlp16 exts
  0x02, wlp24 body}

// Certificate (RFC 8446 4.4.2): a zero-length request context, then a lp24 list whose entries are
// each a lp24 certificate and a lp16 extension block that is empty here.
tlssCertMsg: {[certs]
  lst: raze {[c] (wlp24 c), 0x0000} each certs
  0x0b, wlp24 (0x00, wlp24 lst)}

// CertificateVerify: the signature is over 64 spaces, the context string, a zero, and the
// transcript hash — the same bytes tls.nt's certVerify checks on the other side, which is why that
// constant is written out again here rather than shared: if the two ever disagree, the handshake
// fails loudly instead of one side quietly signing something the other does not check.
tlssCertVerify: {[pk;sc;tr]
  d: sha256 TLSSCVCTX, sha256 tr
  sig: $[sc=TLSSPSS256; rsaSignPss[pk; `sha256; d]; ecdsaSignDer[P256C; pk`d; d]]
  0x0f, wlp24 ((wu16 sc), wlp16 sig)}

tlssFinished: {[secret;tr] 0x14, wlp24 hmac[expandLabel[secret;"finished";0x;32]; sha256 tr]}

// ---- the handshake. `conn` is an accepted socket handle, `certs` the chain leaf-first as DER
// (pemLoad gives exactly that), `pk` an rsaKeyLoad key for the leaf. It is `pk` and not `key`
// because `key` is a builtin, and a local or a global of that name shadows it — which costs an hour
// when the thing that then misbehaves is `key opts` three files away.
tlsAccept: {[conn;certs;pk]
  if[0=count certs; signal "tls: a server needs at least one certificate"]
  r: readRec conn
  if[not r[0]=22; tlssBad[conn; "tls: expected a handshake record, got type ",string r[0]]]
  sc: tlssScheme pk
  ch: tlssParseCh r[2]
  tlssCheck[ch;sc]
  tr: r[2]

  priv: urand 32                                  // `rand` is a reproducible PRNG, never a key
  pub: x25519[priv; X25519BASE]
  ecdhe: x25519[priv; tlssClientShare ch]
  sh: tlssServerHello[urand 32; ch`sid; pub]
  sendPlain[conn; 22; sh]
  tr,: sh

  early: hkdfExtract[TLSZ; TLSZ]
  hs: hkdfExtract[deriveSecret[early;"derived";0x]; ecdhe]
  cHS: deriveSecret[hs;"c hs traffic";tr]
  sHS: deriveSecret[hs;"s hs traffic";tr]
  ck: trafficKeys cHS
  sk: trafficKeys sHS

  sendPlain[conn; 20; ,0x01]                      // dummy CCS, for middleboxes
  ee: 0x08, wlp24 0x0000                          // EncryptedExtensions, none of them
  sealRec[conn; sk[0]; sk[1]; 0; 22; ee]; tr,: ee
  cm: tlssCertMsg certs
  sealRec[conn; sk[0]; sk[1]; 1; 22; cm]; tr,: cm
  cv: tlssCertVerify[pk; sc; tr]
  sealRec[conn; sk[0]; sk[1]; 2; 22; cv]; tr,: cv
  fin: tlssFinished[sHS; tr]
  sealRec[conn; sk[0]; sk[1]; 3; 22; fin]; tr,: fin

  // the application keys are derived over the transcript through the server's Finished, and the
  // client's Finished is checked against that same transcript — so it is computed before reading
  master: hkdfExtract[deriveSecret[hs;"derived";0x]; TLSZ]
  ak: trafficKeys deriveSecret[master;"c ap traffic";tr]   // the client writes with these
  bk: trafficKeys deriveSecret[master;"s ap traffic";tr]   // and this server does with these
  want: hmac[expandLabel[cHS;"finished";0x;32]; sha256 tr]

  cseq: 0; done: 0; hbuf: 0x
  while[not done
    r: readRec conn
    if[r[0]=21; tlssBad[conn; "tls: alert from client: ",hex r[2]]]
    if[r[0]=23
      d: openRec[ck[0]; ck[1]; cseq; r[1]; r[2]]; cseq+:1
      if[not d[0]=22; tlssBad[conn; "tls: expected handshake content from the client, got type ",string d[0]]]
      hbuf,: d[1]
      while[3<count hbuf
        n: 4+wbe hbuf[1+til 3]
        if[(count hbuf)<n; break]
        raw: n#hbuf
        if[not 20=`int$raw[0]; tlssBad[conn; "tls: expected the client's Finished, got handshake type ",string `int$raw[0]]]
        if[not (wdrop[4;raw]) ~ want; tlssBad[conn; "tls: the client's Finished did not verify"]]
        done: 1
        hbuf: wdrop[n;hbuf]]]]

  TLSC[conn]: (bk[0]; bk[1]; 0; ak[0]; ak[1]; 0)  // this end writes with s ap and reads with c ap
  conn}

// a failure has to take the socket down with it, for the reason tls.nt's tlsGuard gives: a
// connection left open after the handshake failed is one someone will go on writing to.
tlssBad: {[h;m] hclose h; signal m}
