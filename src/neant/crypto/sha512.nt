// SHA-512 and SHA-384 (FIPS 180-4) in neant, on raw 64-bit words. Not part of the boot image —
// load it with  load "src/neant/crypto/sha512.nt"
//
//   sha512[bytes] -> 64 bytes
//   sha384[bytes] -> 48 bytes
//
// SHA-384 is not a second hash: FIPS 180-4 5.3.4 and 6.5 define it as SHA-512's compression
// function with a different initial hash value and the digest cut to its leftmost 48 octets. So
// sha512Block below is the only copy of that function in this tree, and both hashes go through it
// — a second transcription would be 80 rounds of constants nobody would diff again.
//
// This file used to be the top of src/neant/crypto/ed25519.nt, which needed SHA-512 for RFC 8032
// and was the only thing in the tree that did. ECDSA-with-SHA-384 certificates need SHA-384, and
// verify.nt has no business loading a curve it cannot verify to get a hash, so the hash moved out
// and ed25519.nt loads this file instead of carrying it. ed25519.nt's callers therefore load two
// files now; its header says so.
//
// A 64-bit word here is a raw i64 bit pattern: band/bor/bxor/shl/shr are exact on those (shr is
// logical, shl discards), and `badd` is the wrapping add — plain `+` would read 1 shl 63 as an int
// null and poison the round.
rotr64: {[x;n] (x shr n) bor x shl 64-n}
be64: {w: `int$x; n: (count w) div 8; i: 8*til n
  ((w[i] shl 56) bor (w[i+1] shl 48) bor (w[i+2] shl 40) bor w[i+3] shl 32) bor (w[i+4] shl 24) bor (w[i+5] shl 16) bor (w[i+6] shl 8) bor w[i+7]}
be64bytes: {`byte$ raze {(x shr 56 48 40 32 24 16 8 0) band 255} each x}
sha512K: be64 unhex ""
// the two initial hash values, FIPS 180-4 5.3.5 (SHA-512: the fractional parts of the square roots
// of the first eight primes) and 5.3.4 (SHA-384: the ninth to sixteenth). Nothing else differs.
sha512H0: be64 unhex "6a09e667f3bcc908bb67ae8584caa73b3c6ef372fe94f82ba54ff53a5f1d36f1510e527fade682d19b05688c2b3e6c1f1f83d9abfb41bd6b5be0cd19137e2179"
sha384H0: be64 unhex "cbbb9d5dc1059ed8629a292a367cd5079159015a3070dd17152fecd8f70e593967332667ffc00b318eb44a8768581511db0c2e0d64f98fa747b5481dbefa4fa4"
// message, 0x80, zeros to 112 mod 128, then the bit length as 16 big-endian bytes
sha512Pad: {[b] n: count b; b, 0x80, (((111-n) mod 128)#0x00), (8#0x00), be64bytes (,8*n)}   // parens: `be64bytes ,x` would parse as a join with the function
sha512Block: {[h;blk]
  w: be64 blk; i: 16
  while[i<80
    s0: (rotr64[w[i-15];1]) bxor (rotr64[w[i-15];8]) bxor w[i-15] shr 7
    s1: (rotr64[w[i-2];19]) bxor (rotr64[w[i-2];61]) bxor w[i-2] shr 6
    w,: w[i-16] badd s0 badd w[i-7] badd s1
    i+:1]
  a: h[0]; b: h[1]; c: h[2]; d: h[3]; e: h[4]; f: h[5]; g: h[6]; hh: h[7]; i: 0
  while[i<80
    S1: (rotr64[e;14]) bxor (rotr64[e;18]) bxor rotr64[e;41]
    ch: (e band f) bxor (bnot e) band g
    t1: hh badd S1 badd ch badd sha512K[i] badd w[i]
    S0: (rotr64[a;28]) bxor (rotr64[a;34]) bxor rotr64[a;39]
    maj: (a band b) bxor (a band c) bxor b band c
    t2: S0 badd maj
    hh: g; g: f; f: e; e: d badd t1; d: c; c: b; b: a; a: t1 badd t2
    i+:1]
  h badd (a;b;c;d;e;f;g;hh)}
// the whole message through the compression function from a given IV, as eight 64-bit words
sha512Hash: {[h0;b] p: sha512Pad b; h: h0; i: 0
  while[i<count p; h: sha512Block[h; p[i+til 128]]; i+:128]
  h}
sha512: {[b] be64bytes sha512Hash[sha512H0; b]}
// FIPS 180-4 6.5: the same eight words, truncated to the leftmost six. Truncating the BYTES rather
// than dropping the last two words would be the same answer here, but 48 is what the standard
// says and it is what a caller can check against `openssl dgst -sha384`.
sha384: {[b] 48 # be64bytes sha512Hash[sha384H0; b]}
