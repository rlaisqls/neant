// Certificate path validation in neant: hostname matching (RFC 6125), chain verification
// (RFC 5280 6.1) and a PEM trust store, on src/neant/crypto/{bignum,sha512,rsa,der,ec,p256,p384,
// x509}.nt. Not part of the boot image — load all nine, in this order:
//   load "src/neant/crypto/bignum.nt"    load "src/neant/crypto/sha512.nt"
//   load "src/neant/crypto/rsa.nt"       load "src/neant/crypto/der.nt"
//   load "src/neant/crypto/ec.nt"        load "src/neant/crypto/p256.nt"
//   load "src/neant/crypto/p384.nt"      load "src/neant/crypto/x509.nt"
//   load "src/neant/crypto/verify.nt"
// or, since that list is now long enough to get wrong, the one line that does all of it and tls.nt
// too:  load "src/neant/crypto/tlsclient.nt"
//
//   x509CheckHost[cert;host]              -> 1b / 0b
//   x509LoadRoots[path]                   -> a trust store over a PEM bundle
//   x509SystemRoots[]                     -> x509LoadRoots X509CAPATH
//   x509VerifyChain[chain;roots;host;now] -> 1b, or signals "x509: <the specific reason>"
//
// `chain` is the server's certificates parsed by x509Parse, leaf first, exactly in the order they
// arrived — nothing here reorders them or goes looking for a missing link, because a chain that is
// not the chain the server sent is a chain nobody audited. `now` is the caller's (date;time) in
// UTC, never read from the clock in here, so a fixed certificate can be tested at a fixed instant.
//
// Every refusal signals with its own sentence, because "the connection was refused" is not an
// answer anybody can act on. Verification is all-or-nothing: x509VerifyChain returns 1b or signals.
//
// WHAT IS CHECKED, link by link:
//   * the names chain: each certificate's `issuerCanon equals the next one's `subjectCanon
//   * the signature over each certificate's `tbs bytes, with the issuer's `spki
//   * the validity window of every certificate, the trust anchor included, against `now`
//   * basicConstraints cA on every certificate above the leaf, and on the anchor
//   * pathLenConstraint against the number of intermediates actually hanging below
//   * keyUsage: a CA that carries the extension must allow keyCertSign
//   * no certificate carries a critical extension x509.nt does not model (`critUnknown)
//   * the chain ends in, or is signed by, a certificate the trust store holds
//   * the leaf is valid for the host: SAN dNSNames, or SAN iPAddresses for an address literal
//
// WHAT IS NOT, and what that costs you:
//   * nine signature algorithms can be checked and no more: RSASSA-PKCS1-v1_5 and RSASSA-PSS over
//     SHA-256, SHA-384 or SHA-512, ECDSA-SHA256 on P-256, ECDSA-SHA384 on P-384, and Ed25519.
//     SHA-1 is out because it is broken; P-521 is out because there is no p521.nt; ecdsaSha512 is
//     out for the curve-pairing reason below, not for want of the hash. Every one of them is
//     refused BY NAME — the algorithm, and for an EC key the curve — rather than skipped.
//   * Ed25519 needs ed25519.nt, which tlsclient.nt loads for exactly this reason. A program that
//     assembles the modules by hand and leaves it out gets an `undefined: ed25519Verify` rather
//     than a refusal, which is the one place this file assumes its dependency rather than checking
//     it: the alternative, dispatching on whether the global happens to exist, would make a
//     verifier's answer depend on what else the program loaded.
//   * an ECDSA algorithm is paired with exactly ONE curve here: ecdsaSha256 means a P-256 key and
//     ecdsaSha384 means a P-384 key. The pairing is not a rule of X.509 — a P-256 key may sign
//     with SHA-384 — but verifying that combination means FIPS 186-4 6.4's digest truncation, the
//     leftmost min(bitlen(hash), bitlen(n)) bits, which ec.nt deliberately does not implement. So
//     a mismatched pair is refused with both the algorithm and the curve named.
//   * revocation: no CRL, no OCSP. A certificate revoked this morning still verifies.
//   * name constraints, policy constraints, policy mapping, inhibitAnyPolicy (RFC 5280 6.1.4's
//     policy machinery) are not implemented — but a critical extension nobody models is refused,
//     so a CA constrained by a critical nameConstraints is refused rather than used unconstrained.
//   * extendedKeyUsage is parsed and ignored: a certificate issued for e-mail will serve a web
//     request here.
//   * no public-suffix list, so `*.co.uk` in a certificate is treated as an ordinary wildcard.
//   * IPv6 literals are refused outright rather than matched, since nothing here parses one.
// This is a verifier written from scratch to be read, not a substitute for a reviewed one.

// ---- time. (date;time) pairs, the values x509.nt's `notBefore / `notAfter hand back.
x509Le: {[a;b] $[a[0]<b[0]; 1b; $[b[0]<a[0]; 0b; not b[1]<a[1]]]}
x509When: {[t] (string t[0]),"T",string t[1]}

// ---- hostnames (RFC 6125)
// One trailing root dot is not part of the name; everything else is compared lowercased, which is
// RFC 4343's "DNS names are case-insensitive" and as far as this goes — no IDNA, no Unicode.
x509Host: {[host]
  h: lower host
  if[0=count h; signal "x509: an empty hostname"]
  if["."=h[(count h)-1]; h: ((count h)-1)#h]
  if[0=count h; signal "x509: an empty hostname"]
  h}

// dotted-quad -> its four octets, or () for anything that is not one. A part with a leading zero is
// refused rather than read as octal the way inet_aton would: two readings of one string is exactly
// the ambiguity a verifier must not have.
x509Ip4: {[h]
  ps: "." vs h
  if[not 4=count ps; :()]
  ok: 1b; out: 0x; i: 0
  while[i<4
    p: ps[i]
    if[(0=count p) | 3<count p; ok: 0b]
    if[ok; if[not all p in "0123456789"; ok: 0b]]
    if[ok; if[(1<count p) & "0"=p[0]; ok: 0b]]
    if[ok
      v: 0; j: 0
      while[j<count p; v: (10*v)+(`code$p[j])-48; j+:1]
      if[255<v; ok: 0b]
      if[ok; out,: `byte$v]]
    i+:1]
  $[ok; out; ()]}

// x509.nt returns the dNSName entries of a SAN and says a verifier wanting iPAddress walks the
// nodes itself, so this does: `tbs is the tbsCertificate as it arrived, its extensions are its last
// field, and an iPAddress is GeneralName [7] IMPLICIT OCTET STRING — 4 octets or 16, unexamined.
x509SanIps: {[c]
  k: derKids derParse c`tbs
  if[0=count k; :()]
  e: k[(count k)-1]
  if[not (`ctx=e`cls) & 3=e`tag; :()]
  es: derKids (derKids e)[0]
  out: (); i: 0
  while[i<count es
    f: derKids es[i]
    if[(derOid f[0]) ~ X509EXTSAN
      gs: derKids derParse derOct f[(count f)-1]
      j: 0
      while[j<count gs
        g: gs[j]
        if[(`ctx=g`cls) & (7=g`tag) & not g`cons; out,: enlist g`v]
        j+:1]]
    i+:1]
  out}

// RFC 6125 6.4.3, narrowed the way every browser narrows it: a wildcard is allowed only as the
// whole leftmost label and stands for exactly one label. So *.a.com matches x.a.com and matches
// neither a.com (there is no label for the star to be) nor x.y.a.com (one star, one label). A star
// anywhere else, or a partial label like w*.a.com, is not a wildcard and therefore matches nothing
// — reading it as one is how a certificate for w*.com becomes a certificate for the whole TLD.
x509DnsMatch: {[pat;host]
  p: lower pat
  if[0=count p; :0b]
  if[not "*" in p; :p ~ host]
  ls: "." vs p
  if[1=count ls; :0b]                                  // "*" on its own is not a name
  if[not (ls[0]) ~ ,"*"; :0b]                          // the star is the whole leftmost label
  rest: "." sv 1_ls
  if["*" in rest; :0b]                                 // and the only one
  hs: "." vs host
  if[not (count hs)=count ls; :0b]                     // exactly one label, never zero
  if[0=count hs[0]; :0b]
  rest ~ "." sv 1_hs}

// The subject CN is deliberately never consulted: RFC 6125 6.4.4 deprecated it, every modern
// verifier ignores it, and a CN that is not in the SAN is a name nobody attested to.
x509CheckHost: {[c;host]
  h: x509Host host
  if[":" in h; :0b]                                    // an IPv6 literal, which is not parsed here
  ip: x509Ip4 h
  ok: 0b; i: 0
  if[0<count ip                                        // an address literal matches an iPAddress
    ips: x509SanIps c                                  // SAN or nothing: never a dNSName
    while[i<count ips; if[ip ~ ips[i]; ok: 1b]; i+:1]
    :ok]
  ns: c`san
  while[i<count ns; if[x509DnsMatch[ns[i];h]; ok: 1b]; i+:1]
  ok}

// ---- signatures
// rsa.nt verifies PKCS#1 v1.5 and PSS over SHA-256 or SHA-384, p256.nt verifies ECDSA-SHA256 on
// P-256 and p384.nt ECDSA-SHA384 on P-384: those six are the whole list. SHA-1 would be refused
// even if rsa.nt knew it. Everything unlisted — Ed25519, SHA-512, P-521, an OID x509.nt could not
// name — is refused by name below rather than skipped, because a verifier that shrugs at an
// algorithm it cannot check accepts every certificate that uses it.
X509V15SIGS: `rsaPkcs1Sha256`rsaPkcs1Sha384`rsaPkcs1Sha512
X509PSSSIGS: `rsaPssSha256`rsaPssSha384`rsaPssSha512
X509RSASIGS: X509V15SIGS,X509PSSSIGS
X509ECSIGS:  `ecdsaSha256`ecdsaSha384
X509EDSIGS:  ,`ed25519
X509SHA384SIGS: `rsaPkcs1Sha384`rsaPssSha384`ecdsaSha384
X509SHA512SIGS: `rsaPkcs1Sha512`rsaPssSha512
x509SigOk: {[c] (c`sigAlg) in X509RSASIGS,X509ECSIGS,X509EDSIGS}
// the hash an algorithm names, and the digest over the bytes that were signed.  Ed25519 names no
// hash at all: RFC 8032 signs the message itself and does its own SHA-512 inside, so it takes the
// tbs span rather than a digest of it and never reaches these two.
x509Digest: {[a;b] $[a in X509SHA512SIGS; sha512 b; a in X509SHA384SIGS; sha384 b; sha256 b]}
x509SigHash: {[a] $[a in X509SHA512SIGS; `sha512; a in X509SHA384SIGS; `sha384; `sha256]}
// and, for ECDSA, the one curve this build pairs that algorithm with: see the header on why the
// pairing is fixed rather than free.
x509SigCurve: {[a] $[a ~ `ecdsaSha384; `p384; `p256]}
x509CurveName: {[c] $[c ~ `p256; "P-256"; c ~ `p384; "P-384"; string c]}
// and the algorithm is only half of it: the ISSUER'S KEY has to be one this build can check that
// signature with. An RSA signature needs an RSA key; an ECDSA one needs an EC key on the curve its
// hash is paired with, and every other curve — P-521, one x509.nt could not name, or simply the
// wrong one of P-256 and P-384 — is refused with its own sentence naming it. "p384 read as some
// elliptic curve, near enough" is how a verifier stops verifying.
// -> "" when the key fits, otherwise the reason it does not.
x509KeyWhy: {[c;spki]
  a: c`sigAlg
  if[a in X509RSASIGS
    if[not `rsa ~ spki`alg
      m: "x509: ",(c`subject)," is signed with ",(string a)," but ",(c`issuer)
      :m,"'s key is not an RSA key"]
    :""]
  if[a in X509EDSIGS
    if[not `ed25519 ~ spki`alg
      m: "x509: ",(c`subject)," is signed with ",(string a)," but ",(c`issuer)
      :m,"'s key is not an Ed25519 key"]
    :""]
  if[a in X509ECSIGS
    if[not `ec ~ spki`alg
      m: "x509: ",(c`subject)," is signed with ",(string a)," but ",(c`issuer)
      :m,"'s key is not an EC key"]
    w: x509SigCurve a
    if[not w ~ spki`curve
      m: "x509: ",(c`subject)," is signed with ",(string a)," by a key on "
      m,: $[`unknown ~ spki`curve; "the unnamed curve ",spki`oid; string spki`curve]
      :m,"; this build checks ",(string a)," on ",(x509CurveName w)," only"]
    :""]
  ""}
x509SigVerify: {[c;spki]
  if[0 < count x509KeyWhy[c;spki]; :0b]                // the wrong kind of key never gets a chance
  a: c`sigAlg
  h: x509SigHash a
  d: x509Digest[a; c`tbs]                              // the span as it arrived, not a re-encoding
  if[a in X509V15SIGS; :rsaVerifyPkcs1[spki`n; spki`e; h; d; c`sig]]
  if[a in X509PSSSIGS; :rsaVerifyPss[spki`n; spki`e; h; d; c`sig]]
  if[a ~ `ecdsaSha256; :ecdsaVerifyP256Der[spki`point; d; c`sig]]
  if[a ~ `ecdsaSha384; :ecdsaVerifyP384Der[spki`point; d; c`sig]]
  // Ed25519 signs the tbs span itself, not a digest of it (RFC 8032 §5.1.7 hashes internally), so
  // this is the one branch that ignores `d`
  if[a in X509EDSIGS; :ed25519Verify[spki`pub; c`tbs; c`sig]]
  0b}
// one link: c, signed by the key in spki, which belongs to the name c claims issued it
x509Link: {[c;spki]
  if[not x509SigOk c
    m: "x509: ",(c`subject)," is signed with ",string c`sigAlg
    m,: " (",(c`sigAlgOid),"), which this build cannot verify"
    signal m]
  why: x509KeyWhy[c;spki]
  if[0 < count why; signal why]
  if[not x509SigVerify[c;spki]
    m: "x509: the signature on ",(c`subject)," does not verify with "
    signal m,(c`issuer),"'s key"]
  1b}

// ---- the trust store
// `subjects`certs`skipped!(symbols; parsed certificates; int): the canonical subject each root is
// found by, the root itself, and how many blocks in the bundle would not parse.
//
// A root this build cannot read is dropped rather than refused: the alternative is that one odd
// certificate in a system bundle takes down every connection, and dropping a root only ever makes
// the store trust less. `skipped` is there so a caller can notice.
//
// Measured on this machine, /etc/ssl/certs/ca-certificates.crt, 146 roots (tests/x509bench.nt):
//   pemLoad  9 ms      x509ParseMany of all 146  46 ms      55 ms in total, 377 us a certificate
// Everything is parsed up front. Indexing by subject and parsing a root only when a chain reached
// it could save at most that 46 ms — the base64 has to be decoded before there is a subject to
// index by at all — and parsing eagerly is what makes a malformed root a load-time problem instead
// of a mid-handshake one. 55 ms once per process is not worth trading that away for.
X509CAPATH: "/etc/ssl/certs/ca-certificates.crt"
// The whole bundle goes through x509ParseMany, which reads all 146 in one derScan. A root this
// build cannot read is still dropped rather than refused — but the batch reader is all-or-nothing,
// so one unreadable root costs the batch and the store is re-read a certificate at a time.
x509LoadRoots: {[path]
  ds: pemLoad path
  if[0=count ds; :`subjects`certs`skipped!(();();0)]
  cs: @[x509ParseMany; ds; {[e] ,`x509bad}]
  if[(1=count cs) & `x509bad ~ cs[0]
    cs: {[d] @[x509Parse; d; {[e] `x509bad}]} each ds]
  sj: (); out: (); bad: 0; i: 0
  while[i<count cs
    c: cs[i]
    if[`x509bad ~ c; bad+:1]
    if[not `x509bad ~ c; sj,: `$c`subjectCanon; out,: enlist c]
    i+:1]
  `subjects`certs`skipped!(sj;out;bad)}
x509SystemRoots: {[] x509LoadRoots X509CAPATH}
// every root with this subject: a rollover can put two keys under one name, and the right one is
// whichever verifies, so all of them are tried rather than the first
x509Find: {[roots;canon]
  sj: roots`subjects
  if[0=count sj; :()]
  where sj = `$canon}
// the chain already ends in a trust anchor: same subject AND the same SubjectPublicKeyInfo, byte
// for byte. An anchor is trusted by identity, so its own self-signature is not what makes it one —
// checking that signature would prove nothing an attacker who swapped the root could not also fake.
x509IsAnchor: {[roots;c]
  ix: x509Find[roots; c`subjectCanon]
  ok: 0b; j: 0
  while[j<count ix; if[(c`spkiRaw) ~ ((roots`certs)[ix[j]])`spkiRaw; ok: 1b]; j+:1]
  ok}

// ---- the checks every certificate faces on its own
// ---- extendedKeyUsage (RFC 5280 4.2.1.12). The extension says what the key was ISSUED for, so a
// verifier that ignores it hands back the constraint the CA applied: a certificate issued for
// S/MIME or code signing, whose SAN happens to carry a hostname, would serve a web request.
//
// Two decisions, neither of which RFC 5280 settles, both taken the way browsers take them:
//   * this function is TLS server verification — it takes a hostname — so the purpose is
//     serverAuth, not a parameter.
//   * the constraint NESTS: an intermediate restricted to emailProtection cannot issue a server
//     certificate under it. 5280 defines EKU per certificate and says nothing about chaining;
//     CA/Browser Forum requires serverAuth on intermediates and browsers enforce the nesting.
//     Checked against a real chain: Google's leaf carries serverAuth and both certificates above
//     it carry serverAuth and clientAuth, so the strict reading costs a real chain nothing.
//   * a trust anchor is exempt: it is trusted by being in the store, not by what it says about
//     itself, which is also what implementations do.
// An ABSENT extension is unconstrained, per 5280. Getting that wrong would refuse ordinary CAs.
X509EKUSERVER: "1.3.6.1.5.5.7.3.1"
X509EKUANY: "2.5.29.37.0"
// -> "" when the certificate may be used for TLS server authentication, otherwise why not
x509EkuWhy: {[c]
  e: c`eku
  if[0=count e; :""]
  if[X509EKUSERVER in e; :""]
  if[X509EKUANY in e; :""]
  m: "x509: ",(c`subject)," may not be used for TLS server authentication: its extendedKeyUsage is "
  m,("," sv e),", which does not include serverAuth (",X509EKUSERVER,")"}

x509CheckOne: {[c;now]
  if[0<count c`critUnknown
    m: "x509: ",(c`subject)," has a critical extension this verifier does not model: "
    signal m,(c`critUnknown)[0]]
  if[not x509Le[c`notBefore;now]
    signal "x509: ",(c`subject)," is not valid until ",x509When c`notBefore]
  if[not x509Le[now;c`notAfter]
    signal "x509: ",(c`subject)," expired on ",x509When c`notAfter]
  1b}
// and the extra ones a certificate faces for being above the leaf. `below` is how many
// intermediates hang under it — RFC 5280 4.2.1.9's pathLenConstraint counts exactly those, the leaf
// excluded. An absent constraint (0N) is no constraint.
x509CheckCa: {[c;below]
  if[not c`isCa
    m: "x509: ",(c`subject)," is not a CA (no basicConstraints cA)"
    signal m," and may not have issued the certificate below it"]
  if[0<count c`keyUsage
    if[not `keyCertSign in c`keyUsage
      signal "x509: ",(c`subject),"'s keyUsage does not allow signing certificates"]]
  if[not isnull c`pathLen
    if[(c`pathLen)<below
      m: "x509: ",(c`subject)," has pathLenConstraint ",string c`pathLen
      m,: " but ",(string below)," certificates hang below it"
      signal m]]
  1b}
// a trust anchor, with its own sentences so "the root is expired" is never reported as if the
// server had sent something wrong
x509CheckAnchor: {[r;now;below]
  if[not x509Le[r`notBefore;now]
    signal "x509: the trusted root ",(r`subject)," is not valid until ",x509When r`notBefore]
  if[not x509Le[now;r`notAfter]
    signal "x509: the trusted root ",(r`subject)," expired on ",x509When r`notAfter]
  if[0<count r`critUnknown
    m: "x509: the trusted root ",(r`subject)
    signal m," has a critical extension this verifier does not model"]
  if[not r`isCa; signal "x509: the trusted root ",(r`subject)," is not a CA"]
  x509CheckCa[r;below]}
// tried against one candidate root; packaged as one argument so the caller can trap it and move on
// to the next root with the first refusal kept as the reason if none of them work out
x509TryAnchor: {[a]
  x509CheckAnchor[a[1];a[2];a[3]]
  x509Link[a[0];(a[1])`spki]
  (1b;1b)}

// ---- the chain.
// The order of the checks is deliberate: the cheap structural ones first, so a chain that is out of
// order is told that it is out of order rather than that its leaf is not valid for the host, and so
// that nothing reaches an RSA exponentiation until the shape of the chain is already right.
x509VerifyChain: {[chain;roots;host;now]
  n: count chain
  if[0=n; signal "x509: an empty certificate chain"]

  i: 0                                                 // 1. the names chain, leaf upwards
  while[i<(n-1)
    if[not ((chain[i])`issuerCanon) ~ (chain[i+1])`subjectCanon
      m: "x509: ",((chain[i])`subject)," was not issued by the next certificate in the chain, "
      m,: ((chain[i+1])`subject),"; the server sent them in the wrong order or left one out"
      signal m]
    i+:1]

  i: 0                                                 // 2. each certificate on its own terms
  while[i<n
    x509CheckOne[chain[i];now]
    if[0<i; x509CheckCa[chain[i];i-1]]                 // i-1 intermediates hang below chain[i]
    if[not x509IsAnchor[roots;chain[i]]                // an anchor is exempt; see x509EkuWhy
      ew: x509EkuWhy chain[i]
      if[0<count ew; signal ew]]
    i+:1]

  if[not x509CheckHost[chain[0];host]                  // 3. the leaf is for this host
    sn: (chain[0])`san
    m: "x509: ",((chain[0])`subject)," is not valid for ",host
    m,: " (subjectAltName: ",($[0=count sn; "none"; "," sv sn]),")"
    signal m]

  i: 0                                                 // 4. the signatures, which cost real time
  while[i<(n-1); x509Link[chain[i];(chain[i+1])`spki]; i+:1]

  top: chain[n-1]                                      // 5. and it must reach the trust store
  if[x509IsAnchor[roots;top]; :1b]                     // the server sent the root itself
  if[((top`issuerCanon) ~ top`subjectCanon) & 1=n
    signal "x509: ",(top`subject)," signed itself and is not in the trust store"]
  ix: x509Find[roots; top`issuerCanon]
  if[0=count ix
    m: "x509: no trusted root named ",(top`issuer)
    signal m,", which issued ",top`subject]
  why: ""; j: 0; ok: 0b
  while[j<count ix
    if[not ok
      r: @[x509TryAnchor; (top;(roots`certs)[ix[j]];now;n-1); {(0b;x)}]
      if[r[0]; ok: 1b]
      if[(not r[0]) & 0=count why; why: r[1]]]
    j+:1]
  if[not ok; signal why]
  1b}
