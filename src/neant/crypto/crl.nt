// Certificate revocation lists (RFC 5280 §5), in neant. Not part of the boot image:
//   load "src/neant/crypto/crl.nt"     // after der.nt, x509.nt and verify.nt
//
// A CRL is a certificate's near twin — a signed SEQUENCE whose body is a name, two times and a list
// of serial numbers — so everything here is der.nt's and x509.nt's primitives rearranged, and the
// signature is checked by verify.nt's own x509Link machinery rather than a second copy of it.
//
//   CertificateList ::= SEQUENCE { tbsCertList, signatureAlgorithm, signatureValue BIT STRING }
//   TBSCertList ::= SEQUENCE { version OPTIONAL, signature, issuer, thisUpdate,
//                              nextUpdate OPTIONAL, revokedCertificates OPTIONAL, [0] extensions }
//
// WHAT THIS IS NOT. Fetching is the caller's, deliberately: x509VerifyChain is pure, and a verifier
// that reached for the network in the middle of validating a chain would turn every verification
// into something that can hang, and would leak which certificate is being checked to whoever runs
// the distribution point. So this parses, verifies and answers questions about a CRL you already
// have. src/neant/net/http.nt fetches one — crlUrls says from where — and the two are composed by
// the program, which is the layer that gets to decide about timeouts, caching and failure policy.
//
// Also not here: delta CRLs, indirect CRLs (a CRL signed by anyone but the issuing CA is refused),
// the reasonCode and invalidityDate entry extensions, and issuingDistributionPoint. A CRL carrying
// a CRITICAL extension this does not model is refused, on the same principle x509.nt applies.

CRLEXTIDP: "2.5.29.28"                        // issuingDistributionPoint, critical when present
CRLEXTAKI: "2.5.29.35"; CRLEXTNUM: "2.5.29.20"

// ---- PEM. x509.nt's pemLines is hardwired to CERTIFICATE markers and sits on the trust-store hot
// path, so this does the small thing beside it rather than generalising that. A CRL on the wire is
// DER and needs none of this; a CRL in a file usually wears the PEM wrapper.
CRLPEMBEGIN: "-----BEGIN X509 CRL-----"
CRLPEMEND: "-----END X509 CRL-----"
crlPem: {[ls]
  t: {trim x except "\r"} each ls
  b: &{x~CRLPEMBEGIN} each t
  e: &{x~CRLPEMEND} each t
  if[0=count b; signal "crl: no ",CRLPEMBEGIN," in the input"]
  if[0=count e; signal "crl: no ",CRLPEMEND," in the input"]
  if[(first e)<first b; signal "crl: the PEM markers are in the wrong order"]
  unb64 raze t[(1+first b)+til (first e)-1+first b]}
crlLoad: {[path] crlPem read0 path}

// -> `issuer`issuerCanon`sigAlg`sigAlgOid`tbs`sig`thisUpdate`nextUpdate`serials`critUnknown
// `serials is the revoked serial numbers as byte vectors, in the order the CRL lists them, which is
// how they are compared: a serial is an arbitrary-length integer and reading it as a number would
// overflow on the 20-byte serials real CAs issue.
crlParse: {[der]
  top: derParse der
  derWant[top;DERSEQ;1b]
  ks: derKids top
  if[not 3=count ks; signal "crl: a CertificateList is a tbsCertList, an algorithm and a signature"]
  tbs: ks[0]
  derWant[tbs;DERSEQ;1b]
  oa: x509Alg ks[1]
  sa: x509SigAlg oa
  sig: derBits ks[2]
  if[0=count sig; signal "crl: an empty signature"]

  t: derKids tbs
  n: count t
  i: 0
  // version is OPTIONAL and, unlike a certificate's, is a bare INTEGER rather than a tagged one
  if[0<n; if[`univ=t[0][`cls]; if[2=t[0][`tag]; ver: 1+derIntVal t[0]; if[not ver=2; signal "crl: only a v2 CRL has revokedCertificates"]; i: 1]]]
  if[n<i+3; signal "crl: tbsCertList is missing fields"]
  // RFC 5280 5.1.1.2: the two AlgorithmIdentifiers must agree, down to the encoding
  if[not (t[i][`raw]) ~ ks[1][`raw]; signal "crl: the inner and outer signature algorithms differ"]
  iss: x509Name t[i+1]
  thisU: derTime t[i+2]
  nextU: ()
  j: i+3
  if[j<n; if[`univ=t[j][`cls]; if[t[j][`tag] in 23 24; nextU: derTime t[j]; j+:1]]]
  // revokedCertificates: a SEQUENCE OF SEQUENCE, each starting with the serial
  ser: ()
  if[j<n; if[(`univ=t[j][`cls]) & 16=t[j][`tag]; ser: crlSerials t[j]; j+:1]]
  cru: ()
  if[j<n
    if[(`ctx=t[j][`cls]) & 0=t[j][`tag]
      if[not t[j][`cons]; signal "crl: the extensions tag must be constructed (EXPLICIT)"]
      ek: derKids t[j]
      if[not 1=count ek; signal "crl: the extensions tag holds one SEQUENCE"]
      cru: crlExts ek[0]]]
  ky: `issuer`issuerCanon`sigAlg`sigAlgOid`tbs`sig`thisUpdate`nextUpdate`serials`critUnknown
  ky!(iss[0]; iss[1]; sa[0]; oa[0]; tbs`raw; sig; thisU; nextU; ser; cru)}

// the serial of every entry, as a byte vector. The revocationDate and any entry extensions are
// parsed past rather than kept: nothing here answers "when" or "why", only "is it on the list".
crlSerials: {[nd]
  es: derKids nd
  {[e]
    derWant[e;DERSEQ;1b]
    k: derKids e
    if[2>count k; signal "crl: a revoked entry is a serial and a date"]
    derInt k[0]} each es}

// the OIDs of any CRITICAL extension this does not model — the same rule x509.nt uses.
// Collected by `each` rather than appended to inside the lambda: a closure captures by value, so
// `out,:` in there would build a list nobody ever sees.
crlExtOne: {[e]
  derWant[e;DERSEQ;1b]
  k: derKids e
  if[not (count k) in 2 3; signal "crl: an extension is an OID, an optional critical flag and a value"]
  o: derOid k[0]
  if[not $[3=count k; derBool k[1]; 0b]; :""]
  $[o in (CRLEXTIDP;CRLEXTAKI;CRLEXTNUM); ""; o]}
crlExts: {[nd]
  derWant[nd;DERSEQ;1b]
  es: derKids nd
  if[0=count es; :()]
  o: crlExtOne each es
  o[&0<count each o]}

// ---- what a caller asks
// Is this CRL the one for this certificate, signed by the key that issued it, and current?
// -> "" when the CRL may be used to answer for `c`, otherwise why not. `now` is (date;time).
crlWhy: {[crl;c;issuer;now]
  if[0<count crl`critUnknown
    m: "crl: the list from ",(crl`issuer)," has a critical extension this verifier does not model: "
    :m,"," sv crl`critUnknown]
  // an indirect CRL is one signed by someone other than the CA that issued the certificate; this
  // refuses it rather than guessing, which is the same choice x509.nt makes about unknown curves
  if[not (crl`issuerCanon) ~ c`issuerCanon
    m: "crl: the list is issued by ",(crl`issuer)," but ",(c`subject)," was issued by ",c`issuer
    :m,", and an indirect CRL is not checked here"]
  if[crlStale[crl;now]; :"crl: the list from ",(crl`issuer)," expired at ",(iso (crl`nextUpdate)[0])," and a stale list cannot be trusted"]
  if[not crlSigOk[crl;issuer]; :"crl: the signature on the list from ",(crl`issuer)," does not verify with ",(issuer`subject),"'s key"]
  ""}
// a list with no nextUpdate is never stale by this test — 5280 says nextUpdate SHOULD be present,
// and refusing every list that omits it would refuse more than it protects
crlStale: {[crl;now]
  nu: crl`nextUpdate
  if[0=count nu; :0b]
  $[(nu[0])<now[0]; 1b; ((nu[0])=now[0]) & (nu[1])<now[1]]}
// the signature, through verify.nt's own dispatch: a CRL is signed exactly as a certificate is, so
// the algorithm and key-type rules are the same ones and are not written twice
crlSigOk: {[crl;issuer]
  c: `subject`issuer`sigAlg`sigAlgOid`tbs`sig!("the CRL"; crl`issuer; crl`sigAlg; crl`sigAlgOid; crl`tbs; crl`sig)
  if[not x509SigOk c; :0b]
  x509SigVerify[c; issuer`spki]}

// Is this serial on the list? Serials are compared as the byte strings DER gave, with leading zero
// padding removed, because that is the only comparison that is right for an arbitrary-length integer.
crlTrim: {[b] i: 0; n: count b; while[$[i<(n-1); 0=`int$b[i]; 0b]; i+:1]; i _ b}
crlHas: {[crl;serial] s: crlTrim serial; 0<sum {[s;x] s~crlTrim x}[s] each crl`serials}

// the whole question, in one call: () when the certificate is not revoked by this list, otherwise
// the reason it cannot be used or the fact that it is.
//   why: crlCheck[crlParse der; leaf; intermediate; (now`date; now`time)]
crlCheck: {[crl;c;issuer;now]
  w: crlWhy[crl;c;issuer;now]
  if[0<count w; :w]
  if[crlHas[crl; c`serial]; :"crl: ",(c`subject)," is revoked (serial ",(hex c`serial),") by the list from ",crl`issuer]
  ""}

// ---- the whole thing, over a chain. `fetch` is the caller's: a function from a URL to the bytes
// at it (src/neant/net/http.nt's httpGet wrapped is the obvious one), and it stays the caller's for
// the reason in this file's header. What this adds is the loop and the policy that goes with it:
//
//   * every certificate BELOW the trust anchor is checked, not only the leaf. A revoked
//     intermediate is the case revocation exists for.
//   * a certificate with no distribution point is not an error. RFC 5280 does not require one, and
//     treating "nothing to check" as "failed to check" would refuse most private PKIs outright.
//   * a fetch that fails IS an error here, and the caller decides what that means. Soft-fail — the
//     browser behaviour of ignoring an unreachable responder — is a policy that belongs to whoever
//     knows whether this connection is worth blocking, not to this function. Trap it to get it.
//
//   why: crlChain[(leaf; intermediate); {[u] (httpGet u)`body}; (now`date; now`time)]
//
// WHAT THIS COSTS, measured rather than guessed, because it decides which of the two to call.
// A public CA's leaf CRL is enormous: example.com's is **43,495,327 bytes and 887,654 serials**,
// 3.0s to fetch and 12.8s to parse (derScan is 8.1s on the same buffer, so it is the size and not
// the parser). Its two intermediates' lists are **301 and 299 bytes, 1ms**. That asymmetry is the
// whole story of why the web left CRLs for OCSP and then for pushed lists, and it is not something
// a faster parser fixes.
//
// So `crlChainCa` checks every link EXCEPT the leaf's own list. It costs milliseconds, and it
// catches the case revocation is really for — a sub-CA that has to be withdrawn — while leaving the
// unbounded download out of the handshake. `crlChain` is the complete check, for a private PKI, for
// a pinned list you fetched once, or when you have decided the leaf's list is worth the wait.
crlChain: {[chain;fetch;now] crlFrom[chain;fetch;now;0]}
crlChainCa: {[chain;fetch;now] crlFrom[chain;fetch;now;1]}
crlFrom: {[chain;fetch;now;from]
  n: count chain
  i: from
  while[i<(n-1)
    w: crlOne[chain[i]; chain[i+1]; fetch; now]
    if[0<count w; :w]
    i+:1]
  ""}
// one link. The DER is needed as well as the parsed form, since the distribution point is an
// extension x509Parse does not keep — it models four, and this is a fifth.
crlOne: {[c;issuer;fetch;now]
  us: crlUrlsTbs c`tbs
  if[0=count us; :""]
  crl: crlParse fetch first us
  crlCheck[crl; c; issuer; now]}

// ---- where to fetch one. cRLDistributionPoints (2.5.29.31) holds DistributionPoint entries, each
// of which may carry a distributionPoint [0] whose fullName [0] is a GeneralNames; a uniformResourceIdentifier
// is [6]. Everything else in the structure — relative names, reasons, cRLIssuer — is skipped rather
// than modelled, so this answers "which URLs, if any" and nothing else.
CRLEXTDP: "2.5.29.31"
// over a whole certificate's DER, or over the tbsCertificate bytes x509Parse already kept as `tbs`
// — the extensions live in the tbs, so a parsed certificate needs no second copy of the whole thing
crlUrls: {[der] crlUrlsTbs (derKids derParse der)[0][`raw]}
crlUrlsTbs: {[tbsRaw]
  tbs: derParse tbsRaw
  derWant[tbs;DERSEQ;1b]
  t: derKids tbs
  out: ()
  i: 0
  while[i<count t
    nd: t[i]
    if[(`ctx=nd[`cls]) & 3=nd[`tag]
      ek: derKids nd
      if[1=count ek; out: crlDpScan ek[0]]]
    i+:1]
  out}

crlDpOne: {[e]
  k: derKids e
  if[2>count k; :()]
  if[not (derOid k[0]) ~ CRLEXTDP; :()]
  crlDpUrls derParse derOct k[(count k)-1]}
crlDpScan: {[nd] es: derKids nd; $[0=count es; (); raze crlDpOne each es]}
// every [6] uniformResourceIdentifier anywhere inside the DistributionPoint structure
crlDpUrls: {[nd]
  if[(`ctx=nd[`cls]) & 6=nd[`tag]; :enlist `char$nd`v]
  if[not nd`cons; :()]
  ks: derKids nd
  $[0=count ks; (); raze crlDpUrls each ks]}
