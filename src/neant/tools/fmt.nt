// neant formatter, in neant.  load "src/neant/tools/fmt.nt" — not part of the boot image.
//
//   nfmt[src]       -> the formatted source text
//   nfmtFile[path]  -> format that file in place (read0/write0), 1b when the text changed
//
// Whitespace in this language is load-bearing — `1 -2` is a vector and `1 - 2` is subtraction, a
// newline ends a statement, `f ,x` parses as `f , x` — so this formatter never reflows anything.
// It works from spans produced by nlex's own dispatch (src/neant/core/lex.nt: lexNum, lexName,
// lexSym, lexStr, prevNoun are reused verbatim, so a token here is exactly a token there), it never
// moves a token across a line and it never adds or removes a line.  Exactly these normalisations:
//
//   1. Trailing whitespace (spaces, tabs, CRs) at the end of a line is removed.
//   2. Leading indentation becomes two spaces per bracket — ( [ { — left open by the preceding
//      lines, one level less when the line's own first token is a closer.  A line with nothing on
//      it becomes empty.  A *continuation* line keeps the indentation it has: one whose own first
//      token is ;, one whose previous line's last token is ;, and — since the alignment is of the
//      whole broken-up group, not of one line — every following line that stays at least that
//      deep.  A ; at either end of a line break is the author saying an argument or condition list
//      goes on, and the columns they then chose are not bracket depth: the leading-; $[..] chains
//      in src/neant/jit/arm64.nt, the trailing-; ones in src/neant/core/lex.nt.  A $[..] arm
//      continued with no ; to mark it is indented by depth like anything else.
//   3. Whitespace immediately after ( [ { is removed.
//   4. Whitespace immediately before ) ] } ; is removed.
//   5. A run of whitespace after ; is collapsed to one space.  Where there was none, none is
//      inserted — `f[a;b]` and `if[c; x]` are both left as written.
//
// Everything else is copied through byte for byte: the run of whitespace between any other two
// tokens (so aligned definitions and aligned trailing comments survive), the run before a //
// comment, and the inside of every token — a string, a `1 -2` vector literal, a `2026.01.01
// 2026.01.02` date vector.  A line carrying a token that crosses a newline (a multi-line string)
// is copied verbatim, indentation included.
//
// Meaning-preservation is checked, not argued.  nparse reads nothing but nlex's token list and its
// line table, so identical tokens and identical lines mean an identical AST.  Every rewritten line
// is re-lexed and thrown away for the original unless nlex gives back exactly the original tokens
// (lexing a line alone is lexing it in context: only a string literal can cross a newline, and at
// the start of a line prevNoun is false either way), and nfmt re-checks the whole file the same way
// before returning.  Source nlex cannot tokenise at all is returned unchanged.
//
// nfmt is idempotent: rule 2 depends only on the tokens, rules 3-5 are already satisfied by their
// own output, and a line that fell back to the original falls back again.

// every piece of src in order, as (class; start; end): `ws (spaces, tabs, CRs), `cmt (a // comment
// to the end of the line), `nl (a newline), `tok (everything nlex keeps).  The dispatch below is
// nlex's, minus the line bookkeeping, so the `tok spans are nlex's tokens and the spans tile src.
nfmtScan: {[s]
  n: count s; i: 0; toks: (); out: ()
  while[i<n
    c: s[i]
    r: $[c in " \t\r"; (i+1; ());
         (c="/") & $[(i+1)<n; s[i+1]="/"; 0]; (run[s;i;{not x="\n"}]; ());
         c in "\n;"; (i+1; (`punct; ";"));
         c="`"; lexSym[s;i];
         c="\""; lexStr[s;i;0];
         (c in digits) | ((c=".") & $[(i+1)<n; s[i+1] in digits; 0]) | (c="-") & (not prevNoun toks) & $[(i+1)<n; s[i+1] in digits,"."; 0]; lexNum[s;i];
         (c in alpha) | (c=".") & $[(i+1)<n; s[i+1] in alpha; 0]; lexName[s;i];
         c in puncts; (i+1; (`punct; c));
         c in verbs; (i+1; (`verb; c));
         (c in "\\/") & $[(i+1)<n; s[i+1]=":"; 0]; (i+2; (`adv; $[c="\\"; "L"; "R"]));
         c in "/\\'"; (i+1; (`adv; c));
         signal "fmt: unexpected ",c]
    j: r[0]
    if[count r[1]; toks,: ,r[1]]
    out,: ,($[0=count r[1]; $[c="/"; `cmt; `ws]; c="\n"; `nl; `tok]; i; j)
    i: j]
  out}

// (line starts; line ends), ends excluding the newline itself; one entry per line, so joining the
// formatted lines back with "\n" round-trips a source with or without a final newline
nfmtLineSpans: {[s] p: where s="\n"; (0, 1+p; p, count s)}
nfmtRTrim: {[s] i: where not s in " \t\r"; $[count i; s[til 1+last i]; ""]}
nfmtText: {[s;x] s[x[1]+til x[2]-x[1]]}
nfmtIs1: {[s;x;set] $[x[0]=`tok; $[1=x[2]-x[1]; s[x[1]] in set; 0]; 0]}

// the whitespace to put between spans p and x, given what the source had there
nfmtGap: {[s;p;x;gap]
  if[x[0]=`cmt; :gap]                          // a run before a comment is alignment — never touched
  if[nfmtIs1[s;p;"([{"]; :""]
  if[nfmtIs1[s;x;")]};"]; :""]
  if[nfmtIs1[s;p;";"]; :$[0=count gap; ""; " "]]
  gap}

// one line, from its non-whitespace spans and the indentation decided for it
nfmtJoin: {[s;its;ind]
  n: count its
  if[0=n; :""]
  txt: ind
  i: 0
  while[i<n
    x: its[i]
    if[i>0; p: its[i-1]; txt,: nfmtGap[s; p; x; s[p[2]+til x[1]-p[2]]]]
    txt,: nfmtText[s;x]
    i+:1]
  txt}

// the token list plus the line table, which is everything nparse sees
nfmtToks: {[s] t: nlex s; (t; plines)}
nfmtSame: {[a;b] u: @[nfmtToks; a; {`fail}]; v: @[nfmtToks; b; {`fail}]; $[u~`fail; 0; u~v]}

nfmtBuild: {[s;sp]
  ls: nfmtLineSpans s; st: ls[0]; en: ls[1]
  nl: count st; ns: count sp
  outl: (); k: 0; m: 0; d: 0; ru: -1; psemi: 0; contd: -1
  while[k<nl
    a: st[k]; b: en[k]
    its: (); multi: 0
    while[$[m<ns; sp[m][1]<b+1; 0]
      x: sp[m]
      if[x[2]>b+1
        multi: 1
        c2: sum (nfmtText[s;x])="\n"
        if[(k+c2)>ru; ru: k+c2]]
      if[not x[0] in `ws`nl; its,: ,x]
      m+:1]
    orig: s[a+til b-a]
    // a ;-broken list keeps its own columns, and so does the rest of the group; else 2 per bracket
    ind: ""
    if[count its
      cont: nfmtIs1[s;its[0];";"] | psemi
      if[cont; contd: $[contd<0; d; $[d<contd; d; contd]]]
      if[not cont; cont: $[contd<0; 0; not d<contd]]
      if[not cont; contd: -1]
      dd: $[nfmtIs1[s;its[0];")]}"]; $[d>0; d-1; 0]; d]
      ind: $[cont; s[a+til (its[0][1])-a]; (2*dd)#" "]]
    cand: $[multi | k<ru+1; orig; nfmtJoin[s;its;ind]]
    if[not cand~orig; if[not nfmtSame[orig;cand]; cand: nfmtRTrim orig]]
    outl,: ,cand
    i: 0; ps: 0
    while[i<count its
      x: its[i]
      if[nfmtIs1[s;x;"([{"]; d+:1]
      if[nfmtIs1[s;x;")]}"]; d-:1]
      if[x[0]=`tok; ps: nfmtIs1[s;x;";"]]
      i+:1]
    if[d<0; d: 0]
    psemi: ps
    k+:1]
  "\n" sv outl}

nfmt: {[src]
  if[2>count src; :src]
  sp: @[nfmtScan; src; {()}]
  if[0=count sp; :src]
  out: nfmtBuild[src; sp]
  $[nfmtSame[src; out]; out; src]}

// read0 cannot tell whether the file ended in a newline, so a rewritten file gets exactly one
nfmtFile: {[path]
  src: "\n" sv read0 path
  out: nfmt src
  if[out~src; :0b]
  write0[path; out,"\n"]
  1b}
