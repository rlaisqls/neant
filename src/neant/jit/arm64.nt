// AArch64 codegen for the baseline JIT (src/jit.rs owns memory/execution; see README "Stage 2").
// Always loaded (part of the boot image) so the JIT can call `jitCompile` on any hot function, but
// nothing here is meant to be called directly from ordinary scripts.
//
// jitCompile[input;trampolines] -> (Bytes; Ints) (machine code, classified vector param/capture
// slots) or null (not compilable).
// input = (opcodes:Ints; args:Ints; consts:List; arity:Int; nlocals:Int) — FnCode::jit_input, src/value.rs.
// trampolines = (call;vecget;vecset), the addresses of src/jit.rs's `jit_call`/`jit_vec_get`/
// `jit_vec_set`, as ints (neant has no way to take a Rust function's address itself, so Rust hands
// them over).

// ---- little-endian byte packing: a 32-bit "word" (built via bor/shl on a plain int) -> 4 bytes.
// A literal like 0xA9800000 (or 0xffff, or 0x07FFFF) is hex-*byte* digits, i.e. a Bytes vector, not
// one big int — jitW reconstructs the (big-endian, as written) int these encoders need, the same
// fold `src/neant/crypto/tls.nt`'s `wbe` already uses for the same reason.
jitW: {[h] 0 {(256*x)+y}/ `int$h}
jitLE: {[w] `byte$ (w band 0xff; (w shr 8) band 0xff; (w shr 16) band 0xff; (w shr 24) band 0xff)}

// ---- registers: x19=loc ptr, x20=NI constant, x21=vm ptr, x22=this call's ok-out ptr — all
// callee-saved, survive nested blr for free. x9..x14 the operand stack (caller-saved, spilled
// around calls). x15 a dedicated call-scratch register. See src/jit.rs's fuller comment.
jitLOC: 19
jitNI: 20
jitVM: 21
jitOK: 22
jitSCRATCH: 15
jitSTACK: 9
jitMAXDEPTH: 6
jitSP: 31
jitSPILLBASE: 96
jitCALLOK: 184
jitFRAME: 192
jitCondLT: 11
jitCondGT: 12
jitCondEQ: 0
jitCondHS: 2                        // unsigned >=: one branch catches both ends of a bounds check
jitCondGE: 10
jitCondLE: 13
jitCondNE: 1
// `buf` (src/jit.rs) is jitVECBASE local words followed by one *descriptor* word per classified
// vector slot — that slot's element count, at jitVECBASE+k for the k'th entry of the slot list.
// The slot's own word holds the element data pointer rather than a `*mut Value`, which is what
// lets `x[i]` be a bounds check and a scaled load instead of a call. Both numbers are src/jit.rs's
// (`MAX_SLOTS`, and the same k it finds with `position`), and the two halves have to agree.
jitVECBASE: 64

// ---- tracing JIT registers (src/trace.rs / jitCompileTrace below): a compiled trace makes no
// calls at all (a call in the loop is *inlined* by the recorder, never called — see "Calls are
// inlined" in src/trace.rs), so it needs no prologue/epilogue and no callee-saved registers —
// everything lives in caller-saved ones. x0=buffer pointer (touched
// locals, in and out — see jit.rs's `CompiledTrace`), x1=out bail-ip pointer, both held for the
// trace's whole lifetime since nothing ever clobbers them (no `blr`). d16..d21 mirror x9..x14 as
// a parallel float operand stack (chosen above d0-d7 so a later pass giving trampolines float
// arguments wouldn't collide with it).
jitTrBUF: 0
jitTrOUT: 1
jitFSTACK: 16

// ---- instruction encoders. Every formula here was cross-checked against `objdump -d` output on
// a snippet assembled with this box's own `as`/`gcc` before being trusted (see README "Stage 2").
jitMovz: {[rd;imm16;hw] (jitW 0xD2800000) bor (hw shl 21) bor (imm16 shl 5) bor rd}
jitMovk: {[rd;imm16;hw] (jitW 0xF2800000) bor (hw shl 21) bor (imm16 shl 5) bor rd}
jitAddR: {[rd;rn;rm] (jitW 0x8B000000) bor (rm shl 16) bor (rn shl 5) bor rd}
jitSubR: {[rd;rn;rm] (jitW 0xCB000000) bor (rm shl 16) bor (rn shl 5) bor rd}
jitMulR: {[rd;rn;rm] (jitW 0x9B007C00) bor (rm shl 16) bor (rn shl 5) bor rd}
jitCmpR: {[rn;rm] (jitW 0xEB00001F) bor (rm shl 16) bor (rn shl 5)}
jitCsel: {[rd;rn;rm;cond] (jitW 0x9A800000) bor (rm shl 16) bor (cond shl 12) bor (rn shl 5) bor rd}
jitCset: {[rd;cond] (jitW 0x9A9F07E0) bor ((cond bxor 1) shl 12) bor rd}
jitLdrImm: {[rt;rn;byteOff] (jitW 0xF9400000) bor ((byteOff div 8) shl 10) bor (rn shl 5) bor rt}
jitStrImm: {[rt;rn;byteOff] (jitW 0xF9000000) bor ((byteOff div 8) shl 10) bor (rn shl 5) bor rt}
jitMovR: {[rd;rn] (jitW 0xAA0003E0) bor (rn shl 16) bor rd}
jitRet: {[] jitW 0xD65F03C0}
jitBlr: {[rn] (jitW 0xD63F0000) bor (rn shl 5)}
jitB: {[imm26] (jitW 0x14000000) bor (imm26 band (jitW 0x03FFFFFF))}
jitCbz: {[rt;imm19] (jitW 0xB4000000) bor ((imm19 band (jitW 0x07FFFF)) shl 5) bor rt}
jitCbnz: {[rt;imm19] (jitW 0xB5000000) bor ((imm19 band (jitW 0x07FFFF)) shl 5) bor rt}
jitBcond: {[cond;imm19] (jitW 0x54000000) bor ((imm19 band (jitW 0x07FFFF)) shl 5) bor cond}
jitCmpImm: {[rn;imm12] (jitW 0xF1000000) bor (imm12 shl 10) bor (rn shl 5) bor 31}
jitSubImm: {[rd;rn;imm12] (jitW 0xD1000000) bor (imm12 shl 10) bor (rn shl 5) bor rd}
jitAddImm: {[rd;rn;imm12] (jitW 0x91000000) bor (imm12 shl 10) bor (rn shl 5) bor rd}
jitStpPre: {[rt1;rt2;rn;immBytes] (jitW 0xA9800000) bor (((immBytes div 8) band 0x7F) shl 15) bor (rt2 shl 10) bor (rn shl 5) bor rt1}
jitStpOff: {[rt1;rt2;rn;byteOff] (jitW 0xA9000000) bor (((byteOff div 8) band 0x7F) shl 15) bor (rt2 shl 10) bor (rn shl 5) bor rt1}
jitLdpOff: {[rt1;rt2;rn;byteOff] (jitW 0xA9400000) bor (((byteOff div 8) band 0x7F) shl 15) bor (rt2 shl 10) bor (rn shl 5) bor rt1}
jitLdpPost: {[rt1;rt2;rn;byteOff] (jitW 0xA8C00000) bor (((byteOff div 8) band 0x7F) shl 15) bor (rt2 shl 10) bor (rn shl 5) bor rt1}
// LDR/STR (register): Xt <- [Xn + Xm*8] and back, the one addressing mode an inlined `x[i]` wants
// (option=011 is LSL/UXTX, S=1 scales by the 8-byte access size).
jitLdrReg: {[rt;rn;rm] (jitW 0xF8607800) bor (rm shl 16) bor (rn shl 5) bor rt}
jitStrReg: {[rt;rn;rm] (jitW 0xF8207800) bor (rm shl 16) bor (rn shl 5) bor rt}
// The bitwise and variable-shift forms the six bit builtins compile to (jitOpBit).
jitAndR: {[rd;rn;rm] (jitW 0x8A000000) bor (rm shl 16) bor (rn shl 5) bor rd}
jitOrrR: {[rd;rn;rm] (jitW 0xAA000000) bor (rm shl 16) bor (rn shl 5) bor rd}
jitEorR: {[rd;rn;rm] (jitW 0xCA000000) bor (rm shl 16) bor (rn shl 5) bor rd}
jitLslv: {[rd;rn;rm] (jitW 0x9AC02000) bor (rm shl 16) bor (rn shl 5) bor rd}
jitLsrv: {[rd;rn;rm] (jitW 0x9AC02400) bor (rm shl 16) bor (rn shl 5) bor rd}

// ---- float (Dn) encoders, for the tracing JIT (src/trace.rs) — a trace records *observed*
// types, so unlike the whole-function JIT there's no static-typing problem to solve here, just
// the AArch64 float ISA itself. jitFDyad's op: 0=FMUL 1=FDIV 2=FADD 3=FSUB 4=FMAX 5=FMIN
// 6=FMAXNM 7=FMINNM — `&`/`|` use FMINNM/FMAXNM specifically, not FMIN/FMAX: Rust's `f64::min`/
// `max` (src/prims.rs's `min2`/`max2`) are IEEE minNum/maxNum (propagate the non-NaN side when
// only one operand is NaN), which is FMINNM/FMAXNM's behavior, not plain FMIN/FMAX's (NaN if
// *either* side is NaN) — an easy mix-up since the mnemonics look interchangeable.
jitFDyad: {[rd;rn;rm;op] (jitW 0x1E600800) bor (op shl 12) bor (rm shl 16) bor (rn shl 5) bor rd}
jitFCmp: {[rn;rm] (jitW 0x1E602000) bor (rm shl 16) bor (rn shl 5)}
jitFMovD: {[dd;dn] (jitW 0x1E604000) bor (dn shl 5) bor dd}     // Dd <- Dn
jitFMovToF: {[dd;xn] (jitW 0x9E670000) bor (xn shl 5) bor dd}   // Dd <- Xn, raw bits
jitFMovToX: {[xd;dn] (jitW 0x9E660000) bor (dn shl 5) bor xd}   // Xd <- Dn, raw bits
jitFLdrImm: {[dt;rn;byteOff] (jitW 0xFD400000) bor ((byteOff div 8) shl 10) bor (rn shl 5) bor dt}
jitFStrImm: {[dt;rn;byteOff] (jitW 0xFD000000) bor ((byteOff div 8) shl 10) bor (rn shl 5) bor dt}

// rd = a 64-bit constant, via movz + up to 3 movk (skipping zero chunks).
jitLoadConst: {[asm;rd;v]
  asm: asm,jitMovz[rd; v band (jitW 0xffff); 0]
  hw: 1
  while[hw<4
    chunk: (v shr (hw*16)) band (jitW 0xffff)
    if[not chunk=0; asm: asm,jitMovk[rd;chunk;hw]]
    hw: hw+1]
  asm}

// ---- locals in registers (README "Stage 2"). Every slot a compiled function touches as a local
// (LoadL/StoreL/TakeL — params, scratch locals and captures alike, in first-seen bytecode order,
// `jitLocalSlots`) gets one register for the whole function, and LoadL/StoreL become register
// moves. The buffer x0 points at on entry (`buf`, src/jit.rs `try_run`/`try_run_raw`) is only how
// the values get *in*, loaded once in the prologue; they are never written back out. That's safe
// because `Compiled::run` reads only the returned value (x0) and the ok word, and neither entry
// point looks at `buf` again after the call, so a return or a deopt just abandons the registers.
// Both entry paths — `try_run` from the interpreter and `try_run_raw` from `jit_call` — marshal
// into the same layout (slot i at `buf[i]`) and reach the same entry, so one prologue serves both.
//
// Unlike a compiled trace, a compiled function makes calls (`blr` to the `jit_call`/`jit_vec_get`/
// `jit_vec_set` trampolines), and its locals have to survive them. The first jitLCALLEE registers
// handed out are callee-saved (x23..x28; x19..x22 are taken, see the top of the file): the
// trampolines preserve them for free, at the cost of one `stp`/`ldp` per two of them in the
// prologue/epilogue — paid once per call *of* the compiled function, not once per call it makes,
// and only for the pairs actually in use. That covers the common function outright. The next
// five are caller-saved (x6..x8, x16, x17 — free because our own code only ever uses x0..x5 for
// trampoline arguments and x15 as scratch, and x16/x17 are only IP0/IP1 across a linker veneer,
// which a `blr` to an absolute address never goes through). Those are spilled to jitLSPILLBASE
// around every `blr`, the same way the live operand stack already is (jitSPILLBASE): a per-call
// cost, but one only a function with more than six locals *and* a call in it ever pays, and
// still cheaper than what it replaces (every LoadL/StoreL of those locals was a memory access).
// A slot past the last register — the twelfth local on — just stays in `buf` and is reached
// through x19 exactly as every local used to be, per slot: no function is rejected for having
// too many locals, its overflow ones only run the old way. (Twelve is well past what real
// functions here have — `traced_loop_allocates_a_register_per_local`'s deliberately wide loop
// has eleven — so the overflow path exists for correctness, not speed.)
//
// A vector-classified slot (`jitClassifySlots`) gets a register like any other: its value is a
// pointer into `vecbuf`, a plain 64-bit word; it's only ever passed to `jit_vec_get`/`jit_vec_set`
// as their first argument and never StoreL'd (the write triple's own StoreL is a no-op, see
// jitOpVecSet), so the register holds the same pointer for the whole call and the trampolines see
// exactly the word they used to be handed from `buf`. Their semantics don't change.
//
// Frame layout (jitFRAME bytes, 16-aligned; stp's pre-index immediate reaches 512):
//   0 x29,x30  16 x19,x20  32 x21,x22  48..96 x23..x28 (jitLSAVEBASE; only the pairs in use)
//   96..144 live operand-stack spill around a blr (jitSPILLBASE, jitMAXDEPTH words)
//   144..184 caller-saved local spill around a blr (jitLSPILLBASE, one word per such register)
//   184 the ok word a trampoline writes (jitCALLOK)
jitLREGS: 23 24 25 26 27 28 6 7 8 16 17
jitLCALLEE: 6
jitLSAVEBASE: 48
jitLSPILLBASE: 144

// Every slot the bytecode touches as a local (LoadL/StoreL/TakeL), in first-seen order — a local's
// position here is its index into jitLREGS, for as long as that list lasts.
jitLocalSlots: {[opcodes;opargs;n]
  slots: ()
  i: 0
  while[i<n
    op: opcodes[i]
    if[(op=3)|(op=4)|(op=13)
      ; a: opargs[i]
        if[(slots?a)=count slots; slots: slots,a]]
    i: i+1]
  `int$slots}

// The register local `a` lives in, or null if it's an overflow slot still in `buf`.
jitLocalReg: {[st;a]
  p: (st[`lslots])?a
  $[p<count st[`lregs]; (st[`lregs])[p]; null]}

// local a <- rs: a register move when the local has a register, else the store through x19 every
// local used to get.
jitRegToLocal: {[st;asm;a;rs]
  r: jitLocalReg[st;a]
  $[isnull r; asm,jitStrImm[rs;jitLOC;a*8]; asm,jitMovR[r;rs]]}

// Around a `blr`: the live operand-stack registers (x9.. below the operands the call consumes)
// and the `ncr` caller-saved local registers in use both go to the frame before and come back
// after, since the trampoline may clobber any of them. The callee-saved local registers need
// nothing here — that's why they're handed out first.
jitSaveLive: {[asm;live;ncr]
  i: 0
  while[i<live; asm: asm,jitStrImm[jitSTACK+i; jitSP; jitSPILLBASE+(i*8)]; i: i+1]
  i: 0
  while[i<ncr; asm: asm,jitStrImm[jitLREGS[jitLCALLEE+i]; jitSP; jitLSPILLBASE+(i*8)]; i: i+1]
  asm}
jitRestoreLive: {[asm;live;ncr]
  i: 0
  while[i<live; asm: asm,jitLdrImm[jitSTACK+i; jitSP; jitSPILLBASE+(i*8)]; i: i+1]
  i: 0
  while[i<ncr; asm: asm,jitLdrImm[jitLREGS[jitLCALLEE+i]; jitSP; jitLSPILLBASE+(i*8)]; i: i+1]
  asm}

// The `ncs` callee-saved local registers in use, saved (prologue) or restored (epilogue) in
// pairs; an odd count saves one register nobody uses, which is harmless and simpler than a
// single-register form.
jitSaveCallee: {[asm;ncs]
  k: 0
  while[(2*k)<ncs; asm: asm,jitStpOff[jitLREGS[2*k];jitLREGS[(2*k)+1];jitSP;jitLSAVEBASE+(16*k)]; k: k+1]
  asm}
jitRestoreCallee: {[asm;ncs]
  k: 0
  while[(2*k)<ncs; asm: asm,jitLdpOff[jitLREGS[2*k];jitLREGS[(2*k)+1];jitSP;jitLSAVEBASE+(16*k)]; k: k+1]
  asm}

// Locals aren't stored back to `buf` on the way out (see the block comment above) — the epilogue
// only undoes the prologue's register saves.
jitEmitEpilogue: {[asm;ncs]
  asm: jitRestoreCallee[asm;ncs]
  asm: asm,jitLdpOff[21;22;jitSP;32]
  asm: asm,jitLdpOff[19;20;jitSP;16]
  asm: asm,jitLdpPost[29;30;jitSP;jitFRAME]
  asm,jitRet[]}

jitEmitReturn: {[asm;valreg;ncs]
  asm: asm,jitMovR[0;valreg]
  asm: jitLoadConst[asm;5;1]
  asm: asm,jitStrImm[5;jitOK;0]
  jitEmitEpilogue[asm;ncs]}

jitEmitDeopt: {[asm;ncs]
  asm: jitLoadConst[asm;5;0]
  asm: asm,jitStrImm[5;jitOK;0]
  jitEmitEpilogue[asm;ncs]}

// Which dyadic verbs this backend inlines — exactly `int_dyad`'s set (src/vm.rs). Kind: 0=+ 1=- 2=*
// 3=& (min) 4=| (max) 5=< 6=> 7==.
jitDyadKind: {[name]
  ks: "+-*&|<>="
  i: ks ss name
  $[0=count i; null; first i]}

// A local slot is `intvec`-eligible only if *every* appearance of it is one of two exact shapes:
// `x[i]` read — `LoadL(s)` immediately consumed by `Call(1)` (`app` in compile.nt: `gen index; gen
// x; emit call 1` — a vector applied as its own indexing function, no dedicated opcode) — or
// `x[i]:v` write — the literal 3-op run `TakeL(s); Amend(1); StoreL(s)` `iassign` always emits back
// to back (value and index are generated *before* this triple, not inside it). Any other
// appearance of `s` (an ordinary arithmetic LoadL, a StoreL that isn't the tail of that triple, a
// TakeL used for `x,: y` instead) disqualifies it — mixed typing isn't supported, the whole
// function just doesn't get this local's accesses fused and falls through to the ordinary (and
// here, rejecting) op handling for it. Restricted to slots `<arity` or `>=nlocals` (params/
// captures) even when a scratch local matches the shape: nothing in the compilable op subset can
// construct a fresh vector value (no arbitrary `LoadG`, no `List`), so only a param/capture is ever
// actually populated with one at entry (`Compiled::try_run`, src/jit.rs) — a scratch local has
// nothing valid written into its slot for this scheme to read as a pointer.
jitClassifySlots: {[opcodes;opargs;n;arity;nlocals]
  readSlots: (); writeSlots: (); intUseSlots: ()
  i: 0
  while[i<n
    op: opcodes[i]; a: opargs[i]
    // `&` is eager (no short-circuit): `opcodes[i+1]` can't sit alongside `(i+1)<n` in one, or it
    // reads out of range whenever the bounds check is what makes it false — same trap as
    // `isStoreHead` below, fixed the same way (a real branch around the bounds-dependent part).
    // And `(i+1)<n`, not `i+1<n` — no operator precedence here, `i+1<n` groups as `i+(1<n)`.
    isReadHead: $[(op=3) & ((i+1)<n); (opcodes[i+1]=7) & ((opargs[i+1])=1); 0b]
    isWriteHead: $[(not isReadHead) & (op=13) & ((i+2)<n); (opcodes[i+1]=15) & ((opargs[i+1])=1) & (opcodes[i+2]=4) & ((opargs[i+2])=a); 0b]
    // A bare `LoadL(s)` that is the whole function's last op, or sits right before an explicit
    // `Ret`, is the third legal appearance: the vector *is* the result. It neither qualifies a
    // slot nor disqualifies it — `{[x] x}` returns a plain int local exactly as it always did, and
    // only a slot already read or written as a vector becomes one, so this widens nothing except
    // the one case it exists for (see jitOpVecRet).
    isRetHead: $[(not isReadHead) & (not isWriteHead) & (op=3); $[(i+1)=n; 1b; (opcodes[i+1])=16]; 0b]
    if[isReadHead; readSlots: readSlots,a]
    if[isWriteHead; writeSlots: writeSlots,a]
    if[(not isReadHead) & (not isWriteHead) & (not isRetHead) & ((op=3)|(op=4)|(op=13)); intUseSlots: intUseSlots,a]
    i: i + $[isReadHead;2; isWriteHead;3; 1]]
  vecSlots: distinct readSlots,writeSlots
  bad: distinct intUseSlots
  cand: ()
  i: 0
  while[i<count vecSlots
    s: vecSlots[i]
    if[(not s in bad) & ((s<arity)|(not s<nlocals)); cand: cand,s]
    i: i+1]
  `int$cand}

// Which of the classified slots the body actually writes (`x[i]:v`), by the same triple
// jitClassifySlots recognises. src/jit.rs makes exactly those uniquely owned at entry, so an
// inlined store can write straight into the elements; a read-only slot is never copied.
jitVecWrites: {[opcodes;opargs;n;vecSlots]
  w: ()
  i: 0
  while[i<n
    a: opargs[i]
    isWriteHead: $[((opcodes[i])=13) & ((i+2)<n); ((opcodes[i+1])=15) & ((opargs[i+1])=1) & ((opcodes[i+2])=4) & ((opargs[i+2])=a); 0b]
    if[isWriteHead; if[a in vecSlots; w: w,a]]
    i: i+1]
  `int$distinct w}

// State carried through the walk, as a dict so each op-case function can take/return it whole:
// asm (word list), depth, fixups (list of (word;target;isCbz)), cbzRegs (dict word->reg),
// deoptFixups (list of (word;kind), kind null=flags-based B.EQ, else a register for CBZ),
// depthAt (dict ip->depth, overrides the naive linear accumulation — see Loop below), pendingCallSlot,
// and the register assignment the op handlers consult: lslots/lregs (see jitLocalSlots/jitLREGS),
// ncs/ncr (how many of those registers are callee-saved / caller-saved, for the epilogue and the
// around-a-blr spills respectively).
jitNewState: {[asm;lslots;lregs]
  ncs: (count lregs) & jitLCALLEE
  `asm`depth`fixups`cbzRegs`deoptFixups`depthAt`pending`lslots`lregs`ncs`ncr`retvec`nvecret`nintret`tail`primslots`vregs`vconst`cmpcond!(asm;0;();()!();();()!();null;lslots;lregs;ncs;(count lregs)-ncs;null;0;0;0b;();0#0;0#0;null)}

// ---- the virtual operand stack. A value's *physical* register used to be its depth: entry i
// lived in x9+i, and a `LoadL` of a local that already has a register of its own still emitted a
// `mov` into it. Now each entry carries where it actually is — `vregs[i]` is a register, or -1 for
// a constant not yet loaded into one (`vconst[i]`) — so a local feeds an add straight out of its
// own register and a small literal becomes an immediate. In a loop that is most of the skeleton:
// `while[j<nb; ...; j: j+1]` was two moves, a materialised 1, a compare, a set and two branches.
//
// The discipline that makes it safe is that an entry is *materialised* — moved into x9+i, the
// register it would always have been in before — whenever anything could invalidate it: before
// every branch and at every branch target, so the two halves of a merge agree on where a value
// is; and before a local's register is written, since an entry aliasing that register holds the
// old value. Materialising is a `mov` that the old scheme emitted unconditionally, so the worst
// case is what it used to cost.
// Appending to `st[`asm]` directly copies the whole buffer every time — the dict holds one
// reference and the local expression another, so the join cannot be in place and a compile is
// quadratic in the code it emits. Clearing the slot first leaves exactly one owner, which is what
// makes `x: x,y` an in-place extend (README "Performance"); every emitter here goes through this.
jitApp: {[st;ws] asm: st[`asm]; st[`asm]: 0#0; asm: asm,ws; st[`asm]: asm; st}
jitVR: {[st;d] (st[`vregs])[d]}
jitMat1: {[st;d]
  r: (st[`vregs])[d]
  if[r=jitSTACK+d; :st]
  st[`asm]: $[r<0; jitLoadConst[st[`asm]; jitSTACK+d; (st[`vconst])[d]]; (st[`asm]),jitMovR[jitSTACK+d;r]]
  st[`vregs;d]: jitSTACK+d
  st}
jitMatAll: {[st;upto] i: 0; while[i<upto; st: jitMat1[st;i]; i: i+1]; st}
jitVPush: {[st;r;c]
  st[`vregs]: (st[`vregs]),r
  st[`vconst]: (st[`vconst]),c
  st[`depth]: (st[`depth])+1
  st}
jitVDrop: {[st;k]
  d: (st[`depth])-k
  st[`vregs]: d#st[`vregs]
  st[`vconst]: d#st[`vconst]
  st[`depth]: d
  st}
// Every entry that is currently living in local register `r` holds that local's *old* value, so
// it has to be somewhere else before the local is assigned.
jitMatAlias: {[st;r]
  i: 0
  while[i<count st[`vregs]
    if[(st[`vregs])[i]=r; st: jitMat1[st;i]]
    i: i+1]
  st}

// `+ - *` on two ordinary ints can land on exactly the null sentinel, which the interpreter would
// propagate as a null and compiled code would not, so every one of them is checked and deopts.
// Both ways of making that branch cheaper were built and measured against this one; see README
// "What the null-sentinel checks cost, measured". Folding a whole block's checks into one branch
// through a `cinc` accumulator is *slower* — the accumulator is a loop-carried dependency where
// these branches are free, being never taken and perfectly predicted — and removing them outright,
// which is unsound and was measured only as a ceiling, is worth 17% of a multiply-accumulate loop
// and 8% of an RSA-2048 verification. So this stays the obvious thing.
// Does this function contain `+`, `-` or `*` at all? The null check after a BIT operation exists
// only because a result that lands on the sentinel would be read as a null by one of those three —
// the interpreter propagates it there and compiled code does not, so the two would disagree. A
// function that never uses them cannot reach that disagreement, and the check is then pure cost and
// a branch on a value. That is the whole of what makes a function compilable constant-time: no
// marking, no mode flag a caller has to remember, just the property itself.
jitHasArith: {[opcodes;opargs;consts]
  n: count opcodes
  i: 0
  while[i<n
    if[(opcodes[i])=6
      k: jitDyadKind string consts[opargs[i]]
      if[not isnull k; if[k<3; :1b]]]
    i+:1]
  0b}

jitNullCheck: {[st;dst]
  st: jitApp[st;jitCmpR[dst;jitNI]]
  st[`deoptFixups]: (st[`deoptFixups]),enlist ((count st[`asm]);null)
  st: jitApp[st;0]
  st}

// ---- per-op handlers. Each takes the state dict (plus whatever else it needs) and returns the
// updated state dict, or null to reject the whole function — checked by the caller after every
// call, since `:null` inside one of these returns from *that* function, not from jitCompile.

jitOpPush: {[st;ip;opcodes;consts;a]
  c: consts[a]
  $[isnull c
    ; $[not (opcodes[ip+1])=11; null   // Null is only ever immediately Pop'd (if/while/do's own statement value) — see README "Stage 2"
        ; jitVPush[st; jitSTACK+(st[`depth]); 0]]
    ; not (`int)=type c
    ; null
    ; c=0N
    ; null
    ; jitVPush[st; -1; c]]}            // no instruction yet: see jitMat1, and the immediate forms

jitOpLoadL: {[st;a]
  if[not a<4096; :null]
  r: jitLocalReg[st;a]
  if[isnull r
    ; st: jitApp[st;jitLdrImm[jitSTACK+(st[`depth]); jitLOC; a*8]]
      :jitVPush[st; jitSTACK+(st[`depth]); 0]]
  jitVPush[st; r; 0]}                  // the local's own register is where the value already is

// Doesn't pop — same as the interpreter's own `Op::StoreL`, which only peeks the top.
jitOpStoreL: {[st;a]
  if[(st[`depth])<1; :null]
  if[not a<4096; :null]
  st: jitMat1[st; (st[`depth])-1]
  r: jitLocalReg[st;a]
  if[not isnull r; st: jitMatAlias[st;r]]
  asm: st[`asm]
  st[`asm]: 0#0
  st[`asm]: jitRegToLocal[st; asm; a; jitVR[st;(st[`depth])-1]]
  st}

jitOpPop: {[st]
  if[(st[`depth])<1; :null]
  jitVDrop[st;1]}

jitOpRet: {[st]
  if[(st[`depth])<1; :null]
  st: jitMat1[st; (st[`depth])-1]
  asm: st[`asm]
  st[`asm]: 0#0
  st[`asm]: jitEmitReturn[asm; jitVR[st;(st[`depth])-1]; st[`ncs]]
  st[`nintret]: 1+st[`nintret]
  st}

// `fuse` is set when the very next op is a `Jmpf` and this is a comparison: the result is then
// only ever a branch condition, so the compare's own flags are the branch and there is no 0/1 to
// materialise — one `cmp` and one conditional branch where there used to be a cmp, a cset and a
// cbz. jitOpJmpf picks the condition up out of `cmpcond`.
//
// A constant operand that is still unmaterialised (`vregs` of -1) and small enough becomes an
// immediate: `i+1` is one `add`, not a `movz` and an `add`. Only where the encoding has the form —
// add/sub take a 12-bit unsigned immediate, the compares take it on the right-hand side.
jitOpDyad: {[st;consts;a;fuse]
  if[(st[`depth])<2; :null]
  p: consts[a]
  kind: jitDyadKind string p
  if[isnull kind; :null]
  d: st[`depth]
  xr: jitVR[st;d-1]; yr: jitVR[st;d-2]
  xc: (st[`vconst])[d-1]; yc: (st[`vconst])[d-2]
  // an immediate is available on the right of an add, a subtract or a compare, and on either
  // side of an add; `mul` and the min/max pair have no immediate form at all
  small: {[r;c] $[r<0; (c>-1) & c<4096; 0b]}
  yimm: $[(kind=2)|(kind=3)|(kind=4); 0b; small[yr;yc]]
  useX: $[yimm; 0b; (kind=0) & small[xr;xc]]            // add is commutative, the rest are not
  if[not useX; st: jitMat1[st;d-1]]
  if[not yimm; st: jitMat1[st;d-2]]
  x: jitVR[st;d-1]; y: jitVR[st;d-2]
  imm: $[useX; xc; yc]
  hasImm: yimm | useX
  dst: jitSTACK+(d-2)
  asm: st[`asm]
  st[`asm]: 0#0                        // sole owner: see jitApp
  // the three comparisons share one word, which is either followed by a cset or, fused, left for
  // the branch to read
  cmpw: $[yimm; jitCmpImm[x;imm]; jitCmpR[x;y]]
  $[kind=0
    ; asm: $[hasImm; asm,jitAddImm[dst;$[useX;y;x];imm]; asm,jitAddR[dst;x;y]]
    ; kind=1
    ; asm: $[yimm; asm,jitSubImm[dst;x;imm]; asm,jitSubR[dst;x;y]]
    ; kind=2
    ; asm: asm,jitMulR[dst;x;y]
    ; kind=3
    ; asm: (asm,jitCmpR[x;y]),jitCsel[dst;x;y;jitCondLT]
    ; kind=4
    ; asm: (asm,jitCmpR[x;y]),jitCsel[dst;x;y;jitCondGT]
    ; fuse
    ; asm: asm,cmpw
    ; kind=5
    ; asm: (asm,cmpw),jitCset[dst;jitCondLT]
    ; kind=6
    ; asm: (asm,cmpw),jitCset[dst;jitCondGT]
    ; asm: (asm,cmpw),jitCset[dst;jitCondEQ]]
  st[`asm]: asm
  st: jitVDrop[st;2]
  if[fuse & kind>4
    ; st[`cmpcond]: $[kind=5; jitCondGE; kind=6; jitCondLE; jitCondNE]   // Jmpf branches when false
      :st]
  st: jitVPush[st;dst;0]
  if[kind<3; st: jitNullCheck[st;dst]]
  st}

// Everything live goes back to x9+i and every pending null check is acted on before a branch, so
// that whichever way control arrives at the target it finds the same values in the same places
// and x4 clear. jitCompile does the same at every target for the path that falls into it.
jitOpJmp: {[st;t]
  st: jitMatAll[st; st[`depth]]
  st[`depthAt;t]: st[`depth]
  st[`fixups]: (st[`fixups]),enlist ((count st[`asm]);t;`b)
  st: jitApp[st;0]
  st}

jitOpJmpf: {[st;t]
  cond: st[`cmpcond]
  // fused with the comparison that produced the condition (jitOpDyad): the flags are already set
  // and everything else was materialised before the `cmp`, so nothing may touch them here
  if[not isnull cond
    ; st[`depthAt;t]: st[`depth]
      st[`cmpcond]: null
      st[`fixups]: (st[`fixups]),enlist ((count st[`asm]);t;cond)
      st: jitApp[st;0]
      :st]
  if[(st[`depth])<1; :null]
  st: jitMat1[st; (st[`depth])-1]
  r: jitVR[st;(st[`depth])-1]
  st: jitVDrop[st;1]
  st: jitMatAll[st; st[`depth]]
  st[`depthAt;t]: st[`depth]
  st[`cbzRegs;count st[`asm]]: r
  st[`fixups]: (st[`fixups]),enlist ((count st[`asm]);t;`cbz)
  st: jitApp[st;0]
  st}

// do[n;..]: n>0 -> decrement in place, fall through (depth unchanged); else pop and jump to the
// exit (depth-1 — the one thing the naive linear scan can't see, so it's recorded in depthAt).
jitOpLoop: {[st;t]
  if[(st[`depth])<1; :null]
  st: jitMatAll[st; st[`depth]]      // the counter is decremented in place, so it must not be
                                     // some local's register
  r: jitSTACK+((st[`depth])-1)
  asm: st[`asm]
  st[`asm]: 0#0                        // sole owner: see jitApp
  asm: asm,jitCmpImm[r;0]
  asm: asm,jitBcond[jitCondGT;2]
  st[`depthAt;t]: (st[`depth])-1
  st[`fixups]: (st[`fixups]),enlist ((count asm);t;`b)
  asm: asm,0
  asm: asm,jitSubImm[r;r;1]
  st[`asm]: asm
  st}

jitOpCall: {[st;consts;trampoline;slot;argc]
  if[(st[`depth])<argc; :null]
  st: jitMatAll[st; st[`depth]]      // the trampoline may clobber any caller-saved register
  live: (st[`depth])-argc
  asm: st[`asm]
  st[`asm]: 0#0
  asm: jitSaveLive[asm; live; st[`ncr]]
  asm: asm,jitMovR[3; jitSTACK+((st[`depth])-1)]
  if[argc=2; asm: asm,jitMovR[4; jitSTACK+((st[`depth])-2)]]
  asm: asm,jitMovR[0;jitVM]
  asm: jitLoadConst[asm;1;slot]
  asm: jitLoadConst[asm;2;argc]
  asm: asm,jitAddImm[5;jitSP;jitCALLOK]
  asm: jitLoadConst[asm;jitSCRATCH;trampoline]
  asm: asm,jitBlr[jitSCRATCH]
  asm: asm,jitLdrImm[jitSCRATCH;jitSP;jitCALLOK]
  st[`deoptFixups]: (st[`deoptFixups]),enlist ((count asm);jitSCRATCH)
  asm: asm,0
  asm: asm,jitMovR[jitSTACK+live; 0]
  st[`asm]: jitRestoreLive[asm; live; st[`ncr]]
  st: jitVDrop[st; (st[`depth])-live]
  st: jitVPush[st; jitSTACK+live; 0]
  st[`pending]: null
  st}

// ---- vector access, inlined. Nothing here calls anything: at entry the slot's word in `buf` is
// the element data pointer and the descriptor word beside it is the element count (jitVECBASE),
// so `x[i]` is a load of the count, one unsigned compare that catches a negative index and an
// out-of-range one together, and a scaled load. The elements cannot move underneath this: a
// read-only slot is an `Arc` this call holds a reference to, and a written one was made uniquely
// owned once at entry (`bind_vec`, src/jit.rs), which is the copy-on-write `jit_vec_set` used to
// do on the first write and the reason the pointer is stable for the rest of the call. The
// trampolines are still in src/jit.rs for the backend that has not been taught this yet; the
// `vecgetAddr`/`vecsetAddr` addresses jitCompile is handed are simply unused here.
//
// A read consumes the index and produces the value, so the depth is unchanged and the index
// register is also the destination.
jitOpVecGet: {[st;vecSlots;slot]
  if[(st[`depth])<1; :null]
  st: jitMat1[st; (st[`depth])-1]
  idx: jitSTACK+((st[`depth])-1)
  asm: st[`asm]
  st[`asm]: 0#0                        // sole owner: see jitApp
  asm: asm,jitLdrImm[jitSCRATCH; jitLOC; 8*(jitVECBASE+(vecSlots?slot))]
  asm: asm,jitCmpR[idx;jitSCRATCH]
  st[`deoptFixups]: (st[`deoptFixups]),enlist ((count asm);`hs)
  asm: asm,0
  // the slot's register *is* the data pointer, so it addresses the element directly; only an
  // overflow slot still in `buf` needs a load first
  r: jitLocalReg[st;slot]
  if[isnull r; asm: asm,jitLdrImm[jitSCRATCH;jitLOC;slot*8]]
  st[`asm]: asm,jitLdrReg[idx; $[isnull r; jitSCRATCH; r]; idx]
  st[`pending]: null
  st}

// x[i]:v — pop index (top) and value (next; push order was `gen value; gen index`, so index ends
// up on top). Net depth is -1, not -2: the interpreter's own `Op::StoreL` peeks rather than pops
// (`iassign`'s own value — normally the amended vector — is left on the stack, same as `assign`/
// `gassign` leave theirs, for a statement-level trailing `Pop` to discard). There's no real value
// to leave here — compiled code has nothing to represent a vector with — but the slot still needs
// to exist so that `Pop`'s depth bookkeeping lines up; nothing ever reads it (jitClassifySlots
// guarantees the write triple is always immediately followed by exactly that `StoreL`+
// something-that-pops-it).
jitOpVecSet: {[st;vecSlots;slot]
  if[(st[`depth])<2; :null]
  st: jitMat1[st; (st[`depth])-1]
  st: jitMat1[st; (st[`depth])-2]
  idx: jitSTACK+((st[`depth])-1)
  val: jitSTACK+((st[`depth])-2)
  asm: st[`asm]
  st[`asm]: 0#0                        // sole owner: see jitApp
  asm: asm,jitLdrImm[jitSCRATCH; jitLOC; 8*(jitVECBASE+(vecSlots?slot))]
  asm: asm,jitCmpR[idx;jitSCRATCH]
  st[`deoptFixups]: (st[`deoptFixups]),enlist ((count asm);`hs)
  asm: asm,0
  r: jitLocalReg[st;slot]
  if[isnull r; asm: asm,jitLdrImm[jitSCRATCH;jitLOC;slot*8]]
  st[`asm]: asm,jitStrReg[val; $[isnull r; jitSCRATCH; r]; idx]
  st: jitVDrop[st;1]
  st[`pending]: (`vecwritedone;slot)
  st}

// ---- the vector a compiled function leaves behind. Locals are never written back (see the
// locals-in-registers comment above), so until now everything a compiled body did to a vector was
// invisible to its caller and the only shape worth compiling was one that reduces to a scalar.
// A body whose last op is a bare `LoadL` of a classified slot returns that vector instead: the
// value in x0 is a placeholder and src/jit.rs hands back the `Value` the slot was bound to, which
// the inlined stores have been writing into all along. Every return has to agree — a function
// that returns an int down one path and the vector down another would have no single answer for
// src/jit.rs to believe — which is what the nvecret/nintret counters below are for.
jitEmitReturnVec: {[asm;ncs]
  asm: jitLoadConst[asm;0;0]
  asm: jitLoadConst[asm;5;1]
  asm: asm,jitStrImm[5;jitOK;0]
  jitEmitEpilogue[asm;ncs]}
jitOpVecRet: {[st;slot;atEnd]
  if[not isnull st[`retvec]; if[not slot=st[`retvec]; :null]]
  st[`retvec]: slot
  st[`nvecret]: 1+st[`nvecret]
  asm: st[`asm]
  st[`asm]: 0#0
  st[`asm]: jitEmitReturnVec[asm; st[`ncs]]
  st[`pending]: $[atEnd; null; (`vecretdone;slot)]
  st[`tail]: atEnd
  st}

// ---- the bit builtins, inlined. `x band y` is an ordinary two-argument call to a global holding
// a `Value::Prim`, so without this every limb mask and every shift inside a compiled loop is a
// `blr` through jit_call — and a limb-based bignum is nothing but masks and shifts. src/jit.rs
// resolves the six names to their global slots and hands them over (`bitSlots`), and records the
// primitive each slot held so entry can re-check it: these are globals and can be reassigned.
// Kind: 0=badd 1=band 2=bor 3=bxor 4=shl 5=shr, matching `BIT_PRIMS` there.
//
// The two shifts deopt unless the count is in [0;64), and only when the count is not already known
// to this walk: a literal shift — which is what a rotation or a limb mask is built out of — needs
// no guard, and a literal outside the range is simply not compiled.
// The rest of the original note: — AArch64 reads it mod 64 and `ib_shl`/
// `ib_shr` (src/prims.rs) truncate to u32 and answer 0, so outside that range the machine and the
// interpreter genuinely differ and the honest thing is to let the interpreter have it. All six
// work on the raw 64-bit pattern and so may *produce* the int-null sentinel where `+ - *` may not;
// that would leave a register holding a value compiled arithmetic would then treat as an ordinary
// int and the interpreter as a null, so the result is checked exactly as an arithmetic one is.
jitOpBit: {[st;kind;slot]
  if[(st[`depth])<2; :null]
  // the shift count before anything is materialised: a negative vreg means the walk is still
  // carrying it as a constant, and then the range the guard below tests is already known
  d0: st[`depth]
  kc: $[((st[`vregs])[d0-2])<0; (st[`vconst])[d0-2]; null]
  if[kind>3; if[not isnull kc; if[not (kc<64) & -1<kc; :null]]]   // a constant shift out of range: the interpreter's
  st: jitMat1[st; (st[`depth])-1]
  st: jitMat1[st; (st[`depth])-2]
  x: jitSTACK+((st[`depth])-1)
  y: jitSTACK+((st[`depth])-2)
  dst: y
  asm: st[`asm]
  st[`asm]: 0#0                        // sole owner: see jitApp
  df: st[`deoptFixups]
  // ... and when it is known to be in range, the guard is not emitted at all. That is worth a
  // branch and two words on every shift in a limb kernel, and it is what lets a function built out
  // of constant shifts and masks come out with no data-dependent branch in it (see jitCtWhy).
  if[kind>3; if[isnull kc
    ; asm: asm,jitCmpImm[y;64]
      df: df,enlist ((count asm);`hs)
      asm: asm,0]]
  $[kind=0
    ; asm: asm,jitAddR[dst;x;y]
    ; kind=1
    ; asm: asm,jitAndR[dst;x;y]
    ; kind=2
    ; asm: asm,jitOrrR[dst;x;y]
    ; kind=3
    ; asm: asm,jitEorR[dst;x;y]
    ; kind=4
    ; asm: asm,jitLslv[dst;x;y]
    ; asm: asm,jitLsrv[dst;x;y]]
  st[`asm]: asm
  st[`deoptFixups]: df
  st: jitVDrop[st;2]
  st: jitVPush[st;dst;0]
  if[st`arith; st: jitNullCheck[st;dst]]     // see jitHasArith
  st[`primslots]: distinct (st[`primslots]),slot
  st[`pending]: null
  st}

jitCompile: {[input;trampolines]
  opcodes: input[0]; opargs: input[1]; consts: input[2]; arity: input[3]; nlocals: input[4]
  n: count opcodes
  callAddr: trampolines[0]
  // The global slots of badd/band/bor/bxor/shl/shr, in that order, -1 for one that isn't bound to
  // its primitive right now. Absent entirely (a caller that predates them, e.g. tests/x86.nt's
  // stand-in addresses) means nothing is inlinable, which is only slower.
  bitSlots: $[3<count trampolines; `int$trampolines[3]; 6#-1]
  vecSlots: jitClassifySlots[opcodes;opargs;n;arity;nlocals]
  vecWrites: jitVecWrites[opcodes;opargs;n;vecSlots]
  lslots: jitLocalSlots[opcodes;opargs;n]
  // Register-resident or not, every slot is reached in `buf` through jitLdrImm/jitStrImm's 12-bit
  // scaled offset at least once (the prologue load below, or every access for an overflow slot).
  p: 0
  while[p<count lslots; if[not (lslots[p])<4096; :null]; p: p+1]
  lregs: ((count lslots) & count jitLREGS)#jitLREGS
  ncs: (count lregs) & jitLCALLEE

  asm: ()
  asm: asm,jitStpPre[29;30;jitSP;neg jitFRAME]
  asm: asm,jitStpOff[19;20;jitSP;16]
  asm: asm,jitStpOff[21;22;jitSP;32]
  asm: jitSaveCallee[asm;ncs]
  asm: asm,jitMovR[jitLOC;0]
  asm: asm,jitMovR[jitVM;2]
  asm: asm,jitMovR[jitOK;1]
  asm: jitLoadConst[asm;jitNI;0N]
  // buf -> the local registers, once (see the locals-in-registers comment above). Every one of
  // them, not just the params/captures: a scratch local's slot is the 0 `buf` was zeroed with,
  // exactly what an ldr through x19 would have read before its first StoreL.
  p: 0
  while[p<count lregs; asm: asm,jitLdrImm[lregs[p]; jitLOC; 8*lslots[p]]; p: p+1]

  st: jitNewState[asm;lslots;lregs]
  st[`arith]: jitHasArith[opcodes;opargs;consts]
  // every bytecode position something jumps to: the walk is linear, so this is where the path
  // falling into a target has to be brought back to the canonical layout (see jitMatAll) before
  // the target's own first instruction, which is what makes both paths agree
  targets: ()
  p: 0
  while[p<n; if[((opcodes[p])=9)|((opcodes[p])=10)|((opcodes[p])=18); targets: targets,opargs[p]]; p: p+1]
  targets: `int$distinct targets
  ipWord: (n+1)#0   // n+1: a jump target can be the position right after the last op (e.g. a `do` loop's exit)
  ip: 0
  while[ip<n
    if[ip in targets; st: jitMatAll[st; st[`depth]]]
    if[not isnull (st[`depthAt])[ip]
      ; st[`depth]: (st[`depthAt])[ip]
        st[`vregs]: jitSTACK+til st[`depth]
        st[`vconst]: (st[`depth])#0]
    ipWord[ip]: count st[`asm]
    if[(st[`depth])<0; :null]
    if[(st[`depth])>jitMAXDEPTH; :null]
    op: opcodes[ip]
    a: opargs[ip]
    pending: st[`pending]
    pendKind: $[isnull pending; null; pending[0]]
    isVecSlot: a in vecSlots
    isCallHead: (op=7) & ((a=1)|(a=2))
    isAmendHead: (op=15) & (a=1)
    // a bare LoadL of a vector slot at the tail, or right before an explicit Ret: the vector is
    // the result (jitOpVecRet). jitClassifySlots recognises exactly the same shape.
    isVecRetHead: $[(op=3) & isVecSlot; $[(ip+1)=n; 1b; (opcodes[ip+1])=16]; 0b]
    // `&`/`|` are eager (no short-circuit) in this language, so `pending[1]` can't sit inside one
    // alongside an `isnull pending` check — has to be a real branch (`$[...]`) instead, evaluating
    // it only once pending is already known to be a 2-element list.
    isStoreHead: $[isnull pending; 0b; (pendKind=`vecwritedone) & (op=4) & (a=(pending[1]))]
    // whatever set `pending` demands one exact op immediately next — see jitClassifySlots's header
    // comment for why every occurrence of a classified slot is guaranteed to fit this shape.
    okNext: $[isnull pending; 1b
             ; pendKind=`call; isCallHead
             ; pendKind=`vecread; isCallHead
             ; pendKind=`vecwrite; isAmendHead
             ; pendKind=`vecwritedone; isStoreHead
             ; pendKind=`vecretdone; op=16
             ; 0b]
    if[not okNext; :null]

    $[op=0; st: jitOpPush[st;ip;opcodes;consts;a]
    ; isVecRetHead; st: jitOpVecRet[st;a;(ip+1)=n]
    ; (op=3) & isVecSlot; st[`pending]: (`vecread;a)
    ; op=3; st: jitOpLoadL[st;a]
    ; isStoreHead; st[`pending]: null
    ; (pendKind=`vecretdone) & (op=16); st[`pending]: null
    ; op=4; st: jitOpStoreL[st;a]
    ; op=11; st: jitOpPop st
    ; op=16; st: jitOpRet st
    ; op=6; st: jitOpDyad[st;consts;a; $[(ip+1)<n; ((opcodes[ip+1])=10) & not (ip+1) in targets; 0b]]
    ; op=9; st: jitOpJmp[st;a]
    ; op=10; st: jitOpJmpf[st;a]
    ; op=18; st: jitOpLoop[st;a]
    ; (op=13) & isVecSlot; st[`pending]: (`vecwrite;a)
    ; op=1
    ; $[not (`int)=type consts[a]; st: null
        ; st[`pending]: (`call;consts[a])]
    ; (pendKind=`vecwrite) & isAmendHead; st: jitOpVecSet[st;vecSlots;pending[1]]
    ; (pendKind=`call) & isCallHead
    ; $[(a=2) & ((bitSlots?(pending[1]))<6)
        ; st: jitOpBit[st; bitSlots?(pending[1]); pending[1]]
        ; st: jitOpCall[st;consts;callAddr;pending[1];a]]
    ; (pendKind=`vecread) & isCallHead; st: jitOpVecGet[st;vecSlots;pending[1]]
    ; st: null]

    if[isnull st; :null]
    ip: ip+1]

  if[not isnull st[`pending]; :null]
  ipWord[n]: count st[`asm]

  lastOp: $[n>0; opcodes[n-1]; -1]
  if[(not lastOp=16) & not st[`tail]
    ; if[(st[`depth])<1; :null]
      st: jitMat1[st; (st[`depth])-1]
      st[`nintret]: 1+st[`nintret]
      asm: st[`asm]
      st[`asm]: 0#0
      st[`asm]: jitEmitReturn[asm; jitSTACK+((st[`depth])-1); ncs]]
  // every return has to be the same kind; see jitOpVecRet
  if[(0<st[`nvecret]) & 0<st[`nintret]; :null]

  deoptAt: count st[`asm]
  asm: st[`asm]
  st[`asm]: 0#0
  asm: jitEmitDeopt[asm; ncs]

  fixups: st[`fixups]
  cbzRegs: st[`cbzRegs]
  i: 0
  while[i<count fixups
    e: fixups[i]
    word: e[0]; target: e[1]; kind: e[2]
    delta: (ipWord[target])-word
    asm[word]: $[(`cbz)~kind; jitCbz[cbzRegs[word];delta]; (`b)~kind; jitB delta; jitBcond[kind;delta]]
    i: i+1]

  deoptFixups: st[`deoptFixups]
  i: 0
  while[i<count deoptFixups
    e: deoptFixups[i]
    word: e[0]; kind: e[1]
    delta: deoptAt-word
    asm[word]: $[isnull kind; jitBcond[jitCondEQ;delta]; (`hs)~kind; jitBcond[jitCondHS;delta]; jitCbz[kind;delta]]
    i: i+1]

  // (code; the classified slots; which of them are written; which one is returned, as an index
  // into that list, or -1; the global slots inlined as bit instructions). src/jit.rs reads the
  // five-element form as "this backend inlines vector access"; a two-element one still means the
  // old `*mut Value`-through-the-trampolines layout.
  (,/jitLE each asm; vecSlots; vecWrites; $[isnull st[`retvec]; -1; vecSlots?(st[`retvec])]; `int$st[`primslots])}


// ==== tracing JIT (src/trace.rs): compile one recorded loop iteration ====
//
// jitCompileTrace[input] -> (Bytes; Ints; Ints; Int; List) or null (not compilable).
//   result = (machine code; the locals this trace touches, in buffer order; their types, 0=int
//   1=float; the buffer position the operand-stack area starts at; the exits table). The slot list
//   and the stack area's position are *decided here* and read back by src/jit.rs rather than
//   recomputed there — the buffer's layout has to mean the same thing on both sides of the
//   boundary, and one side computing it and the other believing it is the only way to guarantee
//   that. The exits table is one `(resume ip; stack tags)` per exit, indexed by the number the
//   compiled code hands back through x1: the bytecode ip the interpreter resumes at, and what it
//   finds in the stack area of the buffer to push before it does, bottom first (tag codes below).
// input = (kinds:Ints; args:Ints; tys:Ints; ips:Ints; consts:List; header:Int; realUpto:Int;
//   entry:Ints) — Trace::to_neant_input (src/trace.rs) plus the loop header's own bytecode ip
//   (where a rewind resumes interpreting), the slot count of the loop's own frame (a slot at or
//   past it belongs to an inlined callee — see "Calls are inlined" in src/trace.rs — and is never
//   loaded from or stored to the buffer: it has no value before the loop and none anyone wants
//   after it), and the tags of the operand stack the recording started on (a `do` counter, or the
//   counters of enclosing `do` loops — see "The operand stack is part of the trace", src/trace.rs).
// kinds: 0=Push 1=PushNull 2=LoadL 3=StoreL 4=Dyad 5=Pop 6=Guard(taken) 7=Guard(not taken)
//   8=GuardRewind(taken) 9=GuardRewind(not taken) 10=FramePush(nargs) 11=FrameEnd
//   12=Loop(continued; arg = the loop's exit ip) 13=Loop(exited; arg = the Loop op's own ip).
// tys: 0=int 1=float 2=bool (per-step; for Dyad this is the *result* type, not necessarily the
//   operand type — comparisons narrow their operands to a bool result, so jitTrDyad below derives
//   the operand type from its own tracked stack, then double-checks the result against this).
//   The same codes tag the exits table, plus 3=null for a `PushNull` placeholder (`if`/`while`/
//   `do`'s statement value) that is live at an exit — it never had a register worth reading.
// ips: a Dyad's resume ip — the op after it, where the interpreter picks up if that op's result
//   wraps to the int-null sentinel (below).
//
// **Locals live in registers for the whole loop**, one each, and the buffer x0 (`jitTrBUF`) points
// at is only how they get in and out: n words, indexed by *position* in the touched-slot list, not
// by raw slot number, then the stack area — one word per live operand-stack value, bottom first.
// The body itself touches no memory at all. **Every exit hands the interpreter its live operand
// stack**: a guard, an `Op::Loop` edge or an int-null collision all name a bytecode ip that is a
// legal place to resume interpreting *given the right stack*, so each exit writes the locals back
// as they stand, then whatever the trace's virtual stack holds at that point (its tags are that
// exit's entry in the exits table), and the interpreter pushes those and carries on. The one exit
// that can't is a **rewind** — a branch, or an int-null collision, inside an inlined callee, whose
// resume ip is in the callee's bytecode where the interpreter no longer is. That one throws the
// half-finished iteration away and resumes the loop header from the values the iteration started
// with, so a trace that contains one stores its written locals and its entry stack to the buffer
// once at the top of every iteration; a trace with none does not, and its body has no memory ops
// in it whatsoever. Layout:
//
//   int-null sentinel -> x17, buf -> the local registers, stack area -> x9.. <- entry, once
//   [rewinds only] the written locals and the entry stack -> buf        <- loopStart, the back edge's target
//   the recorded body, guards branching out to their stubs
//   b loopStart
//   one stub per exit: its index -> x15, its live stack -> the stack area, b writeback
//   [rewinds only] the rewind stub: its index -> x15, b tail   (over the writeback: the buffer
//                                  already holds what this iteration started with)
//   writeback: the local registers -> buf
//   tail: *x1 = x15; ret
//
// There is no prologue/epilogue in the calling-convention sense and no callee-saved register:
// a compiled trace never calls anything (a call in the loop body arrives already inlined — its
// frame is FramePush, StoreL+Pop per argument, its body, FrameEnd, all on this same operand
// stack), so nothing here can clobber a caller-saved one and there is nothing to restore. x9..x14 (`jitSTACK`) are the int operand stack, d16..d21 (`jitFSTACK`) the
// float one, x2..x8/x16 (`jitTrLOCALS`) and d0..d7 (`jitTrFLOCALS`) the locals, x15 (`jitSCRATCH`)
// the exit index and constant-loading scratch, x17 the int-null sentinel. x16/x17 are the linker's
// IP0/IP1, free here precisely because this code never makes a call or crosses a PLT; x18 is left
// alone (it is the platform register on some ABIs).
//
// `tstack` (in the state dict below) is the trace's own virtual operand stack, but unlike the
// whole-function JIT's single `depth` counter, it's a list of `` `int``/`` `float``/`` `bool``/
// `` `null `` tags — the int and float stacks grow independently, so codegen needs to know, at
// each point, how many of *each* file are already live to find the next free physical register
// (`jitTrPos`) — the same problem a real per-value type this JIT never had to solve until a trace
// could hold either kind of value on the same notional stack. A bool lives in the int file as a
// 0/1 and is tagged apart only so an exit hands it back as the `Bool` the interpreter would have
// had (`TraceTy`, src/trace.rs); a null placeholder takes an int-file position it never writes.

jitTrNIREG: 17
jitTrCondLE: 13
// One register per local, handed out in first-seen order. Caps the trace at this many locals of
// each kind — a loop body with more just doesn't get traced, the same way one nested deeper than
// `jitMAXDEPTH` doesn't. (More would mean saving and restoring callee-saved registers on entry and
// on every exit, which is real work in the bail-often case, to buy a case that doesn't come up.)
jitTrLOCALS: 2 3 4 5 6 7 8 16
jitTrFLOCALS: 0 1 2 3 4 5 6 7
// Mirrors MAX_TOUCHED (src/jit.rs), which sizes the locals part of the buffer. Never the binding
// limit — the two register files above already cap it lower — but the buffer is Rust's, so Rust's
// number is the one that has to be respected. The stack area past it is bounded by `jitMAXDEPTH`
// per file, which src/jit.rs mirrors as MAX_STACK and checks against every exit's tags.
jitTrMAXTOUCHED: 16

jitTrTag: {[t] $[t=1;`float; t=2;`bool; t=3;`null; `int]}
jitTrTagCode: {[s] $[s=`float;1; s=`bool;2; s=`null;3; 0]}
jitTrTagCodes: {[tags] $[0=count tags; (); `int$ jitTrTagCode each tags]}
// Tag lists compare by element; `~` would tell an empty symbol list from `()`, which is not a
// difference this cares about.
jitTrSameTags: {[a;b] $[not (count a)=count b; 0b; 0=count a; 1b; (0+/a=b)=count a]}

// (slots; tys; stored) — every local the trace reads or writes, in first-seen order (the buffer
// layout), each one's observed type, and the *positions* (not slot numbers) of the ones it writes,
// which are the only ones worth writing back at an exit. Null if a slot was ever observed as two
// different types across the trace: a silent mismatch there would give one local two buffer
// positions, each written back independently with whichever ran last winning — a real correctness
// bug, not a safe "just don't compile" fallback like everything else here, so it's checked.
jitTraceTouched: {[kinds;args;tys;realUpto]
  slots: (); stys: (); stored: ()
  i: 0
  n: count kinds
  while[i<n
    k: kinds[i]
    if[(k=2)|(k=3)
      ; s: args[i]
        t: tys[i]
        pos: slots?s
        if[pos=count slots; slots: slots,s; stys: stys,t]
        if[not (stys[pos])=t; :null]
        // an inlined callee's local is written every time round (its arguments are bound by
        // StoreL) but is nobody's to keep: neither the top-of-iteration store nor the exit
        // writeback has any business with it
        if[(k=3) & (s<realUpto) & (not pos in stored); stored: stored,pos]]
    i: i+1]
  (slots;stys;stored)}

// The register each local gets, by position: the int and float files are handed out independently,
// in first-seen order. Null if either runs out (see jitTrLOCALS).
jitTrLocalRegs: {[stys]
  regs: ()
  ni: 0; nf: 0
  p: 0
  while[p<count stys
    isF: (stys[p])=1
    if[isF
      ; if[not nf<count jitTrFLOCALS; :null]
        regs: regs,jitTrFLOCALS[nf]
        nf: nf+1]
    if[not isF
      ; if[not ni<count jitTrLOCALS; :null]
        regs: regs,jitTrLOCALS[ni]
        ni: ni+1]
    p: p+1]
  regs}

// The local registers -> the buffer, for the positions in `which`. Emitted on the exit path,
// where it is what makes the locals visible to the interpreter again — and, only when the trace
// has a rewind in it, at the top of every iteration too, so the rewind stub can leave the buffer
// alone and have it already say what the iteration started with.
jitTrStoreLocals: {[asm;which;stys;lregs]
  i: 0
  while[i<count which
    p: which[i]
    $[(stys[p])=1
    ; asm: asm,jitFStrImm[lregs[p]; jitTrBUF; p*8]
    ; asm: asm,jitStrImm[lregs[p]; jitTrBUF; p*8]]
    i: i+1]
  asm}

// The buffer -> the local registers, once on entry. Every local of the loop's own frame, not just
// the written ones: a read-only local is exactly the kind this loads for good and never stores
// back. An inlined callee's local has nothing to load — its first write is inside the loop.
jitTrLoadLocals: {[asm;slots;stys;lregs;realUpto]
  p: 0
  while[p<count stys
    if[(slots[p])<realUpto
      ; $[(stys[p])=1
        ; asm: asm,jitFLdrImm[lregs[p]; jitTrBUF; p*8]
        ; asm: asm,jitLdrImm[lregs[p]; jitTrBUF; p*8]]]
    p: p+1]
  asm}

// how many entries of `ty`'s register file are already on `tstack` — also the next free physical
// register offset for a new push of that file, and (minus 1, minus 2) the top/second-from-top of
// that same file once at least two are live. Everything that isn't a float is in the int file (a
// bool is a 0/1 there; a null placeholder holds a position it never writes). The empty case is a
// real branch, not a fold over an empty vector: `()=`int` is a length error, not an empty mask.
jitTrPos: {[tstack;ty]
  $[0=count tstack; 0
  ; ty=`float; 0+/tstack=`float
  ; 0+/not tstack=`float]}

// The operand stack <-> the buffer's stack area, one word per live value, bottom first: value j
// goes to word `stackBase+j`, from the physical register its file and its position among that
// file's values below it put it in — the same numbering jitTrPos gives a push. A null placeholder
// is skipped: nothing was ever written to its register, and its tag alone tells the interpreter
// what to push (`TraceTy::Null`, src/trace.rs). Emitted per exit over that exit's own live stack,
// and once on entry (and at loopStart, when there is a rewind) over the entry stack.
jitTrStoreStack: {[asm;tags;stackBase]
  j: 0
  while[j<count tags
    t: tags[j]
    reg: jitTrPos[j#tags;t]
    $[t=`null; asm
    ; t=`float; asm: asm,jitFStrImm[jitFSTACK+reg; jitTrBUF; (stackBase+j)*8]
    ; asm: asm,jitStrImm[jitSTACK+reg; jitTrBUF; (stackBase+j)*8]]
    j: j+1]
  asm}
jitTrLoadStack: {[asm;tags;stackBase]
  j: 0
  while[j<count tags
    t: tags[j]
    reg: jitTrPos[j#tags;t]
    $[t=`null; asm
    ; t=`float; asm: asm,jitFLdrImm[jitFSTACK+reg; jitTrBUF; (stackBase+j)*8]
    ; asm: asm,jitLdrImm[jitSTACK+reg; jitTrBUF; (stackBase+j)*8]]
    j: j+1]
  asm}

// The branch a guard leaves the loop on — the condition under which the recorded direction is
// *not* the one being taken this time. 0=CBZ 1=CBNZ (a `Jmpf` whose condition flipped) 2=B.EQ
// (an int result equal to the null sentinel, after a CMP) 3=B.LE 4=B.GT (a `do` counter that is
// not / is positive, after a CMP against 0). Each is one word with an imm19 offset, patched in
// once the stubs have been placed (jitCompileTrace).
jitTrBranch: {[kind;reg;delta]
  $[kind=0; jitCbz[reg;delta]
  ; kind=1; jitCbnz[reg;delta]
  ; kind=2; jitBcond[jitCondEQ;delta]
  ; kind=3; jitBcond[jitTrCondLE;delta]
  ; jitBcond[jitCondGT;delta]]}

// A new exit: the ip to resume interpreting at and the stack the interpreter finds when it does.
// Its index is what the compiled code hands back, and what the branch fixup names.
jitTrExit: {[st;resumeIp;tags] st[`exits]: (st[`exits]),enlist (resumeIp; tags); st}
// ...and the guard word that leaves through it: a placeholder now, `jitTrBranch` once its stub's
// position is known.
jitTrGuardWord: {[st;exitIdx;branchKind;reg]
  st[`fixups]: (st[`fixups]),enlist ((count st[`asm]); exitIdx; branchKind; reg)
  st: jitApp[st;0]
  st}
// The same, leaving through the one rewind stub instead (see the section comment).
jitTrRewindWord: {[st;branchKind;reg]
  st[`rewFixups]: (st[`rewFixups]),enlist ((count st[`asm]); branchKind; reg)
  st: jitApp[st;0]
  st}

jitTrPush: {[st;consts;a;ty]
  tstack: st[`tstack]
  reg: jitTrPos[tstack;ty]
  if[not reg<jitMAXDEPTH; :null]
  c: consts[a]
  isFloat: ty=`float
  // The observed type has to be the constant's own — anything else means the recorder and this
  // walk disagree about the same step, which is never worth guessing through. A bool constant
  // (`if[1b;..]`) is left to the interpreter: nothing real pushes one in a loop.
  if[not $[isFloat; (`float)=type c; ty=`int; (`int)=type c; 0b]; :null]
  // 0N would be an int null, which the interpreter propagates through arithmetic and this backend
  // does not — same rejection jitOpPush makes for the same reason. (0n needs no such check: the
  // float null is a NaN, and NaN propagates identically in hardware.)
  if[(not isFloat) & (c=0N); :null]
  asm: st[`asm]
  st[`asm]: 0#0                        // sole owner: see jitApp
  $[isFloat
  ; asm: (jitLoadConst[asm;jitSCRATCH; fbits c]),jitFMovToF[jitFSTACK+reg;jitSCRATCH]
  ; asm: jitLoadConst[asm; jitSTACK+reg; c]]
  st[`asm]: asm
  st[`tstack]: tstack,ty
  st}

// `if`/`while`/`do`'s own statement-value convention (see jitOpPush's comment) — a true no-op,
// but still needs a placeholder tag so the `Pop` that always immediately follows has something to
// drop, and so the registers of anything pushed in between keep their numbering. Tagged `` `null``
// rather than `` `int`` so that if one is ever live at an exit (nothing the compiler emits does
// that, but it isn't this code's place to rely on it) the interpreter gets a `Null` back, not the
// contents of a register nothing ever wrote.
jitTrPushNull: {[st] st[`tstack]: (st[`tstack]),`null; st}

// A register move, not a load: the local is already in one (see this section's header comment).
jitTrLoadL: {[st;slots;lregs;a;ty]
  tstack: st[`tstack]
  reg: jitTrPos[tstack;ty]
  if[not reg<jitMAXDEPTH; :null]
  pos: slots?a
  if[pos=count slots; :null]
  asm: st[`asm]
  st[`asm]: 0#0                        // sole owner: see jitApp
  $[ty=`float
  ; asm: asm,jitFMovD[jitFSTACK+reg; lregs[pos]]
  ; asm: asm,jitMovR[jitSTACK+reg; lregs[pos]]]
  st[`asm]: asm
  st[`tstack]: tstack,ty
  st}

// Doesn't pop — same as the interpreter's own `Op::StoreL`, which only peeks the top (see
// jitOpStoreL's comment). The local's register is the only live copy of it from here until the
// next exit; the buffer is stale in between, deliberately.
jitTrStoreL: {[st;slots;lregs;a;ty]
  tstack: st[`tstack]
  n: count tstack
  if[n<1; :null]
  if[not (tstack[n-1])=ty; :null]
  reg: (jitTrPos[tstack;ty])-1
  pos: slots?a
  if[pos=count slots; :null]
  asm: st[`asm]
  st[`asm]: 0#0                        // sole owner: see jitApp
  $[ty=`float
  ; asm: asm,jitFMovD[lregs[pos]; jitFSTACK+reg]
  ; asm: asm,jitMovR[lregs[pos]; jitSTACK+reg]]
  st[`asm]: asm
  st}

jitTrPop: {[st]
  tstack: st[`tstack]
  n: count tstack
  if[n<1; :null]
  st[`tstack]: (n-1)#tstack
  st}

// x is the top of the stack and y the one below it, and every encoder below takes them in that
// order — `jitSubR[dst;x;y]` is `x-y`, `jitCmpR[x;y]`+`CSET LT` is `x<y` — because the top of the
// stack is a dyad's *left* argument (jitOpDyad relies on exactly the same thing).
jitTrDyadFCmp: {[asm;x;y;dst;kind]
  cond: $[kind=5;jitCondLT; kind=6;jitCondGT; jitCondEQ]
  (asm,jitFCmp[x;y]),jitCset[dst;cond]}
jitTrDyadICmp: {[asm;x;y;dst;kind]
  cond: $[kind=5;jitCondLT; kind=6;jitCondGT; jitCondEQ]
  (asm,jitCmpR[x;y]),jitCset[dst;cond]}
// jitFDyad op numbering (see its own comment): 0=FMUL 1=FDIV 2=FADD 3=FSUB 4=FMAX 5=FMIN
// 6=FMAXNM 7=FMINNM — `&`/`|` (kind 3/4) need the NM (NaN-propagates-only-if-both-NaN) forms.
jitTrDyadFArith: {[asm;x;y;dst;kind]
  fop: $[kind=0;2; kind=1;3; kind=2;0; kind=3;7; 6]
  asm,jitFDyad[dst;x;y;fop]}
jitTrDyadIArith: {[asm;x;y;dst;kind]
  $[kind=0; asm,jitAddR[dst;x;y]
  ; kind=1; asm,jitSubR[dst;x;y]
  ; kind=2; asm,jitMulR[dst;x;y]
  ; kind=3; (asm,jitCmpR[x;y]),jitCsel[dst;x;y;jitCondLT]
  ; (asm,jitCmpR[x;y]),jitCsel[dst;x;y;jitCondGT]]}

// Both operands must be in the same register file — no implicit int/float promotion this pass
// (deferred, same as the whole-function JIT's own float extension would need to decide the same
// question) — a mismatch just rejects the whole trace, same fail-closed default as everywhere
// else here. A bool operand is a 0/1 in the int file, and the interpreter computes with it as
// exactly that (`1b+2` is 3, `1b<2` is `1b`, `2&1b` is 1); only the result's *type* has rules of
// its own — a comparison's is always a bool, `&`/`|`'s is a bool exactly when both operands are
// (`1b&0b` is `0b`, `2&1b` is `1`), and `+ - *`'s is an int — which is what the tag below
// reproduces. The recorder saw the real result's type, and disagreeing with it here rejects the
// trace rather than guessing. `rip` is the ip of the op after this one — see the null check at
// the end.
jitTrDyad: {[st;consts;a;ty;rip]
  tstack: st[`tstack]
  n: count tstack
  if[n<2; :null]
  opTy: tstack[n-1]; opTy2: tstack[n-2]
  if[not (opTy in `int`bool`float) & (opTy2 in `int`bool`float); :null]
  isFloat: opTy=`float
  if[not isFloat=(opTy2=`float); :null]
  p: consts[a]
  kind: jitDyadKind string p
  if[isnull kind; :null]
  isCmp: kind>4
  bothBool: (opTy=`bool)&(opTy2=`bool)
  resultTy: $[isCmp; `bool; isFloat; `float; bothBool & ((kind=3)|(kind=4)); `bool; `int]
  if[not resultTy=ty; :null]
  base: $[isFloat; jitFSTACK; jitSTACK]
  x: base+((jitTrPos[tstack;opTy])-1)
  y: base+((jitTrPos[tstack;opTy])-2)
  newTstack: (n-2)#tstack
  dst: $[isCmp; jitSTACK+(jitTrPos[newTstack;`int]); y]
  asm: $[isCmp & isFloat; jitTrDyadFCmp[st[`asm];x;y;dst;kind]
       ; isCmp; jitTrDyadICmp[st[`asm];x;y;dst;kind]
       ; isFloat; jitTrDyadFArith[st[`asm];x;y;dst;kind]
       ; jitTrDyadIArith[st[`asm];x;y;dst;kind]]
  st[`asm]: asm
  st[`tstack]: newTstack,resultTy
  // Two ordinary ints wrapping to exactly the null sentinel by coincidence (`0W+1`): the
  // interpreter would start propagating a null from here on and this backend would keep doing
  // plain wrapping arithmetic, so the two diverge from this point. Exit instead — to the op after
  // this one, with the stack as it stands: the null result on top is exactly the `Int` the
  // interpreter would have produced (`int_dyad`, src/vm.rs, wraps the same way), and it takes
  // over the propagating from there. Inside an inlined callee that ip is in another frame's
  // bytecode, so the collision rewinds the iteration instead, like a callee's branch does. Only
  // `+ - *` can do it: `&`/`|` pick one of their operands, both already non-null, and a
  // comparison yields 0 or 1.
  if[(not isFloat) & (kind<3)
    ; st: jitApp[st;jitCmpR[dst;jitTrNIREG]]
      inFrame: 0<count st[`frames]
      if[inFrame; st: jitTrRewindWord[st;2;0]]
      if[not inFrame
        ; st: jitTrExit[st;rip;st[`tstack]]
          st: jitTrGuardWord[st; (count st[`exits])-1; 2; 0]]]
  st}

// The recorded direction of a branch this trace took: `taken` (this `Jmpf` jumped, i.e. the
// condition was false) needs the condition to *still* be false on replay (bail via `CBNZ` if not);
// `not taken` needs it to still be true (bail via `CBZ` if not). Each guard gets its own stub
// (load the exit index, store the live stack, branch to the one shared writeback) rather than
// inlining any of that — keeps every `CBZ`/`CBNZ`'s branch distance small instead of depending on
// how much each exit has to store.
//
// Whatever is under the condition is handed to the interpreter along with the bail ip, so a
// guard is a legal exit anywhere: a `while` header's or a statement-level `if`'s `Jmpf` with an
// enclosing `do` loop's counter under it, or one inside an expression with that expression's
// operands under it. The condition itself has to be an int or a bool — `Jmpf` accepts anything
// truthy, but a float or a null there is not a shape this pass compiles.
jitTrGuard: {[st;taken;bailIp]
  tstack: st[`tstack]
  n: count tstack
  if[n<1; :null]
  if[not (tstack[n-1]) in `int`bool; :null]
  reg: jitSTACK+((jitTrPos[tstack;`int])-1)
  rest: (n-1)#tstack
  st: jitTrExit[st;bailIp;rest]
  st: jitTrGuardWord[st; (count st[`exits])-1; $[taken;1;0]; reg]
  st[`tstack]: rest
  st}

// A guard inside an inlined callee. Same test, different exit: the `ip` it would resume at is in
// the callee's bytecode, and the interpreter is not in that frame — so it goes to the rewind
// stub, back to the loop header with the iteration thrown away (the stub jitTrDyad's in-callee
// null check also branches to; see jitCompileTrace). Nothing on the trace's stack survives a
// rewind, so nothing has to be accounted for.
jitTrGuardRewind: {[st;taken]
  tstack: st[`tstack]
  n: count tstack
  if[n<1; :null]
  if[not (tstack[n-1]) in `int`bool; :null]
  reg: jitSTACK+((jitTrPos[tstack;`int])-1)
  st: jitTrRewindWord[st; $[taken;1;0]; reg]
  st[`tstack]: (n-1)#tstack
  st}

// `do[n;..]`'s `Op::Loop` (only ever in the loop's own frame — the recorder rejects one in a
// callee), as the edge this pass took. The counter is the top of the stack and must be a plain
// int (the interpreter also takes a bool or a whole float there, via `int_of`; the recorder
// checks). Continued: the counter was positive — bail to the loop's exit `t` with the counter
// popped if it is `<= 0` now (that *is* the interpreter's other edge, stack and all), else
// decrement it in place. Exited (a `do` nested inside the traced loop, unrolled — the traced
// loop's own header exiting ends the recording): the counter was `<= 0` — bail to the `Loop` op
// itself, counter still on the stack, if it is positive now, and let the interpreter take it
// from there; else pop it.
jitTrLoop: {[st;exited;bailIp]
  tstack: st[`tstack]
  n: count tstack
  if[n<1; :null]
  if[not (tstack[n-1])=`int; :null]
  reg: jitSTACK+((jitTrPos[tstack;`int])-1)
  rest: (n-1)#tstack
  st: jitApp[st;jitCmpImm[reg;0]]
  st: jitTrExit[st;bailIp;$[exited;tstack;rest]]
  st: jitTrGuardWord[st; (count st[`exits])-1; $[exited;4;3]; reg]
  if[exited; st[`tstack]: rest]
  if[not exited; st: jitApp[st;jitSubImm[reg;reg;1]]]
  st}

// An inlined callee's frame opens with its `nargs` arguments as the top of the stack (the callee
// itself was never a value here — see `TraceOp::FramePush`, src/trace.rs) and the recorder's
// StoreL+Pop pairs about to bind them. Remember where the stack stands underneath them: that is
// where the frame's one result has to end up (jitTrFrameEnd).
jitTrFramePush: {[st;nargs]
  n: count st[`tstack]
  if[n<nargs; :null]
  st[`frames]: (st[`frames]),(n-nargs)
  st}

// The callee's one result is the top of the stack; everything else it left behind (an early
// `:x` discards the rest of its frame's stack, and the interpreter does the same) goes. If that
// leaves the result in a different register than the one its new position calls for, move it.
jitTrFrameEnd: {[st]
  frames: st[`frames]
  nf: count frames
  if[nf<1; :null]
  base: frames[nf-1]
  tstack: st[`tstack]
  n: count tstack
  if[n<(base+1); :null]
  ty: tstack[n-1]
  kept: base#tstack
  file: $[ty=`float; jitFSTACK; jitSTACK]
  src: file+((jitTrPos[tstack;ty])-1)
  dst: file+jitTrPos[kept;ty]
  asm: st[`asm]
  st[`asm]: 0#0                        // sole owner: see jitApp
  if[(not src=dst) & (not ty=`null)
    ; $[ty=`float; asm: asm,jitFMovD[dst;src]; asm: asm,jitMovR[dst;src]]]
  st[`asm]: asm
  st[`tstack]: kept,ty
  st[`frames]: (nf-1)#frames
  st}

jitCompileTrace: {[input]
  kinds: input[0]; args: input[1]; tys: input[2]; ips: input[3]; consts: input[4]
  header: input[5]; realUpto: input[6]
  entry: $[0=count input[7]; (); jitTrTag each input[7]]
  n: count kinds
  touched: jitTraceTouched[kinds;args;tys;realUpto]
  if[isnull touched; :null]
  slots: touched[0]; stys: touched[1]; stored: touched[2]
  nslots: count slots
  if[not nslots<jitTrMAXTOUCHED; :null]
  lregs: jitTrLocalRegs stys
  if[isnull lregs; :null]   // out of local registers
  // The stack area starts right after the locals; src/jit.rs reads this back rather than assuming it.
  stackBase: nslots

  // The body is assembled on its own first: whether the top of the iteration has to store
  // anything (only if the body turns out to contain a rewind) is known only once it has been
  // walked, and everything it branches to is placed after it anyway.
  st: `asm`tstack`fixups`exits`rewFixups`frames!((); entry; (); (); (); ())
  i: 0
  while[i<n
    kind: kinds[i]; a: args[i]
    ty: jitTrTag tys[i]
    $[kind=0; st: jitTrPush[st;consts;a;ty]
    ; kind=1; st: jitTrPushNull st
    ; kind=2; st: jitTrLoadL[st;slots;lregs;a;ty]
    ; kind=3; st: jitTrStoreL[st;slots;lregs;a;ty]
    ; kind=4; st: jitTrDyad[st;consts;a;ty;ips[i]]
    ; kind=5; st: jitTrPop st
    ; kind=6; st: jitTrGuard[st;1b;a]
    ; kind=7; st: jitTrGuard[st;0b;a]
    ; kind=8; st: jitTrGuardRewind[st;1b]
    ; kind=9; st: jitTrGuardRewind[st;0b]
    ; kind=10; st: jitTrFramePush[st;a]
    ; kind=11; st: jitTrFrameEnd st
    ; kind=12; st: jitTrLoop[st;0b;a]
    ; kind=13; st: jitTrLoop[st;1b;a]
    ; st: null]
    if[isnull st; :null]
    i: i+1]

  // The recording started, and now ends, at the back edge — so the trace's stack has to be the
  // one it entered on (the entry stack, value for value: a `do` counter decremented in place is
  // still the same position and type), for the loop-carried registers to line up.
  if[not jitTrSameTags[st[`tstack];entry]; :null]
  if[not 0=count st[`frames]; :null]   // every inlined frame closed (the recorder guarantees it; checked anyway)
  exits: st[`exits]
  hasRewind: 0<count st[`rewFixups]
  // The rewind exit is the last entry in the table: the header, entered with the entry stack.
  if[hasRewind; exits: exits,enlist (header; entry)]
  numExits: count exits
  // No exit means no way out: the emitted back edge would spin forever. Can't happen for a real
  // loop (a `while`'s condition guard or a `do`'s counter test is always in the trace), but it
  // isn't the generated code's place to rely on that.
  if[numExits<1; :null]

  // x17 = the int-null sentinel, compared against after every int add/sub/mul exactly as the
  // whole-function JIT's x20 is (jitOpDyad). Loaded once, above the loop, with the locals and
  // the entry stack.
  asm: jitLoadConst[();jitTrNIREG;0N]
  asm: jitTrLoadLocals[asm;slots;stys;lregs;realUpto]
  asm: jitTrLoadStack[asm;entry;stackBase]
  loopStart: count asm
  // Only a rewind needs the iteration's starting point kept anywhere; without one the loop body
  // has no memory operation in it at all (see the section comment).
  if[hasRewind
    ; asm: jitTrStoreLocals[asm;stored;stys;lregs]
      asm: jitTrStoreStack[asm;entry;stackBase]]
  bodyAt: count asm
  asm: asm,st[`asm]
  asm: asm,jitB[loopStart-(count asm)]

  // Place the stubs before emitting them: each is its index load, one store per live stack value
  // (none for the rewind stub, which skips the writeback too) and a branch, so their positions
  // — and the writeback's and the tail's — follow from the exits table alone.
  starts: ()
  pos: count asm
  ei: 0
  while[ei<numExits
    starts: starts,pos
    isRew: hasRewind & (ei=(numExits-1))
    pos: pos+$[isRew; 2; 2+count (exits[ei])[1]]
    ei: ei+1]
  writebackAt: pos
  tailAt: writebackAt+(count stored)   // one store per written local, so: one word each

  ei: 0
  while[ei<numExits
    e: exits[ei]
    isRew: hasRewind & (ei=(numExits-1))
    asm: asm,jitMovz[jitSCRATCH; ei; 0]
    if[not isRew
      ; asm: jitTrStoreStack[asm;e[1];stackBase]
        asm: asm,jitB[writebackAt-(count asm)]]
    // The rewind stub: straight to the tail, over the writeback — the buffer already holds this
    // iteration's starting values (stored at loopStart) and the registers hold a half-finished
    // iteration, which is exactly the state this exit exists to discard.
    if[isRew; asm: asm,jitB[tailAt-(count asm)]]
    ei: ei+1]
  if[not writebackAt=count asm; :null]   // the placement above and what was emitted disagree: never trust the branches then

  asm: jitTrStoreLocals[asm;stored;stys;lregs]
  asm: asm,jitStrImm[jitSCRATCH; jitTrOUT; 0]   // *out = the index of whichever exit got here
  asm: asm,jitRet[]

  fixups: st[`fixups]
  fi: 0
  while[fi<count fixups
    e: fixups[fi]
    word: bodyAt+e[0]; exitIdx: e[1]; bk: e[2]; reg: e[3]
    asm[word]: jitTrBranch[bk;reg;(starts[exitIdx])-word]
    fi: fi+1]
  rfix: st[`rewFixups]
  rewAt: starts[numExits-1]
  fi: 0
  while[fi<count rfix
    e: rfix[fi]
    word: bodyAt+e[0]; bk: e[1]; reg: e[2]
    asm[word]: jitTrBranch[bk;reg;rewAt-word]
    fi: fi+1]

  (,/jitLE each asm; `int$slots; `int$stys; stackBase; {(x[0]; jitTrTagCodes x[1])} each exits)}

// ============================================================================================
// Constant-time checking. `jitCtWhy[input;trampolines]` answers "" when this function compiles to
// machine code whose timing and memory accesses cannot depend on its arguments, and otherwise the
// reason it does not. It is a CHECK, not a second code generator: the guarantee is read off the
// bytes that were actually emitted, so it cannot be argued around.
//
// WHY A CHECK RATHER THAN A `csel` PASS. Branch-free *selection* needs no new codegen at all — a
// mask built out of `neg`, `band` and `bxor` is already in the compilable subset, and is how
// constant-time C is written anyway. What was missing was not the ability to emit such code but any
// way to know that you had. So this proves it instead:
//
//   1. the bytecode may not contain `Jmpf` (opcode 10). Every `if`, `$[..]` and `while` compiles to
//      one, and each is a branch on a value this function was handed. `do[n;..]` is `Loop`
//      (opcode 18) and is allowed only when `n` is a literal — then the branch is on a counter that
//      runs 0..n-1 for every input alike, which is what makes it timing-invariant.
//   2. the emitted machine code may contain no conditional branch beyond the one back-edge each
//      such `Loop` needs: no B.cond, CBZ/CBNZ or TBZ/TBNZ. This is decoded from the words, so a
//      deopt (they are all conditional branches), a bounds check that can fail, and anything a
//      future change to this file starts emitting are all caught without being enumerated.
//   3. it must compile at all. A function that falls back to the interpreter has no guarantee of
//      any kind, and silently getting the slow path is exactly how this sort of thing goes wrong.
//
// WHAT IT SAYS TODAY. Nothing in this build is constant-time yet, and the checker is what makes
// that precise rather than a suspicion: even `{[a;b] a bxor b}` compiles to
//
//     eor x9, x10, x9
//     cmp x9, x20            // x20 holds the int-null sentinel
//     b.eq <deopt>
//
// The `bxor` itself is one instruction, and then its RESULT is compared against the sentinel. That
// check is not superfluous: a value that happens to equal the sentinel would be read as a null by
// a later `+`, `-` or `*`, which the interpreter propagates and compiled code does not, so the two
// would disagree. It is also a branch on a value, which is exactly what must not be there.
//
// The way out is a pair, not a single change: a function that uses only `badd` and the bit
// primitives — wrapping arithmetic, which is how constant-time code is written anyway — can never
// hand a sentinel to an operation that would misread it, and then the checks after the bit ops can
// go. That has to be a real COMPILE MODE rather than something this checker assumes, because the
// whole point is to inspect the code that will actually execute. Until that mode exists this
// answers "no" for everything, correctly.
//
// WHAT IS STILL NOT GUARANTEED, and this is the honest part. Within the compiled code there are no
// `Value` operations, no allocation and no refcounting, so those cannot leak; the entry guard's
// copy of a vector argument is a fixed size. But AArch64's `MUL` is constant-time on the cores this
// targets and not architecturally required to be; a secret-dependent *index* into a vector is
// rejected only because such an index would need arithmetic this walk refuses, not because the
// check looks for it; and nothing here says anything about what the caller does before or after.
// This proves one specific and useful property — no data-dependent control flow in the emitted
// code — and claims nothing beyond it.

// The whole function is scanned, prologue included, and that is not an oversight: the prologue
// saves registers, loads locals and materialises the null sentinel, and emits no conditional branch
// at all — the entry guards (every argument a plain non-null int, every inlined primitive still
// bound to the global it was compiled against) are checked in Rust before the code is entered, not
// by branches inside it. An earlier version of this skipped the prologue by remembering its length
// in a global, which was WRONG in a way worth recording: `jitCompile` is reentrant — compiling one
// function can cross another's tier-up threshold and compile that one too — so the global could be
// overwritten between being set and being read, and the check would then skip into the middle of
// the body and report code as constant-time that was not.

// the top byte of every AArch64 conditional branch: B.cond, CBZ/CBNZ, TBZ/TBNZ, both widths
JITCTBR: 84 52 180 53 181 54 182 55 183
// the word offsets of every conditional branch in `bytes`
jitCtCondAt: {[bytes]
  n: (count bytes) div 4
  w: `int$bytes[3+4*til n]                 // little-endian: byte 3 of each word is bits 31..24
  &w in JITCTBR}
jitCtCondBranches: {[bytes] count jitCtCondAt bytes}

// -> "" when the bytecode may be compiled constant-time, else why not
jitCtBytecodeWhy: {[opcodes;opargs;consts]
  n: count opcodes
  i: 0; loops: 0
  while[i<n
    op: opcodes[i]
    if[op=10; :"jitct: a conditional branch on a value — if, $[..] or while at op ",string i]
    if[op=18
      // the trip count is whatever was pushed just before the loop head; a literal is a Push of a
      // constant, and anything else (a local, a computed value) is a count this cannot see
      if[i<1; :"jitct: a do loop with no trip count at op ",string i]
      if[not (opcodes[i-1])=0; :"jitct: a do loop whose trip count is not a literal, at op ",string i]
      loops+:1]
    i+:1]
  ""}

jitCtWhy: {[input;trampolines]
  w: jitCtBytecodeWhy[input[0]; input[1]; input[2]]
  if[0<count w; :w]
  r: jitCompile[input;trampolines]
  if[isnull r; :"jitct: this function does not compile at all, so it has no guarantee"]
  nl: jitCtLoops input[0]
  at: jitCtCondAt r[0]
  nb: count at
  if[nb>nl
    m: "jitct: the code has ",(string nb)," conditional branches for ",(string nl)," counted loops"
    m,: " (at words ",(", " sv string each at),")"
    :m," — a deopt, a bounds check, or a vector index whose bound has to be tested"]
  ""}
jitCtLoops: {[opcodes] sum opcodes=18}
