// encodings, in neant: base64, percent (URL) encoding, query strings.  Byte-level, on the 0x vectors `byte$ gives.
//   b64 0x68656c6c6f -> "aGVsbG8="       unb64 "aGVsbG8=" -> 0x68656c6c6f
//   urlenc "a b/é"  -> "a%20b%2F%C3%A9"   urldec "a%20b" -> "a b"       (urldec also reads + as space, like a form)
//   qparse "a=1&b=x+y" -> `a`b!("1";"x y")   qbuild `a`b!("1";"x y") -> "a=1&b=x%20y"
b64chars: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
b64: {[b] v: `int$b; n: #v; if[0=n; :""]; p: (-n) mod 3; v: v,p#0; i: 3*til (#v) div 3
  a: v[i]; c: v[i+1]; d: v[i+2]
  s: raze flip (b64chars[a shr 2]; b64chars[((a band 3) shl 4)+c shr 4]; b64chars[((c band 15) shl 2)+d shr 6]; b64chars[d band 63])
  $[p; (((#s)-p)#s),p#"="; s]}
unb64: {[s] s: s except "=\r\n "; if[0=#s; :0x]; d: b64chars?s; if[|/d=#b64chars; signal "b64: bad char"]; n: #d
  d: d,((-n) mod 4)#0; i: 4*til (#d) div 4
  a: d[i]; b: d[i+1]; c: d[i+2]; e: d[i+3]
  v: raze flip ((a shl 2)+b shr 4; ((b band 15) shl 4)+c shr 2; ((c band 3) shl 6)+e)
  `byte$((6*n) div 8)#v}
// base64url (RFC 4648 §5): - _ instead of + /, no padding — what JWTs use
b64url: {[b] s: b64 b; s: ssr[s;"+";"-"]; s: ssr[s;"/";"_"]; s except "="}
unb64url: {[s] s: ssr[s;"-";"+"]; unb64 ssr[s;"_";"/"]}

// percent encoding, RFC 3986: unreserved chars pass, everything else is %XX per UTF-8 byte
urlkeep: `code$"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~"
hexu: "0123456789ABCDEF"
hexchars: "0123456789abcdefABCDEF"
urlenc1: {$[x in urlkeep; ,`char$x; "%",hexu[(x div 16; x mod 16)]]}
urlenc: {[s] $[0=#s; ""; raze urlenc1 each `int$`byte$s]}
urldec: {[s] out: 0x; i: 0; n: #s
  while[i<n
    c: s[i]; pct: $[c="%"; $[(i+2)<n+1; &/s[i+1+til 2] in hexchars; 0b]; 0b]
    out,: $[pct; unhex s[i+1+til 2]; c="+"; 0x20; `byte$,c]
    i+: $[pct; 3; 1]]
  `char$out}
// query string <-> dict of strings keyed by symbol.  a=1&b=x+y  <->  `a`b!("1";"x y")
qparse: {[s] if[0=#s; :()!()]; ps: "&" vs s; ps: ps[&0<count each ps]
  kv: {[p] i: p?"="; $[i<#p; (i#p; (i+1)_p); (p; "")]} each ps
  (`$urldec each {x 0} each kv)!urldec each {x 1} each kv}
qbuild: {[d] "&" sv {[k;v] (urlenc string k),"=",urlenc $[`char=@v; ,v; 10=@v; v; string v]}'[key d; value d]}
