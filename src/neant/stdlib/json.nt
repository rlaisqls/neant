// JSON, in neant.  jk "text" -> value, jj value -> text.
// objects <-> dicts, arrays <-> lists (typed vectors when homogeneous), strings <-> chars, true/false <-> 1b/0b, null <-> ::
// Parser state is two globals like src/neant/core/parse.nt: js (the text) and jp (position), updated with ::.
jpeek: {[] $[jp<#js; js[jp]; "\0"]}
jws: {[] while[$[jp<#js; js[jp] in ws; 0]; jp::jp+1]}
jfail: {[m] signal "json: ",m," at ",string jp}
jexp: {[c] jws[]; if[not jpeek[]=c; jfail "expected ",c]; jp::jp+1}
jlit: {[w;v] ok: $[(jp+count w)>count js; 0; w~js[jp+til count w]]; if[not ok; jfail "bad literal"]; jp::jp+count w; v}
jnull: {[] jlit["null";0]; null}   // null as a call argument would make a projection
jhex: {[] h: js[jp+til 4]; jp::jp+4; `char$ +/(16^3 2 1 0)*"0123456789abcdef"?lower h}
jnum: {[]
  st: jp; while[$[jp<#js; js[jp] in "+-0123456789.eE"; 0]; jp::jp+1]
  s: js[st+til jp-st]; if[0=#s; jfail $[jp<#js; "unexpected ",jpeek[]; "unexpected end"]]
  $[|/s in ".eE"; `float$s; `int$s]}
jstr: {[]
  jp::jp+1; out: ""
  while[1
    if[not jp<#js; jfail "unterminated string"]
    c: js[jp]; jp::jp+1
    if[c="\""; :out]
    if[c="\\"; e: js[jp]; jp::jp+1
      c: $[e="n"; "\n"; e="t"; "\t"; e="r"; "\r"; e="b"; `char$8; e="f"; `char$12; e="u"; jhex[]; e]]
    out,: c]}
jarr: {[]
  jp::jp+1; out: (); jws[]; if[jpeek[]="]"; jp::jp+1; :out]
  while[1
    out,: enlist jval[]; jws[]; c: jpeek[]; jp::jp+1
    if[c="]"; :out]
    if[not c=","; jfail "expected , or ]"]]}
jobj: {[]
  jp::jp+1; ks: (); vl: (); jws[]; if[jpeek[]="}"; jp::jp+1; :()!()]
  while[1
    jws[]; if[not jpeek[]="\""; jfail "expected key"]
    ks,: `$jstr[]; jexp[":"]; vl,: enlist jval[]
    jws[]; c: jpeek[]; jp::jp+1
    if[c="}"; :ks!vl]
    if[not c=","; jfail "expected , or }"]]}
jval: {[]
  jws[]; c: jpeek[]
  $[c="{"; jobj[]; c="["; jarr[]; c="\""; jstr[]; c="t"; jlit["true";1b]; c="f"; jlit["false";0b]; c="n"; jnull[]; jnum[]]}
jk: {[s] js::s; jp::0; v: jval[]; jws[]; if[jp<#js; jfail "trailing input"]; v}

// ---- serialize
jesc: {[s] s: $[`char=@s; ,s; s]; s: ssr[s;"\\";"\\\\"]; s: ssr[s;"\"";"\\\""]; s: ssr[s;"\n";"\\n"]; s: ssr[s;"\t";"\\t"]; s: ssr[s;"\r";"\\r"]; "\"",s,"\""}
jnumf: {$[isnull x; "null"; x=_x; string floor x; string x]}
jj: {[x] t: @x
  $[t=`null; "null"; t=`bool; $[x;"true";"false"]; t in `int`float; jnumf x; t in `char`chars; jesc x; t in `sym`date`time; jesc string x
    t=`dict; "{",(jitems[key x;value x]),"}"
    t=`fn; signal "json: cannot serialize a function"
    "[",(jitems[();x]),"]"]}
// items are indexed, not each-ed: a :: element passed to a function would make a projection instead of a call
jitems: {[ks;xs] ", " sv {[ks;xs;i] ($[count ks; (jesc string ks[i]),": "; ""]), $[`null=@xs[i]; "null"; jj xs[i]]}[ks;xs] each til count xs}
