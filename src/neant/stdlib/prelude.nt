// neant standard library, in neant. First unit in the boot image, loaded before the compiler.
// A name bound to a verb gets both valences, like q's first = *:  — count[1;2] is 1 2 take.
null: $[0;0]
count: #
first: *
til: !
reverse: |
where: &
distinct: ?
floor: _
not: ~
string: $
type: @
sqrt: ^
sum: +/
prd: */
min: &/
max: |/
avg: {(+/x)%#x}
abs: {x|-x}
last: {x[(#x)-1]}
sort: {x[<x]}
raze: {,/x}
sym: {`$x}
xexp: {x^y}
mod: {x-y*_x%y}
div: {_x%y}
in: {(#y)>y?x}
within: {(not x<y[0]) & not x>y[1]}

// strings
lowerc: "abcdefghijklmnopqrstuvwxyz"
upperc: "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
upper: {`char$(`code$x)-32*x in lowerc}
lower: {`char$(`code$x)+32*x in upperc}
trim: {i: &not x in " \t\r\n"; $[#i; x[(first i)+til 1+(last i)-first i]; ""]}
// positions where p occurs in s
ss: {[s;p] p: $[`char=@p; ,p; p]; n: #p; if[n>#s; :()]; c: & {[s;p;i] s[i+til count p]~p}[s;p] each til 1+(#s)-n
  $[1<#c; {[n;a;i] $[i<n+last a; a; a,i]}[n]/[,first c; 1_c]; c]}
// split s on sep -> list of strings;  join strings with sep.  With an int left argument vs/sv are the
// numeric base forms instead (vsnum/svnum below):  "," vs "a,b" -> ("a";"b")   2 vs 13 -> 1 1 0 1
vss: {[sep;s] p: s ss sep; st: 0, p+#sep; en: p, #s; {[s;a;b] s[a+til b-a]}[s]'[st;en]}
svs: {[sep;xs] $[0=#xs; ""; (,/) {[sep;x;i] $[i; sep,x; x]}[sep]'[xs;til count xs]]}
vs: {[x;y] $[(@x) in `int`ints`bool`byte; vsnum[x;y]; vss[x;y]]}
sv: {[x;y] $[(@x) in `int`ints; svnum[x;y]; svs[x;y]]}
// 2 vs 13 -> 1 1 0 1 (most significant first, minimal);  256 vs 1000 -> 3 232;  24 60 60 vs 3723 -> 1 2 3 (fixed widths)
// 0b vs x -> the 64 bits;  0x00 vs x -> the 8 bytes.  A vector x gives one digit row per input, padded to the widest.
// sv inverts each of these:  2 sv 1 1 0 1 -> 13;  24 60 60 sv 1 2 3 -> 3723;  256 sv 0x0102 -> 258.  Non-negative x only.
vsn: {[b;x] out: ,x mod b; v: x div b; while[v>0; out,: v mod b; v: v div b]; |out}
vsw: {[bs;x] n: #bs; out: n#0; v: x; i: n-1; while[not i<0; out[i]: v mod bs[i]; v: v div bs[i]; i-:1]; out}
vsv: {[b;x] d: vsnum[b] each x; w: max count each d; {[w;x] ((w-#x)#0),x}[w] each d}
vsnum: {[b;x] t: @b
  $[t=`bool; 1=vsnum[64#2;x]; t=`byte; `byte$vsnum[8#256;x]; not (@x) in `int`float; vsv[b;x]; t=`int; vsn[b;x]; vsw[b;x]]}
svnum: {[b;d] if[(@d) in `bytes`bools; d: `int$d]; n: #d; bs: $[`int=@b; n#b; b]; +/d*|prds 1,|1_bs}

// nulls
nullof: {t: @x; $[t in `int`ints; 0N; t in `float`floats; 0n; t in `sym`syms; `; t in `char`chars; " "; t in `date`dates; `date$-2147483648; t in `time`times; `time$0N; null]}
fill: {[a;x] i: &isnull x; if[count i; x[i]: a]; x}
fills: {{$[isnull y; x; y]}\x}

// vector utilities
enlist: ,
flip: +
prev: {(nullof x), -1_x}
next: {(1_x), nullof x}
deltas: {(first x), (1_x) - -1_x}
ratios: {(first x), (1_x) % -1_x}
sums: +\
prds: *\
maxs: |\
mins: &\
asc: {x[<x]}
desc: {x[>x]}
except: {x[&not x in y]}
inter: {x[&x in y]}
union: {distinct x,y}
cross: {[x;y] raze {[y;a] {(x;y)}[a] each y}[y] each x}

// iteration as functions — the adverb forms f/ f\ are fold and scan only
//   prior[-;1 5 20] -> 1 4 15      f over adjacent pairs, first element kept (deltas is prior[-])
//   converge[f;x]                  apply f until the value stops changing;  converges keeps every step
//   iterate[n;f;x]                 apply f n times;                         iterates keeps every step
prior: {[f;x] $[0=#x; x; (,first x), f'[1_x; -1_x]]}
converge: {[f;x] p: x; v: f x; while[not v~p; p: v; v: f v]; v}
converges: {[f;x] out: ,x; p: x; v: f x; while[not v~p; out,: enlist v; p: v; v: f v]; out}
iterate: {[n;f;x] v: x; do[n; v: f v]; v}
iterates: {[n;f;x] out: ,x; v: x; do[n; v: f v; out,: enlist v]; out}

// ---- formatting.  string/tostr give the shortest text; fixed/lpad/fmt lay it out
// tostr: any atom or string -> string;  lpad[w;s] right-aligns in w columns, rpad[w;s] left-aligns;  lpad0 zero-pads a number
tostr: {$[(@x) in `char`chars; $[`char=@x; ,x; x]; string x]}
lpad: {[w;s] s: tostr s; ((0|w-#s)#" "),s}
rpad: {[w;s] s: tostr s; s,(0|w-#s)#" "}
lpad0: {[w;x] s: tostr x; $[s[0]="-"; "-",lpad0[w-1;1_s]; ((0|w-#s)#"0"),s]}
// fixed[2;3.14159] -> "3.14"   p decimals, half away from zero;  a vector gives a list of strings
fixed: {[p;x] if[not (@x) in `int`float; :fixed[p] each x]; m: */1,p#10; n: _0.5+m*abs x; s: string n div m
  if[p>0; s,: ".",lpad0[p;n mod m]]; $[x<0; "-",s; s]}
// commas 1234567.5 -> "1,234,567.5"
commas: {s: tostr x; ng: s[0]="-"; if[ng; s: 1_s]; dp: s?"."; ip: dp#s; ($[ng;"-";""]),(|"," sv 3 cut |ip),dp _ s}
// fmt["%s has %d items (%5.1f%%)"; ("bob";3;42.25)] -> "bob has 3 items ( 42.2%)"
// specs: %s %d %f, optional - (left align), 0 (zero pad), width, .precision; a bare % is %s; %% is a literal %
fmt: {[s;a] a: $[(@a) in `list; a; (@a) in `chars`char`int`float`sym`bool`date`time`byte`bytes`null; enlist a; a]
  out: ""; i: 0; n: #s; k: 0
  while[i<n
    c: s[i]; i+:1
    if[not c="%"; out,: c]
    if[c="%"
      r: fmtspec[s;i]; i: r 0; sp: r 1
      if[sp[4]="%"; out,: "%"]
      if[not sp[4]="%"; out,: fmtarg[sp;a[k]]; k+:1]]]
  out}
// spec state at s[i] (just past the %): (left;zero;width;prec;conv) and the index after it
fmtspec: {[s;i] n: #s; left: 0b; zero: 0b; w: 0; p: -1
  if[$[i<n; s[i]="-"; 0b]; left: 1b; i+:1]
  if[$[i<n; s[i]="0"; 0b]; zero: 1b; i+:1]
  while[$[i<n; s[i] in "0123456789"; 0b]; w: (10*w)+"0123456789"?s[i]; i+:1]
  if[$[i<n; s[i]="."; 0b]; i+:1; p: 0; while[$[i<n; s[i] in "0123456789"; 0b]; p: (10*p)+"0123456789"?s[i]; i+:1]]
  conv: "s"; if[$[i<n; s[i] in "sdf%"; 0b]; conv: s[i]; i+:1]
  (i; (left;zero;w;p;conv))}
fmtarg: {[sp;x] c: sp 4; p: sp 3
  t: $[c="d"; string `int$x; c="f"; fixed[$[p<0;6;p];x]; p<0; tostr x; p#tostr x]
  $[sp 0; rpad[sp 2;t]; $[sp 1; c in "df"; 0b]; lpad0[sp 2;t]; lpad[sp 2;t]]}

timeit: {t0: now`time; r: x[]; print fmt["%dms"; `int$now[`time]-t0]; r}          // timeit {sum til 1000000}


// math
neg: -
iasc: <
idesc: >
any: |/
all: &/
pi: 3.141592653589793
ceiling: {-_-x}
round: {_x+0.5}                        // half up: round -1.5 is -1
signum: {(x>0)-x<0}
med: {s: asc x; n: #s; $[n mod 2; s[n div 2]; avg s[(n div 2)-1 0]]}
var: {avg (x-avg x)^2}
dev: {sqrt var x}
rank: {<<x}
xbar: {[n;x] t: @x; r: n*_x%n; $[t in `date`dates; `date$r; t in `time`times; `time$r; r]}
// x bin y: index of the last element of sorted x not greater than y, -1 if none
bin: {[x;y] $[(@y) in `int`float`date`time; (+/ not x>y)-1; {[x;b] (+/ not x>b)-1}[x] each y]}

// windows (partial windows at the start, like q)
msum: {[n;x] s: sums x; s - (n#0),(-n)_s}
mavg: {[n;x] msum[n;x] % n & 1+til count x}
mwin: {[f;n;x] {[f;n;x;i] f x[(0|1+i-n)+til n&1+i]}[f;n;x] each til count x}   // ponytail: O(n*w), a monotone deque if windows get wide
mmax: mwin[max]
mmin: mwin[min]
ema: {[a;x] {[a;p;c] (a*c)+p*1-a}[a] scan x}

// lists
rotate: {[n;x] c: count x; x[(n+til c) mod c]}
cut: {[i;x] if[`int=@i; i: i*til ceiling (count x)%i]; en: (1_i),count x; {[x;a;b] x[a+til b-a]}[x]'[i;en]}
sublist: {[r;x] $[`int=@r; (r&count x)#x; x[r[0]+til r[1]&(count x)-r[0]]]}
differ: {(,1b), not {x~y}'[1_x;-1_x]}

// more strings
ws: " \t\r\n"
ltrim: {i: &not x in ws; $[#i; (first i)_x; ""]}
rtrim: {i: &not x in ws; $[#i; (1+last i)#x; ""]}
ssr: {[s;p;r] r sv p vs s}
// glob match: * any run, ? any one char.  ponytail: backtracking, exponential on many *
like: {[s;p] p: $[`char=@p; ,p; p]; s: $[`char=@s; ,s; s]
  $[0=#p; 0=#s; p[0]="*"; $[like[s;1_p]; 1b; 0=#s; 0b; like[1_s;p]]; 0=#s; 0b; (p[0]="?") | s[0]=p[0]; like[1_s;1_p]; 0b]}

// bytes <-> hex text:  hex 0x0aff -> "0aff",  unhex "0aff" -> 0x0aff  (the lexer uses unhex for 0x literals)
hex: {2_string x}
unhex: {d: "0123456789abcdef"?lower x; n: (count x) div 2; `byte$(16*d[2*til n])+d[1+2*til n]}

// ---- dates.  today[] is now`date.  `int$d is days since 2000.01.01 (a Saturday); dow is Monday=0 .. Sunday=6
dow: {(5+`int$x) mod 7}
weekdays: `mon`tue`wed`thu`fri`sat`sun
ymd: {(`year$x; `month$x; `day$x)}
isleap: {(0=x mod 4) & (not 0=x mod 100) | 0=x mod 400}
dim: {[y;m] (30+m in 1 3 5 7 8 10 12)-(m=2)*2-isleap y}                  // days in month
mkdate: {[y;m;d] y: y-m<3; era: y div 400; yoe: y-400*era; doy: (d-1)+(2+153*(m+9) mod 12) div 5
  `date$-730425+(146097*era)+doy+(365*yoe)+(yoe div 4)-yoe div 100}              // Hinnant's days-from-civil, vectorizes
addMonths: {[n;d] p: ymd d; t: (n-1)+(p 1)+12*p 0; y: t div 12; m: 1+t mod 12; mkdate[y;m;(p 2)&dim[y;m]]}  // clamps to month end
mstart: {mkdate[`year$x;`month$x;1]}
mend: {yr: `year$x; mo: `month$x; mkdate[yr;mo;dim[yr;mo]]}
ystart: {mkdate[`year$x;1;1]}
wstart: {x-dow x}                                                          // the Monday
// ISO 8601 text: iso 2026.09.16 -> "2026-09-16";  isot 12:30:00.250 -> "12:30:00.250";  isodt[d;t] -> "2026-09-16T12:30:00.250Z"
// pdate / ptime / pdt parse them back (pdt -> (date;time); - or . in dates, optional fraction and Z)
iso: {"-" sv (string `year$x; lpad0[2;`month$x]; lpad0[2;`day$x])}
isot: {(":" sv lpad0[2] each (`hour$x; `minute$x; `second$x)),".",lpad0[3;(`int$x) mod 1000]}
isodt: {[d;t] (iso d),"T",(isot t),"Z"}
pdate: {`date$ssr[x;"-";"."]}
ptime: {x: x except "Z"; d: x?"."; ms: $[d<#x; `int$3#(1+d)_x,"00"; 0]; `time$ms+1000*0 60 60 sv `int$":" vs d#x}
pdt: {t: x?"T"; (pdate t#x; ptime (t+1)_x)}
// strftime-style: dfmt["%a, %d %b %Y %H:%M:%S GMT"; d; t]  codes Y m d H M S b a j y %;  dparse[f;s] -> (date;time)
months3: ("Jan";"Feb";"Mar";"Apr";"May";"Jun";"Jul";"Aug";"Sep";"Oct";"Nov";"Dec")
days3: ("Mon";"Tue";"Wed";"Thu";"Fri";"Sat";"Sun")
dcode: {[k;d;t] $[k="Y"; string `year$d; k="m"; lpad0[2;`month$d]; k="d"; lpad0[2;`day$d]; k="H"; lpad0[2;`hour$t]; k="M"; lpad0[2;`minute$t]; k="S"; lpad0[2;`second$t]
  k="b"; months3[(`month$d)-1]; k="a"; days3[dow d]; k="j"; lpad0[3;1+d-ystart d]; k="y"; lpad0[2;(`year$d) mod 100]; k="%"; "%"; "%",k]}
dfmt: {[f;d;t] out: ""; i: 0; n: #f
  while[i<n; c: f[i]; i+:1
    if[not c="%"; out,: c]
    if[$[c="%"; i<n; 0b]; out,: dcode[f[i];d;t]; i+:1]]
  out}
httpDate: {[d;t] dfmt["%a, %d %b %Y %H:%M:%S GMT";d;t]}
pdigits: {[s;j] v: 0; while[$[j<#s; s[j] in "0123456789"; 0b]; v: (10*v)+"0123456789"?s[j]; j+:1]; (v;j)}
dparse: {[f;s] st: `Y`m`d`H`M`S!2000 1 1 0 0 0; i: 0; j: 0; n: #f
  while[i<n; c: f[i]; i+:1
    if[not c="%"; j+:1]
    if[$[c="%"; i<n; 0b]; k: f[i]; i+:1
      if[k="b"; st[`m]: 1+months3?s[j+til 3]; j+:3]
      if[k="a"; j+:3]
      if[k="%"; j+:1]
      if[k in "YmdHMS"; r: pdigits[s;j]; st[`$,k]: r 0; j: r 1]]]
  (mkdate[st`Y;st`m;st`d]; `time$1000*(st`S)+60*(st`M)+60*st`H)}

today: {now`date}

// ---- statistics
wsum: {[w;x] +/w*x}
wavg: {[w;x] (+/w*x)%+/w}
cov: {[x;y] avg (x-avg x)*y-avg y}
cor: {[x;y] cov[x;y]%(dev x)*dev y}
svar: {(+/(x-avg x)^2)%(#x)-1}                                             // sample variance, n-1
sdev: {sqrt svar x}
zscore: {(x-avg x)%dev x}
// quantile[0.5;x] is the median; linear interpolation between order statistics (R type 7); p may be a vector
quantile: {[p;x] if[not (@p) in `int`float; :quantile[;x] each p]; s: asc x; h: p*(#x)-1; i: _h; s[i]+(h-i)*s[(i+1)&(#x)-1]-s[i]}
percentile: {[p;x] quantile[p%100;x]}
mode: {g: group x; k: key g; c: count each value g; k[c?max c]}


// ---- collections
sortOn: {[f;x] x[<f each x]}                                               // sortOn[count;("aa";"b")] -> ("b";"aa")
maxBy: {[f;x] k: f each x; x[k?max k]}
minBy: {[f;x] k: f each x; x[k?min k]}
freq: {g: group x; (key g)!count each value g}                             // value -> how many times
groupBy: {[f;x] g: group f each x; (key g)!{x y}[x] each value g}         // groupBy[count;("a";"bb";"c")] -> 1 2!(("a";"c");enlist "bb")
takeWhile: {[f;x] ((f each x)?0b)#x}
dropWhile: {[f;x] ((f each x)?0b)_x}
partition: {[f;x] m: f each x; (x[&m]; x[&not m])}                          // (matching; rest)
zip: {[x;y] flip (x;y)}
flatten: {$[`list=@x; raze flatten each x; x]}
