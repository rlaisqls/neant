// test harness, in neant. Tests are .nt files; tests/run.nt loads them and reports.
//   tsection "prelude: lists"              heading, so a long run reads well
//   tok["til"; 3=count til 3]              passes when the condition is 1b
//   teq["til"; til 3; 0 1 2]               passes when got~want; a failure prints the name, got and want
//   terr["bad add"; {[] 1+`a}]             passes when calling the niladic f signals; prints the value if it does not
//   terrLike["bad add"; {[] 1+`a}; "type"] like terr, and the message must start with prefix
//   treport[]                              prints "N passed, M failed", lists every failure by name, returns M
// The name is the locator for a failure, so it is printed first and repeated in the report.
// Passes and failures live in globals assigned with :: — a closure cannot mutate a captured local.
tpass: 0
tfails: ()
tfmt: {t: @x; $[t in `char`chars; "\"",x,"\""; t=`sym; "`",string x; t=`null; "::"; string x]}
tpassed: {[name] tpass::tpass+1; 1b}
tfailed: {[name;lines] tfails::tfails,enlist name; print "FAIL ",name; print each lines; 0b}
tok: {[name;cond] $[cond~1b; tpassed name; tfailed[name; enlist "  got ",(tfmt cond)," for a condition"]]}
teq: {[name;got;want] $[got~want; tpassed name; tfailed[name; ("  got:  ",tfmt got; "  want: ",tfmt want)]]}
// a niladic f cannot go straight through @[f;x;h] (rank), so the protected call applies {x[]} to it;
// the handler tags the message, since a successful f may return anything, a string included
tcatch: {[f] @[{(`err;x[])};f;{(`ok;x)}]}
terr: {[name;f] r: tcatch f; $[`ok=r[0]; tpassed name; tfailed[name; enlist "  expected an error, got ",tfmt r[1]]]}
terrLike: {[name;f;prefix] r: tcatch f
  if[`err=r[0]; :tfailed[name; enlist "  expected an error, got ",tfmt r[1]]]
  m: r[1]; $[prefix~(count prefix)#m; tpassed name; tfailed[name; ("  error: ",m; "  want prefix: ",prefix)]]}
tsection: {[name] print ""; print "== ",name}
treport: {[]
  n: count tfails; print ""; print (string tpass)," passed, ",(string n)," failed"
  if[n; print each "  - ",/:tfails]
  n}
