// Constant-time building blocks, in neant.  load "src/neant/stdlib/ct.nt"
//
// Every function here compiles to machine code with no data-dependent branch, and that is not a
// claim about the source — `jitct` checks the emitted bytes (docs/constant-time.md "Constant time, and a checker
// for it") and tests/ct.nt asserts it for each one, so a change that quietly costs the property
// fails the suite rather than going unnoticed.
//
// The discipline that makes it possible, and every part of it is forced by something real:
//
//   * NO `+`, `-` or `*`. `badd` is the wrapping add. The three ordinary operators are what force
//     the null-sentinel check, which is itself a branch on a value — see jitHasArith in
//     src/neant/jit/arm64.nt. Two's complement negation is therefore `(x bxor (-1)) badd 1`.
//   * NO `if`, `$[..]` or `while`. A choice is made with a mask, which is how constant-time code is
//     written in any language. `do[<literal>;..]` is the one loop, because its counter runs the
//     same way for every input.
//   * NO calls, even to each other. A compiled function calling another goes through a trampoline
//     that checks whether the callee bailed out, and that check is a conditional branch. It could
//     never be taken between two functions that cannot deopt, but nothing proves that yet, so the
//     bodies here are written out rather than composed. That is why `ctZeroBit` repeats `ctNeg`.
//   * NO indexing by a secret. Nothing here indexes at all.
//   * `-1` is written `(-1)`, and that is not style: bare `-1` after a verb lexes as the literal 1
//     with a monadic minus applied, which is outside the compilable subset, so the function
//     silently stops compiling and the guarantee goes with it.
//
// A MASK is 0 (false) or -1 (all ones), because that is the shape `band` wants. A BIT is 0 or 1.
//
// WHAT THIS IS NOT. Branch-free is one property and not the whole of constant-time: `MUL` is
// constant-time on the cores this targets without being architecturally required to be, and nothing
// here says anything about what a caller does before or after. It is the property that was missing
// and is now checkable, not a finished guarantee.

// two's complement negation without `-`: 0 -> 0, 1 -> -1 (all ones)
ctNeg: {[x] (x bxor (-1)) badd 1}
// a 0/1 bit to a 0/-1 mask
ctMask: {[bit] (bit bxor (-1)) badd 1}
// the mask's complement, for the other arm of a select
ctNot: {[m] m bxor (-1)}

// a when the mask is all ones, b when it is zero
ctSel: {[m;a;b] (a band m) bor b band m bxor (-1)}

// 1 when x is zero. A number and its negation both have the sign bit clear only for zero, so the
// sign bit of (x | -x) answers it, inverted.
ctZeroBit: {[x] ((x bor (x bxor (-1)) badd 1) shr 63) bxor 1}
// 1 when x and y are equal
ctEqBit: {[x;y] t: x bxor y; ((t bor (t bxor (-1)) badd 1) shr 63) bxor 1}
// and the same as a mask
ctEqMask: {[x;y] t: x bxor y; b: ((t bor (t bxor (-1)) badd 1) shr 63) bxor 1; (b bxor (-1)) badd 1}

// 1 when x < y with both read as UNSIGNED 64-bit words, which is what a limb or a key word is.
// The borrow out of x-y, read from the sign bits:  (~x & y) | (~(x^y) & (x-y))
ctLtBit: {[x;y]
  nx: x bxor (-1)
  d: x badd (y bxor (-1)) badd 1
  ((((nx band y) bor ((x bxor y) bxor (-1)) band d) shr 63) band 1)}

// Folding a comparison over many words: start at 0, accumulate every pair, and read the answer out
// at the end. Every word is touched whatever it holds, where `~` stops at the first difference —
// which is the whole point when the thing being compared is an authentication tag.
//   acc: 0; acc: ctAcc[acc; a[i]; b[i]] ...; ctZeroBit acc
ctAcc: {[acc;x;y] acc bor x bxor y}
