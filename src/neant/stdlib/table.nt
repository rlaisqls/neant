// tables, in neant. A table is a dict of equal-length columns keyed by symbols; no new value type.
//   t: tbl[`name`age; (`ann`bob`cy; 31 45 28)]
//   t`age                      column          tsel[t; t[`age]>30]       rows where
//   row[t;0]                   row as a dict   tsort[t;`age]             rows ordered by a column
//   tby[t;`dept;`pay;sum]      aggregate       tshow t                   aligned grid
//   meta t  tcols t  xcol  xcols  tcsv  wcsv  rcsv  fby  tupd  tdel  tdistinct  tinsert   see the sections below
tbl: {[names;cols] names!cols}
tcount: {#first value x}
row: {[t;i] (key t)!{x[y]}[;i] each value t}
rows: {[t;idx] (key t)!{x[y]}[;idx] each value t}
tsel: {[t;mask] rows[t; &mask]}
tsort: {[t;col] rows[t; <t col]}
tby: {[t;keycol;col;f] f each t[col] each =t keycol}
tappend: {[t;u] (key t)!{x,y}'[value t; u key t]}
// no closures: helpers used inside nested lambdas must be globals
tpad: {[s;w] s,(w-#s)#" "}
tline: {[cs;w] " " sv tpad'[cs;w]}
tshow: {[t]
  names: string each key t
  cells: {string each x} each value t
  w: {max (#x), count each y}'[names;cells]
  print tline[names;w]
  print ((+/w)+(#w)-1)#"-"
  i: 0; n: tcount t
  while[i<n; print tline[{x[y]}[;i] each cells; w]; i+:1]
  null}

// ---- select (parser desugars `select cols by keys from t where conds` into this)
// w: unary fn over the table -> bool mask, or () ; b/c: dicts name -> unary fn over the (sub)table, or ()
enl: {$[(@x) in `bool`int`float`char`sym`date`time`null; ,x; x]}
krows: {[t;k] $[`sym=@k; t k; 1=count k; t first k; flip t k]}
qsel: {[t;w;b;c]
  if[count w; t: rows[t; &w t]]
  if[0=count c; :t]
  if[0=count b; :(key c)! {[f;t] enl f t}[;t] each value c]
  kv: {[f;t] f t}[;t] each value b
  g: value group $[1=count kv; first kv; flip kv]   // not `value =x`: a name before a verb is its left argument
  firsts: first each g
  kcols: {x[y]}[;firsts] each kv
  vcols: {[f;t;g] {[f;t;idx] f rows[t;idx]}[f;t] each g}[;t;g] each value c
  ((key b),key c)! kcols, vcols}

// ---- joins on key column(s) k
lj: {[t;k;u]
  i: krows[u;k]?krows[t;k]
  uc: (key u) except $[`sym=@k; ,k; k]
  ((key t),uc)! (value t), {[u;i;c] col: u c; (col, nullof col)[i]}[u;i] each uc}
ij: {[t;k;u]
  i: krows[u;k]?krows[t;k]; m: &i<tcount u
  uc: (key u) except $[`sym=@k; ,k; k]
  ((key t),uc)! (value rows[t;m]), {[u;i;c] (u c)[i]}[u;i[m]] each uc}
uj: {[t;u]
  ks: union[key t; key u]; nt: tcount t; nu: tcount u
  ks! {[t;u;nt;nu;c] a: $[c in key t; t c; nt#nullof u c]; b: $[c in key u; u c; nu#nullof t c]; a,b}[t;u;nt;nu] each ks}
// explode list columns into rows
ungroup: {[t]
  cols: value t; isl: {`list=@x} each cols; n: count each first cols[&isl]
  (key t)! {[n;c;l] $[l; raze c; c[&n]]}[n]'[cols;isl]}
// ---- schema.  meta t -> a `c`t table: column name and its type as @ gives it (`ints `syms `chars ... `list for a general list)
//   tcols t                  column names          xcol[`pay`dept!`p`d; t]  rename (a dict old!new, or a symbol list for the first n)
//   xcols[`pay; t]           those columns first, the rest keep their order
meta: {[t] tbl[`c`t; (key t; type each value t)]}
tcols: {key x}
tcolsub: {[t;ks] ks!t ks}
xcol: {[names;t] ks: key t
  ks: $[`dict=@names; {[names;k] $[k in key names; names k; k]}[names] each ks; (enl names), (count enl names) _ ks]
  ks!value t}
xcols: {[names;t] tcolsub[t; (enl names), (key t) except enl names]}

// ---- csv.  tcsv t -> text: a header line then one line per row, "\n"-separated; a cell is quoted with "" (inner quotes
// doubled) only when it holds , " or a newline.  wcsv[path;t] writes it.  rcsv["SSI";",";src] reads it back: src is a path,
// or the CSV text itself when it holds a newline or names no readable file.  types is one char per column: I int, F float,
// S symbol, anything else keeps the string; an I/F cell that does not parse (e.g. "0N", "") becomes null.
csvcell: {[v] s: $[`char=@v; ,v; `chars=@v; v; string v]; $[any s in ",\"\n"; "\"",(ssr[s;"\"";"\"\""]),"\""; s]}
tcsv: {[t] cells: {csvcell each x} each value t
  ls: {[cells;i] "," sv {x[y]}[;i] each cells}[cells] each til tcount t
  hdr: "," sv string each key t
  $[count ls; hdr,"\n","\n" sv ls; hdr]}
wcsv: {[path;t] write0[path; tcsv t]}
// CSV text -> rows of cells, one pass, no recursion; \r is dropped outside quotes; a one-char cell is a char atom, as in a literal
csvatom: {$[1=count x; first x; x]}
csvrows: {[sep;s]
  rws: (); cur: (); cell: ""; q: 0b; i: 0; n: count s
  while[i<n; c: s[i]; i+:1; inq: q
    if[inq & not c="\""; cell,: c]
    if[inq & c="\""; q: 0b; if[$[i<n; s[i]="\""; 0b]; cell,: c; q: 1b; i+:1]]
    if[not inq
      if[c="\""; q: 1b]
      if[c=sep; cur,: enlist csvatom cell; cell: ""]
      if[c="\n"; if[(count cell) | count cur; cur,: enlist csvatom cell; rws,: enlist cur]; cell: ""; cur: ()]
      if[not c in "\"\n\r",sep; cell,: c]]]
  if[(count cell) | count cur; cur,: enlist csvatom cell; rws,: enlist cur]
  rws}
rcell: {[t;c] $[t="I"; `int$c; t="F"; `float$c; t="S"; `$c; c]}
rnull: {[t;e] $[t="I"; 0N; t="F"; 0n; `]}
// a column of one-char cells is a chars vector, so cast per cell; a vector cast that fails falls back to per cell with nulls
rcol: {[t;c] $[0=count c; c; `chars=@c; rcell[t] each c; @[rcell[t]; c; {[t;c;e] {[t;x] @[rcell[t]; x; rnull[t]]}[t] each c}[t;c]]]}
rcsv: {[types;sep;src]
  ls: $[any src in "\n"; `text; @[read0; src; {[e] `text}]]
  rws: csvrows[first sep; $[`text~ls; src; "\n" sv ls]]
  if[0=count rws; :()!()]
  hn: first rws; hdr: $[`chars=@hn; sym each hn; `$hn]; body: 1 _ rws
  cols: {[body;j] {x[y]}[;j] each body}[body] each til count hdr
  hdr! rcol'[types;cols]}

// ---- fby[f;col;bycol;t]: f over col within each bycol group, as a vector aligned with the rows
//   tsel[t; t[`pay] > fby[avg;`pay;`dept;t]]       paid above their department's average
fby: {[f;col;bycol;t] if[0=tcount t; :()]
  g: value group krows[t;bycol]; v: t col
  a: {[f;v;i] f v[i]}[f;v] each g
  p: raze g; k: raze {[i;j] (count j)#i}'[til count g; g]
  (a k)[iasc p]}

// ---- update, delete, distinct, insert
//   tupd[t;mask;cols]   rows where mask is 1b (every row for ()) take the values in cols: name -> vector, atom, or a unary fn
//                       of the masked rows; a new name adds a column, other rows nullof the value
//                       tupd[t; t[`dept]=`ops; (,`pay)!enlist {x[`pay]+5}]      tupd[t; (); (,`n)!enlist 0]
//   tdel[t;mask]        the rows where mask is 0b;  tdel[t;`col] or a symbol list drops columns
//   tdistinct t         distinct rows, first occurrence kept
//   tinsert[t;row]      append one row: a dict, or a list in column order
tatoms: `bool`int`float`char`sym`date`time`null
tupd: {[t;mask;cols] n: tcount t; idx: $[0=count mask; til n; where mask]; sub: rows[t;idx]; ks: key cols
  full: (count idx)=n; i: 0
  while[i<count ks; k: ks[i]; v: cols k; i+:1
    if[`fn=@v; v: v sub]
    if[(@v) in tatoms; v: (count idx)#v]
    c: $[k in key t; t k; n#nullof v]
    if[full; c: v]
    if[not full; c[idx]: v]
    t[k]: c]
  t}
tdel: {[t;m] $[(@m) in `sym`syms; tcolsub[t; (key t) except enl m]; rows[t; where not m]]}
tdistinct: {[t] $[0=tcount t; t; rows[t; asc first each value group flip value t]]}
tinsert: {[t;r] vals: $[`dict=@r; r key t; r]; (key t)!{[c;v] $[(`list=@c) | `chars=@v; c,enlist v; c,v]}'[value t; vals]}

// ---- keyed tables: a dict from key values (rows of the key columns) to the remaining columns as a table;
// kt[key] yields the matching row.  xkey[`id;t]  kt[3]  unkey kt
xkey: {[k;t] ks: $[`sym=@k; ,k; k]; cols: (key t) except ks; krows[t;k] ! cols ! t cols}
unkey: {[kt]
  k: key kt; v: value kt; multi: `list=@k
  kn: $[multi; `$"k",/:string 1+til count first k; ,`k]
  kc: $[multi; flip k; ,k]
  (kn, key v)!(kc, value v)}

// sort rows by one or more columns
xasc: {[k;t] rows[t; <krows[t;k]]}
xdesc: {[k;t] rows[t; >krows[t;k]]}

// asof join: c is the key column(s) then the asof column. For each t row, the last u row with equal keys and
// u's asof value <= t's; u must be sorted by the asof column within each key.   aj[`sym`time;trades;quotes]
aj: {[c;t;u]
  c: $[`sym=@c; ,c; c]; k: -1_c; a: last c; nu: tcount u
  ku: $[#k; krows[u;k]; nu#1]; kt: $[#k; krows[t;k]; (tcount t)#1]
  j: {[ku;ua;nu;kk;ta] i: & (kk ~/: ku) & not ua>ta; $[#i; last i; nu]}[ku;u a;nu]'[kt;t a]
  uc: (key u) except c
  ((key t),uc)! (value t), {[u;j;c] col: u c; (col, nullof col)[j]}[u;j] each uc}
