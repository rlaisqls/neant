// tables, in neant. A table is a dict of equal-length columns keyed by symbols; no new value type.
//   t: tbl[`name`age; (`ann`bob`cy; 31 45 28)]
//   t`age                      column          tsel[t; t[`age]>30]       rows where
//   row[t;0]                   row as a dict   tsort[t;`age]             rows ordered by a column
//   tby[t;`dept;`pay;sum]      aggregate       tshow t                   aligned grid
tbl: {[names;cols] names!cols}
tcount: {#first value x}
row: {[t;i] (key t)!{x[y]}[;i] each value t}
rows: {[t;idx] (key t)!{x[y]}[;idx] each value t}
tsel: {[t;mask] rows[t; &mask]}
tsort: {[t;col] rows[t; <t col]}
tby: {[t;keycol;col;f] f each t[col] each =t keycol}
tappend: {[t;u] (key t)!{x,y}'[value t; u key t]}
// no closures: helpers used inside nested lambdas must be globals
tpad: {[s;w] s,(w-#s)#" "}
tline: {[cs;w] " " sv tpad'[cs;w]}
tshow: {[t]
  names: string each key t
  cells: {string each x} each value t
  w: {max (#x), count each y}'[names;cells]
  print tline[names;w]
  print ((+/w)+(#w)-1)#"-"
  i: 0; n: tcount t
  while[i<n; print tline[{x[y]}[;i] each cells; w]; i+:1]
  null}

// ---- select (parser desugars `select cols by keys from t where conds` into this)
// w: unary fn over the table -> bool mask, or () ; b/c: dicts name -> unary fn over the (sub)table, or ()
enl: {$[(@x) in `bool`int`float`char`sym`date`time`null; ,x; x]}
krows: {[t;k] $[`sym=@k; t k; 1=count k; t first k; flip t k]}
qsel: {[t;w;b;c]
  if[count w; t: rows[t; &w t]]
  if[0=count c; :t]
  if[0=count b; :(key c)! {[f;t] enl f t}[;t] each value c]
  kv: {[f;t] f t}[;t] each value b
  g: value group $[1=count kv; first kv; flip kv]   // not `value =x`: a name before a verb is its left argument
  firsts: first each g
  kcols: {x[y]}[;firsts] each kv
  vcols: {[f;t;g] {[f;t;idx] f rows[t;idx]}[f;t] each g}[;t;g] each value c
  ((key b),key c)! kcols, vcols}

// ---- joins on key column(s) k
lj: {[t;k;u]
  i: krows[u;k]?krows[t;k]
  uc: (key u) except $[`sym=@k; ,k; k]
  ((key t),uc)! (value t), {[u;i;c] col: u c; (col, nullof col)[i]}[u;i] each uc}
ij: {[t;k;u]
  i: krows[u;k]?krows[t;k]; m: &i<tcount u
  uc: (key u) except $[`sym=@k; ,k; k]
  ((key t),uc)! (value rows[t;m]), {[u;i;c] (u c)[i]}[u;i[m]] each uc}
uj: {[t;u]
  ks: union[key t; key u]; nt: tcount t; nu: tcount u
  ks! {[t;u;nt;nu;c] a: $[c in key t; t c; nt#nullof u c]; b: $[c in key u; u c; nu#nullof t c]; a,b}[t;u;nt;nu] each ks}
// explode list columns into rows
ungroup: {[t]
  cols: value t; isl: {`list=@x} each cols; n: count each first cols[&isl]
  (key t)! {[n;c;l] $[l; raze c; c[&n]]}[n]'[cols;isl]}
// csv: types is one char per column: I int, F float, S symbol, anything else keeps the string
rcsv: {[types;sep;path]
  ls: read0 path; hdr: `$sep vs first ls; cols: flip sep vs/: 1_ls
  hdr! {[t;c] $[t="I"; `int$c; t="F"; `float$c; t="S"; `$c; c]}'[types;cols]}

// ---- keyed tables: a dict from key values (rows of the key columns) to the remaining columns as a table;
// kt[key] yields the matching row.  xkey[`id;t]  kt[3]  unkey kt
xkey: {[k;t] ks: $[`sym=@k; ,k; k]; cols: (key t) except ks; krows[t;k] ! cols ! t cols}
unkey: {[kt]
  k: key kt; v: value kt; multi: `list=@k
  kn: $[multi; `$"k",/:string 1+til count first k; ,`k]
  kc: $[multi; flip k; ,k]
  (kn, key v)!(kc, value v)}

// sort rows by one or more columns
xasc: {[k;t] rows[t; <krows[t;k]]}
xdesc: {[k;t] rows[t; >krows[t;k]]}

// asof join: c is the key column(s) then the asof column. For each t row, the last u row with equal keys and
// u's asof value <= t's; u must be sorted by the asof column within each key.   aj[`sym`time;trades;quotes]
aj: {[c;t;u]
  c: $[`sym=@c; ,c; c]; k: -1_c; a: last c; nu: tcount u
  ku: $[#k; krows[u;k]; nu#1]; kt: $[#k; krows[t;k]; (tcount t)#1]
  j: {[ku;ua;nu;kk;ta] i: & (kk ~/: ku) & not ua>ta; $[#i; last i; nu]}[ku;u a;nu]'[kt;t a]
  uc: (key u) except c
  ((key t),uc)! (value t), {[u;j;c] col: u c; (col, nullof col)[j]}[u;j] each uc}
