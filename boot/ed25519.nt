// Ed25519 signature verification (RFC 8032) in neant, on the 2^255-19 field in boot/crypto.nt.
// Not part of the boot image — load it with  load "boot/ed25519.nt"
//
// Verification only: there is no signing here, and nothing is constant-time — every input is public.
// The check is the cofactorless one, [S]B - [k]A encoded and compared with R, plus S < L. That is
// what most implementations do; it rejects the malleable signatures the cofactored equation accepts.

// ---- SHA-512 (FIPS 180-4). A 64-bit word is a raw i64 bit pattern: band/bor/bxor/shl/shr are exact
// on those (shr is logical, shl discards), and `badd` is the wrapping add — plain `+` would read
// 1 shl 63 as an int null and poison the round.
rotr64: {[x;n] (x shr n) bor x shl 64-n}
be64: {w: `int$x; n: (count w) div 8; i: 8*til n
  ((w[i] shl 56) bor (w[i+1] shl 48) bor (w[i+2] shl 40) bor w[i+3] shl 32) bor (w[i+4] shl 24) bor (w[i+5] shl 16) bor (w[i+6] shl 8) bor w[i+7]}
be64bytes: {`byte$ raze {(x shr 56 48 40 32 24 16 8 0) band 255} each x}
sha512K: be64 unhex ""
sha512H0: be64 unhex "6a09e667f3bcc908bb67ae8584caa73b3c6ef372fe94f82ba54ff53a5f1d36f1510e527fade682d19b05688c2b3e6c1f1f83d9abfb41bd6b5be0cd19137e2179"
// message, 0x80, zeros to 112 mod 128, then the bit length as 16 big-endian bytes
sha512Pad: {[b] n: count b; b, 0x80, (((111-n) mod 128)#0x00), (8#0x00), be64bytes (,8*n)}   // parens: `be64bytes ,x` would parse as a join with the function
sha512Block: {[h;blk]
  w: be64 blk; i: 16
  while[i<80
    s0: (rotr64[w[i-15];1]) bxor (rotr64[w[i-15];8]) bxor w[i-15] shr 7
    s1: (rotr64[w[i-2];19]) bxor (rotr64[w[i-2];61]) bxor w[i-2] shr 6
    w,: w[i-16] badd s0 badd w[i-7] badd s1
    i+:1]
  a: h[0]; b: h[1]; c: h[2]; d: h[3]; e: h[4]; f: h[5]; g: h[6]; hh: h[7]; i: 0
  while[i<80
    S1: (rotr64[e;14]) bxor (rotr64[e;18]) bxor rotr64[e;41]
    ch: (e band f) bxor (bnot e) band g
    t1: hh badd S1 badd ch badd sha512K[i] badd w[i]
    S0: (rotr64[a;28]) bxor (rotr64[a;34]) bxor rotr64[a;39]
    maj: (a band b) bxor (a band c) bxor b band c
    t2: S0 badd maj
    hh: g; g: f; f: e; e: d badd t1; d: c; c: b; b: a; a: t1 badd t2
    i+:1]
  h badd (a;b;c;d;e;f;g;hh)}
sha512: {[b] p: sha512Pad b; h: sha512H0; i: 0; while[i<count p; h: sha512Block[h; p[i+til 128]]; i+:128]; be64bytes h}

// ---- the curve: -x^2 + y^2 = 1 + d x^2 y^2 over 2^255-19, in extended coordinates (X;Y;Z;T) with
// x = X/Z, y = Y/Z, xy = T/Z. The twisted-Edwards addition law is complete, so the neutral element
// needs no special case anywhere below.
EDD:    fdecode unhex "a3785913ca4deb75abd841414d0a700098e879777940c78c73fe6f2bee6c0352"
SQRTM1: fdecode unhex "b0a00e4a271beec478e42fad0618432fa7d7fb3d99004d2b0bdfc14f8024832b"
EDBX:   fdecode unhex "1ad5258f602d56c9b2a7259560c72c695cdcd6fd31e2a4c0fe536ecdd3366921"
EDBY:   fdecode unhex "5866666666666666666666666666666666666666666666666666666666666666"
EDD2:   fadd[EDD;EDD]
EDB:    (EDBX; EDBY; F1; fmul[EDBX;EDBY])
EDZERO: (F0; F1; F1; F0)
fneg: {fsub[F0;x]}
feq:  {[a;b] (fencode a) ~ fencode b}
edNeg: {[P] (fneg P[0]; P[1]; P[2]; fneg P[3])}
edAdd: {[P;Q]                                                   // add-2008-hwcd-3
  a: fmul[fsub[P[1];P[0]]; fsub[Q[1];Q[0]]]
  b: fmul[fadd[P[1];P[0]]; fadd[Q[1];Q[0]]]
  c: fmul[fmul[P[3];EDD2]; Q[3]]
  d: fmul[fadd[P[2];P[2]]; Q[2]]
  e: fsub[b;a]; f: fsub[d;c]; g: fadd[d;c]; h: fadd[b;a]
  (fmul[e;f]; fmul[g;h]; fmul[f;g]; fmul[e;h])}
edDbl: {[P]                                                     // dbl-2008-hwcd with a = -1
  a: fsq P[0]; b: fsq P[1]; c: fadd[fsq P[2]; fsq P[2]]
  e: fsub[fsq fadd[P[0];P[1]]; fadd[a;b]]
  g: fsub[b;a]; f: fsub[g;c]; h: fneg fadd[a;b]
  (fmul[e;f]; fmul[g;h]; fmul[f;g]; fmul[e;h])}
// bits least-significant-first. Everything a verifier touches is public, so plain double-and-add.
edMul: {[bits;P]
  r: EDZERO; q: P; i: 0; n: count bits
  while[i<n
    if[bits[i]; r: edAdd[r;q]]
    q: edDbl q
    i+:1]
  r}
// Shamir's trick: both scalars at once over a four-entry table, so one doubling serves both and
// the verification costs 253 doublings instead of 506. Bits are least-significant-first, same length.
edMul2: {[b1;P;b2;Q]
  T: (EDZERO; P; Q; edAdd[P;Q])
  r: EDZERO; i: -1+count b1
  while[not i<0
    r: edDbl r
    j: b1[i] + 2*b2[i]
    if[j; r: edAdd[r; T[j]]]
    i: i-1]
  r}
edEncode: {[P]
  zi: finv P[2]
  b: fencode fmul[P[1];zi]
  s: 128 * (`int$ (fencode fmul[P[0];zi])[0]) band 1             // the sign of x goes in the top bit
  b[31]: `byte$ (`int$ b[31]) bor s
  b}
fpow2523: {[a] r: F1; i: 251; while[not i<0; r: fsq r; if[(i>1) | i=0; r: fmul[r;a]]; i: i-1]; r}
// 32 bytes -> point, or () when they are not a curve point. x = sqrt((y^2-1)/(d y^2+1)).
edDecode: {[b]
  y: fdecode b                                                  // fdecode already drops bit 255
  sign: ((`int$ b[31]) shr 7) band 1
  yy: fsq y
  u: fsub[yy;F1]
  v: fadd[fmul[EDD;yy];F1]
  v3: fmul[v; fsq v]
  v7: fmul[v3; fmul[v3;v]]
  x: fmul[fmul[u;v3]; fpow2523 fmul[u;v7]]
  if[not feq[fmul[v; fsq x]; u]
    if[not feq[fmul[v; fsq x]; fneg u]; :()]
    x: fmul[x;SQRTM1]]
  xb: fencode x
  if[sign & 0=+/`int$xb; :()]                                   // x = 0 with the sign set is not canonical
  if[not sign = (`int$ xb[0]) band 1; x: fneg x]
  (x; y; F1; fmul[x;y])}

// ---- scalars mod L = 2^252 + 27742317777372353535851937790883648493, in 12 limbs of 22 bits
SCL:  3527661 813427 2457894 4056885 3792546 21371 0 0 0 0 0 1024
SCNL: 666643 3380876 1736409 137418 401757 4172932 4194303 4194303 4194303 4194303 4194303 4193279
// carry pass; the carry out of the top limb falls off the 264-bit window, which is where 2^264-L puts it
scNorm: {[v] do[13; c: v shr 22; v: (v band M22) + 0,-1_c]; v}
scGe:   {[v] d: v - SCL; nz: where not d=0; $[0=count nz; 1; 0 < d[last nz]]}
scSubL: {[v] scNorm v + SCNL}
scFromBytes: {[b] bits: raze {(x shr til 8) band 1} each `int$b; bits,: 8#0; {+/x*2^til 22} each 22 cut bits}
scBits: {[v] raze {(x shr til 22) band 1} each v}
bitsBE: {[b] raze {(x shr 7 6 5 4 3 2 1 0) band 1} each `int$b}
// a most-significant-first bit list reduced mod L, one bit at a time: k <- 2k+b, then take L off
scMod: {[bits]
  k: 12#0; i: 0; n: count bits
  while[i<n
    k: scNorm (2*k) + bits[i],11#0
    if[scGe k; k: scSubL k]
    i+:1]
  k}

// ---- verify. Cofactorless: encode [S]B - [k]A and compare with R, and require S < L.
ed25519Verify: {[pub;msg;sig]
  if[not 32=count pub; :0b]
  if[not 64=count sig; :0b]
  r: 32#sig
  sn: scFromBytes sig[32+til 32]                               // `sv` would read as the string-join verb
  if[scGe sn; :0b]                                              // a non-canonical S is a forgery
  A: edDecode pub
  if[0=count A; :0b]
  m: $[`byte=type msg; msg; `byte$msg]
  k: scMod bitsBE reverse sha512 r,pub,m                         // the hash is a little-endian integer
  P: edMul2[253#scBits sn; EDB; 253#scBits k; edNeg A]
  (edEncode P) ~ r}
