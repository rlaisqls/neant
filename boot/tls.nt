// TLS 1.3 client (RFC 8446) in neant, on boot/crypto.nt: x25519 key exchange,
// TLS_CHACHA20_POLY1305_SHA256, no resumption, no client certificate.
// Not part of the boot image — load it with  load "boot/tls.nt"
//
// !! The server certificate is read off the wire and NOT verified: no X.509 parsing, no signature
// !! check, no hostname match, no trust store. That is confidentiality against someone recording
// !! the traffic and nothing at all against someone sitting in the middle of it. What is missing
// !! before this is a safe transport is ASN.1 DER, RSA/ECDSA verification, and a root store.

// ---- integers on the wire, big-endian; lp<n> prefixes a block with its n-byte length
wu8:   {[n] `byte$ ,n band 255}
wu16:  {[n] `byte$ (n shr 8 0) band 255}
wu24:  {[n] `byte$ (n shr 16 8 0) band 255}
wbe:   {[b] 0 {(256*x)+y}/ `int$b}
wlp8:  {[b] (wu8 count b), b}
wlp16: {[b] (wu16 count b), b}
wlp24: {[b] (wu24 count b), b}
wext:  {[t;b] (wu16 t), wlp16 b}
wdrop: {[n;b] b[n+til (count b)-n]}

// ---- key schedule (RFC 8446 7.1). HkdfLabel = len(2) | "tls13 "+label | context
TLSZ: 32#0x00
hkdfLabel:   {[len;label;ctx] (wu16 len), (wlp8 `byte$"tls13 ",label), wlp8 ctx}
expandLabel: {[secret;label;ctx;len] hkdfExpand[secret; hkdfLabel[len;label;ctx]; len]}
deriveSecret:{[secret;label;msgs] expandLabel[secret; label; sha256 msgs; 32]}
trafficKeys: {[secret] (expandLabel[secret;"key";0x;32]; expandLabel[secret;"iv";0x;12])}

// ---- record layer
recvN: {[h;n]
  b: 0x
  while[(count b)<n
    c: hrecv[h; n-count b]
    if[0=count c; signal "tls: peer closed the connection"]
    b,: c]
  b}
readRec: {[h] hdr: recvN[h;5]; (`int$hdr[0]; hdr; recvN[h; wbe hdr[3 4]])}
sendPlain: {[h;ctype;body] hsend[h; (wu8 ctype), 0x0303, wlp16 body]}
// nonce: the record sequence number as 8 big-endian bytes, right-aligned in 12, xor the static iv
recNonce: {[iv;seq] iv bxor (4#0x00), `byte$ (seq shr 56 48 40 32 24 16 8 0) band 255}
// an encrypted record always claims application_data; the real type is the last non-zero inner byte
sealBody: {[key;iv;seq;ctype;body]
  inner: body, wu8 ctype
  hdr: 0x17, 0x0303, wu16 16+count inner
  r: aeadEncrypt[key; recNonce[iv;seq]; hdr; inner]
  (hdr; hdr, r[0], r[1])}
sealRec: {[h;key;iv;seq;ctype;body] hsend[h; (sealBody[key;iv;seq;ctype;body])[1]]}
openRec: {[key;iv;seq;hdr;body]
  n: (count body)-16
  pt: aeadDecrypt[key; recNonce[iv;seq]; hdr; n#body; body[n+til 16]]
  i: -1+count pt
  while[0=`int$pt[i]; i-:1]
  (`int$pt[i]; i#pt)}

// ---- handshake messages and extensions
findExt: {[b;want]
  i: 0
  while[i<count b
    n: wbe b[(i+2)+til 2]
    if[want=wbe b[i+til 2]; :b[(i+4)+til n]]
    i: i+4+n]
  0x}
// ServerHello body: version(2) random(32) lp8 session_id cipher(2) compression(1) lp16 extensions
shKeyShare: {[b]
  i: 38+`int$b[34]
  e: b[(i+2)+til wbe b[i+til 2]]
  ks: findExt[e; 51]
  if[0=count ks; signal "tls: server sent no key_share"]
  ks[4+til wbe ks[2 3]]}

clientHello: {[host;pub;rnd;sid]
  exts: wext[0; wlp16 0x00, wlp16 `byte$host]                   // server_name
  exts,: wext[10; wlp16 wu16 29]                                // supported_groups: x25519
  exts,: wext[13; wlp16 raze wu16 each 2052 1027 1025]          // signature_algorithms
  exts,: wext[43; wlp8 wu16 772]                                // supported_versions: TLS 1.3
  exts,: wext[51; wlp16 (wu16 29), wlp16 pub]                   // key_share
  body: 0x0303, rnd, (wlp8 sid), (wlp16 wu16 4867), 0x0100, wlp16 exts
  0x01, wlp24 body}

// handle -> (client key; client iv; client seq; server key; server iv; server seq)
TLSC: ()!()
TLSCERT: ()!()

// ---- the handshake. Returns a handle for tlsSend / tlsRecv / tlsClose.
tlsConnect: {[host;port]
  priv: urand 32                                           // `rand` is a reproducible PRNG, never a key
  pub: x25519[priv; X25519BASE]
  ch: clientHello[host; pub; urand 32; urand 32]
  h: hopen host,":",string port
  sendPlain[h; 22; ch]
  tr: ch

  r: readRec h
  if[not r[0]=22; signal "tls: expected a handshake record, got type ",string r[0]]
  sh: r[2]
  if[not 2=`int$sh[0]; signal "tls: expected ServerHello, got handshake type ",string `int$sh[0]]
  tr,: sh
  ecdhe: x25519[priv; shKeyShare wdrop[4;sh]]

  early: hkdfExtract[TLSZ; TLSZ]
  hs: hkdfExtract[deriveSecret[early;"derived";0x]; ecdhe]
  cHS: deriveSecret[hs;"c hs traffic";tr]
  sHS: deriveSecret[hs;"s hs traffic";tr]
  ck: trafficKeys cHS
  sk: trafficKeys sHS

  hbuf: 0x; sseq: 0; fin: 0
  while[not fin
    r: readRec h
    if[r[0]=21; signal "tls: alert from server: ",hex r[2]]
    if[r[0]=23
      d: openRec[sk[0]; sk[1]; sseq; r[1]; r[2]]; sseq+:1
      if[not d[0]=22; signal "tls: expected handshake content, got type ",string d[0]]
      hbuf,: d[1]
      while[3<count hbuf                                  // peel off whole messages only
        n: 4+wbe hbuf[1+til 3]
        if[(count hbuf)<n; break]
        mt: `int$hbuf[0]
        raw: n#hbuf
        if[mt=11; TLSCERT[h]: wdrop[4;raw]]               // Certificate, kept but not checked
        if[mt=20
          if[not (wdrop[4;raw]) ~ hmac[expandLabel[sHS;"finished";0x;32]; sha256 tr]
            signal "tls: the server's Finished did not verify"]
          fin: 1]
        tr,: raw
        hbuf: wdrop[n;hbuf]]]]

  master: hkdfExtract[deriveSecret[hs;"derived";0x]; TLSZ]
  ak: trafficKeys deriveSecret[master;"c ap traffic";tr]
  bk: trafficKeys deriveSecret[master;"s ap traffic";tr]
  sendPlain[h; 20; ,0x01]                                  // dummy CCS, for middleboxes
  sealRec[h; ck[0]; ck[1]; 0; 22; 0x14, wlp24 hmac[expandLabel[cHS;"finished";0x;32]; sha256 tr]]
  TLSC[h]: (ak[0]; ak[1]; 0; bk[0]; bk[1]; 0)
  h}

tlsSend: {[h;data]
  st: TLSC h
  sealRec[h; st[0]; st[1]; st[2]; 23; $[`byte=type data; data; `byte$data]]
  TLSC[h]: (st[0]; st[1]; st[2]+1; st[3]; st[4]; st[5])
  count data}

// one application-data record, or 0x at end of stream. Post-handshake messages are skipped.
tlsRecv: {[h]
  while[1
    st: TLSC h
    r: readRec h
    if[r[0]=21; :0x]                                       // close_notify or any other alert
    if[r[0]=23
      d: openRec[st[3]; st[4]; st[5]; r[1]; r[2]]
      TLSC[h]: (st[0]; st[1]; st[2]; st[3]; st[4]; st[5]+1)
      if[d[0]=23; :d[1]]]]}

tlsClose: {[h] TLSC[h]: (); hclose h}
tlsCert: {[h] TLSCERT h}
