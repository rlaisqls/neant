// The fourth self-hosted stage (docs/self-hosting-emitter-design.md): the typed tree to C.
// **A fragment**, like the others: it uses lex.nt's `Token`, parse.nt's `Node`, and check.nt's
// `Ty` and its `ntys` table, and is compiled by concatenating all four and a driver.
//
// In this slice: functions over scalars, every statement and expression check.nt types, `if` and
// blocks in expression position (GNU statement expressions, as bootstrap/src/emit_c.rs also uses).
// Out: slices and arrays — the checker types them, but nothing that can be *built* inside the
// parser's slice can be passed to one, so emitting them would be untested code.
//
// `est` is the emitter's state: est[0] the output length, est[1] the next temporary's number.
// A local's C name is its source spelling, so same-block shadowing (`let x = 1; let x = 2;` in one
// block, which neant allows and C does not) fails in `cc` rather than silently — design §3.

fn emit_b(out: &mut [u8], est: &mut [i64], b: u8) {
    out[est[0]] = b;
    est[0] = est[0] + 1;
}

// The cursor is hoisted into a local and the write indexed by the loop variable, on the cost
// model's own advice — and the machine then said the advice was worth nothing. Both halves are
// worth keeping (docs/experiments.md, "the compiler's cost model, on the compiler").
//
// Written as `out[est[0]] = s[i]`, this loop's index is a *load* from the state array, so the
// model cannot see that it advances by one and charges a whole cache line per byte:
// `B·s.len() + s.len() + 2·B`. Written this way it charges `2·s.len() + 3·B` — 32× less. The
// measurement: **0.65% fewer L2 refills and no change in wall clock**, because the access was
// contiguous all along and the model's caution was an over-estimate, not a description. What
// improved was the report, not the program.
//
// It is kept because a cost report that is true beats one that is merely sound, and because the
// one-element-array idiom the language forces on mutable state (there are no globals) will hide a
// cursor from this analysis every time it is used this way.
fn emit_bytes(out: &mut [u8], est: &mut [i64], s: &[u8]) {
    let start = est[0];
    let mut i = 0;
    while i < s.len() {
        out[start + i] = s[i];
        i += 1;
    }
    est[0] = start + s.len();
}

// a token's own source bytes: an identifier's spelling, a float literal's digits — C spells both
// the same way, which is why no literal was ever parsed into a value
fn emit_span(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], t: i64) {
    let start = est[0];
    let mut i = 0;
    while i < toks[t].len {
        out[start + i] = src[toks[t].start + i];
        i += 1;
    }
    est[0] = start + toks[t].len;
}

// the same, without `_` separators: neant takes `1_000`, C does not
fn emit_span_digits(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], t: i64) {
    let mut i = 0;
    while i < toks[t].len {
        let c = src[toks[t].start + i];
        if c != b'_' {
            out[est[0]] = c;
            est[0] = est[0] + 1;
        }
        i += 1;
    }
}

fn emit_int(out: &mut [u8], est: &mut [i64], v: i64) {
    if v < 0 {
        emit_b(out, est, b'-');
        emit_int(out, est, 0 - v);
    } else {
        if v >= 10 { emit_int(out, est, v / 10); };
        emit_b(out, est, b'0' + (v % 10) as u8);
    }
}

fn emit_type(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], types: &[Ty],
             strs: &[Str], t: i64) {
    let k = if t < 0 { 4 } else { types[t].kind };
    if k == 0 { let s = b"int64_t"; emit_bytes(out, est, &s); }
    else if k == 1 { let s = b"double"; emit_bytes(out, est, &s); }
    else if k == 2 { let s = b"bool"; emit_bytes(out, est, &s); }
    else if k == 3 { let s = b"uint8_t"; emit_bytes(out, est, &s); }
    else if k == 7 {
        let s = b"struct nt_";
        emit_bytes(out, est, &s);
        emit_span(out, est, src, toks, strs[types[t].elem].name);
    }
    // an array or a view is two C variables, `x_p` and `x_n` (arrays design §1); the type written
    // here is the element's, and the caller adds the `*`
    else if k == 5 || k == 6 { emit_type(out, est, src, toks, types, strs, types[t].elem); }
    else { let s = b"void"; emit_bytes(out, est, &s); }
}

fn emit_op(out: &mut [u8], est: &mut [i64], op: i64) {
    if op == 0 { emit_b(out, est, b'+'); }
    else if op == 1 { emit_b(out, est, b'-'); }
    else if op == 2 { emit_b(out, est, b'*'); }
    else if op == 3 { emit_b(out, est, b'/'); }
    else if op == 4 { emit_b(out, est, b'%'); }
    else if op == 5 { let s = b"=="; emit_bytes(out, est, &s); }
    else if op == 6 { let s = b"!="; emit_bytes(out, est, &s); }
    else if op == 7 { emit_b(out, est, b'<'); }
    else if op == 8 { let s = b"<="; emit_bytes(out, est, &s); }
    else if op == 9 { emit_b(out, est, b'>'); }
    else if op == 10 { let s = b">="; emit_bytes(out, est, &s); }
    else if op == 11 { let s = b"&&"; emit_bytes(out, est, &s); }
    else { let s = b"||"; emit_bytes(out, est, &s); }
}

// `nt_t<k>`, a name for a statement expression's value; the prelude's own names all start
// `nt_println`, `nt_idx` or `nt_alloc`, so there is nothing to collide with
fn emit_tmp_name(out: &mut [u8], est: &mut [i64], k: i64) {
    let s = b"nt_t";
    emit_bytes(out, est, &s);
    emit_int(out, est, k);
}

// the source line a token is on — only the bounds check wants it, and only once per index, so
// counting newlines from the start of the file is not worth avoiding
fn line_of(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], t: i64) {
    let mut line = 1;
    let mut i = 0;
    while i < toks[t].start {
        if src[i] == b'\n' { line += 1; };
        i += 1;
    }
    emit_int(out, est, line);
}

fn emit_arr_name(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], t: i64, suffix: u8) {
    emit_span(out, est, src, toks, t);
    emit_b(out, est, b'_');
    emit_b(out, est, suffix);
}

fn is_arr(types: &[Ty], t: i64) -> bool {
    t >= 0 && (types[t].kind == 5 || types[t].kind == 6)
}

// `est` is the emitter's state: est[0] the bytes written, est[1] the next temporary's number,
// est[2] the refusal flag — set where the emitter meets something the slice does not cover.
//
// ---- expressions ----

fn emit_expr(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], nodes: &[Node],
             types: &[Ty], strs: &[Str], sigs: &[Sig], ntys: &[i64], n: i64) {
    if n < 0 { return; }
    let k = nodes[n].kind;
    if k == 60 {
        emit_span_digits(out, est, src, toks, nodes[n].a);
    } else if k == 61 {
        emit_span(out, est, src, toks, nodes[n].a);
    } else if k == 62 {
        if nodes[n].ival == 1 { let s = b"true"; emit_bytes(out, est, &s); }
        else { let s = b"false"; emit_bytes(out, est, &s); }
    } else if k == 63 {
        let s = b"((uint8_t)";
        emit_bytes(out, est, &s);
        emit_int(out, est, toks[nodes[n].a].ival);
        emit_b(out, est, b')');
    } else if k == 65 {
        // a variable of array or view type is its two names — which is what passing a `&[T]`
        // parameter straight on to another function needs, and the only place a bare array name
        // appears in an expression at all
        if is_arr(types, ntys[n]) {
            emit_arr_name(out, est, src, toks, nodes[n].a, b'p');
            let c = b", ";
            emit_bytes(out, est, &c);
            emit_arr_name(out, est, src, toks, nodes[n].a, b'n');
        } else {
            emit_span(out, est, src, toks, nodes[n].a);
        }
    } else if k == 68 {
        // `xs[i]` is `xs_p[nt_idx(i, xs_n, line)]`: the checker has already refused a base that is
        // not a variable, so the name is there to take
        let base = nodes[nodes[n].a].a;
        emit_arr_name(out, est, src, toks, base, b'p');
        let o = b"[nt_idx(";
        emit_bytes(out, est, &o);
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].b);
        let c = b", ";
        emit_bytes(out, est, &c);
        emit_arr_name(out, est, src, toks, base, b'n');
        emit_bytes(out, est, &c);
        line_of(out, est, src, toks, base);
        let e = b")]";
        emit_bytes(out, est, &e);
    } else if k == 72 {
        emit_arr_name(out, est, src, toks, nodes[nodes[n].a].a, b'n');
    } else if k == 73 {
        // `&xs` and `&mut xs` are *two* arguments, the pointer and the length
        emit_arr_name(out, est, src, toks, nodes[nodes[n].a].a, b'p');
        let c = b", ";
        emit_bytes(out, est, &c);
        emit_arr_name(out, est, src, toks, nodes[nodes[n].a].a, b'n');
    } else if k == 66 {
        // a `u8` arithmetic result is truncated back to `u8`, as the Rust emitter truncates it
        let narrow = ntys[n] >= 0 && types[ntys[n]].kind == 3 && nodes[n].ival <= 4;
        if narrow { let s = b"((uint8_t)"; emit_bytes(out, est, &s); };
        emit_b(out, est, b'(');
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].a);
        emit_op(out, est, nodes[n].ival);
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].b);
        emit_b(out, est, b')');
        if narrow { emit_b(out, est, b')'); };
    } else if k == 67 {
        emit_b(out, est, b'(');
        if nodes[n].ival == 0 { emit_b(out, est, b'-'); } else { emit_b(out, est, b'!'); };
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].a);
        emit_b(out, est, b')');
    } else if k == 74 {
        let s = b"((";
        emit_bytes(out, est, &s);
        emit_type(out, est, src, toks, types, strs, ntys[n]);
        emit_b(out, est, b')');
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].a);
        emit_b(out, est, b')');
    } else if k == 69 {
        emit_b(out, est, b'(');
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].a);
        let s = b").";
        emit_bytes(out, est, &s);
        emit_span(out, est, src, toks, nodes[n].b);
    } else if k == 70 {
        // a compound literal with designated initialisers, so the source's field order is free —
        // C gives `{ .y = 2, .x = 1 }` the same meaning whichever way round it is written
        let s = b"((struct nt_";
        emit_bytes(out, est, &s);
        emit_span(out, est, src, toks, nodes[n].a);
        let o = b"){";
        emit_bytes(out, est, &o);
        let mut fi = nodes[n].b;
        while fi >= 0 {
            emit_b(out, est, b'.');
            emit_span(out, est, src, toks, nodes[fi].a);
            let eq = b" = ";
            emit_bytes(out, est, &eq);
            emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[fi].b);
            fi = nodes[fi].next;
            if fi >= 0 { let c = b", "; emit_bytes(out, est, &c); };
        }
        let c = b"})";
        emit_bytes(out, est, &c);
    } else if k == 71 {
        emit_call(out, est, src, toks, nodes, types, strs, sigs, ntys, n);
    } else if k == 75 || k == 76 {
        emit_value_block(out, est, src, toks, nodes, types, strs, sigs, ntys, n);
    }
}

// whether this name is an `extern fn`. The signature table is in declaration order and its names
// are tokens, so this is the same byte comparison every other name lookup is.
fn is_extern(src: &[u8], toks: &[Token], sigs: &[Sig], name: i64) -> bool {
    let mut i = 0;
    let mut found = false;
    while i < sigs.len() && sigs[i].name >= 0 {
        if sigs[i].ext == 1 && name_eq(src, toks, sigs[i].name, name) { found = true; }
        i += 1;
    }
    found
}

// `println` by the argument's type, `min`/`max` without evaluating an argument twice, and
// everything else as a call of `ntu_<name>`
fn emit_call(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], nodes: &[Node],
             types: &[Ty], strs: &[Str], sigs: &[Sig], ntys: &[i64], n: i64) {
    let name = nodes[n].a;
    let arg = nodes[n].b;
    if name_is_println(src, toks, name) {
        let t = ntys[arg];
        let kk = if t < 0 { 0 } else { types[t].kind };
        if kk == 1 { let s = b"nt_println_f64("; emit_bytes(out, est, &s); }
        else if kk == 2 { let s = b"nt_println_bool("; emit_bytes(out, est, &s); }
        else if kk == 3 { let s = b"nt_println_u8("; emit_bytes(out, est, &s); }
        else { let s = b"nt_println_i64("; emit_bytes(out, est, &s); };
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, arg);
        emit_b(out, est, b')');
        return;
    }
    if name_is_min(src, toks, name) || name_is_max(src, toks, name) {
        let second = nodes[arg].next;
        let a = est[1];
        let b = a + 1;
        est[1] = b + 1;
        let open = b"({ ";
        emit_bytes(out, est, &open);
        emit_type(out, est, src, toks, types, strs, ntys[arg]);
        emit_b(out, est, b' ');
        emit_tmp_name(out, est, a);
        let eq = b" = ";
        emit_bytes(out, est, &eq);
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, arg);
        let semi = b"; ";
        emit_bytes(out, est, &semi);
        emit_type(out, est, src, toks, types, strs, ntys[second]);
        emit_b(out, est, b' ');
        emit_tmp_name(out, est, b);
        emit_bytes(out, est, &eq);
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, second);
        emit_bytes(out, est, &semi);
        emit_tmp_name(out, est, a);
        if name_is_min(src, toks, name) { let s = b" < "; emit_bytes(out, est, &s); }
        else { let s = b" > "; emit_bytes(out, est, &s); };
        emit_tmp_name(out, est, b);
        let q = b" ? ";
        emit_bytes(out, est, &q);
        emit_tmp_name(out, est, a);
        let c = b" : ";
        emit_bytes(out, est, &c);
        emit_tmp_name(out, est, b);
        let close = b"; })";
        emit_bytes(out, est, &close);
        return;
    }
    // an `extern fn` is called by the C name it declares; everything else by its `ntu_` one
    if !is_extern(src, toks, sigs, name) { let pre = b"ntu_"; emit_bytes(out, est, &pre); };
    emit_span(out, est, src, toks, name);
    emit_b(out, est, b'(');
    let mut a = arg;
    while a >= 0 {
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, a);
        a = nodes[a].next;
        if a >= 0 { let s = b", "; emit_bytes(out, est, &s); };
    }
    emit_b(out, est, b')');
}

// an `if` or a block *as a value*: a statement expression holding a temporary, which is how the
// Rust emitter does it too (and why the output only ever targets gcc and clang)
fn emit_value_block(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], nodes: &[Node],
                    types: &[Ty], strs: &[Str], sigs: &[Sig], ntys: &[i64], n: i64) {
    let t = ntys[n];
    let unit = t < 0 || types[t].kind == 4;
    let tmp = est[1];
    est[1] = tmp + 1;
    let open = b"({ ";
    emit_bytes(out, est, &open);
    if !unit {
        emit_type(out, est, src, toks, types, strs, t);
        emit_b(out, est, b' ');
        emit_tmp_name(out, est, tmp);
        let s = b"; ";
        emit_bytes(out, est, &s);
    };
    let target = if unit { -1 } else { tmp };
    if nodes[n].kind == 75 {
        emit_if(out, est, src, toks, nodes, types, strs, sigs, ntys, n, target);
    } else {
        emit_block(out, est, src, toks, nodes, types, strs, sigs, ntys, n, target);
    };
    if !unit {
        emit_b(out, est, b' ');
        emit_tmp_name(out, est, tmp);
        emit_b(out, est, b';');
    };
    let close = b" })";
    emit_bytes(out, est, &close);
}

// `if (c) { … } else { … }`, each arm's value assigned to `target` when there is one
fn emit_if(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], nodes: &[Node],
           types: &[Ty], strs: &[Str], sigs: &[Sig], ntys: &[i64], n: i64, target: i64) {
    let s = b"if (";
    emit_bytes(out, est, &s);
    emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].a);
    let c = b") ";
    emit_bytes(out, est, &c);
    emit_block(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].b, target);
    if nodes[n].c >= 0 {
        let e = b" else ";
        emit_bytes(out, est, &e);
        emit_block(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].c, target);
    };
}

// `let ys = xs`: a fresh allocation and a copy of the elements
fn emit_let_array_copy(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], nodes: &[Node],
                       types: &[Ty], strs: &[Str], sigs: &[Sig], ntys: &[i64], name: i64,
                       from: i64, t: i64) {
    let n1 = b"int64_t ";
    emit_bytes(out, est, &n1);
    emit_arr_name(out, est, src, toks, name, b'n');
    let eq = b" = ";
    emit_bytes(out, est, &eq);
    emit_arr_name(out, est, src, toks, from, b'n');
    let semi = b"; ";
    emit_bytes(out, est, &semi);
    emit_type(out, est, src, toks, types, strs, t);
    let star = b" *";
    emit_bytes(out, est, &star);
    emit_arr_name(out, est, src, toks, name, b'p');
    let al = b" = nt_alloc(";
    emit_bytes(out, est, &al);
    emit_arr_name(out, est, src, toks, name, b'n');
    let sz = b", sizeof(";
    emit_bytes(out, est, &sz);
    emit_type(out, est, src, toks, types, strs, t);
    let cl = b")); memcpy(";
    emit_bytes(out, est, &cl);
    emit_arr_name(out, est, src, toks, name, b'p');
    let c = b", ";
    emit_bytes(out, est, &c);
    emit_arr_name(out, est, src, toks, from, b'p');
    emit_bytes(out, est, &c);
    let st = b"(size_t)";
    emit_bytes(out, est, &st);
    emit_arr_name(out, est, src, toks, name, b'n');
    let so = b" * sizeof(";
    emit_bytes(out, est, &so);
    emit_type(out, est, src, toks, types, strs, t);
    let end = b"));";
    emit_bytes(out, est, &end);
}

// `let xs = <array>`: the two names, from the two forms the slice takes (arrays design §3). A
// byte string becomes a C string literal, which is both shorter than a brace list and the thing C
// is good at; `[e; n]` becomes `nt_alloc` and a fill loop, as it does in the Rust emitter.
fn emit_let_array(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], nodes: &[Node],
                  types: &[Ty], strs: &[Str], sigs: &[Sig], ntys: &[i64], n: i64) {
    let name = nodes[n].a;
    let init = nodes[n].c;
    let t = ntys[init];
    if nodes[init].kind == 64 {
        // `let mut s = b"…"` is written to, so it cannot live in `.rodata`: a mutable binding gets
        // an automatic array, which C initialises from the literal on every entry. An immutable
        // one keeps the `static const` that a string literal wants to be.
        let is_mut = nodes[n].ival == 1;
        if is_mut { let m = b"uint8_t "; emit_bytes(out, est, &m); }
        else { let c = b"static const uint8_t "; emit_bytes(out, est, &c); };
        emit_arr_name(out, est, src, toks, name, b'b');
        let s2 = b"[] = \"";
        emit_bytes(out, est, &s2);
        emit_span(out, est, src, toks, nodes[init].a);
        let q = b"\"; ";
        emit_bytes(out, est, &q);
        if is_mut { let m = b"uint8_t *"; emit_bytes(out, est, &m); }
        else { let c = b"const uint8_t *"; emit_bytes(out, est, &c); };
        emit_arr_name(out, est, src, toks, name, b'p');
        let eq = b" = ";
        emit_bytes(out, est, &eq);
        emit_arr_name(out, est, src, toks, name, b'b');
        let s4 = b"; int64_t ";
        emit_bytes(out, est, &s4);
        emit_arr_name(out, est, src, toks, name, b'n');
        emit_bytes(out, est, &eq);
        // the length is the span's, not `strlen`'s: `lex.nt` does not decode escapes inside
        // `b"…"`, so a `\n` in the source is two bytes of span and one byte of C string, and only
        // the C compiler knows which. `sizeof` of the array, minus its terminator, is that answer.
        let s5 = b"(int64_t)(sizeof(";
        emit_bytes(out, est, &s5);
        emit_arr_name(out, est, src, toks, name, b'b');
        let s6 = b") - 1);";
        emit_bytes(out, est, &s6);
        return;
    }
    // `let v = &xs` binds a view, and a view *is* an alias: the two names are copied and no
    // element is. `let ys = xs` is the other case and copies the elements, for the reason the
    // whole-array assignment above copies them.
    let is_ref = nodes[init].kind == 73 && nodes[nodes[init].a].kind == 65;
    if nodes[init].kind == 65 {
        emit_let_array_copy(out, est, src, toks, nodes, types, strs, sigs, ntys, name, nodes[init].a, t);
        return;
    }
    if is_ref {
        let from = nodes[nodes[init].a].a;
        if types[t].mutable == 0 { let c = b"const "; emit_bytes(out, est, &c); };
        emit_type(out, est, src, toks, types, strs, t);
        let star = b" *";
        emit_bytes(out, est, &star);
        emit_arr_name(out, est, src, toks, name, b'p');
        let eq = b" = ";
        emit_bytes(out, est, &eq);
        emit_arr_name(out, est, src, toks, from, b'p');
        let n1 = b"; int64_t ";
        emit_bytes(out, est, &n1);
        emit_arr_name(out, est, src, toks, name, b'n');
        emit_bytes(out, est, &eq);
        emit_arr_name(out, est, src, toks, from, b'n');
        emit_b(out, est, b';');
        return;
    }
    if nodes[init].kind != 77 && nodes[init].kind != 78 && nodes[init].kind != 64 {
        // anything else — a call returning an array, a chain — is outside the slice. Saying so
        // costs one flag and is the difference between a refusal and a C file that looks fine
        // until `cc` reads it.
        est[2] = 1;
        return;
    }
    if nodes[init].kind == 77 {
        // a brace list becomes a C brace list; `sizeof` divides out the length, so the count is
        // never written twice and never disagrees with what is there
        emit_type(out, est, src, toks, types, strs, t);
        emit_b(out, est, b' ');
        emit_arr_name(out, est, src, toks, name, b'b');
        let ob = b"[] = {";
        emit_bytes(out, est, &ob);
        let mut e = nodes[init].a;
        while e >= 0 {
            emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, e);
            e = nodes[e].next;
            if e >= 0 { let c = b", "; emit_bytes(out, est, &c); };
        }
        let cb = b"}; ";
        emit_bytes(out, est, &cb);
        emit_type(out, est, src, toks, types, strs, t);
        let star = b" *";
        emit_bytes(out, est, &star);
        emit_arr_name(out, est, src, toks, name, b'p');
        let eq = b" = ";
        emit_bytes(out, est, &eq);
        emit_arr_name(out, est, src, toks, name, b'b');
        let n1 = b"; int64_t ";
        emit_bytes(out, est, &n1);
        emit_arr_name(out, est, src, toks, name, b'n');
        emit_bytes(out, est, &eq);
        let sz = b"(int64_t)(sizeof(";
        emit_bytes(out, est, &sz);
        emit_arr_name(out, est, src, toks, name, b'b');
        let d = b") / sizeof(";
        emit_bytes(out, est, &d);
        emit_type(out, est, src, toks, types, strs, t);
        let end = b"));";
        emit_bytes(out, est, &end);
        return;
    }
    let nm = b"int64_t ";
    emit_bytes(out, est, &nm);
    emit_arr_name(out, est, src, toks, name, b'n');
    let eq = b" = ";
    emit_bytes(out, est, &eq);
    emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[init].b);
    let semi = b"; ";
    emit_bytes(out, est, &semi);
    emit_type(out, est, src, toks, types, strs, t);
    let star = b" *";
    emit_bytes(out, est, &star);
    emit_arr_name(out, est, src, toks, name, b'p');
    let al = b" = nt_alloc(";
    emit_bytes(out, est, &al);
    emit_arr_name(out, est, src, toks, name, b'n');
    let sz = b", sizeof(";
    emit_bytes(out, est, &sz);
    emit_type(out, est, src, toks, types, strs, t);
    let close = b")); ";
    emit_bytes(out, est, &close);
    // the fill: the element is evaluated once, as `[e; n]` says it is
    let k = est[1];
    est[1] = k + 1;
    let ob = b"{ ";
    emit_bytes(out, est, &ob);
    emit_type(out, est, src, toks, types, strs, t);
    emit_b(out, est, b' ');
    emit_tmp_name(out, est, k);
    emit_bytes(out, est, &eq);
    emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[init].a);
    emit_bytes(out, est, &semi);
    let f1 = b"for (int64_t nt_i";
    emit_bytes(out, est, &f1);
    emit_int(out, est, k);
    let f2 = b" = 0; nt_i";
    emit_bytes(out, est, &f2);
    emit_int(out, est, k);
    let f3 = b" < ";
    emit_bytes(out, est, &f3);
    emit_arr_name(out, est, src, toks, name, b'n');
    let f4 = b"; nt_i";
    emit_bytes(out, est, &f4);
    emit_int(out, est, k);
    let f5 = b"++) ";
    emit_bytes(out, est, &f5);
    emit_arr_name(out, est, src, toks, name, b'p');
    let f6 = b"[nt_i";
    emit_bytes(out, est, &f6);
    emit_int(out, est, k);
    let f7 = b"] = ";
    emit_bytes(out, est, &f7);
    emit_tmp_name(out, est, k);
    let f8 = b"; }";
    emit_bytes(out, est, &f8);
}

// ---- statements ----

// `{ … }`: the statements, then the tail, assigned to `target` when the block has a value
fn emit_block(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], nodes: &[Node],
              types: &[Ty], strs: &[Str], sigs: &[Sig], ntys: &[i64], n: i64, target: i64) {
    let o = b"{ ";
    emit_bytes(out, est, &o);
    let mut s = nodes[n].a;
    while s >= 0 {
        emit_stmt(out, est, src, toks, nodes, types, strs, sigs, ntys, s);
        emit_b(out, est, b' ');
        s = nodes[s].next;
    }
    if nodes[n].b >= 0 {
        if target >= 0 {
            emit_tmp_name(out, est, target);
            let eq = b" = ";
            emit_bytes(out, est, &eq);
        };
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].b);
        let semi = b"; ";
        emit_bytes(out, est, &semi);
    }
    emit_b(out, est, b'}');
}

fn emit_stmt(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], nodes: &[Node],
             types: &[Ty], strs: &[Str], sigs: &[Sig], ntys: &[i64], n: i64) {
    let k = nodes[n].kind;
    if k == 90 {
        let t = ntys[nodes[n].c];
        if is_arr(types, t) {
            emit_let_array(out, est, src, toks, nodes, types, strs, sigs, ntys, n);
            return;
        }
        emit_type(out, est, src, toks, types, strs, t);
        emit_b(out, est, b' ');
        emit_span(out, est, src, toks, nodes[n].a);
        let eq = b" = ";
        emit_bytes(out, est, &eq);
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].c);
        emit_b(out, est, b';');
    } else if k == 91 {
        // `ys = xs` on whole arrays **copies**. Assigning the pointer instead is what the Rust
        // compiler does when it can prove nothing else is looking at `xs` — that proof is M5's
        // move and uniqueness checking, which is not in this slice. Copying is the language's
        // meaning; aliasing is the optimisation, and an emitter that cannot tell must not take it.
        // `reassign_copy.nt` is the golden that tells the two apart.
        if nodes[nodes[n].a].kind == 65 && nodes[nodes[n].b].kind == 65 && is_arr(types, ntys[nodes[n].a]) {
            let l = nodes[nodes[n].a].a;
            let r = nodes[nodes[n].b].a;
            let mc = b"memcpy(";
            emit_bytes(out, est, &mc);
            emit_arr_name(out, est, src, toks, l, b'p');
            let c = b", ";
            emit_bytes(out, est, &c);
            emit_arr_name(out, est, src, toks, r, b'p');
            emit_bytes(out, est, &c);
            let sz = b"(size_t)";
            emit_bytes(out, est, &sz);
            emit_arr_name(out, est, src, toks, r, b'n');
            let so = b" * sizeof(";
            emit_bytes(out, est, &so);
            emit_type(out, est, src, toks, types, strs, ntys[nodes[n].a]);
            let cl = b")); ";
            emit_bytes(out, est, &cl);
            emit_arr_name(out, est, src, toks, l, b'n');
            let eq = b" = ";
            emit_bytes(out, est, &eq);
            emit_arr_name(out, est, src, toks, r, b'n');
            emit_b(out, est, b';');
            return;
        }
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].a);
        emit_b(out, est, b' ');
        if nodes[n].ival >= 0 { emit_op(out, est, nodes[n].ival); };
        let eq = b"= ";
        emit_bytes(out, est, &eq);
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].b);
        emit_b(out, est, b';');
    } else if k == 92 {
        // the end of the range is evaluated once, as the language says it is
        let f = b"for (int64_t ";
        emit_bytes(out, est, &f);
        emit_span(out, est, src, toks, nodes[n].a);
        let eq = b" = ";
        emit_bytes(out, est, &eq);
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].b);
        let e2 = b", nt_e";
        emit_bytes(out, est, &e2);
        let lim = est[1];
        est[1] = lim + 1;
        emit_int(out, est, lim);
        emit_bytes(out, est, &eq);
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].c);
        let sep = b"; ";
        emit_bytes(out, est, &sep);
        emit_span(out, est, src, toks, nodes[n].a);
        let lt = b" < nt_e";
        emit_bytes(out, est, &lt);
        emit_int(out, est, lim);
        emit_bytes(out, est, &sep);
        emit_span(out, est, src, toks, nodes[n].a);
        let inc = b"++) ";
        emit_bytes(out, est, &inc);
        emit_block(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].d, -1);
    } else if k == 93 {
        let w = b"while (";
        emit_bytes(out, est, &w);
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].a);
        let c = b") ";
        emit_bytes(out, est, &c);
        emit_block(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].c, -1);
    } else if k == 94 {
        let b2 = b"break;";
        emit_bytes(out, est, &b2);
    } else if k == 95 {
        let e = nodes[n].a;
        let ek = nodes[e].kind;
        // an `if` or a block in statement position is a statement, not a statement expression
        if ek == 75 {
            emit_if(out, est, src, toks, nodes, types, strs, sigs, ntys, e, -1);
        } else if ek == 76 {
            emit_block(out, est, src, toks, nodes, types, strs, sigs, ntys, e, -1);
        } else {
            emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, e);
            emit_b(out, est, b';');
        }
    } else if k == 96 {
        let r = b"return";
        emit_bytes(out, est, &r);
        if nodes[n].a >= 0 {
            emit_b(out, est, b' ');
            emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[n].a);
        };
        emit_b(out, est, b';');
    }
}

// ---- functions and the whole file ----

fn emit_signature(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], nodes: &[Node],
                  types: &[Ty], strs: &[Str], sigs: &[Sig], ptys: &[i64], si: i64, f: i64) {
    // an `extern fn` names a C symbol that already exists (`bootstrap/rt.c`), so it is neither
    // `static` nor `ntu_`-prefixed — the prefix exists to keep *our* names off the runtime's
    let ext = nodes[f].kind == 116;
    if !ext { let st = b"static "; emit_bytes(out, est, &st); };
    emit_type(out, est, src, toks, types, strs, sigs[si].ret);
    emit_b(out, est, b' ');
    if !ext { let pre = b"ntu_"; emit_bytes(out, est, &pre); };
    emit_span(out, est, src, toks, nodes[f].a);
    emit_b(out, est, b'(');
    let mut p = nodes[f].b;
    let mut k = 0;
    if p < 0 { let v = b"void"; emit_bytes(out, est, &v); };
    while p >= 0 {
        let pt = ptys[sigs[si].params + k];
        if is_arr(types, pt) {
            // two C parameters, and `const` when the view does not allow writing
            if types[pt].kind == 6 && types[pt].mutable == 0 { let c = b"const "; emit_bytes(out, est, &c); };
            emit_type(out, est, src, toks, types, strs, pt);
            let star = b" *";
            emit_bytes(out, est, &star);
            emit_arr_name(out, est, src, toks, nodes[p].a, b'p');
            let ln = b", int64_t ";
            emit_bytes(out, est, &ln);
            emit_arr_name(out, est, src, toks, nodes[p].a, b'n');
        } else {
            emit_type(out, est, src, toks, types, strs, pt);
            emit_b(out, est, b' ');
            emit_span(out, est, src, toks, nodes[p].a);
        }
        k += 1;
        p = nodes[p].next;
        if p >= 0 { let s = b", "; emit_bytes(out, est, &s); };
    }
    emit_b(out, est, b')');
}

fn emit_func(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], nodes: &[Node],
             types: &[Ty], strs: &[Str], sigs: &[Sig], ntys: &[i64], ptys: &[i64], si: i64, f: i64) {
    emit_signature(out, est, src, toks, nodes, types, strs, sigs, ptys, si, f);
    let s = b" {\n";
    emit_bytes(out, est, &s);
    let body = nodes[f].d;
    let mut st = nodes[body].a;
    while st >= 0 {
        let sp = b"    ";
        emit_bytes(out, est, &sp);
        emit_stmt(out, est, src, toks, nodes, types, strs, sigs, ntys, st);
        emit_b(out, est, b'\n');
        st = nodes[st].next;
    }
    if nodes[body].b >= 0 {
        let sp = b"    ";
        emit_bytes(out, est, &sp);
        // a body's value is its return, unless the function returns nothing
        if sigs[si].ret != 4 { let r = b"return "; emit_bytes(out, est, &r); };
        emit_expr(out, est, src, toks, nodes, types, strs, sigs, ntys, nodes[body].b);
        let e = b";\n";
        emit_bytes(out, est, &e);
    }
    let c = b"}\n\n";
    emit_bytes(out, est, &c);
}

// one C struct per `struct`, in declaration order, so the layout is C's — the same choice the
// Rust emitter makes. Field types come from the checker's table, not the parse tree, so a field
// spelled in a way the checker refused never reaches here.
fn emit_structs(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], nodes: &[Node],
                types: &[Ty], strs: &[Str], flds: &[Fld], first: i64) {
    let mut f = first;
    let mut si = 0;
    while f >= 0 {
        if nodes[f].kind == 112 {
            let s = b"struct nt_";
            emit_bytes(out, est, &s);
            emit_span(out, est, src, toks, strs[si].name);
            let o = b" {\n";
            emit_bytes(out, est, &o);
            let mut k = 0;
            while k < strs[si].n_fields {
                let sp = b"    ";
                emit_bytes(out, est, &sp);
                emit_type(out, est, src, toks, types, strs, flds[strs[si].fields + k].ty);
                emit_b(out, est, b' ');
                emit_span(out, est, src, toks, flds[strs[si].fields + k].name);
                let e = b";\n";
                emit_bytes(out, est, &e);
                k += 1;
            }
            let c = b"};\n\n";
            emit_bytes(out, est, &c);
            si += 1;
        }
        f = nodes[f].next;
    }
}

// the whole C file: the prelude, the structs, every prototype, every body, and the entry point
fn emit_program(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], nodes: &[Node],
                types: &[Ty], strs: &[Str], flds: &[Fld], ntys: &[i64], sigs: &[Sig], ptys: &[i64],
                first: i64) -> i64 {
    let p1 = b"// generated by the self-hosted neant compiler (compiler/emit.nt)\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <string.h>\n\n";
    emit_bytes(out, est, &p1);
    let p2 = b"static void nt_println_i64(int64_t v) { printf(\"%lld\\n\", (long long)v); }\nstatic void nt_println_bool(bool v) { puts(v ? \"true\" : \"false\"); }\nstatic void nt_println_u8(uint8_t v) { printf(\"%u\\n\", (unsigned)v); }\n";
    emit_bytes(out, est, &p2);
    let p3 = b"static void nt_println_f64(double v) {\n    char buf[400];\n    if (v != v) { puts(\"NaN\"); return; }\n    if (v == 1.0 / 0.0) { puts(\"inf\"); return; }\n    if (v == -1.0 / 0.0) { puts(\"-inf\"); return; }\n    int prec = 0;\n    for (; prec < 17; prec++) {\n        snprintf(buf, sizeof buf, \"%.*e\", prec, v);\n        if (strtod(buf, NULL) == v) break;\n    }\n    int exp10 = atoi(strchr(buf, 'e') + 1);\n    int decimals = prec - exp10;\n    if (decimals < 0) decimals = 0;\n    snprintf(buf, sizeof buf, \"%.*f\", decimals, v);\n    if (!strchr(buf, '.')) strcat(buf, \".0\");\n    puts(buf);\n}\n\n";
    emit_bytes(out, est, &p3);
    let p4 = b"static void *nt_alloc(int64_t n, size_t sz) {\n    void *p = malloc(n == 0 ? 1 : (size_t)n * sz);\n    if (!p) { fprintf(stderr, \"out of memory\\n\"); exit(101); }\n    return p;\n}\nstatic inline int64_t nt_idx(int64_t i, int64_t n, int line) {\n    if ((uint64_t)i >= (uint64_t)n) {\n        fprintf(stderr, \"index %lld out of bounds for length %lld (line %d)\\n\", (long long)i, (long long)n, line);\n        exit(101);\n    }\n    return i;\n}\n\n";
    emit_bytes(out, est, &p4);
    emit_structs(out, est, src, toks, nodes, types, strs, flds, first);
    let mut f = first;
    let mut si = 0;
    while f >= 0 {
        // the item list interleaves structs, which have no signature and no body
        if nodes[f].kind == 110 || nodes[f].kind == 116 {
            emit_signature(out, est, src, toks, nodes, types, strs, sigs, ptys, si, f);
            let s = b";\n";
            emit_bytes(out, est, &s);
            si += 1;
        }
        f = nodes[f].next;
    }
    emit_b(out, est, b'\n');
    f = first;
    si = 0;
    while f >= 0 {
        if nodes[f].kind == 110 {
            emit_func(out, est, src, toks, nodes, types, strs, sigs, ntys, ptys, si, f);
            si += 1;
        } else if nodes[f].kind == 116 {
            si += 1;
        }
        f = nodes[f].next;
    }
    let m = b"int main(void) { ntu_main(); return 0; }\n";
    emit_bytes(out, est, &m);
    // a negative length is a refusal, not a short file: est[2] is set where the emitter met
    // something outside its slice, and the caller must not write what is in the buffer
    if est[2] != 0 { return -3; }
    est[0]
}
