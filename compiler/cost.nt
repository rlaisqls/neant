// The cost calculus, first slice: `work` as a polynomial, over the parse tree
// (docs/self-hosting-cost-design.md). A fragment; the concatenation order is lex, parse, check,
// emit, poly, this, main — it uses `emit.nt`'s byte-writing helpers rather than growing its own,
// and `poly.nt`'s arenas for the arithmetic.
//
// **The work table is copied from `bootstrap/src/cost/analyze.rs`, entry for entry**, because the
// exit test is string equality with what that file computes. 1 for a binary operator, 1 for a
// unary or a cast, 2 for `min`/`max` (compare, select), 1 for `println`, 2 for a call (call and
// return; arguments are register moves), 1 for an index, 2 per `for` iteration (increment,
// compare-and-branch), the element count for an array literal. An assignment costs 1 through an
// index and 0 into a register, unless it is compound.
//
// Out of this slice (design §2): moves, regimes, recurrences (`while`, self-recursion), span,
// bounds, layout. Each reports **unknown** rather than a number, which is the one thing a cost
// calculus must do when it does not know.
//
// Atoms carry the Rust compiler's own numbering, because both the canonical order of a monomial
// and the order factors print in follow it: `B` is 0, `M` is 1, `P` is 2, and the current
// function's parameter `i` is `3 + i` — an array parameter's atom is its length, which is why it
// prints as `xs.len()`. A loop variable gets an atom above 1000, which `pol_sum_over` eliminates
// before anything is printed.
//
// `wst` is this pass's state:
//   wst[0] environment length   wst[1] unknown flag   wst[2] next loop atom
//   wst[3] the current function's parameter count

// `root` is the array a name ultimately refers to: `let v = &xs` roots `v` at `xs`, which is
// what lets a call over `v` be credited against what a call over `xs` left resident.
struct Env { name: i64, val: i64, len: i64, root: i64 }

// ---- the environment: what a local's value, or an array local's length, is known to be ----

fn env_find(src: &[u8], toks: &[Token], env: &[Env], wst: &[i64], name: i64) -> i64 {
    let mut i = wst[0] - 1;
    let mut found = -1;
    while i >= 0 {
        if found < 0 && name_eq(src, toks, env[i].name, name) { found = i; }
        i -= 1;
    }
    found
}

fn env_add(env: &mut [Env], wst: &mut [i64], name: i64, val: i64, len: i64) {
    env_add_rooted(env, wst, name, val, len, name);
}

fn env_add_rooted(env: &mut [Env], wst: &mut [i64], name: i64, val: i64, len: i64, root: i64) {
    let i = wst[0];
    env[i].name = name;
    env[i].val = val;
    env[i].len = len;
    env[i].root = root;
    wst[0] = i + 1;
}

// the array a name ultimately refers to, or the name itself
fn env_root(src: &[u8], toks: &[Token], env: &[Env], wst: &[i64], name: i64) -> i64 {
    let e = env_find(src, toks, env, wst, name);
    if e < 0 { return name; }
    env[e].root
}

// The polynomial an expression evaluates to, or −1 when it is not a size expression. Only the
// shapes a loop bound or an array length is written in: a literal, a known local, a `.len()`, and
// the three operators that keep a polynomial a polynomial.
fn val_of(src: &[u8], toks: &[Token], nodes: &[Node], facs: &mut [Fac], terms: &mut [Term],
          pols: &mut [Pol], pst: &mut [i64], env: &[Env], wst: &[i64], n: i64) -> i64 {
    if n < 0 { return -1; }
    let k = nodes[n].kind;
    if k == 60 { return pol_const(facs, terms, pols, pst, int_value(src, toks, nodes[n].a)); }
    if k == 65 {
        let e = env_find(src, toks, env, wst, nodes[n].a);
        if e < 0 { return -1; }
        return env[e].val;
    }
    if k == 72 {
        if nodes[nodes[n].a].kind != 65 { return -1; }
        let e = env_find(src, toks, env, wst, nodes[nodes[n].a].a);
        if e < 0 { return -1; }
        return env[e].len;
    }
    if k == 67 {
        // unary minus, which a loop bound reaches through `0 - n` more often than `-n`
        if nodes[n].ival != 0 { return -1; }
        let a = val_of(src, toks, nodes, facs, terms, pols, pst, env, wst, nodes[n].a);
        if a < 0 { return -1; }
        return pol_scale(facs, terms, pols, pst, a, 0 - 1, 1);
    }
    if k == 66 {
        let op = nodes[n].ival;
        if op > 3 { return -1; }
        let a = val_of(src, toks, nodes, facs, terms, pols, pst, env, wst, nodes[n].a);
        if a < 0 { return -1; }
        let b = val_of(src, toks, nodes, facs, terms, pols, pst, env, wst, nodes[n].b);
        if b < 0 { return -1; }
        if op == 0 { return pol_add(facs, terms, pols, pst, a, b); }
        if op == 1 { return pol_sub(facs, terms, pols, pst, a, b); }
        if op == 2 { return pol_mul(facs, terms, pols, pst, a, b); }
        // `n / 4` is a size expression when the divisor is a constant — `0..n/4` is how a tiled
        // loop is written, and it is where a rational coefficient enters from the source rather
        // than from Faulhaber. A non-constant divisor is not a polynomial and is refused.
        let d = pol_as_int(facs, terms, pols, pst, b);
        if pst[4] == 0 || d == 0 { return -1; }
        return pol_scale(facs, terms, pols, pst, a, 1, d);
    }
    -1
}

// ---- `if` is the larger branch, which needs a comparison ----

// Does `q` dominate `p` — is `q` at least `p` for every assignment of sizes ≥ 1? Both halves of
// `piece::dominates`. The easy one: every coefficient of `q − p` is non-negative. The other: give
// each positive term of `q` a budget and let the terms of `p` consume the budgets of monomials
// that *cover* them, largest first. That is what lets `64·n − 64` dominate `n`, which is the
// comparison the arena fork turns on, and the budget arithmetic is `f64` here because it is `f64`
// in the Rust and this has to agree with it.
fn mono_covers(facs: &[Fac], big: i64, nb: i64, small: i64, ns: i64) -> bool {
    let mut i = 0;
    let mut ok = true;
    while i < ns {
        let e = mono_exp(facs, big, nb, facs[small + i].atom);
        if e < facs[small + i].exp { ok = false; }
        i += 1;
    }
    let mut j = 0;
    while j < nb {
        let e = mono_exp(facs, small, ns, facs[big + j].atom);
        if facs[big + j].exp < e { ok = false; }
        j += 1;
    }
    ok
}

fn pol_dominates(facs: &[Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64],
                 budget: &mut [f64], q: i64, p: i64) -> bool {
    let d = pol_sub(facs, terms, pols, pst, q, p);
    let mut i = 0;
    let mut easy = true;
    while i < pols[d].n_term {
        if terms[pols[d].term + i].cn < 0 { easy = false; }
        i += 1;
    }
    if easy { return true; }
    // budgets, one per positive term of `q`
    let mut nb = 0;
    i = 0;
    while i < pols[q].n_term {
        let t = pols[q].term + i;
        budget[i] = if terms[t].cn > 0 { (terms[t].cn as f64) / (terms[t].cd as f64) } else { 0.0 };
        nb += 1;
        i += 1;
    }
    // `p`'s terms largest first, so a big one takes the budget it needs before a small one spends it
    let mut ok = true;
    let mut x = pols[p].n_term - 1;
    while x >= 0 {
        let tp = pols[p].term + x;
        let need0 = (terms[tp].cn as f64) / (terms[tp].cd as f64);
        if need0 > 0.0 {
            let mut need = need0;
            let mut k = 0;
            while k < nb {
                let tq = pols[q].term + k;
                if budget[k] > 0.0 && need > 0.0
                    && mono_covers(facs, terms[tq].fac, terms[tq].n_fac, terms[tp].fac, terms[tp].n_fac) {
                    let take = if need < budget[k] { need } else { budget[k] };
                    budget[k] = budget[k] - take;
                    need = need - take;
                }
                k += 1;
            }
            if need > 0.000000000001 { ok = false; }
        }
        x -= 1;
    }
    ok
}

// the larger of two costs; sets the unknown flag when neither dominates, which is where the Rust
// pass would fork into regimes
fn pol_max(facs: &[Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64], budget: &mut [f64],
           wst: &mut [i64], a: i64, b: i64) -> i64 {
    if pol_dominates(facs, terms, pols, pst, budget, a, b) { return a; }
    if pol_dominates(facs, terms, pols, pst, budget, b, a) { return b; }
    wst[1] = 1;
    a
}

// ---- `while`: the trip count the compiler has to find ----
//
// A `for` says its own trip count; a `while` does not, and there are exactly two ways to get one,
// both copied from `analyze.rs`. Either the programmer wrote `decreasing <measure>`, and the trip
// count is the measure's value at entry — with the promise *checked*, not taken — or the condition
// compares a variable the body steps by a constant, and the trip count is the distance to the
// bound over the step. A `while` that is neither has no static bound and is unknown.

struct Cof { name: i64, c: i64 }

// The measure as a linear form over locals: its coefficients into `cof`, count into wst[7].
// False when the measure is not a linear form, which is the same set of shapes `min_decrease`
// accepts in the Rust one.
fn coef_collect(src: &[u8], toks: &[Token], nodes: &[Node], cof: &mut [Cof], wst: &mut [i64],
                e: i64, sign: i64) -> bool {
    if e < 0 { return false; }
    let k = nodes[e].kind;
    if k == 65 {
        let mut i = 0;
        let mut at = -1;
        while i < wst[7] {
            if at < 0 && name_eq(src, toks, cof[i].name, nodes[e].a) { at = i; }
            i += 1;
        }
        if at < 0 {
            cof[wst[7]].name = nodes[e].a;
            cof[wst[7]].c = sign;
            wst[7] = wst[7] + 1;
        } else {
            cof[at].c = cof[at].c + sign;
        }
        return true;
    }
    if k == 60 || k == 72 { return true; }
    if k == 74 { return coef_collect(src, toks, nodes, cof, wst, nodes[e].a, sign); }
    if k == 66 {
        let op = nodes[e].ival;
        if op == 0 {
            return coef_collect(src, toks, nodes, cof, wst, nodes[e].a, sign)
                && coef_collect(src, toks, nodes, cof, wst, nodes[e].b, sign);
        }
        if op == 1 {
            return coef_collect(src, toks, nodes, cof, wst, nodes[e].a, sign)
                && coef_collect(src, toks, nodes, cof, wst, nodes[e].b, 0 - sign);
        }
        if op == 2 {
            if nodes[nodes[e].a].kind == 60 {
                let c = int_value(src, toks, nodes[nodes[e].a].a);
                return coef_collect(src, toks, nodes, cof, wst, nodes[e].b, sign * c);
            }
            if nodes[nodes[e].b].kind == 60 {
                let c = int_value(src, toks, nodes[nodes[e].b].a);
                return coef_collect(src, toks, nodes, cof, wst, nodes[e].a, sign * c);
            }
            return false;
        }
    }
    false
}

// the constant a statement adds to `name`, or the "not a constant step" marker in wst[8]
fn delta_of(src: &[u8], toks: &[Token], nodes: &[Node], wst: &mut [i64], n: i64) -> i64 {
    wst[8] = 0;
    let op = nodes[n].ival;
    let e = nodes[n].b;
    if op == 0 && nodes[e].kind == 60 { return int_value(src, toks, nodes[e].a); }
    if op == 1 && nodes[e].kind == 60 { return 0 - int_value(src, toks, nodes[e].a); }
    if op < 0 && nodes[e].kind == 66 && nodes[nodes[e].a].kind == 65
        && name_eq(src, toks, nodes[nodes[e].a].a, nodes[nodes[n].a].a)
        && nodes[nodes[e].b].kind == 60 {
        let c = int_value(src, toks, nodes[nodes[e].b].a);
        if nodes[e].ival == 0 { return c; }
        if nodes[e].ival == 1 { return 0 - c; }
    }
    wst[8] = 1;
    0
}

// How far the measure falls along the path through this block that falls the least.
// wst[9]: 0 the block falls through, 1 every path leaves the loop, 2 the body cannot be followed.
fn min_dec(src: &[u8], toks: &[Token], nodes: &[Node], cof: &[Cof], wst: &mut [i64], b: i64) -> i64 {
    wst[9] = 0;
    if b < 0 { return 0; }
    let mut acc = 0;
    let mut s = nodes[b].a;
    let mut tail = false;
    while s >= 0 {
        let k = nodes[s].kind;
        if k == 94 || k == 96 {
            wst[9] = 1;
            return 0;
        }
        if k == 91 && nodes[nodes[s].a].kind == 65 {
            let mut i = 0;
            let mut at = -1;
            while i < wst[7] {
                if at < 0 && cof[i].c != 0 && name_eq(src, toks, cof[i].name, nodes[nodes[s].a].a) { at = i; }
                i += 1;
            }
            if at >= 0 {
                let d = delta_of(src, toks, nodes, wst, s);
                if wst[8] != 0 {
                    wst[9] = 2;
                    return 0;
                }
                // the measure changes by c·d, so it falls by −c·d
                acc = acc - cof[at].c * d;
            }
        } else if k == 95 && nodes[nodes[s].a].kind == 75 {
            let e = nodes[s].a;
            let t = min_dec(src, toks, nodes, cof, wst, nodes[e].b);
            let tk = wst[9];
            if tk == 2 { return 0; }
            let f = min_dec(src, toks, nodes, cof, wst, nodes[e].c);
            let fk = if nodes[e].c < 0 { 0 } else { wst[9] };
            if fk == 2 {
                wst[9] = 2;
                return 0;
            }
            wst[9] = 0;
            if tk == 1 && fk == 1 {
                wst[9] = 1;
                return 0;
            }
            if tk == 1 { acc = acc + f; }
            else if fk == 1 { acc = acc + t; }
            else if t < f { acc = acc + t; }
            else { acc = acc + f; }
        } else if k == 92 || k == 93 {
            // a nested loop may run no laps, so it helps only if it never hurts
            let inner = if k == 92 { nodes[s].d } else { nodes[s].c };
            let d = min_dec(src, toks, nodes, cof, wst, inner);
            let dk = wst[9];
            wst[9] = 0;
            if dk == 2 || (dk == 0 && d < 0) {
                wst[9] = 2;
                return 0;
            }
        }
        s = nodes[s].next;
        if s < 0 && !tail {
            // a block's tail is a statement to this analysis: an `if` in tail position still runs
            tail = true;
            if nodes[b].b >= 0 && nodes[nodes[b].b].kind == 75 {
                let e = nodes[b].b;
                let t = min_dec(src, toks, nodes, cof, wst, nodes[e].b);
                let tk = wst[9];
                let f = min_dec(src, toks, nodes, cof, wst, nodes[e].c);
                let fk = if nodes[e].c < 0 { 0 } else { wst[9] };
                wst[9] = 0;
                if tk == 2 || fk == 2 {
                    wst[9] = 2;
                    return 0;
                }
                if tk == 1 && fk == 1 { wst[9] = 1; }
                else if tk == 1 { acc = acc + f; }
                else if fk == 1 { acc = acc + t; }
                else if t < f { acc = acc + t; }
                else { acc = acc + f; }
            }
        }
    }
    acc
}

// how many times, and by what constant, the body assigns to `name`: the count in wst[4], the step
// in the return, and wst[8] set when a write is not a constant step
fn step_scan(src: &[u8], toks: &[Token], nodes: &[Node], wst: &mut [i64], b: i64, name: i64,
             nested: bool) -> i64 {
    if b < 0 { return 0; }
    let mut found = 0;
    let mut s = nodes[b].a;
    while s >= 0 {
        let k = nodes[s].kind;
        if k == 91 && nodes[nodes[s].a].kind == 65 && name_eq(src, toks, nodes[nodes[s].a].a, name) {
            wst[4] = wst[4] + if nested { 2 } else { 1 };
            let d = delta_of(src, toks, nodes, wst, s);
            if wst[8] != 0 { wst[6] = 1; };
            found = d;
        } else if k == 92 || k == 93 {
            let inner = if k == 92 { nodes[s].d } else { nodes[s].c };
            let d = step_scan(src, toks, nodes, wst, inner, name, true);
            if d != 0 { found = d; };
        } else if k == 95 && nodes[nodes[s].a].kind == 75 {
            let e = nodes[s].a;
            let d1 = step_scan(src, toks, nodes, wst, nodes[e].b, name, nested);
            let d2 = step_scan(src, toks, nodes, wst, nodes[e].c, name, nested);
            if d1 != 0 { found = d1; };
            if d2 != 0 { found = d2; };
        }
        s = nodes[s].next;
    }
    found
}

// does the body assign to any of the measure's or bound's variables
fn assigns_any(src: &[u8], toks: &[Token], nodes: &[Node], cof: &[Cof], wst: &[i64], b: i64,
               skip: i64) -> bool {
    if b < 0 { return false; }
    let mut hit = false;
    let mut s = nodes[b].a;
    while s >= 0 {
        let k = nodes[s].kind;
        if k == 91 && nodes[nodes[s].a].kind == 65 {
            let nm = nodes[nodes[s].a].a;
            if skip < 0 || !name_eq(src, toks, nm, skip) {
                let mut i = 0;
                while i < wst[7] {
                    if name_eq(src, toks, cof[i].name, nm) { hit = true; }
                    i += 1;
                }
            }
        } else if k == 92 || k == 93 {
            let inner = if k == 92 { nodes[s].d } else { nodes[s].c };
            if assigns_any(src, toks, nodes, cof, wst, inner, skip) { hit = true; }
        } else if k == 95 && nodes[nodes[s].a].kind == 75 {
            let e = nodes[s].a;
            if assigns_any(src, toks, nodes, cof, wst, nodes[e].b, skip) { hit = true; }
            if assigns_any(src, toks, nodes, cof, wst, nodes[e].c, skip) { hit = true; }
        }
        s = nodes[s].next;
    }
    hit
}

// ---- the walk ----

fn w_expr(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], ntys: &[i64], sigs: &[Sig],
          fw: &[i64], facs: &mut [Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64],
          env: &mut [Env], wst: &mut [i64], scratch: &mut [i64], cof: &mut [Cof],
          rargs: &mut [i64], budget: &mut [f64], n: i64) -> i64 {
    if n < 0 || wst[1] != 0 { return pol_zero(facs, terms, pols, pst); }
    let k = nodes[n].kind;
    // a literal, a variable, a view and a length are all already in a register
    if k == 60 || k == 61 || k == 62 || k == 63 || k == 64 || k == 65 || k == 72 || k == 73 {
        return pol_zero(facs, terms, pols, pst);
    }
    if k == 66 {
        let a = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[n].a);
        let b = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[n].b);
        let s = pol_add(facs, terms, pols, pst, a, b);
        let one = pol_const(facs, terms, pols, pst, 1);
        return pol_add(facs, terms, pols, pst, s, one);
    }
    if k == 67 || k == 74 {
        let a = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[n].a);
        let one = pol_const(facs, terms, pols, pst, 1);
        return pol_add(facs, terms, pols, pst, a, one);
    }
    if k == 68 {
        // only the index is evaluated: the array is a register pair
        let i = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[n].b);
        let one = pol_const(facs, terms, pols, pst, 1);
        return pol_add(facs, terms, pols, pst, i, one);
    }
    if k == 69 {
        // `xs[i].f` is one load; a field of a value already in registers is free
        let base = nodes[n].a;
        if nodes[base].kind == 68 {
            let i = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[base].b);
            let one = pol_const(facs, terms, pols, pst, 1);
            return pol_add(facs, terms, pols, pst, i, one);
        }
        return w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, base);
    }
    if k == 70 {
        let mut acc = pol_zero(facs, terms, pols, pst);
        let mut fi = nodes[n].b;
        while fi >= 0 {
            let v = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[fi].b);
            acc = pol_add(facs, terms, pols, pst, acc, v);
            fi = nodes[fi].next;
        }
        return acc;
    }
    if k == 71 { return w_call(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, n); }
    if k == 75 {
        let c = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[n].a);
        let one = pol_const(facs, terms, pols, pst, 1);
        let base = pol_add(facs, terms, pols, pst, c, one);
        // **recursive calls are counted along the heavier arm only**, not both: a binary search
        // calls itself once on each side of an `if` and only one of them happens, and counting two
        // would read as two calls per level and come out linear instead of logarithmic. On a tie
        // the else arm's arguments are the ones kept, which is what `analyze.rs` does.
        let before = wst[23];
        let t = w_block(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[n].b);
        let n_then = wst[23] - before;
        wst[23] = before;
        let e = w_block(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[n].c);
        let n_else = wst[23] - before;
        wst[23] = before + if n_then > n_else { n_then } else { n_else };
        let m = pol_max(facs, terms, pols, pst, budget, wst, t, e);
        return pol_add(facs, terms, pols, pst, base, m);
    }
    if k == 76 { return w_block(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, n); }
    if k == 77 || k == 78 {
        // an array literal is only ever a `let` initialiser, and `w_stmt` costs it there: the
        // element count is work the expression alone does not explain
        wst[1] = 1;
        return pol_zero(facs, terms, pols, pst);
    }
    wst[1] = 1;
    pol_zero(facs, terms, pols, pst)
}

// `println` costs one, `min`/`max` two, and everything else two plus the callee's own work with
// this call's argument sizes substituted for the callee's atoms.
fn w_call(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], ntys: &[i64], sigs: &[Sig],
          fw: &[i64], facs: &mut [Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64],
          env: &mut [Env], wst: &mut [i64], scratch: &mut [i64], cof: &mut [Cof],
          rargs: &mut [i64], budget: &mut [f64], n: i64) -> i64 {
    let name = nodes[n].a;
    let arg = nodes[n].b;
    let mut acc = pol_zero(facs, terms, pols, pst);
    let mut a = arg;
    let mut n_args = 0;
    while a >= 0 {
        let w = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, a);
        acc = pol_add(facs, terms, pols, pst, acc, w);
        n_args += 1;
        a = nodes[a].next;
    }
    if name_is_println(src, toks, name) {
        let one = pol_const(facs, terms, pols, pst, 1);
        return pol_add(facs, terms, pols, pst, acc, one);
    }
    if name_is_min(src, toks, name) || name_is_max(src, toks, name) {
        let two = pol_const(facs, terms, pols, pst, 2);
        return pol_add(facs, terms, pols, pst, acc, two);
    }
    let two = pol_const(facs, terms, pols, pst, 2);
    acc = pol_add(facs, terms, pols, pst, acc, two);
    // the callee, by name, in the signature table
    let mut si = -1;
    let mut i = 0;
    while sigs[i].name >= 0 {
        if si < 0 && name_eq(src, toks, sigs[i].name, name) { si = i; }
        i += 1;
    }
    if si == wst[24] {
        // a self-call: the recurrence is solved after the body is walked, so all this contributes
        // now is the call itself, which `acc` already has. The arguments are recorded for the
        // solver — one per parameter, −1 where this call site does not know one.
        let k = wst[23];
        wst[23] = k + 1;
        if k < 4 {
            let mut p2 = 0;
            let mut a2 = arg;
            while p2 < 8 {
                let v = if a2 >= 0 {
                    let inner2 = if nodes[a2].kind == 73 { nodes[a2].a } else { a2 };
                    let vv = val_of(src, toks, nodes, facs, terms, pols, pst, env, wst, inner2);
                    if vv >= 0 { vv } else { arg_len(src, toks, nodes, env, wst, inner2) }
                } else { -1 };
                rargs[k * 8 + p2] = v;
                if a2 >= 0 { a2 = nodes[a2].next; };
                p2 += 1;
            }
        }
        return acc;
    }
    if si < 0 || fw[si] < 0 {
        wst[1] = 1;
        return acc;
    }
    // substitute each argument's size for the callee's atom. A parameter whose size this call
    // site does not know makes the whole call unknown rather than a guess.
    let mut body = fw[si];
    let mut p = 0;
    a = arg;
    while p < sigs[si].n_params && a >= 0 {
        let inner = if nodes[a].kind == 73 { nodes[a].a } else { a };
        let v = val_of(src, toks, nodes, facs, terms, pols, pst, env, wst, inner);
        let sz = if v >= 0 { v } else { arg_len(src, toks, nodes, env, wst, inner) };
        if sz < 0 {
            // the callee's work may simply not mention this parameter, in which case nothing is
            // lost; asking is cheaper than proving
            let e = mono_mentions(facs, terms, pols, body, 3 + p);
            if e { wst[1] = 1; }
        } else {
            body = pol_subst(facs, terms, pols, pst, body, 3 + p, sz);
        }
        p += 1;
        a = nodes[a].next;
    }
    if p < sigs[si].n_params { wst[1] = 1; }
    pol_add(facs, terms, pols, pst, acc, body)
}

// a byte-string literal's element count: the span, with each escape counting once
fn bytes_len(src: &[u8], toks: &[Token], t: i64) -> i64 {
    let mut i = 0;
    let mut n = 0;
    while i < toks[t].len {
        if src[toks[t].start + i] == b'\\' { i += 1; };
        n += 1;
        i += 1;
    }
    n
}

// does this function walk any array it is given
fn walks_anything(ffoot: &[i64], sigs: &[Sig], si: i64) -> bool {
    let mut p = 0;
    let mut any = false;
    while p < sigs[si].n_params {
        if ffoot[si * 16 + p] != 0 { any = true; }
        p += 1;
    }
    any
}

// the length a name is bound to, when the walk knows it
fn arg_len_of(src: &[u8], toks: &[Token], env: &[Env], wst: &[i64], name: i64) -> i64 {
    let e = env_find(src, toks, env, wst, name);
    if e < 0 { return -1; }
    env[e].len
}

// the length of an array argument, when the caller knows it
fn arg_len(src: &[u8], toks: &[Token], nodes: &[Node], env: &[Env], wst: &[i64], n: i64) -> i64 {
    if n < 0 || nodes[n].kind != 65 { return -1; }
    let e = env_find(src, toks, env, wst, nodes[n].a);
    if e < 0 { return -1; }
    env[e].len
}

// does this polynomial mention the atom at all
fn mono_mentions(facs: &[Fac], terms: &[Term], pols: &[Pol], p: i64, atom: i64) -> bool {
    let mut i = 0;
    let mut yes = false;
    while i < pols[p].n_term {
        let t = pols[p].term + i;
        if mono_exp(facs, terms[t].fac, terms[t].n_fac, atom) != 0 { yes = true; }
        i += 1;
    }
    yes
}

fn w_block(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], ntys: &[i64], sigs: &[Sig],
           fw: &[i64], facs: &mut [Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64],
           env: &mut [Env], wst: &mut [i64], scratch: &mut [i64], cof: &mut [Cof],
          rargs: &mut [i64], budget: &mut [f64], n: i64) -> i64 {
    if n < 0 { return pol_zero(facs, terms, pols, pst); }
    let saved = wst[0];
    let mut acc = pol_zero(facs, terms, pols, pst);
    let mut s = nodes[n].a;
    while s >= 0 && wst[1] == 0 {
        let w = w_stmt(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, s);
        acc = pol_add(facs, terms, pols, pst, acc, w);
        s = nodes[s].next;
    }
    if nodes[n].b >= 0 && wst[1] == 0 {
        let t = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[n].b);
        acc = pol_add(facs, terms, pols, pst, acc, t);
    }
    wst[0] = saved;
    acc
}

fn w_stmt(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], ntys: &[i64], sigs: &[Sig],
          fw: &[i64], facs: &mut [Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64],
          env: &mut [Env], wst: &mut [i64], scratch: &mut [i64], cof: &mut [Cof],
          rargs: &mut [i64], budget: &mut [f64], n: i64) -> i64 {
    let k = nodes[n].kind;
    if k == 90 {
        let init = nodes[n].c;
        let ik = nodes[init].kind;
        if ik == 78 {
            // `[e; n]`: the element and the length are evaluated, then the fill costs one per
            // element — which is where a `let` first puts a size variable into the work
            let a = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[init].a);
            let b = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[init].b);
            let sz = val_of(src, toks, nodes, facs, terms, pols, pst, env, wst, nodes[init].b);
            if sz < 0 {
                wst[1] = 1;
                return pol_zero(facs, terms, pols, pst);
            }
            env_add(env, wst, nodes[n].a, -1, sz);
            let s = pol_add(facs, terms, pols, pst, a, b);
            return pol_add(facs, terms, pols, pst, s, sz);
        }
        if ik == 77 {
            let mut acc = pol_zero(facs, terms, pols, pst);
            let mut e = nodes[init].a;
            let mut count = 0;
            while e >= 0 {
                let w = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, e);
                acc = pol_add(facs, terms, pols, pst, acc, w);
                count += 1;
                e = nodes[e].next;
            }
            let c = pol_const(facs, terms, pols, pst, count);
            env_add(env, wst, nodes[n].a, -1, c);
            return pol_add(facs, terms, pols, pst, acc, c);
        }
        if ik == 64 {
            // `let s = b"…"` is an array literal like any other: one unit per element, and the
            // element count is the *decoded* byte count, not the span's — `\n` is two bytes of
            // source and one of array
            let c = pol_const(facs, terms, pols, pst, bytes_len(src, toks, nodes[init].a));
            env_add(env, wst, nodes[n].a, -1, c);
            return c;
        }
        let w = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, init);
        // an array bound to another array or a view of one keeps its length; a scalar keeps its
        // value when it has one
        let t = ntys[init];
        if t >= 0 && (types[t].kind == 5 || types[t].kind == 6) {
            let inner = if nodes[init].kind == 73 { nodes[init].a } else { init };
            env_add(env, wst, nodes[n].a, -1, arg_len(src, toks, nodes, env, wst, inner));
        } else {
            env_add(env, wst, nodes[n].a, val_of(src, toks, nodes, facs, terms, pols, pst, env, wst, init), -1);
        }
        return w;
    }
    if k == 91 {
        let w = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[n].b);
        let tgt = nodes[n].a;
        let tk = nodes[tgt].kind;
        let compound = nodes[n].ival >= 0;
        let mut extra = 0;
        if tk == 65 {
            let t = ntys[tgt];
            if t >= 0 && (types[t].kind == 5 || types[t].kind == 6) {
                // `ys = xs` on whole arrays. **The self-hosted emitter always copies** (arrays
                // design §7), because deciding in-place needs M5's uniqueness proof and this
                // compiler has none — so the cost is the copy's. The Rust compiler charges 1 for
                // the reassignments it can prove are in place, and there the two reports differ
                // on purpose: a cost is a claim about the code the compiler emits, and these two
                // compilers emit different code.
                let srcn = if nodes[n].b >= 0 && nodes[nodes[n].b].kind == 65 { nodes[nodes[n].b].a } else { -1 };
                let e = if srcn >= 0 { env_find(src, toks, env, wst, srcn) } else { -1 };
                let sz = if e >= 0 { env[e].len } else { -1 };
                if sz < 0 {
                    wst[1] = 1;
                    return pol_zero(facs, terms, pols, pst);
                }
                let tgte = env_find(src, toks, env, wst, nodes[tgt].a);
                if tgte >= 0 { env[tgte].len = sz; };
                return pol_add(facs, terms, pols, pst, w, sz);
            }
            // a register: only the operation of `op=` costs, and the value is no longer known
            if compound { extra = 1; }
            let e = env_find(src, toks, env, wst, nodes[tgt].a);
            if e >= 0 { env[e].val = -1; }
        } else if tk == 68 {
            let i = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[tgt].b);
            let c = pol_const(facs, terms, pols, pst, if compound { 3 } else { 1 });
            let s = pol_add(facs, terms, pols, pst, w, i);
            return pol_add(facs, terms, pols, pst, s, c);
        } else if tk == 69 {
            let base = nodes[tgt].a;
            if nodes[base].kind == 68 {
                let i = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[base].b);
                let c = pol_const(facs, terms, pols, pst, if compound { 3 } else { 1 });
                let s = pol_add(facs, terms, pols, pst, w, i);
                return pol_add(facs, terms, pols, pst, s, c);
            }
            if compound { extra = 1; }
        }
        let c = pol_const(facs, terms, pols, pst, extra);
        return pol_add(facs, terms, pols, pst, w, c);
    }
    if k == 92 {
        let lo = val_of(src, toks, nodes, facs, terms, pols, pst, env, wst, nodes[n].b);
        let hi = val_of(src, toks, nodes, facs, terms, pols, pst, env, wst, nodes[n].c);
        let wlo = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[n].b);
        let whi = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[n].c);
        let outside = pol_add(facs, terms, pols, pst, wlo, whi);
        if lo < 0 || hi < 0 {
            wst[1] = 1;
            return pol_zero(facs, terms, pols, pst);
        }
        let trip = pol_sub(facs, terms, pols, pst, hi, lo);
        let atom = wst[2];
        wst[2] = atom + 1;
        let saved = wst[0];
        let av = pol_atom(facs, terms, pols, pst, atom);
        env_add(env, wst, nodes[n].a, av, -1);
        let two = pol_const(facs, terms, pols, pst, 2);
        let body = w_block(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[n].d);
        wst[0] = saved;
        let per = pol_add(facs, terms, pols, pst, two, body);
        let summed = pol_sum_over(facs, terms, pols, pst, per, atom, lo, 1, trip, scratch);
        return pol_add(facs, terms, pols, pst, outside, summed);
    }
    if k == 93 {
        return w_while(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, n);
    }
    if k == 94 { return pol_zero(facs, terms, pols, pst); }
    if k == 95 || k == 96 {
        return w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[n].a);
    }
    wst[1] = 1;
    pol_zero(facs, terms, pols, pst)
}

// The trip count of a `while`, the two ways `analyze.rs` finds one. Leaves the induction
// variable's name token in wst[15] (−1 when the loop has a measure instead and so no variable that
// walks), the loop atom in wst[17], its entry value in wst[18] and its step in wst[19]. Returns −1
// when neither way works, which is a `while` with no static bound at all.
fn while_trip(src: &[u8], toks: &[Token], nodes: &[Node], facs: &mut [Fac], terms: &mut [Term],
              pols: &mut [Pol], pst: &mut [i64], env: &mut [Env], wst: &mut [i64], cof: &mut [Cof],
              n: i64) -> i64 {
    let cond = nodes[n].a;
    let measure = nodes[n].b;
    let body = nodes[n].c;
    let mut trip = -1;
    let mut atom = -1;
    let mut lo = -1;
    let mut step = 1;
    let mut var = -1;

    if measure >= 0 {
        // the programmer's measure. Its value at entry is the trip count — but only once the
        // promise has been checked: a measure that is not shown to fall by at least one every lap
        // is not a bound, it is a wish.
        trip = val_of(src, toks, nodes, facs, terms, pols, pst, env, wst, measure);
        wst[7] = 0;
        if trip < 0 || !coef_collect(src, toks, nodes, cof, wst, measure, 1) {
            return -1;
        }
        let d = min_dec(src, toks, nodes, cof, wst, body);
        // every path leaving the loop means it runs once, which needs no measure at all
        if wst[9] == 2 || (wst[9] == 0 && d < 1) {
            return -1;
        }
        if wst[9] == 1 { trip = pol_const(facs, terms, pols, pst, 1); };
    } else {
        // an induction variable in the condition, stepped by a constant in the body
        if nodes[cond].kind != 66 {
            return -1;
        }
        let op = nodes[cond].ival;
        let l = nodes[cond].a;
        let r = nodes[cond].b;
        let mut bound = -1;
        let mut asc = true;
        if nodes[l].kind == 65 && (op == 7 || op == 8 || op == 6) { var = nodes[l].a; bound = r; asc = true; }
        else if nodes[r].kind == 65 && (op == 9 || op == 10) { var = nodes[r].a; bound = l; asc = true; }
        else if nodes[l].kind == 65 && (op == 9 || op == 10) { var = nodes[l].a; bound = r; asc = false; }
        else if nodes[r].kind == 65 && (op == 7 || op == 8) { var = nodes[r].a; bound = l; asc = false; }
        if bound < 0 {
            return -1;
        }
        wst[4] = 0;
        wst[6] = 0;
        wst[8] = 0;
        step = step_scan(src, toks, nodes, wst, body, var, false);
        if wst[4] != 1 || wst[6] != 0 || step == 0 {
            return -1;
        }
        if (asc && step < 0) || (!asc && step > 0) {
            return -1;
        }
        // the bound must hold still while the loop runs
        wst[7] = 0;
        if !coef_collect(src, toks, nodes, cof, wst, bound, 1)
            || assigns_any(src, toks, nodes, cof, wst, body, var) {
            return -1;
        }
        let e = val_of(src, toks, nodes, facs, terms, pols, pst, env, wst, bound);
        let ve = env_find(src, toks, env, wst, var);
        let i0 = if ve >= 0 { env[ve].val } else { -1 };
        if e < 0 || i0 < 0 {
            return -1;
        }
        let span = if asc { pol_sub(facs, terms, pols, pst, e, i0) }
                   else { pol_sub(facs, terms, pols, pst, i0, e) };
        let mag = if step < 0 { 0 - step } else { step };
        trip = pol_scale(facs, terms, pols, pst, span, 1, mag);
        atom = wst[2];
        wst[2] = atom + 1;
        lo = i0;
    }

    wst[15] = var;
    wst[17] = atom;
    wst[18] = lo;
    wst[19] = step;
    trip
}

// A `while`: its condition once, then the body a trip count of times, with the trip count found
// one of the two ways `analyze.rs` finds it. The condition is charged once and the loop one unit
// per lap, which is what that file does — the `+1` stands for the test.
fn w_while(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], ntys: &[i64], sigs: &[Sig],
           fw: &[i64], facs: &mut [Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64],
           env: &mut [Env], wst: &mut [i64], scratch: &mut [i64], cof: &mut [Cof],
          rargs: &mut [i64], budget: &mut [f64], n: i64) -> i64 {
    let cond = nodes[n].a;
    let measure = nodes[n].b;
    let body = nodes[n].c;
    let wcond = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, cond);
    // the measure is an expression and is evaluated, once, like the condition
    let wmeas = w_expr(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, measure);
    let before = pol_add(facs, terms, pols, pst, wcond, wmeas);
    let one = pol_const(facs, terms, pols, pst, 1);

    // the trip count, and with it the induction variable (wst[15]) and the loop atom (wst[17]):
    // one function knows how to bound a `while`, and the moves walk asks it the same question
    let trip = while_trip(src, toks, nodes, facs, terms, pols, pst, env, wst, cof, n);
    if trip < 0 {
        wst[1] = 1;
        return pol_zero(facs, terms, pols, pst);
    }
    let atom = wst[17];
    let lo = wst[18];
    let step = wst[19];
    let var = wst[15];

    let saved = wst[0];
    wst[3] = wst[3] + 1;
    if atom >= 0 {
        let av = pol_atom(facs, terms, pols, pst, atom);
        env_add(env, wst, var, av, -1);
    };
    let body_w = w_block(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, body);
    wst[3] = wst[3] - 1;
    wst[0] = saved;
    let per = pol_add(facs, terms, pols, pst, one, body_w);
    let summed = if atom >= 0 { pol_sum_over(facs, terms, pols, pst, per, atom, lo, step, trip, scratch) }
                 else { pol_mul(facs, terms, pols, pst, per, trip) };
    pol_add(facs, terms, pols, pst, before, summed)
}

// ---- self-recursion ----
//
// `T(m) = f + T(m′)` for a measure `m` the compiler has to *find*: the Rust pass tries each scalar
// parameter, each `xs.len() − i`, and each difference of two scalars, and keeps the first that
// shrinks at every recursive call. This slice does the same, for **one recursive call per
// invocation**. Two or more is `fib`, which is exponential when the measure falls by a constant and
// the master theorem when it halves; neither is here, and `msum` stays unknown because of it.
//
// Shrinkage is either `m − m′ = c` for a positive integer `c` (unroll and sum) or `b·m′ ≤ m` for a
// small integer `b` (halving, so `log`). In both cases this slice needs `f` to be a constant — the
// corpus's four recurrences all have one — and says unknown otherwise rather than guess.

// the candidate measure numbered `k`, or −1 when there is none: first each scalar parameter, then
// `xs.len() − i` for an array and a scalar, then a difference of two scalars
fn cand_measure(types: &[Ty], sigs: &[Sig], ptys: &[i64], facs: &mut [Fac], terms: &mut [Term],
                pols: &mut [Pol], pst: &mut [i64], si: i64, k: i64) -> i64 {
    let n = sigs[si].n_params;
    let mut seen = 0;
    let mut i = 0;
    while i < n {
        if is_scalar_param(types, sigs, ptys, si, i) {
            if seen == k { return pol_atom(facs, terms, pols, pst, 3 + i); }
            seen += 1;
        }
        i += 1;
    }
    i = 0;
    while i < n {
        let mut j = 0;
        while j < n {
            if is_scalar_param(types, sigs, ptys, si, i) && !is_scalar_param(types, sigs, ptys, si, j) {
                if seen == k {
                    let a = pol_atom(facs, terms, pols, pst, 3 + j);
                    let b = pol_atom(facs, terms, pols, pst, 3 + i);
                    return pol_sub(facs, terms, pols, pst, a, b);
                }
                seen += 1;
            }
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while i < n {
        let mut j = 0;
        while j < n {
            if i != j && is_scalar_param(types, sigs, ptys, si, i) && is_scalar_param(types, sigs, ptys, si, j) {
                if seen == k {
                    let a = pol_atom(facs, terms, pols, pst, 3 + j);
                    let b = pol_atom(facs, terms, pols, pst, 3 + i);
                    return pol_sub(facs, terms, pols, pst, a, b);
                }
                seen += 1;
            }
            j += 1;
        }
        i += 1;
    }
    -1
}

fn is_scalar_param(types: &[Ty], sigs: &[Sig], ptys: &[i64], si: i64, i: i64) -> bool {
    let t = ptys[sigs[si].params + i];
    t >= 0 && types[t].kind == 0
}

// does `f` mention none of the parameters the measure is built from
fn indep(facs: &[Fac], terms: &[Term], pols: &[Pol], sigs: &[Sig], si: i64, f: i64, m: i64) -> bool {
    let mut p = 0;
    let mut ok = true;
    while p < sigs[si].n_params {
        if mono_mentions(facs, terms, pols, m, 3 + p) && mono_mentions(facs, terms, pols, f, 3 + p) {
            ok = false;
        }
        p += 1;
    }
    ok
}

// `T(m) = f + T(m′)` solved, or −1. `f` is the body's own work, which already counts the recursive
// call's two units.
fn solve_recurrence(types: &[Ty], sigs: &[Sig], ptys: &[i64], facs: &mut [Fac], terms: &mut [Term],
                    pols: &mut [Pol], logs: &mut [i64], pst: &mut [i64], rargs: &[i64],
                    scratch: &mut [i64], si: i64, f: i64, a: i64) -> i64 {
    // `f` need not be a number, only **independent of the measure**: `B` is a perfectly good body
    // cost for a recurrence whose measure is `xs.len() − i`, and that is what a self-recursive
    // walk's `moves` looks like. A body whose cost varies with the measure needs the summation the
    // Rust pass does, with each parameter advanced along its own shift, and that is not here — it
    // is checked below, once the measure is known.
    let mut k = 0;
    while k < 32 {
        let m = cand_measure(types, sigs, ptys, facs, terms, pols, pst, si, k);
        if m < 0 { return -1; }
        // m with every parameter replaced by what this call passes for it
        // every call must shrink the measure, and the same way: `msum` recurses on both halves
        // and both must halve it. Only the first call's image is solved with; the rest are checked
        // to agree with it.
        let mut mp = -1;
        let mut ok = true;
        let mut ci = 0;
        while ci < a && ci < 4 {
            let mut mi = m;
            let mut p = 0;
            while p < sigs[si].n_params {
                if mono_mentions(facs, terms, pols, m, 3 + p) {
                    if rargs[ci * 8 + p] < 0 { ok = false; }
                    else { mi = pol_subst(facs, terms, pols, pst, mi, 3 + p, rargs[ci * 8 + p]); }
                }
                p += 1;
            }
            if ci == 0 { mp = mi; }
            else if !pol_eq(facs, terms, pols, mi, mp) { ok = false; }
            ci += 1;
        }
        if a > 4 { ok = false; }
        if mp < 0 { ok = false; }
        if ok {
            let d = pol_sub(facs, terms, pols, pst, m, mp);
            let dc = pol_as_int(facs, terms, pols, pst, d);
            if pst[4] != 0 && dc >= 1 {
                // `a` calls each shrinking the measure by a constant is exponential
                if a != 1 { return -1; }
                if !indep(facs, terms, pols, sigs, si, f, m) { return -1; }
                // `m` falls by `dc` a call: one term per step of the way down, and one more for
                // the call that does not recurse
                let steps = pol_scale(facs, terms, pols, pst, m, 1, dc);
                let one = pol_const(facs, terms, pols, pst, 1);
                let trip = pol_add(facs, terms, pols, pst, steps, one);
                return pol_mul(facs, terms, pols, pst, trip, f);
            }
            // `b·m′ ≤ m`: the measure is divided, so the recursion is `a·T(m/b) + f`
            let mut b = 2;
            while b <= 8 {
                let bm = pol_scale(facs, terms, pols, pst, mp, b, 1);
                let diff = pol_sub(facs, terms, pols, pst, bm, m);
                let dcc = pol_as_int(facs, terms, pols, pst, diff);
                if pst[4] != 0 && dcc <= 0 && indep(facs, terms, pols, sigs, si, f, m) {
                    if a == 1 {
                        // one call: `log_b m + 1` levels, each paying `f`
                        let la = log_atom(facs, terms, pols, logs, pst, m);
                        let lp = pol_atom(facs, terms, pols, pst, la);
                        let one = pol_const(facs, terms, pols, pst, 1);
                        let depth = pol_add(facs, terms, pols, pst, lp, one);
                        return pol_mul(facs, terms, pols, pst, depth, f);
                    }
                    if a == b {
                        // `a` calls on `m/a`, each level paying `f` per node: a geometric series
                        // whose ratio is `a` and whose depth is `log_a m`, so the levels sum to
                        // `(a·m − 1)/(a − 1)`. `msum` is the `a = b = 2` case and comes to
                        // `f·(2m − 1)`. `a ≠ b` lifts the measure to a fractional power and is out.
                        let am = pol_scale(facs, terms, pols, pst, m, a, 1);
                        let one = pol_const(facs, terms, pols, pst, 1);
                        let nodes2 = pol_sub(facs, terms, pols, pst, am, one);
                        let scaled = pol_scale(facs, terms, pols, pst, nodes2, 1, a - 1);
                        return pol_mul(facs, terms, pols, pst, scaled, f);
                    }
                    return -1;
                }
                b += 1;
            }
        }
        k += 1;
    }
    -1
}

// One function's work, or −1 when this slice cannot say. The parameters become atoms 0..n−1,
// which is what makes the printed polynomial read in the caller's own names.
fn w_func(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], ntys: &[i64], sigs: &[Sig],
          ptys: &[i64], fw: &[i64], facs: &mut [Fac], terms: &mut [Term], pols: &mut [Pol],
          pst: &mut [i64], env: &mut [Env], wst: &mut [i64], scratch: &mut [i64], cof: &mut [Cof],
          rargs: &mut [i64], logs: &mut [i64], budget: &mut [f64], f: i64, si: i64) -> i64 {
    wst[0] = 0;
    wst[1] = 0;
    wst[2] = 1003;
    let mut p = nodes[f].b;
    let mut i = 0;
    while p >= 0 {
        let t = ptys[sigs[si].params + i];
        let a = pol_atom(facs, terms, pols, pst, 3 + i);
        if t >= 0 && (types[t].kind == 5 || types[t].kind == 6) {
            env_add(env, wst, nodes[p].a, -1, a);
        } else {
            env_add(env, wst, nodes[p].a, a, -1);
        }
        i += 1;
        p = nodes[p].next;
    }
    wst[23] = 0;
    wst[24] = si;
    let w = w_block(src, toks, nodes, types, ntys, sigs, fw, facs, terms, pols, pst, env, wst, scratch, cof, rargs, budget, nodes[f].d);
    if wst[1] != 0 { return -1; }
    if wst[23] == 0 { return w; }
    solve_recurrence(types, sigs, ptys, facs, terms, pols, logs, pst, rargs, scratch, si, w, wst[23])
}

// ---- printing ----
//
// The exit test is string equality with `neant cost`'s `work` column, so this mirrors
// `PolyDisplay` in `bootstrap/src/cost/size.rs` exactly: terms by descending degree, positive
// before negative at equal degree, then by monomial descending; a coefficient of 1 is elided
// unless the term has no atoms; the denominator goes after the atoms, so `21/4·n` prints as
// `21·n/4`. The decimal form the Rust one falls back to for a big denominator is **not** written
// — it needs float formatting, and a cost calculus that cannot print its answer should say so.

// A byte-string literal holds **ASCII only** (`bootstrap/src/lex.rs`: "byte literals hold ASCII
// only"), and every character this printer needs that the Rust one writes as a `char` — `·`, `−`,
// and the superscript digits — is multi-byte UTF-8. So they go in by number. Listed here rather
// than spelled, because a reader cannot check `0xC2 0xB7` by eye against a `·` that is not there.
fn emit_u(out: &mut [u8], est: &mut [i64], b: i64) {
    emit_b(out, est, b as u8);
}

// `·` U+00B7
fn emit_dot(out: &mut [u8], est: &mut [i64]) {
    emit_u(out, est, 194);
    emit_u(out, est, 183);
}

// `−` U+2212, the minus sign, not the hyphen
fn emit_minus(out: &mut [u8], est: &mut [i64]) {
    emit_u(out, est, 226);
    emit_u(out, est, 136);
    emit_u(out, est, 146);
}

// `²` and `³` are Latin-1 supplement (two bytes); `⁰` and `⁴`..`⁹` are superscripts (three)
fn emit_superscript(out: &mut [u8], est: &mut [i64], e: i64) {
    if e == 2 { emit_u(out, est, 194); emit_u(out, est, 178); return; }
    if e == 3 { emit_u(out, est, 194); emit_u(out, est, 179); return; }
    if e == 1 { emit_u(out, est, 194); emit_u(out, est, 185); return; }
    if e == 0 { emit_u(out, est, 226); emit_u(out, est, 129); emit_u(out, est, 176); return; }
    if e >= 4 && e <= 9 {
        emit_u(out, est, 226);
        emit_u(out, est, 129);
        emit_u(out, est, 176 + e);
        return;
    }
    est[2] = 1;
}

// an atom's name: the parameter's own spelling, with `.len()` when it is an array — which is what
// makes a cost read `12·s.len()` and not `12·s`
fn emit_atom_name(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], facs: &[Fac],
                  terms: &[Term], pols: &[Pol], logs: &[i64], pnames: &[i64], parr: &[i64],
                  atom: i64, order: &mut [i64], off: i64) {
    if atom == 0 {
        let b = b"B";
        emit_bytes(out, est, &b);
        return;
    }
    if atom >= 2000 {
        // `log(e)`: the argument prints without brackets when it is one term and has no `·`, which
        // is what `PolyDisplay` does — `log n` but `log(hi − lo)`
        let l = b"log";
        emit_bytes(out, est, &l);
        let arg = logs[atom - 2000];
        let simple = pols[arg].n_term == 1 && terms[pols[arg].term].n_fac == 1
            && terms[pols[arg].term].cn == 1 && terms[pols[arg].term].cd == 1;
        if simple {
            emit_b(out, est, b' ');
            pol_print(out, est, src, toks, facs, terms, pols, logs, pnames, parr, arg, order, off);
        } else {
            emit_b(out, est, b'(');
            pol_print(out, est, src, toks, facs, terms, pols, logs, pnames, parr, arg, order, off);
            emit_b(out, est, b')');
        }
        return;
    }
    if atom < 3 || atom >= 1000 {
        // `M`, `P`, or a loop atom that `pol_sum_over` should have eliminated — none of which can
        // reach a `work` or a `moves` this slice computes, so printing one is a bug, not a
        // narrowing, and it is loud
        est[2] = 1;
        return;
    }
    emit_span(out, est, src, toks, pnames[atom - 3]);
    if parr[atom - 3] == 1 { let s = b".len()"; emit_bytes(out, est, &s); };
}

// `order` is the scratch the terms are sorted into, and `off` is where in it this call may write.
// A `log`'s argument is printed by a nested call *in the middle of* the outer loop over `order`,
// so the two must not share a region: without `off` the argument's sort overwrites the caller's
// and its later terms come out as the caller's own. That produced `15·log(hi − lo) − lo` where the
// answer is `15·log(hi − lo) + 15`.
fn pol_print(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], facs: &[Fac],
             terms: &[Term], pols: &[Pol], logs: &[i64], pnames: &[i64], parr: &[i64], p: i64,
             order: &mut [i64], off: i64) {
    if pols[p].n_term == 0 { let z = b"0"; emit_bytes(out, est, &z); return; }
    // the display order, as a permutation: highest degree first, positive before negative at equal
    // degree, then by monomial descending
    let mut i = 0;
    while i < pols[p].n_term {
        order[off + i] = pols[p].term + i;
        i += 1;
    }
    let mut k = 1;
    while k < pols[p].n_term {
        let mut j = k;
        while j > 0 && display_before(facs, terms, order[off + j], order[off + j - 1]) {
            let t = order[off + j - 1];
            order[off + j - 1] = order[off + j];
            order[off + j] = t;
            j -= 1;
        }
        k += 1;
    }
    let mut x = 0;
    while x < pols[p].n_term {
        let t = order[off + x];
        let neg = terms[t].cn < 0;
        let cn = if neg { 0 - terms[t].cn } else { terms[t].cn };
        let cd = terms[t].cd;
        if x > 0 {
            if neg {
                emit_b(out, est, b' ');
                emit_minus(out, est);
                emit_b(out, est, b' ');
            } else {
                let s = b" + ";
                emit_bytes(out, est, &s);
            };
        } else if neg {
            emit_minus(out, est);
        };
        // the decimal fallback is out of this slice
        if cd > 64 || (cd > 1 && cn > 1000000) { est[2] = 1; return; };
        let n_fac = terms[t].n_fac;
        if cn != 1 || n_fac == 0 {
            emit_int(out, est, cn);
            if n_fac > 0 { emit_dot(out, est); };
        }
        let mut f = 0;
        while f < n_fac {
            if f > 0 { emit_dot(out, est); };
            emit_atom_name(out, est, src, toks, facs, terms, pols, logs, pnames, parr, facs[terms[t].fac + f].atom, order, off + pols[p].n_term);
            let e = facs[terms[t].fac + f].exp;
            if e != 1 { emit_superscript(out, est, e); };
            f += 1;
        }
        if cd != 1 {
            emit_b(out, est, b'/');
            emit_int(out, est, cd);
        };
        x += 1;
    }
}

fn display_before(facs: &[Fac], terms: &[Term], a: i64, b: i64) -> bool {
    let da = mono_degree(facs, terms[a].fac, terms[a].n_fac);
    let db = mono_degree(facs, terms[b].fac, terms[b].n_fac);
    if da != db { return da > db; }
    let pa = terms[a].cn > 0;
    let pb = terms[b].cn > 0;
    if pa != pb { return pa; }
    mono_cmp(facs, terms[b].fac, terms[b].n_fac, terms[a].fac, terms[a].n_fac) < 0
}

// ---- footprints, residency, and what a call actually costs ----
//
// A call's traffic is the callee's, less what the caller already has in `M` (design §14). The rule
// was not constructed but **read off a run**: `NEANT_DEBUG_CALLS=1` prints `analyze.rs`'s resident
// set, the callee's footprints and the credit at every call site, and three things it shows are
// not what an hour of reasoning had produced.
//
//   1. Building an array does **not** make it resident. `repeat.nt`'s first traversal still pays.
//   2. The credit is a **cross product**: every footprint against every resident range. Calling
//      `dot(&xs, &xs)` has two footprints and two resident entries, so the credit is four times
//      the array — and the intermediate really does go negative, which is correct, because the
//      traffic it cancels was charged at an earlier call.
//   3. It is **conditional**: the callee leaves its footprint resident only if that fits in `M`,
//      so every credit carries that condition and is decided, here, at this machine's `M`.
//
// A footprint is the whole array or nothing, and the flags say which array parameters a callee
// walks: `ffoot[si · 16 + p]`. A flat array rather than a bit mask because the language has no
// bitwise operators — `|` is only ever `||` here.

struct Res { root: i64, foot: i64 }

fn foot_flags(src: &[u8], toks: &[Token], nodes: &[Node], sites: &[Site], ffoot: &mut [i64],
              wst: &[i64], f: i64, si: i64) {
    let mut p = nodes[f].b;
    let mut i = 0;
    while p >= 0 && i < 16 {
        // 0 not walked, 1 walked over a range the compiler knows, 2 walked scatteredly — and an
        // inexact footprint is worth nothing to a caller: it cannot say what was brought in, so the
        // call leaves **nothing** resident. `ring.nt`'s `push_all` writes `buf[head]` and is
        // exactly this case.
        let mut walks = 0;
        let mut k = 0;
        while k < wst[10] {
            if name_eq(src, toks, sites[k].arr, nodes[p].a) {
                // any level whose coefficient could not be read as a number: this slice computes a
                // footprint's range from integer coefficients, so a symbolic stride — `a[i*n + k]`
                // against `i` — leaves a range it cannot state, and a range it cannot state is not
                // exact. `analyze.rs` reaches the same verdict for `stencil`'s `src` and says so:
                // "no residue claimed".
                if sites[k].bad != 0 || sites[k].b0 != 0 || sites[k].b1 != 0 || sites[k].b2 != 0
                    || sites[k].coef == 0 && sites[k].novar != 0 { walks = 2; }
                else if walks == 0 { walks = 1; }
            }
            k += 1;
        }
        ffoot[si * 16 + i] = walks;
        i += 1;
        p = nodes[p].next;
    }
}

// ---- a cost as a list of pieces ----
//
// `piece.rs`'s shape, reproduced rather than narrowed (design §16): a cost is a run of **pieces**,
// each a run of **conditions** and a polynomial. `§13`'s single fork was enough until `matmul`,
// whose two pieces carry two *different* conditions — `≈ 8·n² < M` and `≈ B·n + 8·n ≥ M` — which a
// one-condition cost cannot hold.
//
// `add` is a cross product: every piece of one against every piece of the other, conditions
// unioned, infeasible combinations dropped. `max` is the union. Both prune afterwards, because
// without it the cross product doubles the piece count at every statement.

struct Cnd { ws: i64, fits: i64 }
struct Pce { cnd: i64, n_cnd: i64, poly: i64 }
struct Ck { pce: i64, n_pce: i64 }

fn cnd_push(cnds: &mut [Cnd], wst: &mut [i64], ws: i64, fits: i64) {
    cnds[wst[28]].ws = ws;
    cnds[wst[28]].fits = fits;
    wst[28] = wst[28] + 1;
}

fn pce_push(pcs: &mut [Pce], wst: &mut [i64], cnd: i64, n_cnd: i64, poly: i64) {
    pcs[wst[29]].cnd = cnd;
    pcs[wst[29]].n_cnd = n_cnd;
    pcs[wst[29]].poly = poly;
    wst[29] = wst[29] + 1;
}

// `ws_a < M` and `ws_b ≥ M` contradict when `ws_b ≤ ws_a`
fn conds_feasible(facs: &[Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64],
                  budget: &mut [f64], cnds: &[Cnd], start: i64, n: i64) -> bool {
    let mut i = 0;
    let mut ok = true;
    while i < n {
        if cnds[start + i].fits == 1 {
            let mut j = 0;
            while j < n {
                if cnds[start + j].fits == 0
                    && pol_dominates(facs, terms, pols, pst, budget, cnds[start + i].ws, cnds[start + j].ws) {
                    ok = false;
                }
                j += 1;
            }
        }
        i += 1;
    }
    ok
}

// the union of two condition runs, written fresh; its length is left in wst[19]
fn conds_union(facs: &[Fac], terms: &[Term], pols: &[Pol], cnds: &mut [Cnd], wst: &mut [i64],
               a: i64, na: i64, b: i64, nb: i64) -> i64 {
    let start = wst[28];
    let mut i = 0;
    while i < na {
        cnd_push(cnds, wst, cnds[a + i].ws, cnds[a + i].fits);
        i += 1;
    }
    let mut j = 0;
    while j < nb {
        let mut seen = false;
        let mut k = 0;
        while k < wst[28] - start {
            if cnds[start + k].fits == cnds[b + j].fits
                && pol_eq(facs, terms, pols, cnds[start + k].ws, cnds[b + j].ws) { seen = true; }
            k += 1;
        }
        if !seen { cnd_push(cnds, wst, cnds[b + j].ws, cnds[b + j].fits); };
        j += 1;
    }
    wst[19] = wst[28] - start;
    start
}

// **A condition implied by another is not a condition.** If the bigger working set fits then so
// does the smaller; if the smaller does not fit then neither does the bigger. `simplify` in
// `piece.rs`, and without it `matmul` carries `≈ B·n + 8·n < M` beside `≈ 8·n² < M`, which says
// nothing the other does not and splits one regime into two.
fn conds_simplify(facs: &[Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64],
                  budget: &mut [f64], cnds: &mut [Cnd], wst: &mut [i64], a: i64, na: i64) -> i64 {
    let start = wst[28];
    let mut i = 0;
    while i < na {
        let mut implied = false;
        let mut j = 0;
        while j < na {
            if i != j && cnds[a + i].fits == cnds[a + j].fits
                && !pol_eq(facs, terms, pols, cnds[a + i].ws, cnds[a + j].ws) {
                if cnds[a + i].fits == 1 {
                    if pol_dominates(facs, terms, pols, pst, budget, cnds[a + j].ws, cnds[a + i].ws) {
                        implied = true;
                    }
                } else {
                    if pol_dominates(facs, terms, pols, pst, budget, cnds[a + i].ws, cnds[a + j].ws) {
                        implied = true;
                    }
                };
            };
            j = j + 1;
        }
        if !implied {
            let mut dup = false;
            let mut k = 0;
            while k < wst[28] - start {
                if cnds[start + k].fits == cnds[a + i].fits
                    && pol_eq(facs, terms, pols, cnds[start + k].ws, cnds[a + i].ws) { dup = true; }
                k = k + 1;
            }
            if !dup { cnd_push(cnds, wst, cnds[a + i].ws, cnds[a + i].fits); };
        };
        i = i + 1;
    }
    wst[19] = wst[28] - start;
    start
}

// is every condition of `a` also a condition of `b`
fn conds_subset(facs: &[Fac], terms: &[Term], pols: &[Pol], cnds: &[Cnd],
                a: i64, na: i64, b: i64, nb: i64) -> bool {
    let mut i = 0;
    let mut all = true;
    while i < na {
        let mut found = false;
        let mut j = 0;
        while j < nb {
            if cnds[a + i].fits == cnds[b + j].fits
                && pol_eq(facs, terms, pols, cnds[a + i].ws, cnds[b + j].ws) { found = true; }
            j += 1;
        }
        if !found { all = false; }
        i += 1;
    }
    all
}

// The smallest size at which this working set reaches `M`, by bisection, or −1 when the answer is
// not a number and 1e30 when it never does. A working set with a negative coefficient is not
// monotone and has no threshold. `threshold` in `piece.rs`.
fn cnd_threshold(facs: &[Fac], terms: &[Term], pols: &[Pol], pst: &mut [i64], ws: i64) -> f64 {
    let mut i = 0;
    while i < pols[ws].n_term {
        if terms[pols[ws].term + i].cn < 0 { return 0.0 - 1.0; }
        i += 1;
    }
    let target = 2097152.0;
    let f1 = pol_eval(facs, terms, pols, pst, ws, 64.0, target, 1.0) * 64.0;
    if pst[6] != 0 { return 0.0 - 1.0; }
    if f1 >= target { return 1.0; }
    let mut hi = 2.0;
    let mut fh = pol_eval(facs, terms, pols, pst, ws, 64.0, target, hi) * 64.0;
    while fh < target {
        hi = hi * 2.0;
        if hi > 1e30 { return 1e30; }
        fh = pol_eval(facs, terms, pols, pst, ws, 64.0, target, hi) * 64.0;
    }
    let mut lo = 1.0;
    let mut k = 0;
    while k < 200 {
        let mid = (lo + hi) / 2.0;
        let fm = pol_eval(facs, terms, pols, pst, ws, 64.0, target, mid) * 64.0;
        if fm >= target { hi = mid; } else { lo = mid; }
        k += 1;
    }
    hi
}

// the one size variable every condition of this piece is written in, or −1 when there is none or
// more than one — the interval reading below needs a single axis to be an interval on
fn piece_one_var(facs: &[Fac], terms: &[Term], pols: &[Pol], cnds: &[Cnd], pcs: &[Pce],
                 d: i64) -> i64 {
    let mut found = 0 - 1;
    let mut ci = 0;
    while ci < pcs[d].n_cnd {
        let w = cnds[pcs[d].cnd + ci].ws;
        let mut i = 0;
        while i < pols[w].n_term {
            let t = pols[w].term + i;
            let mut f = 0;
            while f < terms[t].n_fac {
                let a = facs[terms[t].fac + f].atom;
                if a >= 3 && a < 2000 {
                    if found < 0 { found = a; }
                    else if found != a { return 0 - 2; };
                };
                f += 1;
            }
            i += 1;
        }
        ci += 1;
    }
    found
}

// the order `piece.rs` sorts a cost's pieces into: fewest conditions first, then by polynomial
fn piece_before(facs: &[Fac], terms: &[Term], pols: &[Pol], pcs: &[Pce], a: i64, b: i64) -> bool {
    if pcs[a].n_cnd != pcs[b].n_cnd { return pcs[a].n_cnd < pcs[b].n_cnd; }
    pol_cmp_ord(facs, terms, pols, pcs[a].poly, pcs[b].poly) < 0
}

// Close the pieces written at [start, wst[29]) into a cost, dropping any that another piece
// already covers: a piece whose conditions are implied by another's and whose polynomial that
// other dominates says nothing new. Without this the cross product grows without bound.
fn ck_close(facs: &[Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64],
            budget: &mut [f64], cnds: &mut [Cnd], pcs: &mut [Pce], cks: &mut [Ck],
            wst: &mut [i64], start: i64) -> i64 {
    // **A condition whose truth this machine already knows is not a regime** (`prune_at`): decide
    // it here rather than carry a fork the report would print. `128 < M` is a fact, not a
    // question, and `arena.nt`'s `main` read `B + 512 if 128 < M | …` until this was here.
    let mut d = start;
    let mut kept = start;
    while d < wst[29] {
        let cstart = wst[28];
        let mut alive = true;
        let mut ci = 0;
        while ci < pcs[d].n_cnd {
            // a condition's working set is a count of **lines**, so the comparison with `M` scales
            // it by one. `pol_num_at_b` rather than `pol_as_f64` because a working set of `2` lines
            // may still be written with a `B` in it and is a number on this machine regardless.
            let w = pol_num_at_b(facs, terms, pols, pst, cnds[pcs[d].cnd + ci].ws, 64.0) * 64.0;
            if pst[7] != 0 {
                let holds = if w < 2097152.0 { 1 } else { 0 };
                if holds != cnds[pcs[d].cnd + ci].fits { alive = false; }
            } else {
                cnd_push(cnds, wst, cnds[pcs[d].cnd + ci].ws, cnds[pcs[d].cnd + ci].fits);
            }
            ci += 1;
        }
        if alive {
            let ss = conds_simplify(facs, terms, pols, pst, budget, cnds, wst, cstart,
                                    wst[28] - cstart);
            pcs[kept].cnd = ss;
            pcs[kept].n_cnd = wst[19];
            pcs[kept].poly = pcs[d].poly;
            kept += 1;
        }
        d += 1;
    }
    wst[29] = kept;
    // **Conditions as intervals in the one size variable.** When every condition of a piece is
    // written in the same variable, each is a threshold — the smallest size at which the working
    // set reaches `M` — so `fits` reads `n < t` and `≥ M` reads `n ≥ t`. Of two conditions of the
    // same kind only the tighter says anything, and a piece whose interval is empty cannot happen
    // at all. `prune_at` in `piece.rs`. It is what leaves `matmul`'s fitting regime saying
    // `8·n² + 16·n + 2·B < M` alone rather than beside the looser `B·n + 8·n + 2·B < M`, and what
    // rules out the regime where the inner level overflows but the outer one does not.
    let mut d2 = start;
    let mut kept2 = start;
    while d2 < wst[29] {
        let v = piece_one_var(facs, terms, pols, cnds, pcs, d2);
        let mut alive2 = true;
        let mut ncnd2 = pcs[d2].n_cnd;
        let mut cnd2 = pcs[d2].cnd;
        if v >= 3 && pcs[d2].n_cnd > 0 {
            let mut all = true;
            let mut tight_hi = 1e30;
            let mut tight_lo = 0.0;
            let mut hi_b = 1e30;
            let mut lo_b = 1.0;
            let mut ci2 = 0;
            while ci2 < pcs[d2].n_cnd {
                let t = cnd_threshold(facs, terms, pols, pst, cnds[pcs[d2].cnd + ci2].ws);
                if t < 0.0 {
                    all = false;
                } else if cnds[pcs[d2].cnd + ci2].fits == 1 {
                    if t < tight_hi { tight_hi = t; };
                    if t - 1.0 < hi_b { hi_b = t - 1.0; };
                } else {
                    if t > tight_lo { tight_lo = t; };
                    if t > lo_b { lo_b = t; };
                };
                ci2 += 1;
            }
            if all && lo_b > hi_b { alive2 = false; };
            if all && alive2 {
                let ns = wst[28];
                let mut ci3 = 0;
                while ci3 < pcs[d2].n_cnd {
                    let t = cnd_threshold(facs, terms, pols, pst, cnds[pcs[d2].cnd + ci3].ws);
                    let keep_it = if cnds[pcs[d2].cnd + ci3].fits == 1 { t <= tight_hi }
                                  else { t >= tight_lo };
                    if keep_it {
                        cnd_push(cnds, wst, cnds[pcs[d2].cnd + ci3].ws,
                                 cnds[pcs[d2].cnd + ci3].fits);
                    };
                    ci3 += 1;
                }
                cnd2 = ns;
                ncnd2 = wst[28] - ns;
            };
        };
        if alive2 {
            pcs[kept2].cnd = cnd2;
            pcs[kept2].n_cnd = ncnd2;
            pcs[kept2].poly = pcs[d2].poly;
            kept2 += 1;
        };
        d2 += 1;
    }
    wst[29] = kept2;
    kept = kept2;
    if kept == start {
        // every piece was ruled out: the cost is zero rather than nothing
        let z = pol_zero(facs, terms, pols, pst);
        pce_push(pcs, wst, 0, 0, z);
    }
    // the report lists the least-conditional pieces first, which is `ps.sort_by(conds.len())` in
    // `piece.rs` — and the dominance prune below depends on the order, because equal pieces are
    // broken by position
    let mut si = start + 1;
    while si < wst[29] {
        let mut sj = si;
        while sj > start && piece_before(facs, terms, pols, pcs, sj, sj - 1) {
            let tc = pcs[sj].cnd;
            let tn = pcs[sj].n_cnd;
            let tp = pcs[sj].poly;
            pcs[sj].cnd = pcs[sj - 1].cnd;
            pcs[sj].n_cnd = pcs[sj - 1].n_cnd;
            pcs[sj].poly = pcs[sj - 1].poly;
            pcs[sj - 1].cnd = tc;
            pcs[sj - 1].n_cnd = tn;
            pcs[sj - 1].poly = tp;
            sj -= 1;
        }
        si += 1;
    }
    let mut write = start;
    let mut i = start;
    while i < wst[29] {
        let mut covered = false;
        let mut j = start;
        while j < wst[29] {
            if j != i && !covered
                && conds_subset(facs, terms, pols, cnds, pcs[j].cnd, pcs[j].n_cnd, pcs[i].cnd, pcs[i].n_cnd)
                && pol_dominates(facs, terms, pols, pst, budget, pcs[j].poly, pcs[i].poly)
                // the same tie-break `prune` uses: a piece is covered when another says at least
                // as much under no more conditions, and equal pieces are broken by position so
                // that one of a pair survives rather than both or neither
                && (pcs[j].n_cnd < pcs[i].n_cnd
                    || !pol_eq(facs, terms, pols, pcs[j].poly, pcs[i].poly)
                    || j < i) {
                covered = true;
            }
            j += 1;
        }
        if !covered {
            pcs[write].cnd = pcs[i].cnd;
            pcs[write].n_cnd = pcs[i].n_cnd;
            pcs[write].poly = pcs[i].poly;
            write += 1;
        }
        i += 1;
    }
    wst[29] = write;
    let c = wst[25];
    cks[c].pce = start;
    cks[c].n_pce = write - start;
    wst[25] = c + 1;
    c
}

fn ck_one(facs: &[Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64], budget: &mut [f64],
          cnds: &mut [Cnd], pcs: &mut [Pce], cks: &mut [Ck], wst: &mut [i64], p: i64) -> i64 {
    let start = wst[29];
    pce_push(pcs, wst, 0, 0, p);
    ck_close(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, start)
}

fn ck_fork(facs: &[Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64], budget: &mut [f64],
           cnds: &mut [Cnd], pcs: &mut [Pce], cks: &mut [Ck], wst: &mut [i64],
           fits: i64, nofit: i64, ws: i64) -> i64 {
    let start = wst[29];
    let c1 = wst[28];
    cnd_push(cnds, wst, ws, 1);
    pce_push(pcs, wst, c1, 1, fits);
    let c2 = wst[28];
    cnd_push(cnds, wst, ws, 0);
    pce_push(pcs, wst, c2, 1, nofit);
    ck_close(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, start)
}

// a cost of one piece with no conditions — the common case, and the only shape several callers
// know how to take apart
fn ck_plain(pcs: &[Pce], cks: &[Ck], c: i64) -> bool {
    cks[c].n_pce == 1 && pcs[cks[c].pce].n_cnd == 0
}

fn ck_poly(pcs: &[Pce], cks: &[Ck], c: i64) -> i64 {
    pcs[cks[c].pce].poly
}

fn ck_zero(facs: &[Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64], budget: &mut [f64],
           cnds: &mut [Cnd], pcs: &mut [Pce], cks: &mut [Ck], wst: &mut [i64]) -> i64 {
    let z = pol_zero(facs, terms, pols, pst);
    ck_one(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, z)
}

fn ck_add(facs: &[Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64], budget: &mut [f64],
          cnds: &mut [Cnd], pcs: &mut [Pce], cks: &mut [Ck], wst: &mut [i64], a: i64, b: i64) -> i64 {
    let start = wst[29];
    let mut i = 0;
    while i < cks[a].n_pce {
        let mut j = 0;
        while j < cks[b].n_pce {
            let pa = cks[a].pce + i;
            let pb = cks[b].pce + j;
            let u = conds_union(facs, terms, pols, cnds, wst, pcs[pa].cnd, pcs[pa].n_cnd,
                                pcs[pb].cnd, pcs[pb].n_cnd);
            let nu = wst[19];
            if conds_feasible(facs, terms, pols, pst, budget, cnds, u, nu) {
                let sum = pol_add(facs, terms, pols, pst, pcs[pa].poly, pcs[pb].poly);
                pce_push(pcs, wst, u, nu, sum);
            }
            j += 1;
        }
        i += 1;
    }
    ck_close(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, start)
}

fn ck_max(facs: &[Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64], budget: &mut [f64],
          cnds: &mut [Cnd], pcs: &mut [Pce], cks: &mut [Ck], wst: &mut [i64], a: i64, b: i64) -> i64 {
    // alternatives: both survive, and `ck_close` drops whichever the other already covers
    let start = wst[29];
    let mut i = 0;
    while i < cks[a].n_pce {
        pce_push(pcs, wst, pcs[cks[a].pce + i].cnd, pcs[cks[a].pce + i].n_cnd, pcs[cks[a].pce + i].poly);
        i += 1;
    }
    let mut j = 0;
    while j < cks[b].n_pce {
        pce_push(pcs, wst, pcs[cks[b].pce + j].cnd, pcs[cks[b].pce + j].n_cnd, pcs[cks[b].pce + j].poly);
        j += 1;
    }
    ck_close(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, start)
}

// ---- `moves`: cache-line traffic, for a function that calls nothing ----
//
// A separate walk from `work`'s. It could have been folded in, but the two ask different questions
// of the same tree — `work` sums a number per node, `moves` collects *sites* and settles them
// afterwards — and threading a site table through a walk that does not want it would have made
// both harder to read.
//
// The rule (design §11), for the one-loop slice:
//
//   outside every loop            B          one line
//   stride 0 in the loop          B          the same address every lap
//   |stride| ≥ B                  t·B        a whole line per touch
//   otherwise                     B + t·|s|  the line you start on, plus the slide
//
// `B` is symbolic in the answer and numeric in the test, exactly as it is in `analyze.rs`: the
// machine's line is 64 bytes, and `8 < B` is decided here while `8·xs.len() + B` is what prints.

// `field` is the field's name token, or −1 for a whole element. It matters twice: under SoA two
// fields of one struct are two arrays and never one site, and the stride is the field's own size
// rather than the element's.
// `p0`, `p1`, `p2` are the ids of the loops this site sits in, outermost first, −1 where there is
// no loop at that depth — `Site.path` in `analyze.rs`. A site's moves are a property of the levels
// it sits in and not of the site alone (design §18), so the levels have to be nameable after the
// walk has left them.
// `c0`, `c1`, `c2` are the site's coefficient against each of those loops' variables, and `b0`,
// `b1`, `b2` whether that coefficient could be read at all. They are taken **at the site**, where
// the loop bodies are still open: `idx_coef` asks whether a variable is assigned in the body it
// stands in, which is a question with no answer once the walk has left.
//
// `alen` and `es` are the array's length and its element's size, captured for the same reason —
// the region rule needs the footprint of an array whose binding is out of scope by settle time.
struct Site { arr: i64, idx: i64, inloop: i64, coef: i64, stride: i64, bad: i64, trip: i64, branch: i64,
             novar: i64, field: i64, p0: i64, p1: i64, p2: i64,
             c0: i64, c1: i64, c2: i64, b0: i64, b1: i64, b2: i64, alen: i64, es: i64 }

// the id of the loop this site sits in at depth `d`, or −1
fn site_lp(sites: &[Site], s: i64, d: i64) -> i64 {
    if d == 0 { return sites[s].p0; }
    if d == 1 { return sites[s].p1; }
    if d == 2 { return sites[s].p2; }
    0 - 1
}

// the site's coefficient against the variable of the loop at depth `d`, with `wst[14]` left
// non-zero when there is none to be had
fn site_coef(sites: &[Site], wst: &mut [i64], s: i64, d: i64) -> i64 {
    if d == 0 { wst[14] = sites[s].b0; return sites[s].c0; }
    if d == 1 { wst[14] = sites[s].b1; return sites[s].c1; }
    if d == 2 { wst[14] = sites[s].b2; return sites[s].c2; }
    wst[14] = 2;
    0
}

// **A loop record that outlives its loop** — `LoopRec` in `analyze.rs`. The per-depth state in
// `wst[30..35]` is live only while the loop is open, because the walk settles each site where it
// stands; a pass that settles levels innermost outwards needs every loop the function ever opened,
// so these are numbered per function and never reused.
//
//   wst[41]            how many loops this function has opened
//   wst[42 + d]        the id of the loop currently open at depth `d`
//   wst[100 + 8·id]    the loop variable's name token
//            + 1       its atom, or −1 for a `while`, which has none and so cannot be summed over
//            + 2       its first value, as a polynomial — `for j in i..n` starts at `i`
//            + 3       its step
//            + 4       its trip count, as a polynomial
//            + 5       its first value as a *source node*, which is what an outer loop's stride is
//                      read from: `for i in ii*4 .. ii*4+4` moves `a[i]` four elements a lap of `ii`
fn lp_open(wst: &mut [i64], depth: i64, var: i64, atom: i64, lo: i64, step: i64, trip: i64,
           lonode: i64) {
    if depth >= 4 || wst[41] >= 40 { return; }
    let id = wst[41];
    wst[41] = id + 1;
    wst[42 + depth] = id;
    let b = 100 + 8 * id;
    wst[b] = var;
    wst[b + 1] = atom;
    wst[b + 2] = lo;
    wst[b + 3] = step;
    wst[b + 4] = trip;
    wst[b + 5] = lonode;
}

fn lp_var(wst: &[i64], id: i64) -> i64 { wst[100 + 8 * id] }
fn lp_atom(wst: &[i64], id: i64) -> i64 { wst[100 + 8 * id + 1] }
fn lp_lo(wst: &[i64], id: i64) -> i64 { wst[100 + 8 * id + 2] }
fn lp_step(wst: &[i64], id: i64) -> i64 { wst[100 + 8 * id + 3] }
fn lp_trip(wst: &[i64], id: i64) -> i64 { wst[100 + 8 * id + 4] }
fn lp_lonode(wst: &[i64], id: i64) -> i64 { wst[100 + 8 * id + 5] }

// `Σ` of `p` over one full run of this loop — exact over the loop's atom by Faulhaber, and `× trip`
// when the loop has no atom or `p` does not mention it. `LoopRec::sum` in `analyze.rs`.
fn lp_sum(facs: &mut [Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64],
          scratch: &mut [i64], wst: &[i64], id: i64, p: i64) -> i64 {
    let a = lp_atom(wst, id);
    if a < 0 { return pol_mul(facs, terms, pols, pst, p, lp_trip(wst, id)); }
    pol_sum_over(facs, terms, pols, pst, p, a, lp_lo(wst, id), lp_step(wst, id), lp_trip(wst, id),
                 scratch)
}

// the loop variable's last value, `lo + (trip − 1)·step`
fn lp_last(facs: &mut [Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64], wst: &[i64],
           id: i64) -> i64 {
    let one = pol_const(facs, terms, pols, pst, 1);
    let t1 = pol_sub(facs, terms, pols, pst, lp_trip(wst, id), one);
    let sc = pol_scale(facs, terms, pols, pst, t1, lp_step(wst, id), 1);
    pol_add(facs, terms, pols, pst, lp_lo(wst, id), sc)
}

// two index expressions that name the same address: structurally equal, with variables compared by
// the bytes their tokens span. `cs[i].v` and `cs[i].tag` share an index and so share a site, which
// is what makes an array of structs cost one element rather than two fields.
fn expr_same(src: &[u8], toks: &[Token], nodes: &[Node], a: i64, b: i64) -> bool {
    if a < 0 || b < 0 { return a == b; }
    if nodes[a].kind != nodes[b].kind { return false; }
    let k = nodes[a].kind;
    if k == 65 { return name_eq(src, toks, nodes[a].a, nodes[b].a); }
    if k == 60 { return int_value(src, toks, nodes[a].a) == int_value(src, toks, nodes[b].a); }
    if k == 66 {
        return nodes[a].ival == nodes[b].ival
            && expr_same(src, toks, nodes, nodes[a].a, nodes[b].a)
            && expr_same(src, toks, nodes, nodes[a].b, nodes[b].b);
    }
    if k == 67 || k == 74 {
        return nodes[a].ival == nodes[b].ival && expr_same(src, toks, nodes, nodes[a].a, nodes[b].a);
    }
    if k == 68 {
        return expr_same(src, toks, nodes, nodes[a].a, nodes[b].a)
            && expr_same(src, toks, nodes, nodes[a].b, nodes[b].b);
    }
    if k == 72 { return expr_same(src, toks, nodes, nodes[a].a, nodes[b].a); }
    false
}

// does this block assign to `name`, at any depth
fn assigns_var(src: &[u8], toks: &[Token], nodes: &[Node], b: i64, name: i64) -> bool {
    if b < 0 { return false; }
    let mut hit = false;
    let mut s = nodes[b].a;
    while s >= 0 {
        let k = nodes[s].kind;
        if k == 91 && nodes[nodes[s].a].kind == 65 && name_eq(src, toks, nodes[nodes[s].a].a, name) {
            hit = true;
        } else if k == 92 || k == 93 {
            let inner = if k == 92 { nodes[s].d } else { nodes[s].c };
            if assigns_var(src, toks, nodes, inner, name) { hit = true; }
        } else if k == 95 && nodes[nodes[s].a].kind == 75 {
            let e = nodes[s].a;
            if assigns_var(src, toks, nodes, nodes[e].b, name) { hit = true; }
            if assigns_var(src, toks, nodes, nodes[e].c, name) { hit = true; }
        }
        s = nodes[s].next;
    }
    hit
}

// The coefficient of the loop variable in an index, with the verdict in `wst[14]`: 0 the returned
// integer is the coefficient, 1 the index is affine but the coefficient is not a number, 2 the
// index is not affine at all. The middle one exists because `analyze.rs` never compares a symbolic
// stride with `B` — it treats it as a whole line or more — while a non-affine index gets the region
// rule instead, and one flag cannot carry both (design §17).
fn idx_coef(src: &[u8], toks: &[Token], nodes: &[Node], wst: &mut [i64], e: i64, lv: i64) -> i64 {
    if e < 0 { wst[14] = 2; return 0; }
    let k = nodes[e].kind;
    if k == 60 { return 0; }
    if k == 65 {
        if lv >= 0 && name_eq(src, toks, nodes[e].a, lv) { return 1; }
        // a variable the body assigns is not a constant offset: `buf[head]` with `head` stepped
        // inside the loop walks the array in a way this slice does not follow, and the assumption
        // that rounds up is a whole line per touch
        if assigns_var(src, toks, nodes, wst[22], nodes[e].a) {
            wst[14] = 2;
            return 0;
        }
        return 0;
    }
    if k == 72 { return 0; }
    if k == 74 { return idx_coef(src, toks, nodes, wst, nodes[e].a, lv); }
    if k == 66 {
        let op = nodes[e].ival;
        if op == 0 || op == 1 {
            let a = idx_coef(src, toks, nodes, wst, nodes[e].a, lv);
            let b = idx_coef(src, toks, nodes, wst, nodes[e].b, lv);
            if op == 0 { return a + b; }
            return a - b;
        }
        if op == 2 {
            if nodes[nodes[e].a].kind == 60 {
                return int_value(src, toks, nodes[nodes[e].a].a) * idx_coef(src, toks, nodes, wst, nodes[e].b, lv);
            }
            if nodes[nodes[e].b].kind == 60 {
                return int_value(src, toks, nodes[nodes[e].b].a) * idx_coef(src, toks, nodes, wst, nodes[e].a, lv);
            }
            // **Neither factor is a literal.** `i * n` moves by `n` elements a lap of `i`: a stride
            // that is affine but is not a number. Asked about a variable neither factor mentions —
            // the same `i * n`, against `matmul`'s `j` — the product is simply constant, which is
            // the case this used to fall off the end of and call non-affine.
            let save = wst[14];
            wst[14] = 0;
            let ca = idx_coef(src, toks, nodes, wst, nodes[e].a, lv);
            let fa = wst[14];
            wst[14] = 0;
            let cb = idx_coef(src, toks, nodes, wst, nodes[e].b, lv);
            let fb = wst[14];
            wst[14] = save;
            if fa == 2 || fb == 2 {
                wst[14] = 2;
                return 0;
            }
            let amoves = ca != 0 || fa == 1;
            let bmoves = cb != 0 || fb == 1;
            // both factors move with it: the index is quadratic there, and not affine at all
            if amoves && bmoves {
                wst[14] = 2;
                return 0;
            }
            if !amoves && !bmoves { return 0; }
            if wst[14] < 1 { wst[14] = 1; };
            return 0;
        }
    }
    // an index the compiler cannot follow — an arena walk, a call — moves by a whole line or more,
    // which is what `analyze.rs` assumes for the same case. Every assumption rounds up.
    wst[14] = 2;
    0
}

// is this array's element a struct the module has chosen SoA for
fn is_soa(types: &[Ty], slay: &[i64], t: i64) -> bool {
    if t < 0 { return false; }
    if types[t].kind != 5 && types[t].kind != 6 { return false; }
    let e = types[t].elem;
    if e < 0 || types[e].kind != 7 { return false; }
    slay[types[e].elem] == 1
}

// the bytes one field of this array's struct element occupies, or −1
fn field_bytes(src: &[u8], toks: &[Token], types: &[Ty], strs: &[Str], flds: &[Fld], t: i64,
               fld: i64) -> i64 {
    let e = types[t].elem;
    if e < 0 || types[e].kind != 7 { return -1; }
    let f = field_find(src, toks, strs, flds, types[e].elem, fld);
    if f < 0 { return -1; }
    scalar_bytes(types, strs, flds, flds[f].ty)
}

// the bytes one element of this array occupies, or −1. A struct is laid out as C lays it out,
// which is what `emit.nt` emits, so the size is the fields padded to the widest one.
fn elem_bytes(types: &[Ty], strs: &[Str], flds: &[Fld], t: i64) -> i64 {
    if t < 0 { return -1; }
    if types[t].kind != 5 && types[t].kind != 6 { return -1; }
    let e = types[t].elem;
    if e < 0 { return -1; }
    scalar_bytes(types, strs, flds, e)
}

fn scalar_bytes(types: &[Ty], strs: &[Str], flds: &[Fld], t: i64) -> i64 {
    let k = types[t].kind;
    if k == 0 || k == 1 { return 8; }
    if k == 2 || k == 3 { return 1; }
    if k == 7 {
        let si = types[t].elem;
        let mut i = 0;
        let mut total = 0;
        let mut widest = 1;
        while i < strs[si].n_fields {
            let fb = scalar_bytes(types, strs, flds, flds[strs[si].fields + i].ty);
            if fb > widest { widest = fb; };
            // each field starts at a multiple of its own size, as C aligns it
            while total % fb != 0 { total += 1; }
            total += fb;
            i += 1;
        }
        while total % widest != 0 { total += 1; }
        return total;
    }
    -1
}

// Record a site, merging it into one already seen at the same array, the same index and the same
// loop. wst[14] carries "the index is not affine" out of `idx_coef`.
fn site_add(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], strs: &[Str], flds: &[Fld],
            ntys: &[i64], sigs: &[Sig], ptys: &[i64], fm: &[i64], ffoot: &[i64],
            facs: &mut [Fac], terms: &mut [Term], pols: &mut [Pol],
            pst: &mut [i64], env: &mut [Env], cof: &mut [Cof], sites: &mut [Site], cks: &mut [Ck], cnds: &mut [Cnd], pcs: &mut [Pce], budget: &mut [f64],
            resid: &mut [Res], rargs: &mut [i64], subst: &mut [i64], slay: &[i64], wst: &mut [i64],
            arr: i64, idx: i64, fld: i64) -> i64 {
    // four loops deep is past what a site's path records
    if wst[11] > 3 {
        wst[1] = 1;
        return ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst);
    }
    let t = ntys[arr];
    let es = elem_bytes(types, strs, flds, t);
    if es < 0 || nodes[arr].kind != 65 {
        wst[1] = 1;
        return ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst);
    }
    // under SoA a field access walks that field's own array, so it steps by the field's size and
    // not the element's — the one split M4 recorded as making AoS cost `24n` and SoA `8n`
    let soa = is_soa(types, slay, t);
    let mut step = es;
    let mut sfld = -1;
    if soa {
        if fld < 0 {
            // **a whole element under SoA is a gather**: the fields live in different arrays, so
            // this is one site per field. `structs.nt`'s `let q = ps[2];` is the corpus's only
            // one, and it is part of what the choice weighs against SoA.
            let e2 = types[t].elem;
            let si2 = types[e2].elem;
            let mut acc2 = ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst);
            let mut k2 = 0;
            while k2 < strs[si2].n_fields {
                let one2 = site_add(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm,
                                    ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs,
                                    budget, resid, rargs, subst, slay, wst, arr, idx,
                                    flds[strs[si2].fields + k2].name);
                acc2 = ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, acc2, one2);
                k2 += 1;
            }
            return acc2;
        }
        step = field_bytes(src, toks, types, strs, flds, t, fld);
        sfld = fld;
        if step < 0 {
            wst[1] = 1;
            return ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst);
        }
    }
    let mut i = 0;
    while i < wst[10] {
        // the same address *on the same path*: two reads of `pos[0]` on either side of an `if`
        // are two sites, because only one of them happens and the other's line may be gone. The
        // innermost branch's id stands for the whole path — two sites agree on it exactly when
        // they agree on every branch they sit inside.
        if sites[i].inloop == wst[11] && sites[i].branch == wst[20]
            && name_eq(src, toks, sites[i].arr, nodes[arr].a)
            && expr_same(src, toks, nodes, sites[i].idx, idx)
            && (!soa || name_eq(src, toks, sites[i].field, sfld)) {
            return ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst);
        }
        i += 1;
    }
    wst[14] = 0;
    let c = idx_coef(src, toks, nodes, wst, idx, wst[12]);
    let s = wst[10];
    sites[s].arr = nodes[arr].a;
    sites[s].idx = idx;
    sites[s].inloop = wst[11];
    sites[s].coef = c;
    sites[s].stride = step;
    sites[s].field = sfld;
    sites[s].bad = wst[14];
    sites[s].trip = wst[13];
    sites[s].branch = wst[20];
    sites[s].novar = if wst[12] < 0 { 1 } else { 0 };
    sites[s].p0 = if wst[11] > 0 { wst[42] } else { -1 };
    sites[s].p1 = if wst[11] > 1 { wst[43] } else { -1 };
    sites[s].p2 = if wst[11] > 2 { wst[44] } else { -1 };
    sites[s].es = es;
    sites[s].alen = arg_len(src, toks, nodes, env, wst, arr);
    // The coefficient against every enclosing loop, taken here because `idx_coef` asks whether a
    // variable is assigned in the body it stands in. A loop *inside* `d` chains into `d`'s stride
    // through its own lower bound: `for i in ii*4 .. ii*4+4` moves `a[i]` four elements a lap of
    // `ii`, although `a[i]`'s index never mentions `ii`.
    let nd = wst[11];
    if nd > 2 {
        wst[14] = 0;
        sites[s].c2 = idx_coef(src, toks, nodes, wst, idx, lp_var(wst, wst[44]));
        sites[s].b2 = wst[14];
    };
    if nd > 1 {
        wst[14] = 0;
        let mut a1 = idx_coef(src, toks, nodes, wst, idx, lp_var(wst, wst[43]));
        if nd > 2 {
            a1 = a1 + sites[s].c2
                * idx_coef(src, toks, nodes, wst, lp_lonode(wst, wst[44]), lp_var(wst, wst[43]));
        };
        sites[s].c1 = a1;
        sites[s].b1 = wst[14];
    };
    if nd > 0 {
        wst[14] = 0;
        let mut a0 = idx_coef(src, toks, nodes, wst, idx, lp_var(wst, wst[42]));
        if nd > 1 {
            a0 = a0 + sites[s].c1
                * idx_coef(src, toks, nodes, wst, lp_lonode(wst, wst[43]), lp_var(wst, wst[42]));
        };
        if nd > 2 {
            a0 = a0 + sites[s].c2
                * idx_coef(src, toks, nodes, wst, lp_lonode(wst, wst[44]), lp_var(wst, wst[42]));
        };
        sites[s].c0 = a0;
        sites[s].b0 = wst[14];
    };
    wst[10] = s + 1;

    // The site is recorded and costs nothing here. Its moves are settled once the whole function
    // has been walked, by `settle_moves`, because what a site costs depends on what *else* is in
    // the loops it sits in (design §18).
    ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst)
}

// ---------------------------------------------------------------------------------------------
// **Settling the sites, innermost level outwards** (design §18).
//
// A site's moves are not a property of the site. The working set at a level is the sum, over every
// site inside that loop, of the lines that site touches per lap of it — they compete for the same
// cache — and whether *that* fits `M` decides whether every site in the level keeps its reuse. So
// the settle cannot happen where the site is seen, which is what `site_add` used to do and what
// held this slice to one site per loop.
//
// The table: for each (site, depth) the alternatives that site has over one full run of the loop
// at that depth, as a run in `lpes`.
//
//   sc[2·(3·s + d)]      where site `s`'s alternatives over its depth-`d` level start in `lpes`
//            + 1         how many there are
//   sc[24576 + k]        the `k`th site inside the level being settled
//   sc[28672 + k]        the depth at which that level sits for it
//   sc[32768 + k]        which of its alternatives is currently picked
//
// A condition's working set is carried in **bytes** here, as everywhere in this compiler — the
// report prints it directly, where `analyze.rs` keeps lines and multiplies by `B` in `brief_cond`.

// one alternative for the lines a site touches over one run of a level: the lines, the conditions
// that produced them, and whether they are one contiguous region. `LP` in `analyze.rs`.
struct Lpe { cnd: i64, n_cnd: i64, lines: i64, contig: i64 }

fn lpe_push(lpes: &mut [Lpe], wst: &mut [i64], cnd: i64, n_cnd: i64, lines: i64, contig: i64) {
    lpes[wst[45]].cnd = cnd;
    lpes[wst[45]].n_cnd = n_cnd;
    lpes[wst[45]].lines = lines;
    lpes[wst[45]].contig = contig;
    wst[45] = wst[45] + 1;
}

// append, unless an alternative written since `from` already says exactly this. The Rust dedups on
// equality and deliberately does **not** prune by dominance here: two alternatives that differ only
// in `contig` behave differently at the next level out.
fn lpe_add(facs: &[Fac], terms: &[Term], pols: &[Pol], cnds: &[Cnd], lpes: &mut [Lpe],
           wst: &mut [i64], from: i64, cnd: i64, n_cnd: i64, lines: i64, contig: i64) {
    let mut i = from;
    let mut seen = false;
    while i < wst[45] {
        if lpes[i].contig == contig && lpes[i].n_cnd == n_cnd
            && pol_eq(facs, terms, pols, lpes[i].lines, lines)
            && conds_subset(facs, terms, pols, cnds, lpes[i].cnd, lpes[i].n_cnd, cnd, n_cnd) {
            seen = true;
        }
        i = i + 1;
    }
    if !seen { lpe_push(lpes, wst, cnd, n_cnd, lines, contig); };
}

// how many alternatives the `k`th member has at the level just inside this one, and where they are
fn pick_n(sites: &[Site], sc: &[i64], k: i64) -> i64 {
    let s = sc[24576 + k];
    let pos = sc[28672 + k];
    if pos + 1 < sites[s].inloop { return sc[2 * (3 * s + pos + 1) + 1]; }
    1
}

fn pick_at(sites: &[Site], sc: &[i64], base: i64, k: i64) -> i64 {
    let s = sc[24576 + k];
    let pos = sc[28672 + k];
    if pos + 1 < sites[s].inloop { return sc[2 * (3 * s + pos + 1)] + sc[32768 + k]; }
    base
}

// the sites inside this level, and the depth at which it sits for each; the count is the answer
fn level_members(sites: &[Site], sc: &mut [i64], wst: &mut [i64], lid: i64) -> i64 {
    let mut nm = 0;
    let mut s = 0;
    while s < wst[10] {
        let mut d = 0;
        while d < sites[s].inloop {
            if site_lp(sites, s, d) == lid {
                if nm < 4000 { sc[24576 + nm] = s; sc[28672 + nm] = d; nm = nm + 1; }
                else { wst[1] = 1; };
            };
            d = d + 1;
        }
        s = s + 1;
    }
    nm
}

// is the `mi`th member the first site in this level to walk its array in a way the compiler cannot
// follow? **An arena's lines are the arena's, however many sites walk it**: a later scattered site
// on the same array adds nothing on the fitting side, because the bound is the array and it has
// already been counted. `arenas_taken` in `analyze.rs`.
fn arena_first(src: &[u8], toks: &[Token], sites: &[Site], sc: &[i64], wst: &mut [i64], nm: i64,
               mi: i64) -> bool {
    let me = sc[24576 + mi];
    let mut k = 0;
    let mut first = true;
    while k < mi {
        let q = sc[24576 + k];
        let pos = sc[28672 + k];
        let c = site_coef(sites, wst, q, pos);
        if (wst[14] == 2 || c == 0 && sites[q].novar != 0)
            && name_eq(src, toks, sites[q].arr, sites[me].arr) { first = false; }
        k = k + 1;
    }
    first
}

// One site's alternative under one outcome of the level's working-set test. `fits` says whether the
// level's working set was found to fit; when it does not, nothing in the level keeps its reuse.
fn settle_one(src: &[u8], toks: &[Token], facs: &mut [Fac], terms: &mut [Term], pols: &mut [Pol],
              pst: &mut [i64], budget: &mut [f64], cnds: &mut [Cnd], sites: &[Site],
              lpes: &mut [Lpe], sc: &mut [i64], scratch: &mut [i64], wst: &mut [i64],
              lid: i64, mi: i64, base: i64, ostart: i64, cstart: i64, ncnd: i64, fits: i64,
              first: bool) {
    let s = sc[24576 + mi];
    let pos = sc[28672 + mi];
    let alt = pick_at(sites, sc, base, mi);
    let lines = lpes[alt].lines;
    let contig = lpes[alt].contig;
    let one = pol_const(facs, terms, pols, pst, 1);
    let summed = lp_sum(facs, terms, pols, pst, scratch, wst, lid, lines);
    let coef = site_coef(sites, wst, s, pos);
    // a `while` with no induction variable gives nothing to move against, exactly as a coefficient
    // the compiler could not read does
    let scattered = wst[14] == 2 || lp_var(wst, lid) < 0;
    // affine, but the stride is not a number: never compared with `B`, always a whole line or more
    let symbolic = wst[14] == 1;

    // **The region rule.** A walk the compiler cannot follow costs a fresh line per lap, unless the
    // array it walks is small enough to stay in cache: once every line of it has been touched
    // nothing more is fetched, whatever the order. So it costs at most the array, under the
    // condition that the array fits — and that is worth saying only when the walk is longer than
    // the array, since bounding a scatter by what it scatters over buys nothing until lines are
    // revisited.
    if fits == 1 && scattered && sites[s].alen >= 0 {
        let foot = pol_scale(facs, terms, pols, pst, sites[s].alen, sites[s].es, 1);
        let touched = pol_scale(facs, terms, pols, pst, summed, 64, 1);
        if pol_dominates(facs, terms, pols, pst, budget, touched, foot) {
            let arena = pol_div_atom(facs, terms, pols, pst, foot, 0);
            let keep = if first { arena } else { pol_zero(facs, terms, pols, pst) };
            // the array's lines, which is both what the site costs when it fits and the condition
            let cf = wst[28];
            let mut i = 0;
            while i < ncnd {
                cnd_push(cnds, wst, cnds[cstart + i].ws, cnds[cstart + i].fits);
                i = i + 1;
            }
            cnd_push(cnds, wst, arena, 1);
            if conds_feasible(facs, terms, pols, pst, budget, cnds, cf, ncnd + 1) {
                lpe_add(facs, terms, pols, cnds, lpes, wst, ostart, cf, ncnd + 1, keep, 0);
            };
            let cn = wst[28];
            let mut j = 0;
            while j < ncnd {
                cnd_push(cnds, wst, cnds[cstart + j].ws, cnds[cstart + j].fits);
                j = j + 1;
            }
            cnd_push(cnds, wst, arena, 0);
            if conds_feasible(facs, terms, pols, pst, budget, cnds, cn, ncnd + 1) {
                lpe_add(facs, terms, pols, cnds, lpes, wst, ostart, cn, ncnd + 1, summed, 0);
            };
            return;
        };
    };

    let mut total = summed;
    let mut ctg = 0;
    if fits == 1 {
        // the set this site already has: itself summed when it varies with this level
        let a = lp_atom(wst, lid);
        let same = if a >= 0 && mono_mentions(facs, terms, pols, lines, a) { summed } else { lines };
        if scattered || symbolic {
            total = summed;
        } else if coef == 0 {
            // the site does not move with this loop at all: the same lines, every lap
            total = same;
            ctg = contig;
        } else {
            let cm = if coef < 0 { 0 - coef } else { coef };
            let st = cm * sites[s].stride;
            if st < 64 {
                // the slide: how far the site walks over one full run of this level, in lines, and
                // floored at one — a walk that covers less than a line still crosses one
                let trips = lp_sum(facs, terms, pols, pst, scratch, wst, lid, one);
                let raw = pol_scale(facs, terms, pols, pst, trips, st, 1);
                let mut slide = pol_div_atom(facs, terms, pols, pst, raw, 0);
                let test = pol_scale(facs, terms, pols, pst, trips, st, 64);
                let tv = pol_as_f64(facs, terms, pols, pst, test);
                if pst[7] != 0 && tv < 1.0 { slide = one; };
                if contig == 1 {
                    total = pol_add(facs, terms, pols, pst, same, slide);
                    ctg = 1;
                } else {
                    total = pol_mul(facs, terms, pols, pst, same, slide);
                }
            };
        };
    };
    lpe_add(facs, terms, pols, cnds, lpes, wst, ostart, cstart, ncnd, total, ctg);
}

// One combination of the members' alternatives: their working sets add, the level's test is taken
// once for all of them, and the outcome is emitted for the one member being filled in.
fn settle_combo(src: &[u8], toks: &[Token], facs: &mut [Fac], terms: &mut [Term], pols: &mut [Pol],
                pst: &mut [i64], budget: &mut [f64], cnds: &mut [Cnd], sites: &[Site],
                lpes: &mut [Lpe], sc: &mut [i64], scratch: &mut [i64], wst: &mut [i64],
                lid: i64, nm: i64, mi: i64, base: i64, ostart: i64, first: bool) {
    let b = pol_atom(facs, terms, pols, pst, 0);
    let cstart = wst[28];
    let mut ws = pol_zero(facs, terms, pols, pst);
    let mut k = 0;
    while k < nm {
        let alt = pick_at(sites, sc, base, k);
        ws = pol_add(facs, terms, pols, pst, ws, lpes[alt].lines);
        let mut ci = 0;
        while ci < lpes[alt].n_cnd {
            let mut seen = false;
            let mut j = 0;
            while j < wst[28] - cstart {
                if cnds[cstart + j].fits == cnds[lpes[alt].cnd + ci].fits
                    && pol_eq(facs, terms, pols, cnds[cstart + j].ws, cnds[lpes[alt].cnd + ci].ws) {
                    seen = true;
                }
                j = j + 1;
            }
            if !seen {
                cnd_push(cnds, wst, cnds[lpes[alt].cnd + ci].ws, cnds[lpes[alt].cnd + ci].fits);
            };
            ci = ci + 1;
        }
        k = k + 1;
    }
    let ncnd = wst[28] - cstart;
    if !conds_feasible(facs, terms, pols, pst, budget, cnds, cstart, ncnd) { return; };

    // a working set that varies with this level's variable is tested at the variable's largest
    let a = lp_atom(wst, lid);
    let mut test = ws;
    let mut testable = true;
    if a >= 0 && mono_mentions(facs, terms, pols, ws, a) {
        let sg = pol_atom_signs(facs, terms, pols, ws, a);
        if sg > 0 {
            let lst = lp_last(facs, terms, pols, pst, wst, lid);
            test = pol_subst(facs, terms, pols, pst, ws, a, lst);
        } else if sg < 0 {
            test = pol_subst(facs, terms, pols, pst, ws, a, lp_lo(wst, lid));
        } else {
            testable = false;
        };
    };
    // **A condition's working set is carried in lines**, as `analyze.rs` carries it, and the report
    // multiplies by `B` when it prints. Not because either unit reads better, but because
    // `dominates` compares monomials exponent by exponent and is *not* scale-invariant: in lines
    // `2·n + n² + 8·n²/B` dominates `2 + 8·n/B + n`, and in bytes the same pair does not, which
    // left `matmul` with a fourth regime that the comparison should have ruled out.
    let v = pol_num_at_b(facs, terms, pols, pst, test, 64.0) * 64.0;
    if !testable {
        // no single extreme to test at, so it is assumed not to fit. Every assumption rounds up.
        settle_one(src, toks, facs, terms, pols, pst, budget, cnds, sites, lpes, sc, scratch, wst,
                   lid, mi, base, ostart, cstart, ncnd, 0, first);
        return;
    };
    if pst[7] != 0 {
        let fits = if v < 2097152.0 { 1 } else { 0 };
        settle_one(src, toks, facs, terms, pols, pst, budget, cnds, sites, lpes, sc, scratch, wst,
                   lid, mi, base, ostart, cstart, ncnd, fits, first);
        return;
    };
    // symbolic: both regimes stand, each under its own condition
    let cf = wst[28];
    let mut i = 0;
    while i < ncnd {
        cnd_push(cnds, wst, cnds[cstart + i].ws, cnds[cstart + i].fits);
        i = i + 1;
    }
    cnd_push(cnds, wst, test, 1);
    if conds_feasible(facs, terms, pols, pst, budget, cnds, cf, ncnd + 1) {
        settle_one(src, toks, facs, terms, pols, pst, budget, cnds, sites, lpes, sc, scratch, wst,
                   lid, mi, base, ostart, cf, ncnd + 1, 1, first);
    };
    let cn = wst[28];
    let mut j = 0;
    while j < ncnd {
        cnd_push(cnds, wst, cnds[cstart + j].ws, cnds[cstart + j].fits);
        j = j + 1;
    }
    cnd_push(cnds, wst, test, 0);
    if conds_feasible(facs, terms, pols, pst, budget, cnds, cn, ncnd + 1) {
        settle_one(src, toks, facs, terms, pols, pst, budget, cnds, sites, lpes, sc, scratch, wst,
                   lid, mi, base, ostart, cn, ncnd + 1, 0, first);
    };
}

// Every combination of one alternative per member, for one member's column of the table. The
// enumeration is re-run per member rather than stored, so that each member's alternatives land
// contiguously in the bump arena; the combinations are the same every time.
fn settle_level(src: &[u8], toks: &[Token], facs: &mut [Fac], terms: &mut [Term], pols: &mut [Pol],
                pst: &mut [i64], budget: &mut [f64], cnds: &mut [Cnd], sites: &[Site],
                lpes: &mut [Lpe], sc: &mut [i64], scratch: &mut [i64], wst: &mut [i64],
                lid: i64, nm: i64, base: i64) {
    let mut mi = 0;
    while mi < nm {
        let s = sc[24576 + mi];
        let pos = sc[28672 + mi];
        let ostart = wst[45];
        let first = arena_first(src, toks, sites, sc, wst, nm, mi);
        let mut c = 0;
        while c < nm { sc[32768 + c] = 0; c = c + 1; }
        let mut more = true;
        while more {
            settle_combo(src, toks, facs, terms, pols, pst, budget, cnds, sites, lpes, sc, scratch,
                         wst, lid, nm, mi, base, ostart, first);
            let mut k = 0;
            let mut carry = true;
            while carry && k < nm {
                sc[32768 + k] = sc[32768 + k] + 1;
                if sc[32768 + k] < pick_n(sites, sc, k) { carry = false; }
                else { sc[32768 + k] = 0; k = k + 1; };
            }
            if carry { more = false; };
        }
        sc[2 * (3 * s + pos)] = ostart;
        sc[2 * (3 * s + pos) + 1] = wst[45] - ostart;
        mi = mi + 1;
    }
}

// one site's whole cost, in bytes: its alternatives over its outermost level, each a line count
fn site_top(facs: &mut [Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64],
            budget: &mut [f64], cnds: &mut [Cnd], pcs: &mut [Pce], cks: &mut [Ck],
            sites: &[Site], lpes: &[Lpe], sc: &[i64], wst: &mut [i64], s: i64) -> i64 {
    let b = pol_atom(facs, terms, pols, pst, 0);
    if sites[s].inloop == 0 {
        return ck_one(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, b);
    }
    let ts = sc[2 * (3 * s)];
    let tn = sc[2 * (3 * s) + 1];
    if tn <= 0 {
        wst[1] = 1;
        return ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst);
    }
    let start = wst[29];
    let mut i = 0;
    while i < tn {
        let mv = pol_mul(facs, terms, pols, pst, lpes[ts + i].lines, b);
        pce_push(pcs, wst, lpes[ts + i].cnd, lpes[ts + i].n_cnd, mv);
        i = i + 1;
    }
    ck_close(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, start)
}

// The sites of one `if` arm, summed — with every `if` nested directly in it contributing the
// *larger* of its two arms rather than their sum, because only one of them happens. `group` in
// `analyze.rs`; the tag tree is `wst[500 + q]`, the arm each `if` sits in.
fn group_moves(facs: &mut [Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64],
               budget: &mut [f64], cnds: &mut [Cnd], pcs: &mut [Pce], cks: &mut [Ck],
               sites: &[Site], lpes: &[Lpe], sc: &[i64], wst: &mut [i64], tag: i64) -> i64 {
    let mut total = ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst);
    let mut s = 0;
    while s < wst[10] {
        if sites[s].branch == tag {
            let t = site_top(facs, terms, pols, pst, budget, cnds, pcs, cks, sites, lpes, sc, wst, s);
            total = ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, total, t);
        };
        s = s + 1;
    }
    let mut q = 1;
    while q <= wst[21] {
        if q < 3000 && wst[500 + q] == tag {
            let t = group_moves(facs, terms, pols, pst, budget, cnds, pcs, cks, sites, lpes, sc,
                                wst, q * 2);
            let e = group_moves(facs, terms, pols, pst, budget, cnds, pcs, cks, sites, lpes, sc,
                                wst, q * 2 + 1);
            let m = ck_max(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, t, e);
            total = ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, total, m);
        };
        q = q + 1;
    }
    total
}

fn settle_moves(src: &[u8], toks: &[Token], facs: &mut [Fac], terms: &mut [Term],
                pols: &mut [Pol], pst: &mut [i64], budget: &mut [f64], cnds: &mut [Cnd],
                pcs: &mut [Pce], cks: &mut [Ck], sites: &[Site], lpes: &mut [Lpe],
                sc: &mut [i64], scratch: &mut [i64], wst: &mut [i64]) -> i64 {
    wst[45] = 0;
    let one = pol_const(facs, terms, pols, pst, 1);
    // the alternative a site has at the level just inside its innermost: one line, contiguous
    let base = wst[45];
    lpe_push(lpes, wst, 0, 0, one, 1);
    let mut lid = wst[41] - 1;
    while lid >= 0 {
        let nm = level_members(sites, sc, wst, lid);
        if nm > 0 {
            settle_level(src, toks, facs, terms, pols, pst, budget, cnds, sites, lpes, sc, scratch,
                         wst, lid, nm, base);
        };
        lid = lid - 1;
    }
    group_moves(facs, terms, pols, pst, budget, cnds, pcs, cks, sites, lpes, sc, wst, 0)
}

fn m_expr(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], strs: &[Str], flds: &[Fld],
          ntys: &[i64], sigs: &[Sig], ptys: &[i64], fm: &[i64], ffoot: &[i64],
            facs: &mut [Fac], terms: &mut [Term], pols: &mut [Pol],
            pst: &mut [i64], env: &mut [Env], cof: &mut [Cof], sites: &mut [Site], cks: &mut [Ck], cnds: &mut [Cnd], pcs: &mut [Pce], budget: &mut [f64],
            resid: &mut [Res], rargs: &mut [i64], subst: &mut [i64], slay: &[i64], wst: &mut [i64], n: i64) -> i64 {
    if n < 0 || wst[1] != 0 { return ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst); }
    let k = nodes[n].kind;
    if k == 68 {
        let i = m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[n].b);
        let s = site_add(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[n].a, nodes[n].b, -1);
        return ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, i, s);
    }
    if k == 69 {
        let base = nodes[n].a;
        if nodes[base].kind == 68 {
            let i = m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[base].b);
            let s = site_add(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[base].a, nodes[base].b, nodes[n].b);
            return ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, i, s);
        }
        return m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, base);
    }
    if k == 71 {
        let mut acc = ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst);
        let mut a = nodes[n].b;
        while a >= 0 {
            let w = m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, a);
            acc = ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, acc, w);
            a = nodes[a].next;
        }
        // `println`, `min` and `max` touch nothing of their own
        if name_is_println(src, toks, nodes[n].a) || name_is_min(src, toks, nodes[n].a)
            || name_is_max(src, toks, nodes[n].a) {
            return acc;
        }
        let mut si = -1;
        let mut i = 0;
        while sigs[i].name >= 0 {
            if si < 0 && name_eq(src, toks, sigs[i].name, nodes[n].a) { si = i; }
            i += 1;
        }
        if wst[11] != 0 {
            // a callee that touches nothing has nothing to replay
            if si >= 0 && si != wst[24] && fm[si] >= 0 && ck_plain(pcs, cks, fm[si])
                && pol_is_zero(pols, ck_poly(pcs, cks, fm[si])) && !walks_anything(ffoot, sigs, si) {
                return acc;
            }
            if si < 0 || fm[si] < 0 || si == wst[24] || wst[13] < 0 {
                wst[1] = 1;
                return acc;
            }
            // **The cold/warm replay.** The first lap finds nothing of the callee's resident and
            // pays in full; every later lap finds what the previous one left. So the loop costs
            // `cold + (t − 1)·warm`, and `warm` is `cold` less the callee's own footprints —
            // each credited only where it fits in `M`. `warm.nt` is the golden this exists for: it
            // calls `sum` twenty times over a 1.6 MB array and twenty times over a 32 MB one, and
            // pays once for the first and twenty times for the second.
            let cold = call_moves(src, toks, nodes, types, strs, flds, sigs, ptys, fm, ffoot, facs,
                                  terms, pols, pst, env, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, n, si);
            if wst[1] != 0 { return acc; }
            let warm = call_moves(src, toks, nodes, types, strs, flds, sigs, ptys, fm, ffoot, facs,
                                  terms, pols, pst, env, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, n, si);
            if wst[1] != 0 { return acc; }
            let one = pol_const(facs, terms, pols, pst, 1);
            let rest = pol_sub(facs, terms, pols, pst, wst[13], one);
            if !ck_plain(pcs, cks, warm) || !ck_plain(pcs, cks, cold) {
                wst[1] = 1;
                return acc;
            }
            let laps = pol_mul(facs, terms, pols, pst, ck_poly(pcs, cks, warm), rest);
            let total = pol_add(facs, terms, pols, pst, ck_poly(pcs, cks, cold), laps);
            let ct = ck_one(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, total);
            return ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, acc, ct);
        }
        if si == wst[24] {
            // a self-call: the recurrence is solved once the body is walked, so the call itself
            // adds nothing here beyond its arguments. The arguments are recorded for the solver,
            // which is the same one the `work` column uses.
            let k = wst[23];
            wst[23] = k + 1;
            if k < 4 {
                let mut p2 = 0;
                let mut a2 = nodes[n].b;
                while p2 < 8 {
                    let v = if a2 >= 0 {
                        let inner2 = if nodes[a2].kind == 73 { nodes[a2].a } else { a2 };
                        let vv = val_of(src, toks, nodes, facs, terms, pols, pst, env, wst, inner2);
                        if vv >= 0 { vv } else { arg_len(src, toks, nodes, env, wst, inner2) }
                    } else { -1 };
                    rargs[k * 8 + p2] = v;
                    if a2 >= 0 { a2 = nodes[a2].next; };
                    p2 += 1;
                }
            }
            return acc;
        }
        if si < 0 || fm[si] < 0 {
            wst[1] = 1;
            return acc;
        }
        let cm = call_moves(src, toks, nodes, types, strs, flds, sigs, ptys, fm, ffoot, facs, terms,
                            pols, pst, env, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, n, si);
        return ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, acc, cm);
    }
    if k == 75 {
        // **the two arms are alternatives, so the traffic is the larger and not the sum** — the
        // same rule `work` follows, and the reason `vm.nt`'s dispatch chain costs three lines a
        // lap and not ten. Sites still carry a branch tag, because two reads of one address on
        // opposite sides of an `if` are two sites even though only one of them happens.
        let c = m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[n].a);
        let saved = wst[20];
        wst[21] = wst[21] + 1;
        // the arm this `if` itself sits in, so that the settle pass can rebuild the tree: a tag
        // is unique per arm but says nothing about what encloses it (design §18)
        if wst[21] < 3000 { wst[500 + wst[21]] = saved; } else { wst[1] = 1; };
        wst[20] = wst[21] * 2;
        // recursive calls count along the heavier arm only, as they do for `work`: `bsearch` calls
        // itself on each side and only one of them happens
        let before = wst[23];
        let t = m_block(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[n].b);
        let n_then = wst[23] - before;
        wst[23] = before;
        wst[20] = wst[21] * 2 + 1;
        let e = m_block(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[n].c);
        let n_else = wst[23] - before;
        wst[23] = before + if n_then > n_else { n_then } else { n_else };
        wst[20] = saved;
        let m = ck_max(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, t, e);
        return ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, c, m);
    }
    if k == 76 {
        return m_block(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, n);
    }
    if k == 66 {
        let a = m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[n].a);
        let b = m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[n].b);
        return ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, a, b);
    }
    if k == 67 || k == 74 {
        return m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[n].a);
    }
    if k == 70 {
        let mut acc = ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst);
        let mut fi = nodes[n].b;
        while fi >= 0 {
            let v = m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[fi].b);
            acc = ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, acc, v);
            fi = nodes[fi].next;
        }
        return acc;
    }
    if k == 77 || k == 78 { wst[1] = 1; };
    ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst)
}

// The callee's moves in the caller's atoms, less the credit, with the resident set replaced by the
// callee's footprints. The credit is the **cross product** of footprints and resident ranges,
// matched by root, and each one applies only where the array it credits fits in `M` — all three of
// those read off `NEANT_DEBUG_CALLS`, not deduced.
fn call_moves(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], strs: &[Str], flds: &[Fld],
              sigs: &[Sig], ptys: &[i64], fm: &[i64], ffoot: &[i64], facs: &mut [Fac],
              terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64], env: &mut [Env],
              cks: &mut [Ck], cnds: &mut [Cnd], pcs: &mut [Pce], budget: &mut [f64], resid: &mut [Res], rargs: &mut [i64],
              subst: &mut [i64], slay: &[i64], wst: &mut [i64], n: i64, si: i64) -> i64 {
    // A callee's pieces come up with it: each polynomial and each condition is substituted into
    // the caller's atoms, and `ck_add` sorts out what the combination means. §13's single fork
    // could not carry a callee that forks on two conditions; a piece list can.
    let c = fm[si];
    let start = wst[29];
    let mut newn = 0;
    wst[27] = 0;
    let mut credit = pol_zero(facs, terms, pols, pst);

    // first the substitution map: one pass over the parameters, recorded for reuse per piece
    let mut p = 0;
    let mut a = nodes[n].b;
    while p < sigs[si].n_params {
        let inner = if a >= 0 && nodes[a].kind == 73 { nodes[a].a } else { a };
        let v = if a >= 0 { val_of(src, toks, nodes, facs, terms, pols, pst, env, wst, inner) } else { -1 };
        let len = if v >= 0 { v } else { arg_len(src, toks, nodes, env, wst, inner) };
        subst[p] = len;
        let t = ptys[sigs[si].params + p];
        if ffoot[si * 16 + p] != 0 && is_soa(types, slay, t) { wst[1] = 1; };
        if ffoot[si * 16 + p] == 2 { wst[27] = 1; };
        if ffoot[si * 16 + p] == 1 && t >= 0 && inner >= 0 && nodes[inner].kind == 65 {
            let es = elem_bytes(types, strs, flds, t);
            let al = arg_len(src, toks, nodes, env, wst, inner);
            if es < 0 || al < 0 {
                wst[1] = 1;
            } else {
                resid[64 + newn].root = env_root(src, toks, env, wst, nodes[inner].a);
                resid[64 + newn].foot = pol_scale(facs, terms, pols, pst, al, es, 1);
                newn += 1;
            }
        }
        if a >= 0 { a = nodes[a].next; };
        p += 1;
    }
    // every footprint against every resident range
    let mut i = 0;
    while i < newn {
        let mut r = 0;
        while r < wst[26] {
            if name_eq(src, toks, resid[r].root, resid[64 + i].root) {
                let bytes = pol_as_int(facs, terms, pols, pst, resid[r].foot);
                if pst[4] == 0 {
                    wst[1] = 1;
                } else if bytes < 2097152 {
                    credit = pol_add(facs, terms, pols, pst, credit, resid[r].foot);
                }
            }
            r += 1;
        }
        i += 1;
    }
    if wst[27] != 0 { newn = 0; };
    let mut k = 0;
    while k < newn {
        resid[k].root = resid[64 + k].root;
        resid[k].foot = resid[64 + k].foot;
        k += 1;
    }
    wst[26] = newn;

    // then each of the callee's pieces, substituted and credited
    let mut pi = 0;
    while pi < cks[c].n_pce {
        let src_p = cks[c].pce + pi;
        let mut poly = pcs[src_p].poly;
        let cstart = wst[28];
        let mut ci = 0;
        while ci < pcs[src_p].n_cnd {
            let mut w = cnds[pcs[src_p].cnd + ci].ws;
            let mut q = 0;
            while q < sigs[si].n_params {
                if subst[q] >= 0 { w = pol_subst(facs, terms, pols, pst, w, 3 + q, subst[q]); }
                else if mono_mentions(facs, terms, pols, w, 3 + q) { wst[1] = 1; };
                q += 1;
            }
            cnd_push(cnds, wst, w, cnds[pcs[src_p].cnd + ci].fits);
            ci += 1;
        }
        let mut q2 = 0;
        while q2 < sigs[si].n_params {
            if subst[q2] >= 0 { poly = pol_subst(facs, terms, pols, pst, poly, 3 + q2, subst[q2]); }
            else if mono_mentions(facs, terms, pols, poly, 3 + q2) { wst[1] = 1; };
            q2 += 1;
        }
        let net = pol_sub(facs, terms, pols, pst, poly, credit);
        pce_push(pcs, wst, cstart, pcs[src_p].n_cnd, net);
        pi += 1;
    }
    ck_close(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, start)
}

fn m_block(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], strs: &[Str], flds: &[Fld],
           ntys: &[i64], sigs: &[Sig], ptys: &[i64], fm: &[i64], ffoot: &[i64],
            facs: &mut [Fac], terms: &mut [Term], pols: &mut [Pol],
            pst: &mut [i64], env: &mut [Env], cof: &mut [Cof], sites: &mut [Site], cks: &mut [Ck], cnds: &mut [Cnd], pcs: &mut [Pce], budget: &mut [f64],
            resid: &mut [Res], rargs: &mut [i64], subst: &mut [i64], slay: &[i64], wst: &mut [i64], n: i64) -> i64 {
    if n < 0 || wst[1] != 0 { return ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst); }
    let saved = wst[0];
    let mut acc = ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst);
    let mut s = nodes[n].a;
    while s >= 0 && wst[1] == 0 {
        let w = m_stmt(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, s);
        acc = ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, acc, w);
        s = nodes[s].next;
    }
    let t = m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[n].b);
    wst[0] = saved;
    ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, acc, t)
}

fn m_stmt(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], strs: &[Str], flds: &[Fld],
          ntys: &[i64], sigs: &[Sig], ptys: &[i64], fm: &[i64], ffoot: &[i64],
            facs: &mut [Fac], terms: &mut [Term], pols: &mut [Pol],
            pst: &mut [i64], env: &mut [Env], cof: &mut [Cof], sites: &mut [Site], cks: &mut [Ck], cnds: &mut [Cnd], pcs: &mut [Pce], budget: &mut [f64],
            resid: &mut [Res], rargs: &mut [i64], subst: &mut [i64], slay: &[i64], wst: &mut [i64], n: i64) -> i64 {
    let k = nodes[n].kind;
    if k == 90 {
        let init = nodes[n].c;
        if nodes[init].kind == 77 || nodes[init].kind == 78 || nodes[init].kind == 64 {
            // building an array streams every byte of it, and leaves it **not** resident — which
            // the instrumentation says plainly and no amount of reasoning had
            let t = ntys[init];
            let es = elem_bytes(types, strs, flds, t);
            let mut len = -1;
            if nodes[init].kind == 78 {
                len = val_of(src, toks, nodes, facs, terms, pols, pst, env, wst, nodes[init].b);
            } else if nodes[init].kind == 64 {
                len = pol_const(facs, terms, pols, pst, bytes_len(src, toks, nodes[init].a));
            } else {
                let mut e = nodes[init].a;
                let mut count = 0;
                while e >= 0 {
                    count += 1;
                    e = nodes[e].next;
                }
                len = pol_const(facs, terms, pols, pst, count);
            }
            if es < 0 || len < 0 {
                wst[1] = 1;
                return ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst);
            }
            env_add(env, wst, nodes[n].a, -1, len);
            let mut bytes = pol_scale(facs, terms, pols, pst, len, es, 1);
            // a build inside a loop happens every lap. A *site*'s cost already carries its loop's
            // trip count, but this is not a site — it is a flat stream — so it is the one thing the
            // walk has to multiply itself.
            if wst[11] != 0 && wst[13] >= 0 {
                bytes = pol_mul(facs, terms, pols, pst, bytes, wst[13]);
            };
            return ck_one(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, bytes);
        }
        let w = m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, init);
        // the same environment the work walk keeps, and for the same reason: a `while`'s induction
        // variable needs its entry value, and an array's length is what a loop bound reads
        let t = ntys[init];
        if t >= 0 && (types[t].kind == 5 || types[t].kind == 6) {
            let inner = if nodes[init].kind == 73 { nodes[init].a } else { init };
            // `let v = &xs` roots `v` at `xs`: a call over `v` is credited against what a call
            // over `xs` left resident, which is the whole of `dot.nt`'s last two calls
            let r = if inner >= 0 && nodes[inner].kind == 65 {
                env_root(src, toks, env, wst, nodes[inner].a)
            } else { nodes[n].a };
            env_add_rooted(env, wst, nodes[n].a, -1, arg_len(src, toks, nodes, env, wst, inner), r);
        } else {
            env_add(env, wst, nodes[n].a, val_of(src, toks, nodes, facs, terms, pols, pst, env, wst, init), -1);
        }
        return w;
    }
    if k == 91 {
        let mut acc = m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[n].b);
        let tgt = nodes[n].a;
        if nodes[tgt].kind == 68 {
            let i = m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[tgt].b);
            let sp = site_add(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[tgt].a, nodes[tgt].b, -1);
            acc = ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, acc, i);
            acc = ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, acc, sp);
        } else if nodes[tgt].kind == 69 && nodes[nodes[tgt].a].kind == 68 {
            let b = nodes[tgt].a;
            let i = m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[b].b);
            let sp = site_add(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[b].a, nodes[b].b, nodes[tgt].b);
            acc = ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, acc, i);
            acc = ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, acc, sp);
        } else if nodes[tgt].kind == 65 {
            if ntys[tgt] >= 0 && (types[ntys[tgt]].kind == 5 || types[ntys[tgt]].kind == 6) {
                // `ys = xs` **copies**, so it streams one array's worth — the same decision the
                // emitter makes and for the same reason (arrays design §7). Where the Rust proves
                // the assignment is in place it charges nothing, and there the two reports differ
                // on purpose, exactly as the `work` column does.
                let es = elem_bytes(types, strs, flds, ntys[tgt]);
                let srcn = if nodes[n].b >= 0 && nodes[nodes[n].b].kind == 65 { nodes[nodes[n].b].a } else { -1 };
                let len = if srcn >= 0 { arg_len_of(src, toks, env, wst, srcn) } else { -1 };
                if es < 0 || len < 0 {
                    wst[1] = 1;
                } else {
                    let e = env_find(src, toks, env, wst, nodes[tgt].a);
                    if e >= 0 { env[e].len = len; };
                    let mut bytes = pol_scale(facs, terms, pols, pst, len, es, 1);
                    if wst[11] != 0 && wst[13] >= 0 {
                        bytes = pol_mul(facs, terms, pols, pst, bytes, wst[13]);
                    };
                    let cb = ck_one(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, bytes);
                    acc = ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, acc, cb);
                }
            } else {
                let e = env_find(src, toks, env, wst, nodes[tgt].a);
                if e >= 0 { env[e].val = -1; }
            }
        }
        return acc;
    }
    if k == 92 || k == 93 {
        // A *site* inside two loops is where reuse lives, and reuse is what `settle_moves` exists
        // for — but a nested loop that touches no array has no reuse to get wrong, and refusing it
        // was refusing arithmetic. `site_add` is where the depth is actually checked.
        let saved = wst[0];
        let depth = wst[11];
        let svar = wst[12];
        let strip = wst[13];
        let sbody = wst[22];
        // the open loops, by depth: wst[30+d] the variable, wst[32+d] the trip, wst[34+d] the
        // lower bound's node. A site's stride against an *outer* loop reads the inner loop's
        // bound — `for i in ii*4 .. ii*4+4` moves `a[i]` by four elements a lap of `ii`.
        wst[11] = depth + 1;
        let mut acc = ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst);
        if k == 92 {
            let a = m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[n].b);
            let b = m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[n].c);
            let lo = val_of(src, toks, nodes, facs, terms, pols, pst, env, wst, nodes[n].b);
            let hi = val_of(src, toks, nodes, facs, terms, pols, pst, env, wst, nodes[n].c);
            if lo < 0 || hi < 0 {
                wst[1] = 1;
                return ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst);
            }
            wst[13] = pol_sub(facs, terms, pols, pst, hi, lo);
            wst[12] = nodes[n].a;
            wst[22] = nodes[n].d;
            if depth < 2 {
                wst[30 + depth] = nodes[n].a;
                wst[32 + depth] = wst[13];
                wst[34 + depth] = nodes[n].b;
            };
            // the loop variable is bound to an atom, as it is in the work walk: a nested loop's
            // bound may name it, and `for j in i..4` is unbounded without it
            let atom = wst[2];
            wst[2] = atom + 1;
            let av = pol_atom(facs, terms, pols, pst, atom);
            env_add(env, wst, nodes[n].a, av, -1);
            lp_open(wst, depth, nodes[n].a, atom, lo, 1, wst[13], nodes[n].b);
            let body = m_block(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[n].d);
            acc = ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, a, b);
            acc = ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, acc, body);
        } else {
            let t = while_trip(src, toks, nodes, facs, terms, pols, pst, env, wst, cof, n);
            if t < 0 {
                wst[1] = 1;
                return ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst);
            }
            let a = m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[n].a);
            let b = m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[n].b);
            wst[13] = t;
            // a `while` with a measure has no loop variable at all, so nothing in it is known to
            // move contiguously; one with an induction variable has that variable
            wst[12] = wst[15];
            wst[22] = nodes[n].c;
            if depth < 2 {
                wst[30 + depth] = wst[15];
                wst[32 + depth] = t;
                wst[34 + depth] = -1;
            };
            // a `while` has no loop atom: nothing accumulated in it can be summed over its
            // variable, which is `LoopRec.atom = None` in `analyze.rs`
            lp_open(wst, depth, wst[15], -1, -1, 1, t, -1);
            let body = m_block(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[n].c);
            acc = ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, a, b);
            acc = ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, acc, body);
        }
        wst[0] = saved;
        wst[11] = depth;
        wst[12] = svar;
        wst[13] = strip;
        wst[22] = sbody;
        return acc;
    }
    if k == 94 { return ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst); }
    if k == 95 || k == 96 {
        return m_expr(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[n].a);
    }
    wst[1] = 1;
    ck_zero(facs, terms, pols, pst, budget, cnds, pcs, cks, wst)
}

// The moves of a function that calls nothing: its sites, settled by the rule in §11. −1 when this
// slice cannot say, which a call, a second loop, an array built here or a `moves 0` that was never
// looked for all produce.
fn m_func(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], strs: &[Str], flds: &[Fld],
          ntys: &[i64], sigs: &[Sig], ptys: &[i64], fm: &[i64], ffoot: &[i64],
          facs: &mut [Fac], terms: &mut [Term],
          pols: &mut [Pol], pst: &mut [i64], env: &mut [Env], cof: &mut [Cof],
          sites: &mut [Site], cks: &mut [Ck], cnds: &mut [Cnd], pcs: &mut [Pce], budget: &mut [f64], resid: &mut [Res],
          rargs: &mut [i64], logs: &mut [i64], scratch: &mut [i64], subst: &mut [i64],
          slay: &[i64], lpes: &mut [Lpe], sc: &mut [i64], wst: &mut [i64], f: i64, si: i64) -> i64 {
    wst[0] = 0;
    wst[1] = 0;
    wst[10] = 0;
    wst[11] = 0;
    wst[41] = 0;
    wst[12] = -1;
    wst[13] = -1;
    wst[24] = si;
    wst[26] = 0;
    wst[2] = 1003;
    wst[20] = 0;
    wst[21] = 0;
    wst[22] = -1;
    let mut p = nodes[f].b;
    let mut i = 0;
    while p >= 0 {
        let t = ptys[sigs[si].params + i];
        let a = pol_atom(facs, terms, pols, pst, 3 + i);
        if t >= 0 && (types[t].kind == 5 || types[t].kind == 6) {
            env_add(env, wst, nodes[p].a, -1, a);
        } else {
            env_add(env, wst, nodes[p].a, a, -1);
        }
        i += 1;
        p = nodes[p].next;
    }
    wst[23] = 0;
    let walked = m_block(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, fm, ffoot, facs, terms, pols, pst, env, cof, sites, cks, cnds, pcs, budget, resid, rargs, subst, slay, wst, nodes[f].d);
    // the sites, settled now that every level is known — see `settle_moves`
    let sm = settle_moves(src, toks, facs, terms, pols, pst, budget, cnds, pcs, cks, sites, lpes,
                          sc, scratch, wst);
    let total = ck_add(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, walked, sm);
    if wst[1] != 0 { return -1; }
    if wst[23] == 0 { return total; }
    // the same solver the `work` column uses; a forked body would need the recurrence solved in
    // both regimes, which is a second condition and out
    if !ck_plain(pcs, cks, total) { return -1; }
    let solved = solve_recurrence(types, sigs, ptys, facs, terms, pols, logs, pst, rargs, scratch, si, ck_poly(pcs, cks, total), wst[23]);
    if solved < 0 { return -1; }
    ck_one(facs, terms, pols, pst, budget, cnds, pcs, cks, wst, solved)
}

// does this function take or build an array whose element is struct `sid`
fn touches_struct(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], sigs: &[Sig],
                  ptys: &[i64], sid: i64, f: i64, si: i64) -> bool {
    let mut p = 0;
    let mut hit = false;
    while p < sigs[si].n_params {
        let t = ptys[sigs[si].params + p];
        if t >= 0 && (types[t].kind == 5 || types[t].kind == 6) {
            let e = types[t].elem;
            if e >= 0 && types[e].kind == 7 && types[e].elem == sid { hit = true; }
        }
        p += 1;
    }
    if builds_struct(nodes, types, sid, nodes[f].d) { hit = true; };
    hit
}

// does this block build an array of struct `sid`
fn builds_struct(nodes: &[Node], types: &[Ty], sid: i64, b: i64) -> bool {
    if b < 0 { return false; }
    let mut hit = false;
    let mut s = nodes[b].a;
    while s >= 0 {
        let k = nodes[s].kind;
        if k == 90 {
            let init = nodes[s].c;
            if nodes[init].kind == 78 && nodes[nodes[init].a].kind == 70 { hit = true; }
        } else if k == 92 || k == 93 {
            let inner = if k == 92 { nodes[s].d } else { nodes[s].c };
            if builds_struct(nodes, types, sid, inner) { hit = true; }
        }
        s = nodes[s].next;
    }
    hit
}

// ---- the layout choice ----
//
// For each struct: walk every function twice, once with that struct AoS and once SoA, and sum what
// the touching ones move at a reference point — `B` and `M` from the machine, every size variable
// at a million. **Strictly fewer bytes wins; a tie is AoS**, the same margin `choose_layouts` uses.
// A function this slice declines contributes nothing to either side, exactly as an `Unknown`
// contributes zero there, so the choice is made on whatever evidence there is and no more.
fn choose_layouts(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], strs: &[Str],
                  flds: &[Fld], ntys: &[i64], sigs: &[Sig], ptys: &[i64], slay: &mut [i64],
                  first: i64, n_structs: i64) {
    let mut facs = [Fac { atom: 0, exp: 0 }; 262144];
    let mut terms = [Term { fac: 0, n_fac: 0, cn: 0, cd: 0 }; 262144];
    let mut pols = [Pol { term: 0, n_term: 0 }; 262144];
    let mut logs = [-1; 1024];
    let mut pst = [0, 0, 0, 0, 0, 0, 0, 0];
    let mut env = [Env { name: 0, val: 0, len: 0, root: 0 }; 4096];
    let mut cof = [Cof { name: 0, c: 0 }; 256];
    let mut sites = [Site { arr: 0, idx: 0, inloop: 0, coef: 0, stride: 0, bad: 0, trip: 0, branch: 0, novar: 0, field: -1, p0: -1, p1: -1, p2: -1, c0: 0, c1: 0, c2: 0, b0: 0, b1: 0, b2: 0, alen: -1, es: 0 }; 4096];
    let mut cks = [Ck { pce: 0, n_pce: 0 }; 262144];
    let mut cnds = [Cnd { ws: 0, fits: 0 }; 262144];
    let mut pcs = [Pce { cnd: 0, n_cnd: 0, poly: 0 }; 262144];
    let mut subst = [-1; 64];
    let mut budget = [0.0; 4096];
    let mut resid = [Res { root: 0, foot: 0 }; 128];
    let mut rargs = [-1; 64];
    let mut scratch = [0; 64];
    let mut ffoot = [0; 65536];
    let mut fm = [-1; 4096];
    let mut lpes = [Lpe { cnd: 0, n_cnd: 0, lines: 0, contig: 0 }; 65536];
    let mut sc = [0; 40960];
    let mut wst = [0; 4096];

    let mut sid = 0;
    while sid < n_structs {
        let mut total_aos = 0.0;
        let mut total_soa = 0.0;
        let mut which = 0;
        while which < 2 {
            slay[sid] = which;
            // the arenas start over for each layout: nothing from the other one is referred to
            // again, and a walk of a whole module twice per struct would otherwise not fit
            pst[0] = 0;
            pst[1] = 0;
            pst[2] = 0;
            pst[5] = 0;
            wst[25] = 0;
            wst[28] = 0;
            wst[29] = 0;
            // two sub-passes, as the reporter does: a call to a function declared later needs its
            // callee's moves, and without them every caller declines and contributes nothing
            let mut pass = 0;
            while pass < 2 {
                let mut f = first;
                let mut si = 0;
                while f >= 0 {
                    if nodes[f].kind == 110 {
                        fm[si] = m_func(src, toks, nodes, types, strs, flds, ntys, sigs, ptys, &fm,
                                        &ffoot, &mut facs, &mut terms, &mut pols, &mut pst, &mut env,
                                        &mut cof, &mut sites, &mut cks, &mut cnds, &mut pcs,
                                        &mut budget, &mut resid, &mut rargs, &mut logs,
                                        &mut scratch, &mut subst, slay, &mut lpes, &mut sc,
                                        &mut wst, f, si);
                        foot_flags(src, toks, nodes, &sites, &mut ffoot, &wst, f, si);
                        if pass == 1 && fm[si] >= 0
                            && touches_struct(src, toks, nodes, types, sigs, ptys, sid, f, si) {
                            // the piece whose conditions hold at the reference point, and the
                            // largest of them where several do — `Cost::eval`'s own rule
                            let v = ck_eval(&facs, &terms, &pols, &mut pst, &cnds, &pcs, &cks,
                                            fm[si], 64.0, 2097152.0, 1000000.0);
                            if pst[6] == 0 {
                                if which == 0 { total_aos = total_aos + v; }
                                else { total_soa = total_soa + v; };
                            }
                        }
                        si += 1;
                    } else if nodes[f].kind == 116 {
                        si += 1;
                    }
                    f = nodes[f].next;
                }
                pass += 1;
            }
            which += 1;
        }
        slay[sid] = if total_soa < total_aos * 0.999 { 1 } else { 0 };
        sid += 1;
    }
}

// A cost's value at a point: the largest of the pieces whose conditions hold there, which is what
// `Cost::eval` does. `pst[6]` is left set when some piece could not be valued at all.
fn ck_eval(facs: &[Fac], terms: &[Term], pols: &[Pol], pst: &mut [i64], cnds: &[Cnd],
           pcs: &[Pce], cks: &[Ck], c: i64, b: f64, m: f64, size: f64) -> f64 {
    let mut best = 0.0;
    let mut any = false;
    let mut bad = 0;
    let mut i = 0;
    while i < cks[c].n_pce {
        let p = cks[c].pce + i;
        let mut holds = true;
        let mut j = 0;
        while j < pcs[p].n_cnd {
            let w = pol_eval(facs, terms, pols, pst, cnds[pcs[p].cnd + j].ws, b, m, size) * b;
            if pst[6] != 0 { bad = 1; };
            let fits = if w < m { 1 } else { 0 };
            if fits != cnds[pcs[p].cnd + j].fits { holds = false; }
            j += 1;
        }
        if holds {
            let v = pol_eval(facs, terms, pols, pst, pcs[p].poly, b, m, size);
            if pst[6] != 0 { bad = 1; };
            if !any || v > best { best = v; };
            any = true;
        }
        i += 1;
    }
    pst[6] = bad;
    best
}

// ---- printing a cost ----
//
// `lock.rs`'s `brief`: a polynomial of more than three terms shows its **highest-degree terms**
// with `≈` in front, and a condition shows its working set's leading term the same way. Nothing is
// approximated — the cost object is exact and the report is short, which is why `stencil`'s two
// regimes print the same `≈ 40·n²` while differing below the leading term.
fn pol_leading(facs: &[Fac], terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64], p: i64) -> i64 {
    let mut top = 0 - 1;
    let mut i = 0;
    while i < pols[p].n_term {
        let d = mono_var_degree(facs, terms[pols[p].term + i].fac, terms[pols[p].term + i].n_fac);
        if d > top { top = d; };
        i += 1;
    }
    let start = pst[1];
    i = 0;
    while i < pols[p].n_term {
        let t = pols[p].term + i;
        if mono_var_degree(facs, terms[t].fac, terms[t].n_fac) == top {
            terms[pst[1]].fac = terms[t].fac;
            terms[pst[1]].n_fac = terms[t].n_fac;
            terms[pst[1]].cn = terms[t].cn;
            terms[pst[1]].cd = terms[t].cd;
            pst[1] = pst[1] + 1;
        }
        i += 1;
    }
    pol_close(facs, terms, pols, pst, start)
}

fn emit_brief(out: &mut [u8], est: &mut [i64], src: &[u8], toks: &[Token], facs: &mut [Fac],
              terms: &mut [Term], pols: &mut [Pol], pst: &mut [i64], logs: &[i64], pnames: &[i64],
              parr: &[i64], p: i64, order: &mut [i64], limit: i64) {
    let mut q = p;
    if pols[p].n_term > limit {
        // `\u2248` ASCIIly unspellable, like every other symbol this printer needs
        emit_u(out, est, 226);
        emit_u(out, est, 137);
        emit_u(out, est, 136);
        emit_b(out, est, b' ');
        q = pol_leading(facs, terms, pols, pst, p);
    };
    pol_print(out, est, src, toks, facs, terms, pols, logs, pnames, parr, q, order, 0);
}
