// The second self-hosted stage (docs/self-hosting-parser-design.md), ported from
// bootstrap/src/parse.rs. **A fragment, not a standalone program**: it uses `Token` and the token
// kind numbers `compiler/lex.nt` defines, and there is no module system to import them with, so it
// is compiled by concatenating `lex.nt` then this file then a driver — which is what the eventual
// self-hosted compiler is anyway, one file.
//
// **One change from the design, found while writing it.** §3 planned a second flat `children`
// arena that every variable-arity node would slice into. That does not work: a nested block parses
// its own statements *while* the outer block is still collecting its own, so the outer block's
// entries would not be contiguous. Children are chained through the nodes themselves instead —
// each `Node` has a `next` (−1 ends the list), a parent points at the first child — which is M4's
// own arena-of-index-links, one arena instead of two, and no interleaving to get wrong.
//
// Node kinds (design §2), disjoint from lex.nt's 0-57 so a mix-up is loud:
//   60 Int  61 Float  62 Bool  63 Byte  64 Bytes  65 Var  66 Binary  67 Unary  68 Index
//   69 Field  72 Len (`.len()`)  73 Ref  74 Cast  75 If  76 Block  78 ArrayRepeat (`[e; n]`)
//   90 Let  91 Assign  92 For  93 While  94 Break  95 ExprStmt  96 Return
//   100 TyNamed  101 TyUnit  102 TyArray  103 TySlice  104 TyOwned
//   110 Func  111 Param  112 StructDef  113 FieldDef  114 FieldInit  70 StructLit
//   116 ExternFn (a signature and no body; its `uses` clause is dropped)
//   115 a struct-name marker, laid down before parsing and never part of the tree
// Out of this slice, by design §6: MethodCall/chains other than `.len()`,
// Lambda(79), Comprehension(80), `extern` and attributes. Structs were added afterwards, the
// first widening of the slice (docs/self-hosting-structs.md).
//
// BinOp: 0 Add 1 Sub 2 Mul 3 Div 4 Rem 5 Eq 6 Ne 7 Lt 8 Le 9 Gt 10 Ge 11 And 12 Or
// UnOp:  0 Neg 1 Not
//
// `st` is the parser's whole mutable state, the one-element-array idiom `tests/golden/parse.nt`
// already uses, widened: st[0] = the token position, st[1] = the next free node, st[2] = 1 once a
// parse has failed, st[3] = how many struct-name markers were laid down, st[4] = the depth of
// `if`/`while`/`for` heads currently open. Every function returns −1 immediately once st[2] is
// set, so one error stops the parse the way parse.rs's `?` does, without unwinding.

struct Node { kind: i64, a: i64, b: i64, c: i64, d: i64, ival: i64, next: i64 }

fn peek(toks: &[Token], st: &[i64]) -> i64 {
    toks[st[0]].kind
}
fn peek2(toks: &[Token], st: &[i64], n_toks: i64) -> i64 {
    if st[0] + 1 < n_toks { toks[st[0] + 1].kind } else { 57 }
}
fn bump(st: &mut [i64]) -> i64 {
    let at = st[0];
    st[0] = at + 1;
    at
}
fn eat(toks: &[Token], st: &mut [i64], k: i64) -> bool {
    if toks[st[0]].kind == k {
        st[0] = st[0] + 1;
        true
    } else {
        false
    }
}
// consumes `k` or fails the parse; returns the token's index, or −1
fn expect(toks: &[Token], st: &mut [i64], k: i64) -> i64 {
    if toks[st[0]].kind == k {
        let at = st[0];
        st[0] = at + 1;
        at
    } else {
        st[2] = 1;
        -1
    }
}
fn alloc(nodes: &mut [Node], st: &mut [i64], kind: i64) -> i64 {
    let i = st[1];
    nodes[i].kind = kind;
    nodes[i].a = -1;
    nodes[i].b = -1;
    nodes[i].c = -1;
    nodes[i].d = -1;
    nodes[i].ival = -1;
    nodes[i].next = -1;
    st[1] = i + 1;
    i
}

// two identifier tokens spell the same name: their spans hold the same bytes
fn tok_text_eq(src: &[u8], toks: &[Token], a: i64, b: i64) -> bool {
    if a < 0 || b < 0 { return false; }
    if toks[a].len != toks[b].len { return false; }
    let mut i = 0;
    let mut ok = true;
    while i < toks[a].len {
        if src[toks[a].start + i] != src[toks[b].start + i] { ok = false; }
        i += 1;
    }
    ok
}

// is this identifier token the name of a struct? compared against the markers `parse_program`
// laid down for every `struct <Ident>` in the file (node kind 115, never part of the tree)
fn is_struct_name(src: &[u8], toks: &[Token], nodes: &[Node], st: &[i64], t: i64) -> bool {
    let mut i = 0;
    let mut found = false;
    while i < st[3] {
        if nodes[i].kind == 115 && tok_text_eq(src, toks, nodes[i].a, t) { found = true; }
        i += 1;
    }
    found
}

// ---- types ----

fn type_expr(src: &[u8], toks: &[Token], n_toks: i64, st: &mut [i64], nodes: &mut [Node]) -> i64 {
    if st[2] != 0 { return -1; }
    let k = toks[st[0]].kind;
    if k == 0 {
        let t = bump(st);
        let n = alloc(nodes, st, 100);
        nodes[n].a = t;
        return n;
    }
    if k == 23 {
        bump(st);
        expect(toks, st, 24);
        return alloc(nodes, st, 101);
    }
    if k == 25 {
        bump(st);
        let elem = type_expr(src, toks, n_toks, st, nodes);
        if eat(toks, st, 26) {
            let n = alloc(nodes, st, 104);
            nodes[n].a = elem;
            return n;
        }
        expect(toks, st, 30);
        let count = expr(src, toks, n_toks, st, nodes);
        expect(toks, st, 26);
        let n = alloc(nodes, st, 102);
        nodes[n].a = elem;
        nodes[n].b = count;
        return n;
    }
    if k == 51 {
        bump(st);
        let m = eat(toks, st, 8);
        expect(toks, st, 25);
        let elem = type_expr(src, toks, n_toks, st, nodes);
        expect(toks, st, 26);
        let n = alloc(nodes, st, 103);
        nodes[n].a = elem;
        nodes[n].ival = if m { 1 } else { 0 };
        return n;
    }
    st[2] = 1;
    -1
}

// ---- expressions, one function per precedence level (no function values to parameterise with) ----

fn expr(src: &[u8], toks: &[Token], n_toks: i64, st: &mut [i64], nodes: &mut [Node]) -> i64 {
    or_level(src, toks, n_toks, st, nodes)
}

fn or_level(src: &[u8], toks: &[Token], n_toks: i64, st: &mut [i64], nodes: &mut [Node]) -> i64 {
    let mut lhs = and_level(src, toks, n_toks, st, nodes);
    while st[2] == 0 && toks[st[0]].kind == 54 {
        bump(st);
        let rhs = and_level(src, toks, n_toks, st, nodes);
        let n = alloc(nodes, st, 66);
        nodes[n].a = lhs;
        nodes[n].b = rhs;
        nodes[n].ival = 12;
        lhs = n;
    }
    lhs
}

fn and_level(src: &[u8], toks: &[Token], n_toks: i64, st: &mut [i64], nodes: &mut [Node]) -> i64 {
    let mut lhs = cmp_level(src, toks, n_toks, st, nodes);
    while st[2] == 0 && toks[st[0]].kind == 52 {
        bump(st);
        let rhs = cmp_level(src, toks, n_toks, st, nodes);
        let n = alloc(nodes, st, 66);
        nodes[n].a = lhs;
        nodes[n].b = rhs;
        nodes[n].ival = 11;
        lhs = n;
    }
    lhs
}

// comparisons do not chain, exactly as parse.rs has it
fn cmp_level(src: &[u8], toks: &[Token], n_toks: i64, st: &mut [i64], nodes: &mut [Node]) -> i64 {
    let lhs = add_level(src, toks, n_toks, st, nodes);
    if st[2] != 0 { return -1; }
    let k = toks[st[0]].kind;
    let op = if k == 36 { 5 } else if k == 37 { 6 } else if k == 38 { 7 }
        else if k == 39 { 8 } else if k == 40 { 9 } else if k == 41 { 10 } else { -1 };
    if op < 0 { return lhs; }
    bump(st);
    let rhs = add_level(src, toks, n_toks, st, nodes);
    let n = alloc(nodes, st, 66);
    nodes[n].a = lhs;
    nodes[n].b = rhs;
    nodes[n].ival = op;
    n
}

fn add_level(src: &[u8], toks: &[Token], n_toks: i64, st: &mut [i64], nodes: &mut [Node]) -> i64 {
    let mut lhs = mul_level(src, toks, n_toks, st, nodes);
    while st[2] == 0 && (toks[st[0]].kind == 42 || toks[st[0]].kind == 43) {
        let op = if toks[st[0]].kind == 42 { 0 } else { 1 };
        bump(st);
        let rhs = mul_level(src, toks, n_toks, st, nodes);
        let n = alloc(nodes, st, 66);
        nodes[n].a = lhs;
        nodes[n].b = rhs;
        nodes[n].ival = op;
        lhs = n;
    }
    lhs
}

fn mul_level(src: &[u8], toks: &[Token], n_toks: i64, st: &mut [i64], nodes: &mut [Node]) -> i64 {
    let mut lhs = cast_level(src, toks, n_toks, st, nodes);
    while st[2] == 0 && (toks[st[0]].kind == 44 || toks[st[0]].kind == 45 || toks[st[0]].kind == 46) {
        let k = toks[st[0]].kind;
        let op = if k == 44 { 2 } else if k == 45 { 3 } else { 4 };
        bump(st);
        let rhs = cast_level(src, toks, n_toks, st, nodes);
        let n = alloc(nodes, st, 66);
        nodes[n].a = lhs;
        nodes[n].b = rhs;
        nodes[n].ival = op;
        lhs = n;
    }
    lhs
}

fn cast_level(src: &[u8], toks: &[Token], n_toks: i64, st: &mut [i64], nodes: &mut [Node]) -> i64 {
    let mut e = unary_level(src, toks, n_toks, st, nodes);
    while st[2] == 0 && toks[st[0]].kind == 16 {
        bump(st);
        let ty = type_expr(src, toks, n_toks, st, nodes);
        let n = alloc(nodes, st, 74);
        nodes[n].a = e;
        nodes[n].b = ty;
        e = n;
    }
    e
}

fn unary_level(src: &[u8], toks: &[Token], n_toks: i64, st: &mut [i64], nodes: &mut [Node]) -> i64 {
    if st[2] != 0 { return -1; }
    let k = toks[st[0]].kind;
    if k == 43 {
        bump(st);
        let e = unary_level(src, toks, n_toks, st, nodes);
        let n = alloc(nodes, st, 67);
        nodes[n].a = e;
        nodes[n].ival = 0;
        return n;
    }
    if k == 55 {
        bump(st);
        let e = unary_level(src, toks, n_toks, st, nodes);
        let n = alloc(nodes, st, 67);
        nodes[n].a = e;
        nodes[n].ival = 1;
        return n;
    }
    if k == 51 {
        bump(st);
        let m = eat(toks, st, 8);
        let e = unary_level(src, toks, n_toks, st, nodes);
        let n = alloc(nodes, st, 73);
        nodes[n].a = e;
        nodes[n].ival = if m { 1 } else { 0 };
        return n;
    }
    postfix_level(src, toks, n_toks, st, nodes)
}

fn postfix_level(src: &[u8], toks: &[Token], n_toks: i64, st: &mut [i64], nodes: &mut [Node]) -> i64 {
    let mut e = primary(src, toks, n_toks, st, nodes);
    let mut going = true;
    while st[2] == 0 && going {
        let k = toks[st[0]].kind;
        if k == 25 {
            bump(st);
            let idx = expr(src, toks, n_toks, st, nodes);
            expect(toks, st, 26);
            let n = alloc(nodes, st, 68);
            nodes[n].a = e;
            nodes[n].b = idx;
            e = n;
        } else if k == 33 {
            bump(st);
            let name = expect(toks, st, 0);
            // `.name(` is a method call or a chain stage: out of this slice (design §6), with
            // `.len()` carved out by name and by shape — the only one the compiler's own source
            // uses (arrays design §2). `.count()` is still "a method call or chain".
            if toks[st[0]].kind == 23 {
                if name_is_len(src, toks, name) && toks[st[0] + 1].kind == 24 {
                    bump(st);
                    bump(st);
                    let n = alloc(nodes, st, 72);
                    nodes[n].a = e;
                    e = n;
                } else {
                    st[2] = 1;
                    going = false;
                }
            } else {
                let n = alloc(nodes, st, 69);
                nodes[n].a = e;
                nodes[n].b = name;
                e = n;
            }
        } else {
            going = false;
        }
    }
    e
}

fn name_is_len(src: &[u8], toks: &[Token], t: i64) -> bool {
    toks[t].len == 3 && src[toks[t].start] == b'l' && src[toks[t].start + 1] == b'e'
        && src[toks[t].start + 2] == b'n'
}

fn primary(src: &[u8], toks: &[Token], n_toks: i64, st: &mut [i64], nodes: &mut [Node]) -> i64 {
    if st[2] != 0 { return -1; }
    let k = toks[st[0]].kind;
    if k == 1 {
        let t = bump(st);
        let n = alloc(nodes, st, 60);
        nodes[n].a = t;
        return n;
    }
    if k == 2 {
        let t = bump(st);
        let n = alloc(nodes, st, 61);
        nodes[n].a = t;
        return n;
    }
    if k == 3 {
        let t = bump(st);
        let n = alloc(nodes, st, 63);
        nodes[n].a = t;
        return n;
    }
    if k == 4 {
        let t = bump(st);
        let n = alloc(nodes, st, 64);
        nodes[n].a = t;
        return n;
    }
    if k == 25 {
        // `[e; n]` and `[a, b, c]`, told apart by what follows the first element. The language
        // already restricts either to a `let` initialiser, which is checked there.
        bump(st);
        let first = expr(src, toks, n_toks, st, nodes);
        if eat(toks, st, 30) {
            let n = alloc(nodes, st, 78);
            nodes[n].a = first;
            nodes[n].b = expr(src, toks, n_toks, st, nodes);
            expect(toks, st, 26);
            return n;
        }
        let n = alloc(nodes, st, 77);
        nodes[n].a = first;
        let mut last = first;
        while st[2] == 0 && eat(toks, st, 29) && toks[st[0]].kind != 26 {
            let e = expr(src, toks, n_toks, st, nodes);
            nodes[last].next = e;
            last = e;
        }
        expect(toks, st, 26);
        return n;
    }
    if k == 14 || k == 15 {
        let t = bump(st);
        let n = alloc(nodes, st, 62);
        nodes[n].a = t;
        nodes[n].ival = if k == 14 { 1 } else { 0 };
        return n;
    }
    if k == 0 {
        let t = bump(st);
        if toks[st[0]].kind == 27 && st[4] == 0 && is_struct_name(src, toks, nodes, st, t) {
            bump(st);
            let n = alloc(nodes, st, 70);
            nodes[n].a = t;
            let mut last = -1;
            while st[2] == 0 && toks[st[0]].kind != 28 {
                let fname = expect(toks, st, 0);
                expect(toks, st, 31);
                let fi = alloc(nodes, st, 114);
                nodes[fi].a = fname;
                // a field's value is an ordinary expression: `S { f: if c { 1 } else { 2 } }` is fine
                let saved = st[4];
                st[4] = 0;
                nodes[fi].b = expr(src, toks, n_toks, st, nodes);
                st[4] = saved;
                if last < 0 { nodes[n].b = fi; } else { nodes[last].next = fi; }
                last = fi;
                if !eat(toks, st, 29) { break; }
            }
            expect(toks, st, 28);
            return n;
        }
        if toks[st[0]].kind == 23 {
            bump(st);
            let n = alloc(nodes, st, 71);
            nodes[n].a = t;
            let mut last = -1;
            while st[2] == 0 && toks[st[0]].kind != 24 {
                let arg = expr(src, toks, n_toks, st, nodes);
                if last < 0 { nodes[n].b = arg; } else { nodes[last].next = arg; }
                last = arg;
                if !eat(toks, st, 29) { break; }
            }
            expect(toks, st, 24);
            return n;
        }
        let n = alloc(nodes, st, 65);
        nodes[n].a = t;
        return n;
    }
    if k == 23 {
        bump(st);
        let e = expr(src, toks, n_toks, st, nodes);
        expect(toks, st, 24);
        return e;
    }
    if k == 9 {
        bump(st);
        // inside a condition `S {` opens the body, it is not a struct literal — parse.rs keeps the
        // same counter for the same reason
        st[4] = st[4] + 1;
        let cond = expr(src, toks, n_toks, st, nodes);
        st[4] = st[4] - 1;
        let then = block(src, toks, n_toks, st, nodes);
        let n = alloc(nodes, st, 75);
        nodes[n].a = cond;
        nodes[n].b = then;
        if eat(toks, st, 10) {
            if toks[st[0]].kind == 9 {
                // `else if` is an else block whose value is the inner if, as parse.rs has it
                let inner = primary(src, toks, n_toks, st, nodes);
                let b = alloc(nodes, st, 76);
                nodes[b].b = inner;
                nodes[n].c = b;
            } else {
                nodes[n].c = block(src, toks, n_toks, st, nodes);
            }
        }
        return n;
    }
    if k == 27 {
        return block(src, toks, n_toks, st, nodes);
    }
    st[2] = 1;
    -1
}

// ---- statements ----

// a block: `{ stmt* tail? }` — `a` is the first statement, chained by `next`; `b` is the tail
fn block(src: &[u8], toks: &[Token], n_toks: i64, st: &mut [i64], nodes: &mut [Node]) -> i64 {
    if st[2] != 0 { return -1; }
    expect(toks, st, 27);
    let n = alloc(nodes, st, 76);
    let mut last = -1;
    let mut going = true;
    while st[2] == 0 && going {
        let k = toks[st[0]].kind;
        if k == 28 || k == 57 {
            going = false;
        } else {
            let s = item(src, toks, n_toks, st, nodes);
            if st[2] == 0 {
                if nodes[s].kind == 95 && toks[st[0]].kind == 28 && nodes[s].ival == 1 {
                    // an expression with no `;` before the closing brace is the block's value
                    nodes[n].b = nodes[s].a;
                    going = false;
                } else {
                    if last < 0 { nodes[n].a = s; } else { nodes[last].next = s; }
                    last = s;
                }
            }
        }
    }
    expect(toks, st, 28);
    n
}

// one statement, or an expression statement — `ival` is 1 on an ExprStmt that had no `;`, which
// `block` reads to tell a tail expression from a statement
fn item(src: &[u8], toks: &[Token], n_toks: i64, st: &mut [i64], nodes: &mut [Node]) -> i64 {
    if st[2] != 0 { return -1; }
    let k = toks[st[0]].kind;
    if k == 7 {
        bump(st);
        let m = eat(toks, st, 8);
        let name = expect(toks, st, 0);
        let n = alloc(nodes, st, 90);
        nodes[n].a = name;
        nodes[n].ival = if m { 1 } else { 0 };
        if eat(toks, st, 31) { nodes[n].b = type_expr(src, toks, n_toks, st, nodes); }
        expect(toks, st, 35);
        nodes[n].c = expr(src, toks, n_toks, st, nodes);
        expect(toks, st, 30);
        return n;
    }
    if k == 11 {
        bump(st);
        let var = expect(toks, st, 0);
        expect(toks, st, 12);
        let n = alloc(nodes, st, 92);
        nodes[n].a = var;
        st[4] = st[4] + 1;
        nodes[n].b = expr(src, toks, n_toks, st, nodes);
        expect(toks, st, 34);
        nodes[n].c = expr(src, toks, n_toks, st, nodes);
        st[4] = st[4] - 1;
        nodes[n].d = block(src, toks, n_toks, st, nodes);
        return n;
    }
    if k == 17 {
        bump(st);
        let n = alloc(nodes, st, 93);
        st[4] = st[4] + 1;
        nodes[n].a = expr(src, toks, n_toks, st, nodes);
        if eat(toks, st, 19) { nodes[n].b = expr(src, toks, n_toks, st, nodes); }
        st[4] = st[4] - 1;
        nodes[n].c = block(src, toks, n_toks, st, nodes);
        return n;
    }
    if k == 18 {
        bump(st);
        expect(toks, st, 30);
        return alloc(nodes, st, 94);
    }
    if k == 13 {
        bump(st);
        let n = alloc(nodes, st, 96);
        if toks[st[0]].kind != 30 { nodes[n].a = expr(src, toks, n_toks, st, nodes); }
        expect(toks, st, 30);
        return n;
    }
    // in *statement* position an expression that begins with a block-like form — `if` or `{` —
    // ends at that block, and an operator on the next line starts a new statement rather than
    // continuing it. Same rule as parse.rs, for the reason recorded there: without it an
    // else-less `if` followed by a line starting with `-` is one subtraction, which bit this
    // file, check.nt and a debug driver before the grammar was fixed.
    let block_like = k == 9 || k == 27;
    let e = if block_like { primary(src, toks, n_toks, st, nodes) } else { expr(src, toks, n_toks, st, nodes) };
    if st[2] != 0 { return -1; }
    let a = toks[st[0]].kind;
    let op = if a == 35 { -1 } else if a == 47 { 0 } else if a == 48 { 1 }
        else if a == 49 { 2 } else if a == 50 { 3 } else { -2 };
    if op > -2 {
        bump(st);
        let n = alloc(nodes, st, 91);
        nodes[n].a = e;
        nodes[n].b = expr(src, toks, n_toks, st, nodes);
        nodes[n].ival = op;
        expect(toks, st, 30);
        return n;
    }
    let n = alloc(nodes, st, 95);
    nodes[n].a = e;
    if eat(toks, st, 30) {
        nodes[n].ival = 0;
    } else if toks[st[0]].kind == 28 {
        // no `;` and the block ends here: this is its value, `if` or not — parse.rs checks this
        // before the `if`/block case below, and getting the two the other way round makes a
        // trailing `if` a statement instead of the tail it is
        nodes[n].ival = 1;
    } else {
        let ek = nodes[e].kind;
        if ek == 75 || ek == 76 {
            nodes[n].ival = 0;
        } else {
            st[2] = 1;
        }
    }
    n
}

// ---- functions ----

// `fn name(p: T, …) -> T { … }` — `a` is the name token, `b` the first Param (chained by `next`),
// `c` the return type (−1 when `()` was written or omitted), `d` the body block
// `extern fn name(params) -> ret uses <effects>;` — a signature and no body. The effect list is
// read and dropped: effects are the cost model's, and the cost model is not self-hosted, so
// keeping them would be a field nothing reads. What this buys is the driver: `read_file` and
// `write_file` are the only reason the stages are not already a program.
fn extern_fn(src: &[u8], toks: &[Token], n_toks: i64, st: &mut [i64], nodes: &mut [Node]) -> i64 {
    if st[2] != 0 { return -1; }
    expect(toks, st, 20);
    expect(toks, st, 6);
    let name = expect(toks, st, 0);
    let n = alloc(nodes, st, 116);
    nodes[n].a = name;
    expect(toks, st, 23);
    let mut last = -1;
    while st[2] == 0 && toks[st[0]].kind != 24 {
        let pname = expect(toks, st, 0);
        expect(toks, st, 31);
        let p = alloc(nodes, st, 111);
        nodes[p].a = pname;
        nodes[p].b = type_expr(src, toks, n_toks, st, nodes);
        if last < 0 { nodes[n].b = p; } else { nodes[last].next = p; }
        last = p;
        if !eat(toks, st, 29) { break; }
    }
    expect(toks, st, 24);
    if eat(toks, st, 32) { nodes[n].c = type_expr(src, toks, n_toks, st, nodes); };
    while st[2] == 0 && toks[st[0]].kind != 30 && toks[st[0]].kind != 57 { bump(st); }
    expect(toks, st, 30);
    n
}

fn func(src: &[u8], toks: &[Token], n_toks: i64, st: &mut [i64], nodes: &mut [Node]) -> i64 {
    if st[2] != 0 { return -1; }
    expect(toks, st, 6);
    let name = expect(toks, st, 0);
    let n = alloc(nodes, st, 110);
    nodes[n].a = name;
    expect(toks, st, 23);
    let mut last = -1;
    while st[2] == 0 && toks[st[0]].kind != 24 {
        let pname = expect(toks, st, 0);
        expect(toks, st, 31);
        let p = alloc(nodes, st, 111);
        nodes[p].a = pname;
        nodes[p].b = type_expr(src, toks, n_toks, st, nodes);
        if last < 0 { nodes[n].b = p; } else { nodes[last].next = p; }
        last = p;
        if !eat(toks, st, 29) { break; }
    }
    expect(toks, st, 24);
    if eat(toks, st, 32) { nodes[n].c = type_expr(src, toks, n_toks, st, nodes); }
    nodes[n].d = block(src, toks, n_toks, st, nodes);
    n
}

// every `fn` in the file, chained by `next`; returns the first, or −1 (st[2] says whether that is
// an empty program or a parse error)
// `struct S { f: T, … }` — `a` is the name token, `b` the first FieldDef (chained by `next`)
fn struct_def(src: &[u8], toks: &[Token], n_toks: i64, st: &mut [i64], nodes: &mut [Node]) -> i64 {
    expect(toks, st, 22);
    let name = expect(toks, st, 0);
    let n = alloc(nodes, st, 112);
    nodes[n].a = name;
    expect(toks, st, 27);
    let mut last = -1;
    while st[2] == 0 && toks[st[0]].kind != 28 {
        let fname = expect(toks, st, 0);
        expect(toks, st, 31);
        let f = alloc(nodes, st, 113);
        nodes[f].a = fname;
        nodes[f].b = type_expr(src, toks, n_toks, st, nodes);
        if last < 0 { nodes[n].b = f; } else { nodes[last].next = f; }
        last = f;
        if !eat(toks, st, 29) { break; }
    }
    expect(toks, st, 28);
    n
}

// every top-level item — a `fn` or a `struct` — chained by `next`, in source order
fn parse_program(src: &[u8], toks: &[Token], n_toks: i64, st: &mut [i64], nodes: &mut [Node]) -> i64 {
    // the struct names, first: `S {` is a struct literal only when `S` is one, which is how
    // `S { … }` is told apart from a block, and needs the whole file scanned before parsing
    let mut i = 0;
    while i + 1 < n_toks {
        if toks[i].kind == 22 && toks[i + 1].kind == 0 {
            nodes[st[1]].kind = 115;
            nodes[st[1]].a = i + 1;
            st[1] = st[1] + 1;
            st[3] = st[3] + 1;
        }
        i += 1;
    }
    let mut first = -1;
    let mut last = -1;
    while st[2] == 0 && toks[st[0]].kind != 57 {
        let f = if toks[st[0]].kind == 22 {
            struct_def(src, toks, n_toks, st, nodes)
        } else if toks[st[0]].kind == 20 {
            extern_fn(src, toks, n_toks, st, nodes)
        } else {
            func(src, toks, n_toks, st, nodes)
        };
        if st[2] == 0 {
            if last < 0 { first = f; } else { nodes[last].next = f; }
            last = f;
        }
    }
    first
}
