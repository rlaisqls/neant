// The cost pass's own driver: source in, a `name<TAB>work` line per function out — the self-hosted
// answer to `neant cost`'s `work` column, and what `bootstrap/tests/self_host_cost.rs` compares
// against it. A filter, like `compiler/main.nt`, and for the same reason: there is no argv.
//
// It is a *fifth* fragment rather than a mode of `main.nt` because the compiler binary has no way
// to be asked for a cost report. Concatenate lex, parse, check, emit, poly, cost and this.
//
// Two passes over the functions, so a call to one declared later still finds its work. A third
// would change nothing: a cycle is self-recursion, which this slice reports unknown either way.

extern fn read_stdin(buf: &mut [u8]) -> i64 uses io, unbounded;
extern fn write_stdout(buf: &[u8], n: i64) -> i64 uses io, unbounded;

fn main() {
    let mut buf = [b'\0'; 262144];
    let n = read_stdin(&mut buf);
    let mut toks = [Token { kind: 0, start: 0, len: 0, ival: 0 }; 262144];
    let n_toks = lex(&buf, n, &mut toks);
    let mut nodes = [Node { kind: 0, a: 0, b: 0, c: 0, d: 0, ival: 0, next: 0 }; 262144];
    let mut st = [0, 0, 0, 0, 0];
    let first = parse_program(&buf, &toks, n_toks, &mut st, &mut nodes);
    let mut types = [Ty { kind: 0, elem: 0, mutable: 0, size: 0 }; 65536];
    let mut syms = [Sym { name: 0, ty: 0, mutable: 0, root: 0 }; 65536];
    let mut sigs = [Sig { name: -1, params: 0, n_params: 0, ret: 0, ext: 0 }; 4096];
    let mut strs = [Str { name: 0, fields: 0, n_fields: 0 }; 1024];
    let mut flds = [Fld { name: 0, ty: 0 }; 4096];
    let mut ptys = [0; 16384];
    let mut ntys = [-1; 262144];
    let mut cst = [0; 1024];
    cst[16] = st[1];
    let bad = check_program(&buf, &toks, &mut nodes, &mut types, &mut syms, &mut sigs, &mut ptys, &mut strs, &mut flds, &mut ntys, &mut cst, first);

    let mut facs = [Fac { atom: 0, exp: 0 }; 262144];
    let mut terms = [Term { fac: 0, n_fac: 0, cn: 0, cd: 0 }; 262144];
    let mut pols = [Pol { term: 0, n_term: 0 }; 262144];
    let mut pst = [0, 0, 0, 0, 0, 0, 0, 0];
    let mut env = [Env { name: 0, val: 0, len: 0, root: 0 }; 4096];
    let mut lpes = [Lpe { cnd: 0, n_cnd: 0, lines: 0, contig: 0 }; 65536];
    let mut imgs = [Img { arr: 0, fld: 0, poly: 0 }; 1024];
    let mut fb = [-1; 4096];
    let mut fdecl = [0; 4096];
    let mut iw = [-1; 4096];
    let mut im = [-1; 4096];
    let mut ds = [0, 0, 0];
    let mut viol = [0];
    let mut sc = [0; 40960];
    let mut wst = [0; 4096];
    let mut sites = [Site { arr: 0, idx: 0, inloop: 0, coef: 0, stride: 0, bad: 0, trip: 0, branch: 0, novar: 0, field: -1, p0: -1, p1: -1, p2: -1, c0: 0, c1: 0, c2: 0, b0: 0, b1: 0, b2: 0, alen: -1, es: 0, base: 0, touch: 0, fldname: -1, tail: 0, pc0: -1, pc1: -1, pc2: -1, rlo: -1, rhi: -1 }; 4096];
    let mut fm = [-1; 4096];
    let mut cks = [Ck { pce: 0, n_pce: 0 }; 262144];
    let mut cnds = [Cnd { ws: 0, fits: 0 }; 262144];
    let mut pcs = [Pce { cnd: 0, n_cnd: 0, poly: 0 }; 262144];
    let mut subst = [-1; 64];
    let mut ffoot = [0; 262144];
    let mut resid = [Res { root: 0, lo: 0, hi: 0 }; 128];
    let mut slay = [0; 1024];
    let mut cof = [Cof { name: 0, c: 0 }; 256];
    let mut rargs = [-1; 64];
    let mut scratch = [0; 64];
    let mut order = [0; 4096];
    let mut logs = [-1; 1024];
    let mut budget = [0.0; 4096];
    let mut fw = [-1; 4096];
    let mut pnames = [0; 256];
    let mut parr = [0; 256];
    let mut out = [b'\0'; 262144];
    let mut est = [0, 0, 0];

    // the same choice the compiler makes before emitting, so the report describes the code
    choose_layouts(&buf, &toks, &nodes, &types, &strs, &flds, &ntys, &sigs, &ptys, &mut slay,
                   first, cst[7]);

    // two passes, so a call to a function declared later still finds its work
    let mut pass = 0;
    while pass < 2 {
        let mut f = first;
        let mut si = 0;
        while f >= 0 {
            if nodes[f].kind == 110 {
                fw[si] = w_func(&buf, &toks, &nodes, &types, &ntys, &sigs, &ptys, &fw, &mut facs, &mut terms, &mut pols, &mut pst, &mut env, &mut wst, &mut scratch, &mut cof, &mut rargs, &mut logs, &mut budget, f, si);
                fm[si] = m_func(&buf, &toks, &nodes, &types, &strs, &flds, &ntys, &sigs, &ptys, &fm, &ffoot, &mut facs, &mut terms, &mut pols, &mut pst, &mut env, &mut cof, &mut sites, &mut cks, &mut cnds, &mut pcs, &mut budget, &mut resid, &mut rargs, &mut logs, &mut scratch, &mut subst, &slay, &mut lpes, &mut imgs, &mut sc, &mut wst, f, si);
                fb[si] = wst[50];
                // after the walk, since it reads the sites the walk recorded; the second pass is
                // what lets a call to a function declared later find them
                foot_flags(&buf, &toks, &nodes, &sites, &mut ffoot, &wst, f, si);
                foot_ranges(&buf, &toks, &nodes, &mut facs, &mut terms, &mut pols, &mut pst,
                            &mut budget, &sites, &mut ffoot, &mut wst, f, si);
                // **A declaration replaces the inference**, and only when it gives both columns
                // (design §24). Replacing `fw`/`fm` is all it takes for a caller to see the
                // declaration rather than the body: the call path reads them and asks nothing else.
                // the inference is kept, because a declaration replaces what is *reported* and an
                // assertion is still checked against what was *inferred*
                iw[si] = fw[si];
                im[si] = fm[si];
                fdecl[si] = take_decl(&buf, &toks, &nodes, &mut facs, &mut terms, &mut pols,
                                      &mut pst, &mut budget, &mut cnds, &mut pcs, &mut cks,
                                      &mut wst, &mut ds, &mut fw, &mut fm, f, si);
                si += 1;
            } else if nodes[f].kind == 116 {
                // an `extern fn` has no body to infer from, which is the case that shows a
                // declaration is a claim in its own right — `decl_extern.nt` declares libc's `labs`
                fdecl[si] = take_decl(&buf, &toks, &nodes, &mut facs, &mut terms, &mut pols,
                                      &mut pst, &mut budget, &mut cnds, &mut pcs, &mut cks,
                                      &mut wst, &mut ds, &mut fw, &mut fm, f, si);
                si += 1;
            }
            f = nodes[f].next;
        }
        pass += 1;
    }

    // **a breached `#[cost]` bound is a check error**, which is what `neant check` reports, so the
    // verdict this prints has to account for it and not only for the checker's own rules
    let mut vf = first;
    let mut vsi = 0;
    while vf >= 0 {
        if nodes[vf].kind == 110 {
            if !asserts_hold(&buf, &toks, &nodes, &mut facs, &mut terms, &mut pols, &mut pst,
                             &pcs, &cks, &mut ds, iw[vsi], im[vsi], vf) { viol[0] = 1; };
            vsi += 1;
        } else if nodes[vf].kind == 116 {
            vsi += 1;
        }
        vf = nodes[vf].next;
    }

    let mut f = first;
    let mut si = 0;
    while f >= 0 {
        if nodes[f].kind == 110 {
            emit_span(&mut out, &mut est, &buf, &toks, nodes[f].a);
            emit_b(&mut out, &mut est, b'\t');
            let mut p = nodes[f].b;
            let mut i = 0;
            while p >= 0 {
                pnames[i] = nodes[p].a;
                let t = ptys[sigs[si].params + i];
                parr[i] = if t >= 0 && (types[t].kind == 5 || types[t].kind == 6) { 1 } else { 0 };
                i += 1;
                p = nodes[p].next;
            }
            if fw[si] < 0 {
                let u = b"unknown";
                emit_bytes(&mut out, &mut est, &u);
            } else {
                let before = est[2];
                if fdecl[si] != 0 { emit_le(&mut out, &mut est); };
                pol_print(&mut out, &mut est, &buf, &toks, &facs, &terms, &pols, &logs, &pnames, &parr, fw[si], &mut order, 0);
                if est[2] != before {
                    est[2] = before;
                    let u = b" [unprintable]";
                    emit_bytes(&mut out, &mut est, &u);
                }
            }
            emit_b(&mut out, &mut est, b'\t');
            if fm[si] < 0 {
                let u = b"unknown";
                emit_bytes(&mut out, &mut est, &u);
            } else {
                let before = est[2];
                if fdecl[si] != 0 { emit_le(&mut out, &mut est); };
                let c = fm[si];
                let mut pi = 0;
                while pi < cks[c].n_pce {
                    if pi > 0 {
                        let bar = b" | ";
                        emit_bytes(&mut out, &mut est, &bar);
                    };
                    let pp = cks[c].pce + pi;
                    emit_brief(&mut out, &mut est, &buf, &toks, &mut facs, &mut terms, &mut pols,
                               &mut pst, &logs, &pnames, &parr, pcs[pp].poly, &mut order, 3);
                    let mut ci = 0;
                    while ci < pcs[pp].n_cnd {
                        // an array literal may only initialise a `let`, so the two words are two
                        if ci == 0 {
                            let i1 = b" if ";
                            emit_bytes(&mut out, &mut est, &i1);
                        } else {
                            let i2 = b" and ";
                            emit_bytes(&mut out, &mut est, &i2);
                        };
                        // a condition is carried in lines; the report states it in bytes, which is
                        // `brief_cond`'s `mul_atom_pow(B, 1)` in `lock.rs`
                        let bb = pol_atom(&mut facs, &mut terms, &mut pols, &mut pst, 0);
                        let wb = pol_mul(&mut facs, &mut terms, &mut pols, &mut pst,
                                         cnds[pcs[pp].cnd + ci].ws, bb);
                        emit_brief(&mut out, &mut est, &buf, &toks, &mut facs, &mut terms, &mut pols,
                                   &mut pst, &logs, &pnames, &parr, wb, &mut order, 1);
                        if cnds[pcs[pp].cnd + ci].fits == 1 {
                            let lt = b" < M";
                            emit_bytes(&mut out, &mut est, &lt);
                        } else {
                            emit_b(&mut out, &mut est, b' ');
                            emit_u(&mut out, &mut est, 226);
                            emit_u(&mut out, &mut est, 137);
                            emit_u(&mut out, &mut est, 165);
                            let m2 = b" M";
                            emit_bytes(&mut out, &mut est, &m2);
                        };
                        ci += 1;
                    }
                    pi += 1;
                }
                if est[2] != before {
                    est[2] = before;
                    let u = b"[unprintable]";
                    emit_bytes(&mut out, &mut est, &u);
                }
            }
            // the fourth column: the footprint lower bound, or `none` where the function has no
            // parameter array whose image this slice can state
            emit_b(&mut out, &mut est, b'\t');
            if fb[si] < 0 {
                let u = b"none";
                emit_bytes(&mut out, &mut est, &u);
            } else {
                let before = est[2];
                pol_print(&mut out, &mut est, &buf, &toks, &facs, &terms, &pols, &logs, &pnames,
                          &parr, fb[si], &mut order, 0);
                if est[2] != before {
                    est[2] = before;
                    let u = b"[unprintable]";
                    emit_bytes(&mut out, &mut est, &u);
                }
            }
            // the fifth column: the footprint, one entry per array parameter and then the
            // condition under which the whole of it is resident on return. Whitespace is a single
            // space everywhere, so the report's column padding is not part of the comparison.
            emit_b(&mut out, &mut est, b'\t');
            let mut fp = nodes[f].b;
            let mut fi2 = 0;
            let mut n_fp = 0;
            let mut allx = true;
            let mut tot = pol_zero(&mut facs, &mut terms, &mut pols, &mut pst);
            while fp >= 0 && fi2 < 16 {
                let bb = (si * 16 + fi2) * 8;
                if ffoot[bb + 4] >= 0 && ffoot[bb + 5] >= 0 {
                    if n_fp > 0 { emit_b(&mut out, &mut est, b' '); };
                    emit_span(&mut out, &mut est, &buf, &toks, nodes[fp].a);
                    let cl = b": [";
                    emit_bytes(&mut out, &mut est, &cl);
                    pol_print(&mut out, &mut est, &buf, &toks, &facs, &terms, &pols, &logs,
                              &pnames, &parr, ffoot[bb + 4], &mut order, 0);
                    let cm = b", ";
                    emit_bytes(&mut out, &mut est, &cm);
                    pol_print(&mut out, &mut est, &buf, &toks, &facs, &terms, &pols, &logs,
                              &pnames, &parr, ffoot[bb + 5], &mut order, 0);
                    emit_b(&mut out, &mut est, b')');
                    if ffoot[bb + 6] == 0 {
                        let wa = b" (whole array)";
                        emit_bytes(&mut out, &mut est, &wa);
                        allx = false;
                    } else {
                        let d = pol_sub(&mut facs, &mut terms, &mut pols, &mut pst,
                                        ffoot[bb + 5], ffoot[bb + 4]);
                        tot = pol_add(&mut facs, &mut terms, &mut pols, &mut pst, tot, d);
                    };
                    n_fp += 1;
                };
                fi2 += 1;
                fp = nodes[fp].next;
            }
            if n_fp == 0 {
                let nn = b"none";
                emit_bytes(&mut out, &mut est, &nn);
            } else if allx {
                let r = b" | resident ";
                emit_bytes(&mut out, &mut est, &r);
                pol_print(&mut out, &mut est, &buf, &toks, &facs, &terms, &pols, &logs, &pnames,
                          &parr, tot, &mut order, 0);
            } else {
                let r2 = b" | none";
                emit_bytes(&mut out, &mut est, &r2);
            };
            emit_b(&mut out, &mut est, b'\n');
            si += 1;
        } else if nodes[f].kind == 116 {
            si += 1;
        }
        f = nodes[f].next;
    }
    println(if bad != 0 || viol[0] != 0 { 1 } else { 0 });
    println(st[2]);
    write_stdout(&out, est[0]);
}
