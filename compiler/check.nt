// The third self-hosted stage (docs/self-hosting-checker-design.md), the first slice of
// bootstrap/src/types.rs: name resolution and type checking over exactly the grammar
// `compiler/parse.nt` produces. **A fragment**, like parse.nt: it uses lex.nt's `Token` and
// parse.nt's `Node` and node kinds, and is compiled by concatenating lex.nt, parse.nt, this, and
// a driver.
//
// Out of this slice (design §1): size variables, chain desugaring, moves/uniqueness/layout, and
// building a typed IR — every one of them feeds a stage that does not exist self-hosted yet.
//
// Type kinds:  0 i64  1 f64  2 bool  3 u8  4 unit  5 array  6 slice  7 struct (`elem` indexes `strs`)
// The five scalars are interned first, so their indices are 0..4 and a scalar comparison is an
// integer comparison.
//
// `cst` is the checker's state, the same one-element-array idiom the parser uses:
//   cst[0] next free type   cst[1] symbol table length   cst[2] error flag
//   cst[3] signature count  cst[4] next free param type  cst[5] loop depth
//   cst[6] the current function's return type
//   cst[7] struct count      cst[8] next free field
//   cst[9] the node the check failed at, or −1 — set once, by the innermost frame to see the
//          error flag go up, so it names the smallest expression or statement that is wrong
//   cst[11] the fresh-size-atom counter
//   cst[12] how many arrays have been moved away
//   cst[13] the symbol table's length at the innermost loop's entry, or −1 outside every loop
//   cst[14] the top of the `if`-union stash
//   cst[16] the next free node, so the checker can build the loop a chain desugars to
//   cst[17] the next synthetic local's number
//   cst[15] the token this item ends before — the next item's name, or past the end
//   cst[200 + i]  the declaring name token of the i-th moved array
//   cst[400 + j]  the stash an `if` arm's moves are held in while the other arm is checked
//   cst[10] the item — function or struct — being read when it failed, which is where the
//          failures that happen outside an expression (a signature, a field's type) land

// `size` is meaningful only for an array (kind 5): the *size atom*, which says whether two array
// types have the same length without saying what it is. Design §1 put size variables out of this
// slice on the grounds that only the cost model wants them — that was wrong. `ys = xs` on whole
// arrays type-checks exactly when the two sizes are known to agree, so a checker without atoms
// either refuses every reassignment (and disagrees with `neant check` on reassign_named_size.nt)
// or accepts every one (and disagrees on err_reassign_mutable_size.nt). Three disjoint ranges:
//   0 .. 999999          a token index: the declaration of the immutable local the length names
//   1000000 + v          an integer literal of value v, so two `[0; 4]` agree
//   2000000 +            a fresh atom, for a length that may differ between two uses
struct Ty { kind: i64, elem: i64, mutable: i64, size: i64 }
// `root` is the array this name ultimately views: its own name token for an array, and the
// source's root for a view (`let v = &xs;`). Two views of one array share a root, which is what
// both the aliasing rule at a call and the view-survives-a-move rule ask about.
struct Sym { name: i64, ty: i64, mutable: i64, root: i64 }
// `ext` marks an `extern fn`: it names a C symbol that already exists, so it is called by
// its own name rather than the `ntu_` one
struct Sig { name: i64, params: i64, n_params: i64, ret: i64, ext: i64 }
// a struct type: its name token, and a run of fields in the flat `flds` table
struct Str { name: i64, fields: i64, n_fields: i64 }
struct Fld { name: i64, ty: i64 }

// ---- types ----

fn intern_scalars(types: &mut [Ty], cst: &mut [i64]) {
    let mut k = 0;
    while k < 5 {
        types[k].kind = k;
        types[k].elem = -1;
        types[k].mutable = 0;
        types[k].size = -1;
        k += 1;
    }
    cst[0] = 5;
}

fn new_ty(types: &mut [Ty], cst: &mut [i64], kind: i64, elem: i64, mutable: i64) -> i64 {
    new_ty_sized(types, cst, kind, elem, mutable, fresh_atom(cst))
}

fn new_ty_sized(types: &mut [Ty], cst: &mut [i64], kind: i64, elem: i64, mutable: i64, size: i64) -> i64 {
    let i = cst[0];
    types[i].kind = kind;
    types[i].elem = elem;
    types[i].mutable = mutable;
    types[i].size = size;
    cst[0] = i + 1;
    i
}

// an atom that equals nothing but itself
fn fresh_atom(cst: &mut [i64]) -> i64 {
    cst[11] = cst[11] + 1;
    1999999 + cst[11]
}

fn is_scalar(types: &[Ty], t: i64) -> bool {
    t >= 0 && types[t].kind < 4
}
fn is_numeric(types: &[Ty], t: i64) -> bool {
    t >= 0 && (types[t].kind == 0 || types[t].kind == 1 || types[t].kind == 3)
}
fn is_arrayish(types: &[Ty], t: i64) -> bool {
    t >= 0 && (types[t].kind == 5 || types[t].kind == 6)
}

// structural equality; a slice's mutability is part of it, and `elem` is compared recursively
fn same_ty(types: &[Ty], a: i64, b: i64) -> bool {
    if a < 0 || b < 0 { return false; }
    if a == b { return true; }
    if types[a].kind != types[b].kind { return false; }
    if types[a].kind == 6 && types[a].mutable != types[b].mutable { return false; }
    // an array's length is part of its type; a view's is not, which is why `&[T]` accepts arrays
    // of any length and only a whole-array assignment has to ask
    if types[a].kind == 5 && types[a].size != types[b].size { return false; }
    if types[a].kind == 5 || types[a].kind == 6 {
        return same_ty(types, types[a].elem, types[b].elem);
    }
    // two struct types are the same when they name the same struct; `elem` is its table index,
    // not another type, so this is an integer comparison and not the recursion above
    if types[a].kind == 7 { return types[a].elem == types[b].elem; }
    false
}

// ---- names ----

// two identifier tokens name the same thing when their spans hold the same bytes: lex.nt kept
// `(start, len)` into the source rather than copying, so this is the comparison
// **A name token below −1 is a synthetic local**, `−t − 2`, which the desugaring of a chain needs:
// a rewritten loop wants a counter and an accumulator, and there is no source text for either. Two
// synthetic names are the same name exactly when they are the same number, and no source span can
// ever equal one — which is what a fresh local has to mean. `emit_span` spells them `nt_s<k>`.
fn name_eq(src: &[u8], toks: &[Token], a: i64, b: i64) -> bool {
    if a < 0 - 1 || b < 0 - 1 { return a == b; }
    if a < 0 || b < 0 { return false; }
    if toks[a].len != toks[b].len { return false; }
    let mut i = 0;
    let mut ok = true;
    while i < toks[a].len {
        if src[toks[a].start + i] != src[toks[b].start + i] { ok = false; }
        i += 1;
    }
    ok
}

// a token's span against a literal, one byte at a time — an array literal cannot be an argument,
// so a `b"println"` to compare with is not available
fn name_is_println(src: &[u8], toks: &[Token], t: i64) -> bool {
    if t < 0 || toks[t].len != 7 { return false; }
    let s = toks[t].start;
    src[s] == b'p' && src[s + 1] == b'r' && src[s + 2] == b'i' && src[s + 3] == b'n'
        && src[s + 4] == b't' && src[s + 5] == b'l' && src[s + 6] == b'n'
}
// **A call is found by the text of its name**, which a rewrite cannot write: `.zip()` runs to
// `min(a.len(), b.len())` and there may be no `min` anywhere in the source to point at. So the two
// builtins get a sentinel token apiece — the third and last thing a negative index means in this
// tree, after a synthetic local (−k − 2) and a synthetic literal. They are placed far below any
// synthetic name so the three spaces cannot meet.
fn name_is_min(src: &[u8], toks: &[Token], t: i64) -> bool {
    if t == 0 - 1000000 { return true; }
    if t < 0 { return false; }
    toks[t].len == 3 && src[toks[t].start] == b'm' && src[toks[t].start + 1] == b'i' && src[toks[t].start + 2] == b'n'
}
fn name_is_max(src: &[u8], toks: &[Token], t: i64) -> bool {
    if t == 0 - 1000001 { return true; }
    if t < 0 { return false; }
    toks[t].len == 3 && src[toks[t].start] == b'm' && src[toks[t].start + 1] == b'a' && src[toks[t].start + 2] == b'x'
}

// the type name a `TyNamed` node spells, or −1 if it is not one of the four scalars
fn scalar_named(src: &[u8], toks: &[Token], t: i64) -> i64 {
    let s = toks[t].start;
    let n = toks[t].len;
    if n == 3 && src[s] == b'i' && src[s + 1] == b'6' && src[s + 2] == b'4' { return 0; }
    if n == 3 && src[s] == b'f' && src[s + 1] == b'6' && src[s + 2] == b'4' { return 1; }
    if n == 4 && src[s] == b'b' && src[s + 1] == b'o' && src[s + 2] == b'o' && src[s + 3] == b'l' { return 2; }
    if n == 2 && src[s] == b'u' && src[s + 1] == b'8' { return 3; }
    -1
}

// the innermost symbol with this name, or −1: searched backwards, so an inner `let` shadows
fn sym_find(src: &[u8], toks: &[Token], syms: &[Sym], cst: &[i64], name: i64) -> i64 {
    let mut i = cst[1] - 1;
    let mut found = -1;
    while i >= 0 {
        if found < 0 && name_eq(src, toks, syms[i].name, name) { found = i; }
        i -= 1;
    }
    found
}

fn declare(syms: &mut [Sym], cst: &mut [i64], name: i64, ty: i64, mutable: i64, root: i64) {
    let i = cst[1];
    syms[i].name = name;
    syms[i].ty = ty;
    syms[i].mutable = mutable;
    syms[i].root = if root < 0 { name } else { root };
    cst[1] = i + 1;
}

// the root of the array a name views, following `let v = &xs;` chains
fn sym_root(src: &[u8], toks: &[Token], syms: &[Sym], cst: &[i64], name: i64) -> i64 {
    let s = sym_find(src, toks, syms, cst, name);
    if s < 0 { return 0 - 1; }
    syms[s].root
}

// ---- moves ----
//
// `let ys = xs;` on whole arrays **moves** `xs`: the buffer is `ys`'s now and a further use of `xs`
// reads memory that is no longer its own. The set of moved arrays is keyed by the **declaring name
// token**, which is a stable identity where a symbol index is not: a scope here is the symbol
// table's saved length, so indices are reused as scopes close, and two different locals can be the
// same index at different times. A declaration's token is unique by construction.
//
// `neant check` names the line of the move in its message. This checker only ever reports a
// verdict, so it records the fact and not the line.
fn moved_add(cst: &mut [i64], name: i64) {
    if cst[12] >= 100 { cst[2] = 1; return; }
    cst[200 + cst[12]] = name;
    cst[12] = cst[12] + 1;
}

// a reassignment makes its target live again, whatever it held before
fn moved_del(src: &[u8], toks: &[Token], cst: &mut [i64], name: i64) {
    let mut i = 0;
    let mut w = 0;
    while i < cst[12] {
        if !name_eq(src, toks, cst[200 + i], name) {
            cst[200 + w] = cst[200 + i];
            w += 1;
        };
        i += 1;
    }
    cst[12] = w;
}

fn moved_has(src: &[u8], toks: &[Token], cst: &[i64], name: i64) -> bool {
    let mut i = 0;
    let mut hit = false;
    while i < cst[12] {
        if name_eq(src, toks, cst[200 + i], name) { hit = true; }
        i += 1;
    }
    hit
}

// **Is this name used again, later in the same item?** `types.rs` computes each local's last use
// over the *checked body* and compares it with the move's line; this checker builds no typed body
// to walk, so it asks the token stream, which is in source order by construction. It
// over-approximates in the safe direction — a write counts as a use where `last_uses` counts reads
// — and stops at the next item so a same-named local elsewhere cannot be mistaken for this one.
fn used_after(src: &[u8], toks: &[Token], cst: &[i64], name: i64, from: i64) -> bool {
    let mut t = from + 1;
    let mut hit = false;
    while toks[t].kind != 57 && t < cst[15] {
        if toks[t].kind == 0 && name_eq(src, toks, t, name) { hit = true; }
        t += 1;
    }
    hit
}

// a node and a synthetic name, for the rewrite: the checker allocates into the same arena the
// parser filled, continuing from where it stopped
fn nnew(nodes: &mut [Node], cst: &mut [i64], kind: i64) -> i64 {
    let i = cst[16];
    nodes[i].kind = kind;
    nodes[i].a = 0 - 1;
    nodes[i].b = 0 - 1;
    nodes[i].c = 0 - 1;
    nodes[i].d = 0 - 1;
    nodes[i].ival = 0 - 1;
    nodes[i].next = 0 - 1;
    cst[16] = i + 1;
    i
}

// a literal node with no source text: `kind` 60 for an integer and 61 for a float
fn nlit(nodes: &mut [Node], cst: &mut [i64], kind: i64, v: i64) -> i64 {
    let n = nnew(nodes, cst, kind);
    nodes[n].a = 0 - v - 2;
    n
}

fn nfresh(cst: &mut [i64]) -> i64 {
    let k = cst[17];
    if k > 100000 { cst[2] = 1; return 0 - 2; }
    cst[17] = k + 1;
    0 - k - 2
}

// the struct a name token names, or −1
fn struct_find(src: &[u8], toks: &[Token], strs: &[Str], cst: &[i64], name: i64) -> i64 {
    let mut i = 0;
    let mut found = -1;
    while i < cst[7] {
        if found < 0 && name_eq(src, toks, strs[i].name, name) { found = i; }
        i += 1;
    }
    found
}

// the field of struct `si` with this name, as an index into `flds`, or −1
fn field_find(src: &[u8], toks: &[Token], strs: &[Str], flds: &[Fld], si: i64, name: i64) -> i64 {
    let mut i = 0;
    let mut found = -1;
    while i < strs[si].n_fields {
        if found < 0 && name_eq(src, toks, flds[strs[si].fields + i].name, name) { found = strs[si].fields + i; }
        i += 1;
    }
    found
}

// every `struct` first, so a parameter or a field may name one. Fields are scalars, as they are in
// the Rust checker — no struct holds another, so nothing here depends on collection order.
fn collect_structs(src: &[u8], toks: &[Token], nodes: &[Node], types: &mut [Ty], strs: &mut [Str],
                   flds: &mut [Fld], cst: &mut [i64], first: i64) {
    let mut f = first;
    while cst[2] == 0 && f >= 0 {
        cst[10] = f;
        if nodes[f].kind == 112 {
            let si = cst[7];
            strs[si].name = nodes[f].a;
            strs[si].fields = cst[8];
            let mut nf = 0;
            let mut fd = nodes[f].b;
            while cst[2] == 0 && fd >= 0 {
                let t = nodes[fd].b;
                let sc = if nodes[t].kind == 100 { scalar_named(src, toks, nodes[t].a) } else { -1 };
                if sc < 0 { cst[2] = 1; };
                flds[cst[8]].name = nodes[fd].a;
                flds[cst[8]].ty = sc;
                cst[8] = cst[8] + 1;
                nf += 1;
                fd = nodes[fd].next;
            }
            if nf == 0 { cst[2] = 1; };
            strs[si].n_fields = nf;
            cst[7] = si + 1;
        }
        f = nodes[f].next;
    }
}

// an integer literal's value. `lex.nt` keeps a numeric literal's span and never parses it — the
// emitter copies the span through to C — so the one place that needs the number reads it here.
// **A literal token below −1 is the value `−t − 2`**, with no source text behind it — the second
// half of what rewriting needs: a chain's loop starts its accumulator at `0` or `0.0` and counts by
// `1`, and none of those three is written anywhere in the program. Names use the same encoding in a
// different field of a different node kind, so the two never meet.
fn int_value(src: &[u8], toks: &[Token], t: i64) -> i64 {
    if t < 0 - 1 { return 0 - t - 2; }
    let mut v = 0;
    let mut i = 0;
    while i < toks[t].len {
        let c = src[toks[t].start + i];
        if c != b'_' { v = v * 10 + ((c as i64) - 48); }
        i += 1;
    }
    v
}

// the atom for a length expression: an integer literal is its value, an immutable local is its
// declaration, and anything else — a mutable local above all, which may have changed between two
// uses — gets an atom of its own
fn size_atom(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], syms: &[Sym],
             cst: &mut [i64], n: i64) -> i64 {
    if n < 0 { return fresh_atom(cst); }
    if nodes[n].kind == 60 { return 1000000 + int_value(src, toks, nodes[n].a); }
    if nodes[n].kind == 65 {
        let s = sym_find(src, toks, syms, cst, nodes[n].a);
        if s >= 0 && syms[s].mutable == 0 { return syms[s].name; }
    }
    // `[0; xs.len()]` is xs's own size, not a fresh atom that merely agrees with it once — which
    // is what lets two arrays both sized by `src.len()` be assigned to each other
    if nodes[n].kind == 72 && nodes[nodes[n].a].kind == 65 {
        let s = sym_find(src, toks, syms, cst, nodes[nodes[n].a].a);
        if s >= 0 && syms[s].mutable == 0 && is_arrayish(types, syms[s].ty) {
            return types[syms[s].ty].size;
        }
    }
    fresh_atom(cst)
}

// ---- type expressions ----

fn resolve_ty(src: &[u8], toks: &[Token], nodes: &[Node], types: &mut [Ty], strs: &[Str], cst: &mut [i64], n: i64) -> i64 {
    if n < 0 { return 4; }
    let k = nodes[n].kind;
    if k == 100 {
        let s = scalar_named(src, toks, nodes[n].a);
        if s >= 0 { return s; }
        let si = struct_find(src, toks, strs, cst, nodes[n].a);
        if si < 0 { cst[2] = 1; return -1; }
        return new_ty(types, cst, 7, si, 0);
    }
    if k == 101 { return 4; }
    if k == 104 {
        let e = resolve_ty(src, toks, nodes, types, strs, cst, nodes[n].a);
        return new_ty(types, cst, 5, e, 0);
    }
    if k == 102 {
        let e = resolve_ty(src, toks, nodes, types, strs, cst, nodes[n].a);
        return new_ty(types, cst, 5, e, 0);
    }
    if k == 103 {
        let e = resolve_ty(src, toks, nodes, types, strs, cst, nodes[n].a);
        return new_ty(types, cst, 6, e, nodes[n].ival);
    }
    cst[2] = 1;
    -1
}

// ---- expressions ----

// every expression's type is recorded in `ntys`, indexed by node — the table a next stage would
// read, and what the type dump prints. The rules are in `check_expr_inner`; this only records.
fn check_expr(src: &[u8], toks: &[Token], nodes: &mut [Node], types: &mut [Ty], syms: &mut [Sym],
              sigs: &[Sig], ptys: &[i64], strs: &[Str], flds: &[Fld], ntys: &mut [i64], cst: &mut [i64], n: i64) -> i64 {
    let before = cst[2];
    let t = check_expr_inner(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, n);
    if n >= 0 { ntys[n] = t; }
    // the innermost expression that failed: the recursion unwinds through here, and only the
    // deepest frame sees the flag go from clear to set. `cst[2]` alone says a program is wrong
    // without saying where, which is unusable on a file the size of the compiler's own source.
    if cst[2] != 0 && before == 0 && cst[9] < 0 { cst[9] = n; }
    t
}

fn check_expr_inner(src: &[u8], toks: &[Token], nodes: &mut [Node], types: &mut [Ty], syms: &mut [Sym],
              sigs: &[Sig], ptys: &[i64], strs: &[Str], flds: &[Fld], ntys: &mut [i64], cst: &mut [i64], n: i64) -> i64 {
    if cst[2] != 0 || n < 0 { return -1; }
    let k = nodes[n].kind;
    if k == 60 { return 0; }
    if k == 61 { return 1; }
    if k == 62 { return 2; }
    if k == 63 { return 3; }
    if k == 64 { return new_ty(types, cst, 5, 3, 0); }
    if k == 65 {
        let s = sym_find(src, toks, syms, cst, nodes[n].a);
        if s < 0 { cst[2] = 1; return -1; }
        if moved_has(src, toks, cst, syms[s].name) { cst[2] = 1; return -1; }
        return syms[s].ty;
    }
    if k == 66 {
        let a = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        let b = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
        if cst[2] != 0 { return -1; }
        if !same_ty(types, a, b) { cst[2] = 1; return -1; }
        let op = nodes[n].ival;
        if op <= 4 {
            if !is_numeric(types, a) { cst[2] = 1; return -1; }
            return a;
        }
        if op <= 10 {
            if !is_scalar(types, a) { cst[2] = 1; return -1; }
            // an ordering comparison on `bool` is refused, as the Rust checker refuses it
            if op >= 7 && types[a].kind == 2 { cst[2] = 1; return -1; }
            return 2;
        }
        if types[a].kind != 2 { cst[2] = 1; return -1; }
        return 2;
    }
    if k == 67 {
        let a = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        if cst[2] != 0 { return -1; }
        if nodes[n].ival == 0 {
            if !is_numeric(types, a) { cst[2] = 1; return -1; }
            return a;
        }
        if a != 2 { cst[2] = 1; return -1; }
        return 2;
    }
    if k == 68 {
        // the Rust checker indexes a variable, not an arbitrary expression
        if nodes[nodes[n].a].kind != 65 { cst[2] = 1; return -1; }
        let base = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        let idx = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
        if cst[2] != 0 { return -1; }
        if !is_arrayish(types, base) { cst[2] = 1; return -1; }
        if idx != 0 { cst[2] = 1; return -1; }
        return types[base].elem;
    }
    if k == 69 {
        let base = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        if cst[2] != 0 { return -1; }
        if base < 0 || types[base].kind != 7 { cst[2] = 1; return -1; }
        let f = field_find(src, toks, strs, flds, types[base].elem, nodes[n].b);
        if f < 0 { cst[2] = 1; return -1; }
        return flds[f].ty;
    }
    if k == 70 {
        let si = struct_find(src, toks, strs, cst, nodes[n].a);
        if si < 0 { cst[2] = 1; return -1; }
        // every field exactly once, in any order. Naming a field of this struct and counting the
        // initialisers is not enough — `P { x: 1, x: 2 }` passes both and never gives `y` — so a
        // repeat is caught directly, by scanning the initialisers already read.
        let mut seen = 0;
        let mut fi = nodes[n].b;
        while cst[2] == 0 && fi >= 0 {
            let f = field_find(src, toks, strs, flds, si, nodes[fi].a);
            if f < 0 { cst[2] = 1; return -1; }
            let mut prev = nodes[n].b;
            while prev != fi {
                if name_eq(src, toks, nodes[prev].a, nodes[fi].a) { cst[2] = 1; return -1; }
                prev = nodes[prev].next;
            }
            let v = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[fi].b);
            if cst[2] != 0 { return -1; }
            if !same_ty(types, flds[f].ty, v) { cst[2] = 1; return -1; }
            seen += 1;
            fi = nodes[fi].next;
        }
        if seen != strs[si].n_fields { cst[2] = 1; return -1; }
        return new_ty(types, cst, 7, si, 0);
    }
    if k == 72 {
        // the receiver must be a variable, as it must for an index: "the receiver of `.len()`
        // must be a variable for now" is the Rust checker's own message
        if nodes[nodes[n].a].kind != 65 { cst[2] = 1; return -1; }
        let a = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        if cst[2] != 0 { return -1; }
        if !is_arrayish(types, a) { cst[2] = 1; return -1; }
        return 0;
    }
    if k == 77 {
        // every element the same type, and the length is the count — a literal size atom, so two
        // lists of the same length agree
        let mut e = nodes[n].a;
        let mut t = -1;
        let mut count = 0;
        while cst[2] == 0 && e >= 0 {
            let et = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, e);
            if cst[2] != 0 { return -1; }
            if count == 0 { t = et; } else if !same_ty(types, t, et) { cst[2] = 1; return -1; };
            count += 1;
            e = nodes[e].next;
        }
        if count == 0 { cst[2] = 1; return -1; }
        return new_ty_sized(types, cst, 5, t, 0, 1000000 + count);
    }
    // **An allocation with no fill**, which nothing in the language denotes: `[e; n]` builds *and*
    // fills, and an array-valued comprehension writes every element itself, so a rewrite that used
    // `[0; n]` would pay for the array twice (design §26). `ival` carries the element type, which
    // the rewrite knows and the node cannot otherwise say.
    if k == 82 {
        let c = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        if cst[2] != 0 { return -1; }
        if c != 0 { cst[2] = 1; return -1; }
        return new_ty_sized(types, cst, 5, nodes[n].ival, 0,
                            size_atom(src, toks, nodes, types, syms, cst, nodes[n].a));
    }
    if k == 78 {
        let e = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        let c = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
        if cst[2] != 0 { return -1; }
        if c != 0 { cst[2] = 1; return -1; }
        if !is_scalar(types, e) && (e < 0 || types[e].kind != 7) { cst[2] = 1; return -1; }
        return new_ty_sized(types, cst, 5, e, 0, size_atom(src, toks, nodes, types, syms, cst, nodes[n].b));
    }
    if k == 71 { return check_call(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, n); }
    if k == 73 {
        if nodes[nodes[n].a].kind != 65 { cst[2] = 1; return -1; }
        let s = sym_find(src, toks, syms, cst, nodes[nodes[n].a].a);
        if s < 0 { cst[2] = 1; return -1; }
        let t = syms[s].ty;
        if !is_arrayish(types, t) { cst[2] = 1; return -1; }
        // the referent is resolved here rather than through `check_expr`, so its type is recorded
        // here too — the emitter asks what `&ps` refers to in order to lay it out
        ntys[nodes[n].a] = t;
        let m = nodes[n].ival;
        // `&mut` of something that is not `let mut`, or of a `&[T]`, is refused
        if m == 1 {
            if types[t].kind == 5 && syms[s].mutable == 0 { cst[2] = 1; return -1; }
            if types[t].kind == 6 && types[t].mutable == 0 { cst[2] = 1; return -1; }
        }
        return new_ty(types, cst, 6, types[t].elem, m);
    }
    if k == 74 {
        let a = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        let t = resolve_ty(src, toks, nodes, types, strs, cst, nodes[n].b);
        if cst[2] != 0 { return -1; }
        if !is_numeric(types, a) || !is_numeric(types, t) { cst[2] = 1; return -1; }
        return t;
    }
    if k == 75 {
        let c = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        if cst[2] == 0 && c != 2 { cst[2] = 1; return -1; }
        // **Each arm is checked from the same starting set, and a local moved on either side is
        // moved after the `if`.** The then-arm's moves are held aside while the else-arm is checked
        // — otherwise a move in one arm would wrongly reject a use in the other — and appended
        // afterwards, which is the union `types.rs` takes. The stash is a stack, because an `if`
        // inside the else-arm would otherwise write over the one held for the `if` around it.
        let msave = cst[12];
        let t = check_block(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
        if nodes[n].c < 0 {
            if cst[2] == 0 && t != 4 { cst[2] = 1; return -1; }
            return 4;
        }
        let stash = cst[14];
        let n_then = cst[12] - msave;
        let mut si = 0;
        while si < n_then {
            cst[400 + stash + si] = cst[200 + msave + si];
            si += 1;
        }
        cst[14] = stash + n_then;
        cst[12] = msave;
        let e = check_block(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].c);
        let mut sj = 0;
        while sj < n_then {
            if !moved_has(src, toks, cst, cst[400 + stash + sj]) {
                moved_add(cst, cst[400 + stash + sj]);
            };
            sj += 1;
        }
        cst[14] = stash;
        if cst[2] != 0 { return -1; }
        if !same_ty(types, t, e) { cst[2] = 1; return -1; }
        return t;
    }
    if k == 76 { return check_block(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, n); }
    if k == 81 { return check_chain(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, n); }
    cst[2] = 1;
    -1
}

// The array an argument is a view of, as a root name token, or −1 when it is not one: `&x`,
// `&mut x`, or a bare name already holding a view.
fn arg_root(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], syms: &[Sym], cst: &[i64],
            a: i64) -> i64 {
    let inner = if nodes[a].kind == 73 { nodes[a].a } else { a };
    if inner < 0 || nodes[inner].kind != 65 { return 0 - 1; }
    let s = sym_find(src, toks, syms, cst, nodes[inner].a);
    if s < 0 { return 0 - 1; }
    if !is_arrayish(types, syms[s].ty) { return 0 - 1; }
    syms[s].root
}

// whether that argument reaches the callee as `&mut`: written on the `&mut` itself, or carried by
// the type of a view variable passed along
fn arg_is_mut(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], syms: &[Sym], cst: &[i64],
              a: i64) -> bool {
    if nodes[a].kind == 73 { return nodes[a].ival != 0; }
    if nodes[a].kind != 65 { return false; }
    let s = sym_find(src, toks, syms, cst, nodes[a].a);
    if s < 0 { return false; }
    let t = syms[s].ty;
    t >= 0 && types[t].kind == 6 && types[t].mutable == 1
}

// ---------------------------------------------------------------------------------------------
// **A chain is a loop** (design §25). `xs.iter().map(|x| e).filter(|p| c).sum()` becomes
//
//     { let mut ACC = 0; for I in 0..xs.len() { let x = xs[I]; let p = e; if c { ACC += p; } } ACC }
//
// built here and written over the chain's own node, so the emitter and the cost pass see a plain
// block and neither has to know what a chain is. Fusion is not an optimisation applied to this —
// one loop is the only form the construct has.
//
// This slice: `.iter()` as the source, `.map` and `.filter` as stages with one-parameter closures,
// and `.sum()` or `.count()` as the terminal.

// a stage's name, by its first three bytes and its length — which tells `iter`, `map`, `filter`,
// `sum` and `count` apart from each other and from anything else, and an array literal cannot be an
// argument so a whole word to compare with is not available
fn name_is(src: &[u8], toks: &[Token], t: i64, a: u8, b: u8, c: u8, n: i64) -> bool {
    if t < 0 || toks[t].len != n { return false; }
    let s0 = toks[t].start;
    src[s0] == a && src[s0 + 1] == b && src[s0 + 2] == c
}

// **A chain's closure must be a pure function of its arguments.** Fusing every stage into one loop
// is the only form the construct has, so a stage that writes to something outside itself would have
// its writes reordered and merged with the others' by a rewrite it cannot see. `types.rs` calls
// this the `in_closure` check, and `m5-span-design.md` notes that it is also, for free, the proof
// a `.par()` chain needs to be sound.
//
// The walk dispatches on kind rather than following `a` everywhere: on a `Var` or an `Int` that
// field is a **token** index, not a node, and following it walks whatever node happens to share the
// number.
fn has_assign(nodes: &[Node], n: i64) -> bool {
    if n < 0 { return false; }
    let k = nodes[n].kind;
    if k == 91 { return true; }
    if k == 76 { return has_assign_list(nodes, nodes[n].a) || has_assign(nodes, nodes[n].b); }
    if k == 71 { return has_assign_list(nodes, nodes[n].b); }
    if k == 81 { return has_assign(nodes, nodes[n].a) || has_assign_list(nodes, nodes[n].c); }
    if k == 77 { return has_assign_list(nodes, nodes[n].a); }
    if k == 66 || k == 68 || k == 78 {
        return has_assign(nodes, nodes[n].a) || has_assign(nodes, nodes[n].b);
    }
    if k == 82 { return has_assign(nodes, nodes[n].a); }
    if k == 67 || k == 73 || k == 74 || k == 95 || k == 96 || k == 69 || k == 72 || k == 79 {
        if k == 79 { return has_assign(nodes, nodes[n].b); }
        return has_assign(nodes, nodes[n].a);
    }
    if k == 75 || k == 93 || k == 80 {
        return has_assign(nodes, nodes[n].a) || has_assign(nodes, nodes[n].b)
            || has_assign(nodes, nodes[n].c) || has_assign(nodes, nodes[n].d);
    }
    if k == 90 { return has_assign(nodes, nodes[n].c); }
    if k == 92 {
        return has_assign(nodes, nodes[n].b) || has_assign(nodes, nodes[n].c)
            || has_assign(nodes, nodes[n].d);
    }
    false
}

fn has_assign_list(nodes: &[Node], n: i64) -> bool {
    let mut i = n;
    let mut hit = false;
    while i >= 0 {
        if has_assign(nodes, i) { hit = true; };
        i = nodes[i].next;
    }
    hit
}

// append a statement to a block, returning the new last
fn blk_add(nodes: &mut [Node], blk: i64, last: i64, stmt: i64) -> i64 {
    if last < 0 { nodes[blk].a = stmt; } else { nodes[last].next = stmt; };
    stmt
}

// `let NAME = VAL;`
fn mk_let(nodes: &mut [Node], cst: &mut [i64], name: i64, val: i64, mutable: i64) -> i64 {
    let n = nnew(nodes, cst, 90);
    nodes[n].a = name;
    nodes[n].c = val;
    nodes[n].ival = mutable;
    n
}

fn mk_var(nodes: &mut [Node], cst: &mut [i64], name: i64) -> i64 {
    let n = nnew(nodes, cst, 65);
    nodes[n].a = name;
    n
}

fn mk_bin(nodes: &mut [Node], cst: &mut [i64], op: i64, a: i64, b: i64) -> i64 {
    let n = nnew(nodes, cst, 66);
    nodes[n].a = a;
    nodes[n].b = b;
    nodes[n].ival = op;
    n
}

fn mk_bool(nodes: &mut [Node], cst: &mut [i64], v: i64) -> i64 {
    let n = nnew(nodes, cst, 62);
    nodes[n].ival = v;
    n
}

// `LHS <op>= RHS`, or a plain assignment when `op` is −1
fn mk_assign(nodes: &mut [Node], cst: &mut [i64], tgt: i64, val: i64, op: i64) -> i64 {
    let n = nnew(nodes, cst, 91);
    nodes[n].a = tgt;
    nodes[n].b = val;
    nodes[n].ival = op;
    n
}

fn check_chain(src: &[u8], toks: &[Token], nodes: &mut [Node], types: &mut [Ty], syms: &mut [Sym],
               sigs: &[Sig], ptys: &[i64], strs: &[Str], flds: &[Fld], ntys: &mut [i64],
               cst: &mut [i64], n: i64) -> i64 {
    // flatten, outermost first, then walk it inward
    let mut st0 = 0;
    let mut cur = n;
    while nodes[cur].kind == 81 && st0 < 16 {
        cst[40 + st0] = cur;
        st0 += 1;
        cur = nodes[cur].a;
    }
    if nodes[cur].kind == 81 || st0 < 1 { cst[2] = 1; return 0 - 1; }
    // **A comprehension is the same loop**: its condition is a filter and its element a map, both
    // over the variable it names, pushed in front of whatever follows. `[x*x for x in xs if x>0].sum()`
    // needs nothing of its own beyond that.
    let mut comp = 0 - 1;
    let mut sname = 0 - 1;
    if nodes[cur].kind == 80 {
        comp = cur;
        if nodes[nodes[cur].c].kind != 65 { cst[2] = 1; return 0 - 1; }
        sname = nodes[nodes[cur].c].a;
        if st0 < 1 { cst[2] = 1; return 0 - 1; }
    } else {
        if st0 < 2 { cst[2] = 1; return 0 - 1; }
        let it = cst[40 + st0 - 1];
        if !name_is(src, toks, nodes[it].b, b'i', b't', b'e', 4) || nodes[cur].kind != 65 {
            cst[2] = 1;
            return 0 - 1;
        }
        sname = nodes[cur].a;
        st0 -= 1;
    }
    let ss = sym_find(src, toks, syms, cst, sname);
    if ss < 0 || !is_arrayish(types, syms[ss].ty) { cst[2] = 1; return 0 - 1; }
    let elem = types[syms[ss].ty].elem;

    // **the element's type after the stages**, needed before the loop is built because the
    // accumulator's first value is `0` or `0.0` by it. The closure bodies are checked here with
    // their parameter bound, and again when the finished loop is checked; they agree by
    // construction, since the rewrite binds the parameter to exactly this type.
    // a comprehension's own condition and element are checked as if they were stages
    let mut et = elem;
    if comp >= 0 {
        let saved0 = cst[1];
        declare(syms, cst, nodes[comp].b, et, 0, 0 - 1);
        if nodes[comp].d >= 0 {
            let ct = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[comp].d);
            if cst[2] == 0 && ct != 2 { cst[2] = 1; };
        };
        let mt = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[comp].a);
        cst[1] = saved0;
        if cst[2] != 0 { return 0 - 1; }
        et = mt;
    };
    // `.zip(b)` must come first, directly after the source: it names the *other* array, and the
    // loop then runs to the shorter of the two
    let mut zname = 0 - 1;
    let mut zelem = 0 - 1;
    if st0 >= 2 && name_is(src, toks, nodes[cst[40 + st0 - 1]].b, b'z', b'i', b'p', 3) {
        let zs = cst[40 + st0 - 1];
        let za = nodes[zs].c;
        if za < 0 || nodes[za].kind != 65 || nodes[za].next >= 0 { cst[2] = 1; return 0 - 1; }
        let zsym = sym_find(src, toks, syms, cst, nodes[za].a);
        if zsym < 0 || !is_arrayish(types, syms[zsym].ty) { cst[2] = 1; return 0 - 1; }
        zname = nodes[za].a;
        zelem = types[syms[zsym].ty].elem;
        st0 -= 1;
    };
    // **values flow through the stages as a list**, not one at a time: `.enumerate()` puts the index
    // in front of the element and the closure after it takes both. Two is all the corpus asks for.
    let mut et1 = if zname >= 0 { zelem } else { 0 - 1 };
    let mut nval = if zname >= 0 { 2 } else { 1 };
    let mut k = st0 - 1;
    while k >= 1 && cst[2] == 0 {
        let stg = cst[40 + k];
        if name_is(src, toks, nodes[stg].b, b'e', b'n', b'u', 9) {
            if nodes[stg].c >= 0 || nval != 1 { cst[2] = 1; return 0 - 1; }
            et1 = et;
            et = 0;
            nval = 2;
        } else {
            let lam = nodes[stg].c;
            if lam < 0 || nodes[lam].kind != 79 || nodes[lam].a < 0 { cst[2] = 1; return 0 - 1; }
            let p0 = nodes[lam].a;
            let p1 = nodes[p0].next;
            if nval == 1 && p1 >= 0 { cst[2] = 1; return 0 - 1; }
            if nval == 2 && p1 < 0 { cst[2] = 1; return 0 - 1; }
            if has_assign(nodes, nodes[lam].b) { cst[2] = 1; return 0 - 1; }
            let saved = cst[1];
            declare(syms, cst, nodes[p0].a, et, 0, 0 - 1);
            if nval == 2 { declare(syms, cst, nodes[p1].a, et1, 0, 0 - 1); };
            let bt = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[lam].b);
            cst[1] = saved;
            if cst[2] != 0 { return 0 - 1; }
            if name_is(src, toks, nodes[stg].b, b'm', b'a', b'p', 3) {
                et = bt;
                et1 = 0 - 1;
                nval = 1;
            } else if name_is(src, toks, nodes[stg].b, b'f', b'i', b'l', 6) {
                if bt != 2 { cst[2] = 1; return 0 - 1; }
            } else {
                cst[2] = 1;
                return 0 - 1;
            };
        };
        k -= 1;
    }
    if nval != 1 { cst[2] = 1; return 0 - 1; }
    let term = cst[40];
    let is_sum = name_is(src, toks, nodes[term].b, b's', b'u', b'm', 3);
    let is_cnt = name_is(src, toks, nodes[term].b, b'c', b'o', b'u', 5);
    let is_max = name_is(src, toks, nodes[term].b, b'm', b'a', b'x', 3);
    let is_min = name_is(src, toks, nodes[term].b, b'm', b'i', b'n', 3);
    let is_any = name_is(src, toks, nodes[term].b, b'a', b'n', b'y', 3);
    let is_all = name_is(src, toks, nodes[term].b, b'a', b'l', b'l', 3);
    let is_fold = name_is(src, toks, nodes[term].b, b'f', b'o', b'l', 4);
    if !is_sum && !is_cnt && !is_max && !is_min && !is_any && !is_all && !is_fold {
        cst[2] = 1;
        return 0 - 1;
    }
    // **`.fold(init, |acc, x| e)`** is the only terminal with arguments, and its accumulator starts
    // at a value the program gives rather than at an identity the terminal knows
    let mut fold_init = 0 - 1;
    let mut fold_lam = 0 - 1;
    if is_fold {
        fold_init = nodes[term].c;
        if fold_init < 0 { cst[2] = 1; return 0 - 1; }
        fold_lam = nodes[fold_init].next;
        if fold_lam < 0 || nodes[fold_lam].kind != 79 || nodes[fold_lam].next >= 0 {
            cst[2] = 1;
            return 0 - 1;
        }
        let fp0 = nodes[fold_lam].a;
        if fp0 < 0 || nodes[fp0].next < 0 || nodes[nodes[fp0].next].next >= 0 {
            cst[2] = 1;
            return 0 - 1;
        }
        if has_assign(nodes, nodes[fold_lam].b) { cst[2] = 1; return 0 - 1; }
    } else if nodes[term].c >= 0 {
        cst[2] = 1;
        return 0 - 1;
    };
    // `any` and `all` want a `bool` an element at a time; `max` and `min` want a number
    if is_any || is_all {
        if et != 2 { cst[2] = 1; return 0 - 1; }
    } else if is_max || is_min {
        if et != 0 && et != 1 { cst[2] = 1; return 0 - 1; }
    };
    let mut acc_ty = if is_cnt { 0 } else if is_any || is_all { 2 } else { et };
    if is_fold {
        acc_ty = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, fold_init);
        if cst[2] != 0 { return 0 - 1; }
        // the closure returns what the accumulator holds, checked with both bound
        let sv4 = cst[1];
        declare(syms, cst, nodes[nodes[fold_lam].a].a, acc_ty, 0, 0 - 1);
        declare(syms, cst, nodes[nodes[nodes[fold_lam].a].next].a, et, 0, 0 - 1);
        let ft = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[fold_lam].b);
        cst[1] = sv4;
        if cst[2] != 0 { return 0 - 1; }
        if ft != acc_ty { cst[2] = 1; return 0 - 1; }
    };
    if acc_ty != 0 && acc_ty != 1 && acc_ty != 2 { cst[2] = 1; return 0 - 1; }

    // ---- build ----
    let iv = nfresh(cst);
    let av = nfresh(cst);
    let sn = nfresh(cst);
    let zero = if is_fold { fold_init }
               else if acc_ty == 2 { mk_bool(nodes, cst, if is_all { 1 } else { 0 }) }
               else { nlit(nodes, cst, if acc_ty == 1 { 61 } else { 60 }, 0) };
    let l0 = mk_let(nodes, cst, av, zero, 1);
    // `max` and `min` keep a `seen` flag beside the accumulator: the first element wins outright,
    // there being no identity to start from — which is also why `.par()` refuses them
    if is_max || is_min {
        let f0 = mk_bool(nodes, cst, 0);
        nodes[l0].next = mk_let(nodes, cst, sn, f0, 1);
    };
    let lo = nlit(nodes, cst, 60, 0);
    let sv = mk_var(nodes, cst, sname);
    let hi0 = nnew(nodes, cst, 72);
    nodes[hi0].a = sv;
    let mut hi = hi0;
    if zname >= 0 {
        let zv = mk_var(nodes, cst, zname);
        let hz = nnew(nodes, cst, 72);
        nodes[hz].a = zv;
        // `min(a.len(), b.len())`, through the sentinel name a rewrite can write
        let mn = nnew(nodes, cst, 71);
        nodes[mn].a = 0 - 1000000;
        nodes[mn].b = hi0;
        nodes[hi0].next = hz;
        hi = mn;
    };
    let body = nnew(nodes, cst, 76);
    let fo = nnew(nodes, cst, 92);
    nodes[fo].a = iv;
    nodes[fo].b = lo;
    nodes[fo].c = hi;
    nodes[fo].d = body;

    // the element, and one statement per stage
    let sv2 = mk_var(nodes, cst, sname);
    let ivv = mk_var(nodes, cst, iv);
    let ix = nnew(nodes, cst, 68);
    nodes[ix].a = sv2;
    nodes[ix].b = ivv;
    // **the element is always bound**, even when nothing looks at it: `xs.iter().count()` reads
    // each element in `analyze.rs`'s model, and a desugaring that skipped the read would cost 3 per
    // element where the answer is 4 and move nothing where the answer is `8·xs.len() + B`
    // a comprehension binds the element to the variable it names, since both its condition and its
    // element expression are written in terms of that name
    let ev = if comp >= 0 { nodes[comp].b } else { nfresh(cst) };
    let mut blk = body;
    let mut last = blk_add(nodes, blk, 0 - 1, mk_let(nodes, cst, ev, ix, 0));
    let mut cure = mk_var(nodes, cst, ev);
    let mut cure1 = 0 - 1;
    if zname >= 0 {
        let zv2 = mk_var(nodes, cst, zname);
        let iv3 = mk_var(nodes, cst, iv);
        let zix = nnew(nodes, cst, 68);
        nodes[zix].a = zv2;
        nodes[zix].b = iv3;
        let ev2 = nfresh(cst);
        last = blk_add(nodes, blk, last, mk_let(nodes, cst, ev2, zix, 0));
        cure1 = mk_var(nodes, cst, ev2);
    };
    if comp >= 0 {
        if nodes[comp].d >= 0 {
            let inner0 = nnew(nodes, cst, 76);
            let if0 = nnew(nodes, cst, 75);
            nodes[if0].a = nodes[comp].d;
            nodes[if0].b = inner0;
            let es0 = nnew(nodes, cst, 95);
            nodes[es0].a = if0;
            last = blk_add(nodes, blk, last, es0);
            blk = inner0;
            last = 0 - 1;
        };
        cure = nodes[comp].a;
    };
    let mut j = st0 - 1;
    while j >= 1 {
        let stg = cst[40 + j];
        if name_is(src, toks, nodes[stg].b, b'e', b'n', b'u', 9) {
            // the index goes in *front* of the element, so a closure after it reads `|i, x|`
            let kv = nfresh(cst);
            let iv2 = mk_var(nodes, cst, iv);
            last = blk_add(nodes, blk, last, mk_let(nodes, cst, kv, iv2, 0));
            cure1 = cure;
            cure = mk_var(nodes, cst, kv);
            j -= 1;
        } else {
        let lam = nodes[stg].c;
        let pn = nodes[nodes[lam].a].a;
        last = blk_add(nodes, blk, last, mk_let(nodes, cst, pn, cure, 0));
        if cure1 >= 0 {
            let pn1 = nodes[nodes[nodes[lam].a].next].a;
            last = blk_add(nodes, blk, last, mk_let(nodes, cst, pn1, cure1, 0));
            cure1 = 0 - 1;
        };
        if name_is(src, toks, nodes[stg].b, b'm', b'a', b'p', 3) {
            cure = nodes[lam].b;
        } else {
            // a filter nests what follows inside an `if`, which is how a chain says "skip" in a
            // language with no `continue`
            let inner = nnew(nodes, cst, 76);
            let iff = nnew(nodes, cst, 75);
            nodes[iff].a = nodes[lam].b;
            nodes[iff].b = inner;
            let es = nnew(nodes, cst, 95);
            nodes[es].a = iff;
            last = blk_add(nodes, blk, last, es);
            blk = inner;
            last = 0 - 1;
            cure = mk_var(nodes, cst, pn);
        };
        j -= 1;
        };
    }
    // the terminal
    let tgt = mk_var(nodes, cst, av);
    if is_max || is_min {
        // `if !seen || cur <cmp> acc { acc = cur; seen = true; }`
        let sv3 = mk_var(nodes, cst, sn);
        let nots = nnew(nodes, cst, 67);
        nodes[nots].a = sv3;
        nodes[nots].ival = 1;
        let better = mk_bin(nodes, cst, if is_max { 9 } else { 7 }, cure, tgt);
        let cond = mk_bin(nodes, cst, 12, nots, better);
        let inner = nnew(nodes, cst, 76);
        let t2 = mk_var(nodes, cst, av);
        let set = mk_assign(nodes, cst, t2, cure, 0 - 1);
        let s2 = mk_var(nodes, cst, sn);
        let tru = mk_bool(nodes, cst, 1);
        nodes[set].next = mk_assign(nodes, cst, s2, tru, 0 - 1);
        nodes[inner].a = set;
        let iff = nnew(nodes, cst, 75);
        nodes[iff].a = cond;
        nodes[iff].b = inner;
        let es2 = nnew(nodes, cst, 95);
        nodes[es2].a = iff;
        blk_add(nodes, blk, last, es2);
    } else if is_fold {
        // `acc = <closure body>`, with the accumulator and the element bound to its parameters
        let fa = nodes[nodes[fold_lam].a].a;
        let fx = nodes[nodes[nodes[fold_lam].a].next].a;
        let accv = mk_var(nodes, cst, av);
        last = blk_add(nodes, blk, last, mk_let(nodes, cst, fa, accv, 0));
        last = blk_add(nodes, blk, last, mk_let(nodes, cst, fx, cure, 0));
        blk_add(nodes, blk, last, mk_assign(nodes, cst, tgt, nodes[fold_lam].b, 0 - 1));
    } else if is_any || is_all {
        // `acc = acc || cur` / `acc = acc && cur`
        let t3 = mk_var(nodes, cst, av);
        let comb = mk_bin(nodes, cst, if is_any { 12 } else { 11 }, tgt, cure);
        blk_add(nodes, blk, last, mk_assign(nodes, cst, t3, comb, 0 - 1));
    } else {
        let v = if is_cnt { nlit(nodes, cst, 60, 1) } else { cure };
        blk_add(nodes, blk, last, mk_assign(nodes, cst, tgt, v, 0));
    };

    // the chain's own node becomes the block that replaces it
    nodes[n].kind = 76;
    nodes[n].a = l0;
    // a `for` is a statement already; only an `if` needs wrapping to become one
    if nodes[l0].next >= 0 { nodes[nodes[l0].next].next = fo; } else { nodes[l0].next = fo; };
    nodes[n].b = mk_var(nodes, cst, av);
    nodes[n].c = 0 - 1;
    nodes[n].d = 0 - 1;
    check_block(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, n)
}

// `let ys = [e for x in xs];` → `let ys = <alloc xs.len()>;` followed by
// `for i in 0..xs.len() { let x = xs[i]; ys[i] = e; }`. A *filtered* comprehension has no length
// the compiler can state and is refused, which is what `err_filtered_let.nt` tests.
fn comp_let(src: &[u8], toks: &[Token], nodes: &mut [Node], types: &mut [Ty], syms: &mut [Sym],
            sigs: &[Sig], ptys: &[i64], strs: &[Str], flds: &[Fld], ntys: &mut [i64],
            cst: &mut [i64], n: i64) {
    let comp = nodes[n].c;
    if nodes[comp].d >= 0 { cst[2] = 1; return; }
    let srcn = nodes[comp].c;
    if nodes[srcn].kind != 65 { cst[2] = 1; return; }
    let sname = nodes[srcn].a;
    let ss = sym_find(src, toks, syms, cst, sname);
    if ss < 0 || !is_arrayish(types, syms[ss].ty) { cst[2] = 1; return; }
    let elem = types[syms[ss].ty].elem;
    // the element type the comprehension produces, with its variable bound
    let saved = cst[1];
    declare(syms, cst, nodes[comp].b, elem, 0, 0 - 1);
    let et = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[comp].a);
    cst[1] = saved;
    if cst[2] != 0 { return; }
    if !is_scalar(types, et) { cst[2] = 1; return; }

    let sv = mk_var(nodes, cst, sname);
    let hi = nnew(nodes, cst, 72);
    nodes[hi].a = sv;
    let alloc = nnew(nodes, cst, 82);
    nodes[alloc].a = hi;
    nodes[alloc].ival = et;

    let iv = nfresh(cst);
    let lo = nlit(nodes, cst, 60, 0);
    let sv2 = mk_var(nodes, cst, sname);
    let hi2 = nnew(nodes, cst, 72);
    nodes[hi2].a = sv2;
    let body = nnew(nodes, cst, 76);
    let fo = nnew(nodes, cst, 92);
    nodes[fo].a = iv;
    nodes[fo].b = lo;
    nodes[fo].c = hi2;
    nodes[fo].d = body;

    let sv3 = mk_var(nodes, cst, sname);
    let iv2 = mk_var(nodes, cst, iv);
    let ix = nnew(nodes, cst, 68);
    nodes[ix].a = sv3;
    nodes[ix].b = iv2;
    let l1 = mk_let(nodes, cst, nodes[comp].b, ix, 0);
    let yv = mk_var(nodes, cst, nodes[n].a);
    let iv3 = mk_var(nodes, cst, iv);
    let tix = nnew(nodes, cst, 68);
    nodes[tix].a = yv;
    nodes[tix].b = iv3;
    // **the fill is a build, not a store site**: `analyze.rs` charges a comprehension the bytes of
    // the array it streams and no line term, the same way it charges `[e; n]`, so the write here
    // must not be counted a second time as a site. The mark rides on the index node's `ival`, which
    // an index otherwise never uses.
    nodes[tix].ival = 1;
    nodes[l1].next = mk_assign(nodes, cst, tix, nodes[comp].a, 0 - 1);
    nodes[body].a = l1;

    // the `let` keeps its place and the loop follows it, so the target is in scope for the fill
    nodes[n].c = alloc;
    nodes[n].ival = 1;
    nodes[fo].next = nodes[n].next;
    nodes[n].next = fo;
}

fn check_call(src: &[u8], toks: &[Token], nodes: &mut [Node], types: &mut [Ty], syms: &mut [Sym],
              sigs: &[Sig], ptys: &[i64], strs: &[Str], flds: &[Fld], ntys: &mut [i64], cst: &mut [i64], n: i64) -> i64 {
    let name = nodes[n].a;
    if name_is_println(src, toks, name) {
        let a = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
        if cst[2] != 0 { return -1; }
        if nodes[n].b < 0 || nodes[nodes[n].b].next >= 0 { cst[2] = 1; return -1; }
        if !is_scalar(types, a) { cst[2] = 1; return -1; }
        return 4;
    }
    if name_is_min(src, toks, name) || name_is_max(src, toks, name) {
        let first = nodes[n].b;
        if first < 0 { cst[2] = 1; return -1; }
        let second = nodes[first].next;
        if second < 0 || nodes[second].next >= 0 { cst[2] = 1; return -1; }
        let a = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, first);
        let b = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, second);
        if cst[2] != 0 { return -1; }
        if !same_ty(types, a, b) || !is_numeric(types, a) { cst[2] = 1; return -1; }
        return a;
    }
    // a declared function: its signature, by name
    let mut si = -1;
    let mut i = 0;
    while i < cst[3] {
        if si < 0 && name_eq(src, toks, sigs[i].name, name) { si = i; }
        i += 1;
    }
    if si < 0 { cst[2] = 1; return -1; }
    // **Two arguments must not be views of one array when either is `&mut`.** Parameters are
    // emitted as `restrict` and the cost model counts them as disjoint, so an overlap here is a
    // claim the emitted C already makes. Matched by *root*, since `&xs` and a `let v = &xs` are
    // the same memory under two names.
    let mut a1 = nodes[n].b;
    while cst[2] == 0 && a1 >= 0 {
        let r1 = arg_root(src, toks, nodes, types, syms, cst, a1);
        if r1 >= 0 {
            let m1 = arg_is_mut(src, toks, nodes, types, syms, cst, a1);
            let mut a2 = nodes[a1].next;
            while cst[2] == 0 && a2 >= 0 {
                let r2 = arg_root(src, toks, nodes, types, syms, cst, a2);
                if r2 >= 0 && name_eq(src, toks, r1, r2) {
                    let m2 = arg_is_mut(src, toks, nodes, types, syms, cst, a2);
                    if m1 || m2 { cst[2] = 1; }
                };
                a2 = nodes[a2].next;
            }
        };
        a1 = nodes[a1].next;
    }
    if cst[2] != 0 { return -1; }
    let mut arg = nodes[n].b;
    let mut k = 0;
    while cst[2] == 0 && arg >= 0 {
        let at = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, arg);
        if cst[2] == 0 {
            if k >= sigs[si].n_params {
                cst[2] = 1;
            } else {
                let want = ptys[sigs[si].params + k];
                // a `&mut [T]` argument satisfies a `&[T]` parameter, not the other way round
                let ok = if same_ty(types, at, want) {
                    true
                } else if at >= 0 && want >= 0 && types[at].kind == 6 && types[want].kind == 6 {
                    types[at].mutable == 1 && types[want].mutable == 0 && same_ty(types, types[at].elem, types[want].elem)
                } else {
                    false
                };
                if !ok { cst[2] = 1; }
            }
        }
        k += 1;
        arg = nodes[arg].next;
    }
    if cst[2] == 0 && k != sigs[si].n_params { cst[2] = 1; }
    if cst[2] != 0 { return -1; }
    let r = sigs[si].ret;
    if r >= 0 && types[r].kind == 5 {
        return new_ty_sized(types, cst, 5, types[r].elem, 0, fresh_atom(cst));
    }
    r
}

// **An owned array return carries its length in the signature.** `same_ty` makes an array's length
// part of its type, so a declared `-> [T]` — which `resolve_ty` gives no length — can never equal
// the body's, whose length is a real atom. The declaration says the element type and the *body*
// says the length, which is what `-> [T]` means: the caller is handed an array whose length is the
// callee's business. So the two are compared by element type, and a call gets an array with a
// length of its own.
fn ret_ok(types: &[Ty], declared: i64, got: i64) -> bool {
    if same_ty(types, declared, got) { return true; }
    if declared < 0 || got < 0 { return false; }
    if types[declared].kind != 5 || types[got].kind != 5 { return false; }
    same_ty(types, types[declared].elem, types[got].elem)
}

// ---- statements and blocks ----

// a block's own scope is the symbol table's length: entering saves it, leaving restores it
fn check_block(src: &[u8], toks: &[Token], nodes: &mut [Node], types: &mut [Ty], syms: &mut [Sym],
               sigs: &[Sig], ptys: &[i64], strs: &[Str], flds: &[Fld], ntys: &mut [i64], cst: &mut [i64], n: i64) -> i64 {
    if cst[2] != 0 || n < 0 { return -1; }
    let saved = cst[1];
    let mut s = nodes[n].a;
    while cst[2] == 0 && s >= 0 {
        check_stmt(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, s);
        s = nodes[s].next;
    }
    let mut t = 4;
    if nodes[n].b >= 0 {
        t = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
    }
    cst[1] = saved;
    // recorded here rather than in `check_expr`'s wrapper: a function body, a loop body and an
    // `if` arm reach this directly, without being an expression themselves
    ntys[n] = t;
    t
}

fn check_stmt(src: &[u8], toks: &[Token], nodes: &mut [Node], types: &mut [Ty], syms: &mut [Sym],
              sigs: &[Sig], ptys: &[i64], strs: &[Str], flds: &[Fld], ntys: &mut [i64], cst: &mut [i64], n: i64) {
    let before = cst[2];
    check_stmt_inner(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, n);
    if cst[2] != 0 && before == 0 && cst[9] < 0 { cst[9] = n; }
}

fn check_stmt_inner(src: &[u8], toks: &[Token], nodes: &mut [Node], types: &mut [Ty], syms: &mut [Sym],
              sigs: &[Sig], ptys: &[i64], strs: &[Str], flds: &[Fld], ntys: &mut [i64], cst: &mut [i64], n: i64) {
    if cst[2] != 0 || n < 0 { return; }
    let k = nodes[n].kind;
    if k == 90 {
        // **`let ys = [e for x in xs];` is two statements, not one.** Every other chain became a
        // block expression written over its own node and the emitter never had to know; this one
        // allocates, and `emit`'s array-`let` path takes only a brace list, a repeat or a byte
        // string. So the rewrite happens here, at the statement, and puts a fill loop after the
        // `let` (design §26).
        if nodes[n].c >= 0 && nodes[nodes[n].c].kind == 80 {
            comp_let(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, n);
            if cst[2] != 0 { return; }
        };
        let t = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].c);
        if cst[2] != 0 { return; }
        if t == 4 { cst[2] = 1; return; }
        if nodes[n].b >= 0 {
            let d = resolve_ty(src, toks, nodes, types, strs, cst, nodes[n].b);
            if cst[2] != 0 { return; }
            if !same_ty(types, d, t) { cst[2] = 1; return; }
        }
        // **`let ys = xs;` moves `xs`.** A bare variable is the only initialiser a move can name;
        // an array literal, a repeat or a byte string builds a fresh array and moves nothing.
        if types[t].kind == 5 && nodes[nodes[n].c].kind == 65 {
            let sv = sym_find(src, toks, syms, cst, nodes[nodes[n].c].a);
            if sv < 0 { cst[2] = 1; return; }
            // **moving inside a loop moves it again on the next lap.** One lexical occurrence
            // stands for every iteration, so a source declared before the loop cannot be moved in
            // it — which is `src < loop_start` in `types.rs`, and here the symbol table's length at
            // the loop's entry says the same thing.
            if cst[13] >= 0 && sv < cst[13] { cst[2] = 1; return; }
            // **A view of the source may not outlive the move and be read again.** The buffer is
            // the target's now, so a view still pointing into it reads memory that is no longer
            // what it was declared to view — and the emitter hands both to C as `restrict`
            // pointers. `resolve_moves` in `types.rs`.
            let mut vi = 0;
            while vi < cst[1] {
                let vt = syms[vi].ty;
                if vi != sv && vt >= 0 && types[vt].kind == 6
                    && name_eq(src, toks, syms[vi].root, syms[sv].root)
                    && used_after(src, toks, cst, syms[vi].name, nodes[nodes[n].c].a) {
                    cst[2] = 1;
                    return;
                };
                vi += 1;
            }
            moved_add(cst, syms[sv].name);
            if cst[2] != 0 { return; }
        };
        // `let v = &xs;` is a view of `xs`, and of whatever `xs` itself views
        let mut root = 0 - 1;
        let ini = nodes[n].c;
        if ini >= 0 && nodes[ini].kind == 73 && nodes[nodes[ini].a].kind == 65 {
            root = sym_root(src, toks, syms, cst, nodes[nodes[ini].a].a);
        } else if ini >= 0 && nodes[ini].kind == 65 && is_arrayish(types, t) {
            root = sym_root(src, toks, syms, cst, nodes[ini].a);
        };
        declare(syms, cst, nodes[n].a, t, nodes[n].ival, root);
        return;
    }
    if k == 91 {
        let tgt = nodes[n].a;
        let tk = nodes[tgt].kind;
        if tk == 65 {
            let s = sym_find(src, toks, syms, cst, nodes[tgt].a);
            if s < 0 { cst[2] = 1; return; }
            if syms[s].mutable == 0 { cst[2] = 1; return; }
            // the target is resolved here rather than through `check_expr`, so its type has to be
            // recorded here too: the emitter asks whether an assignment's target is an array
            ntys[tgt] = syms[s].ty;
            let v = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
            if cst[2] != 0 { return; }
            // `ys = xs` on whole arrays is M5's reassignment, and it is allowed. This slice has no
            // size variables (design §1), so it compares element types and not lengths: it accepts
            // a length mismatch the Rust checker refuses, which is a narrowing, not a difference
            // of opinion — nothing here decides in-place versus copy.
            if !same_ty(types, syms[s].ty, v) { cst[2] = 1; return; }
            if nodes[n].ival >= 0 && !is_numeric(types, syms[s].ty) { cst[2] = 1; return; }
            // **`ys = xs` on whole arrays: in place, or a copy.** `ys` takes `xs`'s buffer unless
            // something can still observe that they became the same memory. Two things force the
            // copy, and they are the two `types.rs` uses: a loop either name was declared before,
            // because one lexical assignment stands for every lap and the second would read a
            // buffer the first gave away; and a view of the source that is read after this point.
            // The verdict is recorded at the statement as `ntys[n] = −2`, which no type index can
            // be, so the emitter and the cost pass read the same decision the checker made.
            let vnode = nodes[n].b;
            if types[syms[s].ty].kind == 5 && nodes[n].ival < 0 && vnode >= 0
                && nodes[vnode].kind == 65 {
                let sv = sym_find(src, toks, syms, cst, nodes[vnode].a);
                if sv >= 0 && sv != s {
                    let forced = cst[13] >= 0 && (sv < cst[13] || s < cst[13]);
                    let mut inplace = !forced;
                    let mut vi = 0;
                    while vi < cst[1] {
                        let vt = syms[vi].ty;
                        if vi != sv && vt >= 0 && types[vt].kind == 6
                            && name_eq(src, toks, syms[vi].root, syms[sv].root)
                            && used_after(src, toks, cst, syms[vi].name, nodes[vnode].a) {
                            inplace = false;
                        };
                        vi += 1;
                    }
                    if inplace { ntys[n] = 0 - 2; };
                    // `xs` is dead either way, and `ys` denotes a value disjoint from everything
                    // else — in place or not, nothing later can observe which it was
                    moved_del(src, toks, cst, syms[s].name);
                    moved_add(cst, syms[sv].name);
                    syms[s].root = syms[s].name;
                }
            };
            return;
        }
        if tk == 68 {
            if nodes[nodes[tgt].a].kind != 65 { cst[2] = 1; return; }
            let s = sym_find(src, toks, syms, cst, nodes[nodes[tgt].a].a);
            if s < 0 { cst[2] = 1; return; }
            let bt = syms[s].ty;
            if !is_arrayish(types, bt) { cst[2] = 1; return; }
            // the base is resolved here rather than through `check_expr`, so its type has to be
            // recorded here too — the cost pass asks what an assignment target's array holds
            ntys[nodes[tgt].a] = bt;
            // writing needs an owned `let mut` array or a `&mut [T]`
            if types[bt].kind == 5 && syms[s].mutable == 0 { cst[2] = 1; return; }
            if types[bt].kind == 6 && types[bt].mutable == 0 { cst[2] = 1; return; }
            let it = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[tgt].b);
            if cst[2] == 0 && it != 0 { cst[2] = 1; return; }
            let v = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
            if cst[2] != 0 { return; }
            if !same_ty(types, types[bt].elem, v) { cst[2] = 1; }
            return;
        }
        if tk == 69 {
            // writing a field needs the *place* to be writable: a `let mut` struct, or an element
            // of a writable array. Checking the base as an expression would not say which.
            let b0 = nodes[tgt].a;
            if nodes[b0].kind == 65 {
                let s = sym_find(src, toks, syms, cst, nodes[b0].a);
                if s < 0 { cst[2] = 1; return; }
                if syms[s].mutable == 0 { cst[2] = 1; return; }
            } else if nodes[b0].kind == 68 {
                if nodes[nodes[b0].a].kind != 65 { cst[2] = 1; return; }
                let s = sym_find(src, toks, syms, cst, nodes[nodes[b0].a].a);
                if s < 0 { cst[2] = 1; return; }
                let bt = syms[s].ty;
                if !is_arrayish(types, bt) { cst[2] = 1; return; }
                if types[bt].kind == 5 && syms[s].mutable == 0 { cst[2] = 1; return; }
                if types[bt].kind == 6 && types[bt].mutable == 0 { cst[2] = 1; return; }
                ntys[nodes[b0].a] = bt;
            } else {
                cst[2] = 1;
                return;
            }
            let ft = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, tgt);
            let v = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
            if cst[2] != 0 { return; }
            if !same_ty(types, ft, v) { cst[2] = 1; return; }
            if nodes[n].ival >= 0 && !is_numeric(types, ft) { cst[2] = 1; }
            return;
        }
        cst[2] = 1;
        return;
    }
    if k == 92 {
        let a = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
        let b = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].c);
        if cst[2] != 0 { return; }
        if a != 0 || b != 0 { cst[2] = 1; return; }
        let saved = cst[1];
        let sloop = cst[13];
        cst[13] = saved;
        declare(syms, cst, nodes[n].a, 0, 0, 0 - 1);
        cst[5] = cst[5] + 1;
        let t = check_block(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].d);
        cst[5] = cst[5] - 1;
        cst[13] = sloop;
        cst[1] = saved;
        if cst[2] == 0 && t != 4 { cst[2] = 1; }
        return;
    }
    if k == 93 {
        let c = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        if cst[2] == 0 && c != 2 { cst[2] = 1; return; }
        if nodes[n].b >= 0 {
            let m = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
            if cst[2] == 0 && m != 0 { cst[2] = 1; return; }
        }
        let sloop = cst[13];
        cst[13] = cst[1];
        cst[5] = cst[5] + 1;
        let t = check_block(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].c);
        cst[5] = cst[5] - 1;
        cst[13] = sloop;
        if cst[2] == 0 && t != 4 { cst[2] = 1; }
        return;
    }
    if k == 94 {
        if cst[5] == 0 { cst[2] = 1; }
        return;
    }
    if k == 95 {
        let t = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        if cst[2] == 0 && is_arrayish(types, t) { cst[2] = 1; }
        return;
    }
    if k == 96 {
        if nodes[n].a < 0 {
            if cst[6] != 4 { cst[2] = 1; }
            return;
        }
        let t = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        if cst[2] == 0 && !ret_ok(types, cst[6], t) { cst[2] = 1; }
        return;
    }
    cst[2] = 1;
}

// ---- functions ----

// every signature first, so a call may name a function declared later
fn collect_sigs(src: &[u8], toks: &[Token], nodes: &[Node], types: &mut [Ty], sigs: &mut [Sig],
                ptys: &mut [i64], strs: &[Str], cst: &mut [i64], first: i64) {
    let mut f = first;
    while cst[2] == 0 && f >= 0 {
        // the item list interleaves functions, externs and structs in source order, so this skips
        // what `collect_structs` already read. An `extern fn` has a signature like any other and
        // is called like any other, so it takes a slot here; it just has no body to check.
        cst[10] = f;
        if nodes[f].kind == 110 || nodes[f].kind == 116 {
            let si = cst[3];
            sigs[si].name = nodes[f].a;
            sigs[si].ext = if nodes[f].kind == 116 { 1 } else { 0 };
            sigs[si].params = cst[4];
            let mut np = 0;
            let mut p = nodes[f].b;
            while cst[2] == 0 && p >= 0 {
                let t = resolve_ty(src, toks, nodes, types, strs, cst, nodes[p].b);
                ptys[cst[4]] = t;
                cst[4] = cst[4] + 1;
                np += 1;
                p = nodes[p].next;
            }
            sigs[si].n_params = np;
            sigs[si].ret = resolve_ty(src, toks, nodes, types, strs, cst, nodes[f].c);
            cst[3] = si + 1;
        }
        f = nodes[f].next;
    }
    // a terminator, so a reader that has the table but not the count — the emitter — can stop
    sigs[cst[3]].name = -1;
}

fn check_func(src: &[u8], toks: &[Token], nodes: &mut [Node], types: &mut [Ty], syms: &mut [Sym],
              sigs: &[Sig], ptys: &[i64], strs: &[Str], flds: &[Fld], ntys: &mut [i64], cst: &mut [i64], f: i64, si: i64) {
    if cst[2] != 0 { return; }
    let saved = cst[1];
    // moves are per function: nothing a previous body moved is moved in this one
    cst[15] = if nodes[f].next >= 0 { nodes[nodes[f].next].a } else { 1000000000 };
    cst[12] = 0;
    cst[13] = 0 - 1;
    cst[14] = 0;
    let mut p = nodes[f].b;
    let mut k = 0;
    while p >= 0 {
        declare(syms, cst, nodes[p].a, ptys[sigs[si].params + k], 0, 0 - 1);
        k += 1;
        p = nodes[p].next;
    }
    cst[6] = sigs[si].ret;
    let body = nodes[f].d;
    let t = check_block(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, body);
    if cst[2] == 0 {
        if nodes[body].b >= 0 {
            // the body's value is its tail: it must be what the signature says
            if !ret_ok(types, sigs[si].ret, t) { cst[2] = 1; }
        } else if sigs[si].ret != 4 && !ends_in_return(nodes, body) {
            cst[2] = 1;
        }
    }
    cst[1] = saved;
}

// the last statement of a block is a `return`
fn ends_in_return(nodes: &[Node], body: i64) -> bool {
    let mut s = nodes[body].a;
    let mut last = -1;
    while s >= 0 {
        last = s;
        s = nodes[s].next;
    }
    last >= 0 && nodes[last].kind == 96
}

// returns 0 when the program checks, 1 when it does not
fn check_program(src: &[u8], toks: &[Token], nodes: &mut [Node], types: &mut [Ty], syms: &mut [Sym],
                 sigs: &mut [Sig], ptys: &mut [i64], strs: &mut [Str], flds: &mut [Fld],
                 ntys: &mut [i64], cst: &mut [i64], first: i64) -> i64 {
    cst[9] = -1;
    intern_scalars(types, cst);
    collect_structs(src, toks, nodes, types, strs, flds, cst, first);
    collect_sigs(src, toks, nodes, types, sigs, ptys, strs, cst, first);
    let mut f = first;
    let mut si = 0;
    while cst[2] == 0 && f >= 0 {
        cst[10] = f;
        if nodes[f].kind == 110 {
            check_func(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, f, si);
            si += 1;
        } else if nodes[f].kind == 116 {
            si += 1;
        }
        f = nodes[f].next;
    }
    cst[2]
}
