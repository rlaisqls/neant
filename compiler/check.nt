// The third self-hosted stage (docs/self-hosting-checker-design.md), the first slice of
// bootstrap/src/types.rs: name resolution and type checking over exactly the grammar
// `compiler/parse.nt` produces. **A fragment**, like parse.nt: it uses lex.nt's `Token` and
// parse.nt's `Node` and node kinds, and is compiled by concatenating lex.nt, parse.nt, this, and
// a driver.
//
// Out of this slice (design §1): size variables, chain desugaring, moves/uniqueness/layout, and
// building a typed IR — every one of them feeds a stage that does not exist self-hosted yet.
//
// Type kinds:  0 i64  1 f64  2 bool  3 u8  4 unit  5 array  6 slice  7 struct (`elem` indexes `strs`)
// The five scalars are interned first, so their indices are 0..4 and a scalar comparison is an
// integer comparison.
//
// `cst` is the checker's state, the same one-element-array idiom the parser uses:
//   cst[0] next free type   cst[1] symbol table length   cst[2] error flag
//   cst[3] signature count  cst[4] next free param type  cst[5] loop depth
//   cst[6] the current function's return type
//   cst[7] struct count      cst[8] next free field
//   cst[9] the node the check failed at, or −1 — set once, by the innermost frame to see the
//          error flag go up, so it names the smallest expression or statement that is wrong
//   cst[11] the fresh-size-atom counter
//   cst[12] how many arrays have been moved away
//   cst[13] the symbol table's length at the innermost loop's entry, or −1 outside every loop
//   cst[14] the top of the `if`-union stash
//   cst[15] the token this item ends before — the next item's name, or past the end
//   cst[200 + i]  the declaring name token of the i-th moved array
//   cst[400 + j]  the stash an `if` arm's moves are held in while the other arm is checked
//   cst[10] the item — function or struct — being read when it failed, which is where the
//          failures that happen outside an expression (a signature, a field's type) land

// `size` is meaningful only for an array (kind 5): the *size atom*, which says whether two array
// types have the same length without saying what it is. Design §1 put size variables out of this
// slice on the grounds that only the cost model wants them — that was wrong. `ys = xs` on whole
// arrays type-checks exactly when the two sizes are known to agree, so a checker without atoms
// either refuses every reassignment (and disagrees with `neant check` on reassign_named_size.nt)
// or accepts every one (and disagrees on err_reassign_mutable_size.nt). Three disjoint ranges:
//   0 .. 999999          a token index: the declaration of the immutable local the length names
//   1000000 + v          an integer literal of value v, so two `[0; 4]` agree
//   2000000 +            a fresh atom, for a length that may differ between two uses
struct Ty { kind: i64, elem: i64, mutable: i64, size: i64 }
// `root` is the array this name ultimately views: its own name token for an array, and the
// source's root for a view (`let v = &xs;`). Two views of one array share a root, which is what
// both the aliasing rule at a call and the view-survives-a-move rule ask about.
struct Sym { name: i64, ty: i64, mutable: i64, root: i64 }
// `ext` marks an `extern fn`: it names a C symbol that already exists, so it is called by
// its own name rather than the `ntu_` one
struct Sig { name: i64, params: i64, n_params: i64, ret: i64, ext: i64 }
// a struct type: its name token, and a run of fields in the flat `flds` table
struct Str { name: i64, fields: i64, n_fields: i64 }
struct Fld { name: i64, ty: i64 }

// ---- types ----

fn intern_scalars(types: &mut [Ty], cst: &mut [i64]) {
    let mut k = 0;
    while k < 5 {
        types[k].kind = k;
        types[k].elem = -1;
        types[k].mutable = 0;
        types[k].size = -1;
        k += 1;
    }
    cst[0] = 5;
}

fn new_ty(types: &mut [Ty], cst: &mut [i64], kind: i64, elem: i64, mutable: i64) -> i64 {
    new_ty_sized(types, cst, kind, elem, mutable, fresh_atom(cst))
}

fn new_ty_sized(types: &mut [Ty], cst: &mut [i64], kind: i64, elem: i64, mutable: i64, size: i64) -> i64 {
    let i = cst[0];
    types[i].kind = kind;
    types[i].elem = elem;
    types[i].mutable = mutable;
    types[i].size = size;
    cst[0] = i + 1;
    i
}

// an atom that equals nothing but itself
fn fresh_atom(cst: &mut [i64]) -> i64 {
    cst[11] = cst[11] + 1;
    1999999 + cst[11]
}

fn is_scalar(types: &[Ty], t: i64) -> bool {
    t >= 0 && types[t].kind < 4
}
fn is_numeric(types: &[Ty], t: i64) -> bool {
    t >= 0 && (types[t].kind == 0 || types[t].kind == 1 || types[t].kind == 3)
}
fn is_arrayish(types: &[Ty], t: i64) -> bool {
    t >= 0 && (types[t].kind == 5 || types[t].kind == 6)
}

// structural equality; a slice's mutability is part of it, and `elem` is compared recursively
fn same_ty(types: &[Ty], a: i64, b: i64) -> bool {
    if a < 0 || b < 0 { return false; }
    if a == b { return true; }
    if types[a].kind != types[b].kind { return false; }
    if types[a].kind == 6 && types[a].mutable != types[b].mutable { return false; }
    // an array's length is part of its type; a view's is not, which is why `&[T]` accepts arrays
    // of any length and only a whole-array assignment has to ask
    if types[a].kind == 5 && types[a].size != types[b].size { return false; }
    if types[a].kind == 5 || types[a].kind == 6 {
        return same_ty(types, types[a].elem, types[b].elem);
    }
    // two struct types are the same when they name the same struct; `elem` is its table index,
    // not another type, so this is an integer comparison and not the recursion above
    if types[a].kind == 7 { return types[a].elem == types[b].elem; }
    false
}

// ---- names ----

// two identifier tokens name the same thing when their spans hold the same bytes: lex.nt kept
// `(start, len)` into the source rather than copying, so this is the comparison
fn name_eq(src: &[u8], toks: &[Token], a: i64, b: i64) -> bool {
    if a < 0 || b < 0 { return false; }
    if toks[a].len != toks[b].len { return false; }
    let mut i = 0;
    let mut ok = true;
    while i < toks[a].len {
        if src[toks[a].start + i] != src[toks[b].start + i] { ok = false; }
        i += 1;
    }
    ok
}

// a token's span against a literal, one byte at a time — an array literal cannot be an argument,
// so a `b"println"` to compare with is not available
fn name_is_println(src: &[u8], toks: &[Token], t: i64) -> bool {
    if toks[t].len != 7 { return false; }
    let s = toks[t].start;
    src[s] == b'p' && src[s + 1] == b'r' && src[s + 2] == b'i' && src[s + 3] == b'n'
        && src[s + 4] == b't' && src[s + 5] == b'l' && src[s + 6] == b'n'
}
fn name_is_min(src: &[u8], toks: &[Token], t: i64) -> bool {
    toks[t].len == 3 && src[toks[t].start] == b'm' && src[toks[t].start + 1] == b'i' && src[toks[t].start + 2] == b'n'
}
fn name_is_max(src: &[u8], toks: &[Token], t: i64) -> bool {
    toks[t].len == 3 && src[toks[t].start] == b'm' && src[toks[t].start + 1] == b'a' && src[toks[t].start + 2] == b'x'
}

// the type name a `TyNamed` node spells, or −1 if it is not one of the four scalars
fn scalar_named(src: &[u8], toks: &[Token], t: i64) -> i64 {
    let s = toks[t].start;
    let n = toks[t].len;
    if n == 3 && src[s] == b'i' && src[s + 1] == b'6' && src[s + 2] == b'4' { return 0; }
    if n == 3 && src[s] == b'f' && src[s + 1] == b'6' && src[s + 2] == b'4' { return 1; }
    if n == 4 && src[s] == b'b' && src[s + 1] == b'o' && src[s + 2] == b'o' && src[s + 3] == b'l' { return 2; }
    if n == 2 && src[s] == b'u' && src[s + 1] == b'8' { return 3; }
    -1
}

// the innermost symbol with this name, or −1: searched backwards, so an inner `let` shadows
fn sym_find(src: &[u8], toks: &[Token], syms: &[Sym], cst: &[i64], name: i64) -> i64 {
    let mut i = cst[1] - 1;
    let mut found = -1;
    while i >= 0 {
        if found < 0 && name_eq(src, toks, syms[i].name, name) { found = i; }
        i -= 1;
    }
    found
}

fn declare(syms: &mut [Sym], cst: &mut [i64], name: i64, ty: i64, mutable: i64, root: i64) {
    let i = cst[1];
    syms[i].name = name;
    syms[i].ty = ty;
    syms[i].mutable = mutable;
    syms[i].root = if root < 0 { name } else { root };
    cst[1] = i + 1;
}

// the root of the array a name views, following `let v = &xs;` chains
fn sym_root(src: &[u8], toks: &[Token], syms: &[Sym], cst: &[i64], name: i64) -> i64 {
    let s = sym_find(src, toks, syms, cst, name);
    if s < 0 { return 0 - 1; }
    syms[s].root
}

// ---- moves ----
//
// `let ys = xs;` on whole arrays **moves** `xs`: the buffer is `ys`'s now and a further use of `xs`
// reads memory that is no longer its own. The set of moved arrays is keyed by the **declaring name
// token**, which is a stable identity where a symbol index is not: a scope here is the symbol
// table's saved length, so indices are reused as scopes close, and two different locals can be the
// same index at different times. A declaration's token is unique by construction.
//
// `neant check` names the line of the move in its message. This checker only ever reports a
// verdict, so it records the fact and not the line.
fn moved_add(cst: &mut [i64], name: i64) {
    if cst[12] >= 100 { cst[2] = 1; return; }
    cst[200 + cst[12]] = name;
    cst[12] = cst[12] + 1;
}

fn moved_has(src: &[u8], toks: &[Token], cst: &[i64], name: i64) -> bool {
    let mut i = 0;
    let mut hit = false;
    while i < cst[12] {
        if name_eq(src, toks, cst[200 + i], name) { hit = true; }
        i += 1;
    }
    hit
}

// **Is this name used again, later in the same item?** `types.rs` computes each local's last use
// over the *checked body* and compares it with the move's line; this checker builds no typed body
// to walk, so it asks the token stream, which is in source order by construction. It
// over-approximates in the safe direction — a write counts as a use where `last_uses` counts reads
// — and stops at the next item so a same-named local elsewhere cannot be mistaken for this one.
fn used_after(src: &[u8], toks: &[Token], cst: &[i64], name: i64, from: i64) -> bool {
    let mut t = from + 1;
    let mut hit = false;
    while toks[t].kind != 57 && t < cst[15] {
        if toks[t].kind == 0 && name_eq(src, toks, t, name) { hit = true; }
        t += 1;
    }
    hit
}

// the struct a name token names, or −1
fn struct_find(src: &[u8], toks: &[Token], strs: &[Str], cst: &[i64], name: i64) -> i64 {
    let mut i = 0;
    let mut found = -1;
    while i < cst[7] {
        if found < 0 && name_eq(src, toks, strs[i].name, name) { found = i; }
        i += 1;
    }
    found
}

// the field of struct `si` with this name, as an index into `flds`, or −1
fn field_find(src: &[u8], toks: &[Token], strs: &[Str], flds: &[Fld], si: i64, name: i64) -> i64 {
    let mut i = 0;
    let mut found = -1;
    while i < strs[si].n_fields {
        if found < 0 && name_eq(src, toks, flds[strs[si].fields + i].name, name) { found = strs[si].fields + i; }
        i += 1;
    }
    found
}

// every `struct` first, so a parameter or a field may name one. Fields are scalars, as they are in
// the Rust checker — no struct holds another, so nothing here depends on collection order.
fn collect_structs(src: &[u8], toks: &[Token], nodes: &[Node], types: &mut [Ty], strs: &mut [Str],
                   flds: &mut [Fld], cst: &mut [i64], first: i64) {
    let mut f = first;
    while cst[2] == 0 && f >= 0 {
        cst[10] = f;
        if nodes[f].kind == 112 {
            let si = cst[7];
            strs[si].name = nodes[f].a;
            strs[si].fields = cst[8];
            let mut nf = 0;
            let mut fd = nodes[f].b;
            while cst[2] == 0 && fd >= 0 {
                let t = nodes[fd].b;
                let sc = if nodes[t].kind == 100 { scalar_named(src, toks, nodes[t].a) } else { -1 };
                if sc < 0 { cst[2] = 1; };
                flds[cst[8]].name = nodes[fd].a;
                flds[cst[8]].ty = sc;
                cst[8] = cst[8] + 1;
                nf += 1;
                fd = nodes[fd].next;
            }
            if nf == 0 { cst[2] = 1; };
            strs[si].n_fields = nf;
            cst[7] = si + 1;
        }
        f = nodes[f].next;
    }
}

// an integer literal's value. `lex.nt` keeps a numeric literal's span and never parses it — the
// emitter copies the span through to C — so the one place that needs the number reads it here.
fn int_value(src: &[u8], toks: &[Token], t: i64) -> i64 {
    let mut v = 0;
    let mut i = 0;
    while i < toks[t].len {
        let c = src[toks[t].start + i];
        if c != b'_' { v = v * 10 + ((c as i64) - 48); }
        i += 1;
    }
    v
}

// the atom for a length expression: an integer literal is its value, an immutable local is its
// declaration, and anything else — a mutable local above all, which may have changed between two
// uses — gets an atom of its own
fn size_atom(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], syms: &[Sym],
             cst: &mut [i64], n: i64) -> i64 {
    if n < 0 { return fresh_atom(cst); }
    if nodes[n].kind == 60 { return 1000000 + int_value(src, toks, nodes[n].a); }
    if nodes[n].kind == 65 {
        let s = sym_find(src, toks, syms, cst, nodes[n].a);
        if s >= 0 && syms[s].mutable == 0 { return syms[s].name; }
    }
    // `[0; xs.len()]` is xs's own size, not a fresh atom that merely agrees with it once — which
    // is what lets two arrays both sized by `src.len()` be assigned to each other
    if nodes[n].kind == 72 && nodes[nodes[n].a].kind == 65 {
        let s = sym_find(src, toks, syms, cst, nodes[nodes[n].a].a);
        if s >= 0 && syms[s].mutable == 0 && is_arrayish(types, syms[s].ty) {
            return types[syms[s].ty].size;
        }
    }
    fresh_atom(cst)
}

// ---- type expressions ----

fn resolve_ty(src: &[u8], toks: &[Token], nodes: &[Node], types: &mut [Ty], strs: &[Str], cst: &mut [i64], n: i64) -> i64 {
    if n < 0 { return 4; }
    let k = nodes[n].kind;
    if k == 100 {
        let s = scalar_named(src, toks, nodes[n].a);
        if s >= 0 { return s; }
        let si = struct_find(src, toks, strs, cst, nodes[n].a);
        if si < 0 { cst[2] = 1; return -1; }
        return new_ty(types, cst, 7, si, 0);
    }
    if k == 101 { return 4; }
    if k == 104 {
        let e = resolve_ty(src, toks, nodes, types, strs, cst, nodes[n].a);
        return new_ty(types, cst, 5, e, 0);
    }
    if k == 102 {
        let e = resolve_ty(src, toks, nodes, types, strs, cst, nodes[n].a);
        return new_ty(types, cst, 5, e, 0);
    }
    if k == 103 {
        let e = resolve_ty(src, toks, nodes, types, strs, cst, nodes[n].a);
        return new_ty(types, cst, 6, e, nodes[n].ival);
    }
    cst[2] = 1;
    -1
}

// ---- expressions ----

// every expression's type is recorded in `ntys`, indexed by node — the table a next stage would
// read, and what the type dump prints. The rules are in `check_expr_inner`; this only records.
fn check_expr(src: &[u8], toks: &[Token], nodes: &[Node], types: &mut [Ty], syms: &mut [Sym],
              sigs: &[Sig], ptys: &[i64], strs: &[Str], flds: &[Fld], ntys: &mut [i64], cst: &mut [i64], n: i64) -> i64 {
    let before = cst[2];
    let t = check_expr_inner(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, n);
    if n >= 0 { ntys[n] = t; }
    // the innermost expression that failed: the recursion unwinds through here, and only the
    // deepest frame sees the flag go from clear to set. `cst[2]` alone says a program is wrong
    // without saying where, which is unusable on a file the size of the compiler's own source.
    if cst[2] != 0 && before == 0 && cst[9] < 0 { cst[9] = n; }
    t
}

fn check_expr_inner(src: &[u8], toks: &[Token], nodes: &[Node], types: &mut [Ty], syms: &mut [Sym],
              sigs: &[Sig], ptys: &[i64], strs: &[Str], flds: &[Fld], ntys: &mut [i64], cst: &mut [i64], n: i64) -> i64 {
    if cst[2] != 0 || n < 0 { return -1; }
    let k = nodes[n].kind;
    if k == 60 { return 0; }
    if k == 61 { return 1; }
    if k == 62 { return 2; }
    if k == 63 { return 3; }
    if k == 64 { return new_ty(types, cst, 5, 3, 0); }
    if k == 65 {
        let s = sym_find(src, toks, syms, cst, nodes[n].a);
        if s < 0 { cst[2] = 1; return -1; }
        if moved_has(src, toks, cst, syms[s].name) { cst[2] = 1; return -1; }
        return syms[s].ty;
    }
    if k == 66 {
        let a = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        let b = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
        if cst[2] != 0 { return -1; }
        if !same_ty(types, a, b) { cst[2] = 1; return -1; }
        let op = nodes[n].ival;
        if op <= 4 {
            if !is_numeric(types, a) { cst[2] = 1; return -1; }
            return a;
        }
        if op <= 10 {
            if !is_scalar(types, a) { cst[2] = 1; return -1; }
            // an ordering comparison on `bool` is refused, as the Rust checker refuses it
            if op >= 7 && types[a].kind == 2 { cst[2] = 1; return -1; }
            return 2;
        }
        if types[a].kind != 2 { cst[2] = 1; return -1; }
        return 2;
    }
    if k == 67 {
        let a = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        if cst[2] != 0 { return -1; }
        if nodes[n].ival == 0 {
            if !is_numeric(types, a) { cst[2] = 1; return -1; }
            return a;
        }
        if a != 2 { cst[2] = 1; return -1; }
        return 2;
    }
    if k == 68 {
        // the Rust checker indexes a variable, not an arbitrary expression
        if nodes[nodes[n].a].kind != 65 { cst[2] = 1; return -1; }
        let base = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        let idx = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
        if cst[2] != 0 { return -1; }
        if !is_arrayish(types, base) { cst[2] = 1; return -1; }
        if idx != 0 { cst[2] = 1; return -1; }
        return types[base].elem;
    }
    if k == 69 {
        let base = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        if cst[2] != 0 { return -1; }
        if base < 0 || types[base].kind != 7 { cst[2] = 1; return -1; }
        let f = field_find(src, toks, strs, flds, types[base].elem, nodes[n].b);
        if f < 0 { cst[2] = 1; return -1; }
        return flds[f].ty;
    }
    if k == 70 {
        let si = struct_find(src, toks, strs, cst, nodes[n].a);
        if si < 0 { cst[2] = 1; return -1; }
        // every field exactly once, in any order. Naming a field of this struct and counting the
        // initialisers is not enough — `P { x: 1, x: 2 }` passes both and never gives `y` — so a
        // repeat is caught directly, by scanning the initialisers already read.
        let mut seen = 0;
        let mut fi = nodes[n].b;
        while cst[2] == 0 && fi >= 0 {
            let f = field_find(src, toks, strs, flds, si, nodes[fi].a);
            if f < 0 { cst[2] = 1; return -1; }
            let mut prev = nodes[n].b;
            while prev != fi {
                if name_eq(src, toks, nodes[prev].a, nodes[fi].a) { cst[2] = 1; return -1; }
                prev = nodes[prev].next;
            }
            let v = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[fi].b);
            if cst[2] != 0 { return -1; }
            if !same_ty(types, flds[f].ty, v) { cst[2] = 1; return -1; }
            seen += 1;
            fi = nodes[fi].next;
        }
        if seen != strs[si].n_fields { cst[2] = 1; return -1; }
        return new_ty(types, cst, 7, si, 0);
    }
    if k == 72 {
        // the receiver must be a variable, as it must for an index: "the receiver of `.len()`
        // must be a variable for now" is the Rust checker's own message
        if nodes[nodes[n].a].kind != 65 { cst[2] = 1; return -1; }
        let a = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        if cst[2] != 0 { return -1; }
        if !is_arrayish(types, a) { cst[2] = 1; return -1; }
        return 0;
    }
    if k == 77 {
        // every element the same type, and the length is the count — a literal size atom, so two
        // lists of the same length agree
        let mut e = nodes[n].a;
        let mut t = -1;
        let mut count = 0;
        while cst[2] == 0 && e >= 0 {
            let et = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, e);
            if cst[2] != 0 { return -1; }
            if count == 0 { t = et; } else if !same_ty(types, t, et) { cst[2] = 1; return -1; };
            count += 1;
            e = nodes[e].next;
        }
        if count == 0 { cst[2] = 1; return -1; }
        return new_ty_sized(types, cst, 5, t, 0, 1000000 + count);
    }
    if k == 78 {
        let e = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        let c = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
        if cst[2] != 0 { return -1; }
        if c != 0 { cst[2] = 1; return -1; }
        if !is_scalar(types, e) && (e < 0 || types[e].kind != 7) { cst[2] = 1; return -1; }
        return new_ty_sized(types, cst, 5, e, 0, size_atom(src, toks, nodes, types, syms, cst, nodes[n].b));
    }
    if k == 71 { return check_call(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, n); }
    if k == 73 {
        if nodes[nodes[n].a].kind != 65 { cst[2] = 1; return -1; }
        let s = sym_find(src, toks, syms, cst, nodes[nodes[n].a].a);
        if s < 0 { cst[2] = 1; return -1; }
        let t = syms[s].ty;
        if !is_arrayish(types, t) { cst[2] = 1; return -1; }
        // the referent is resolved here rather than through `check_expr`, so its type is recorded
        // here too — the emitter asks what `&ps` refers to in order to lay it out
        ntys[nodes[n].a] = t;
        let m = nodes[n].ival;
        // `&mut` of something that is not `let mut`, or of a `&[T]`, is refused
        if m == 1 {
            if types[t].kind == 5 && syms[s].mutable == 0 { cst[2] = 1; return -1; }
            if types[t].kind == 6 && types[t].mutable == 0 { cst[2] = 1; return -1; }
        }
        return new_ty(types, cst, 6, types[t].elem, m);
    }
    if k == 74 {
        let a = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        let t = resolve_ty(src, toks, nodes, types, strs, cst, nodes[n].b);
        if cst[2] != 0 { return -1; }
        if !is_numeric(types, a) || !is_numeric(types, t) { cst[2] = 1; return -1; }
        return t;
    }
    if k == 75 {
        let c = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        if cst[2] == 0 && c != 2 { cst[2] = 1; return -1; }
        // **Each arm is checked from the same starting set, and a local moved on either side is
        // moved after the `if`.** The then-arm's moves are held aside while the else-arm is checked
        // — otherwise a move in one arm would wrongly reject a use in the other — and appended
        // afterwards, which is the union `types.rs` takes. The stash is a stack, because an `if`
        // inside the else-arm would otherwise write over the one held for the `if` around it.
        let msave = cst[12];
        let t = check_block(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
        if nodes[n].c < 0 {
            if cst[2] == 0 && t != 4 { cst[2] = 1; return -1; }
            return 4;
        }
        let stash = cst[14];
        let n_then = cst[12] - msave;
        let mut si = 0;
        while si < n_then {
            cst[400 + stash + si] = cst[200 + msave + si];
            si += 1;
        }
        cst[14] = stash + n_then;
        cst[12] = msave;
        let e = check_block(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].c);
        let mut sj = 0;
        while sj < n_then {
            if !moved_has(src, toks, cst, cst[400 + stash + sj]) {
                moved_add(cst, cst[400 + stash + sj]);
            };
            sj += 1;
        }
        cst[14] = stash;
        if cst[2] != 0 { return -1; }
        if !same_ty(types, t, e) { cst[2] = 1; return -1; }
        return t;
    }
    if k == 76 { return check_block(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, n); }
    cst[2] = 1;
    -1
}

// The array an argument is a view of, as a root name token, or −1 when it is not one: `&x`,
// `&mut x`, or a bare name already holding a view.
fn arg_root(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], syms: &[Sym], cst: &[i64],
            a: i64) -> i64 {
    let inner = if nodes[a].kind == 73 { nodes[a].a } else { a };
    if inner < 0 || nodes[inner].kind != 65 { return 0 - 1; }
    let s = sym_find(src, toks, syms, cst, nodes[inner].a);
    if s < 0 { return 0 - 1; }
    if !is_arrayish(types, syms[s].ty) { return 0 - 1; }
    syms[s].root
}

// whether that argument reaches the callee as `&mut`: written on the `&mut` itself, or carried by
// the type of a view variable passed along
fn arg_is_mut(src: &[u8], toks: &[Token], nodes: &[Node], types: &[Ty], syms: &[Sym], cst: &[i64],
              a: i64) -> bool {
    if nodes[a].kind == 73 { return nodes[a].ival != 0; }
    if nodes[a].kind != 65 { return false; }
    let s = sym_find(src, toks, syms, cst, nodes[a].a);
    if s < 0 { return false; }
    let t = syms[s].ty;
    t >= 0 && types[t].kind == 6 && types[t].mutable == 1
}

fn check_call(src: &[u8], toks: &[Token], nodes: &[Node], types: &mut [Ty], syms: &mut [Sym],
              sigs: &[Sig], ptys: &[i64], strs: &[Str], flds: &[Fld], ntys: &mut [i64], cst: &mut [i64], n: i64) -> i64 {
    let name = nodes[n].a;
    if name_is_println(src, toks, name) {
        let a = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
        if cst[2] != 0 { return -1; }
        if nodes[n].b < 0 || nodes[nodes[n].b].next >= 0 { cst[2] = 1; return -1; }
        if !is_scalar(types, a) { cst[2] = 1; return -1; }
        return 4;
    }
    if name_is_min(src, toks, name) || name_is_max(src, toks, name) {
        let first = nodes[n].b;
        if first < 0 { cst[2] = 1; return -1; }
        let second = nodes[first].next;
        if second < 0 || nodes[second].next >= 0 { cst[2] = 1; return -1; }
        let a = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, first);
        let b = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, second);
        if cst[2] != 0 { return -1; }
        if !same_ty(types, a, b) || !is_numeric(types, a) { cst[2] = 1; return -1; }
        return a;
    }
    // a declared function: its signature, by name
    let mut si = -1;
    let mut i = 0;
    while i < cst[3] {
        if si < 0 && name_eq(src, toks, sigs[i].name, name) { si = i; }
        i += 1;
    }
    if si < 0 { cst[2] = 1; return -1; }
    // **Two arguments must not be views of one array when either is `&mut`.** Parameters are
    // emitted as `restrict` and the cost model counts them as disjoint, so an overlap here is a
    // claim the emitted C already makes. Matched by *root*, since `&xs` and a `let v = &xs` are
    // the same memory under two names.
    let mut a1 = nodes[n].b;
    while cst[2] == 0 && a1 >= 0 {
        let r1 = arg_root(src, toks, nodes, types, syms, cst, a1);
        if r1 >= 0 {
            let m1 = arg_is_mut(src, toks, nodes, types, syms, cst, a1);
            let mut a2 = nodes[a1].next;
            while cst[2] == 0 && a2 >= 0 {
                let r2 = arg_root(src, toks, nodes, types, syms, cst, a2);
                if r2 >= 0 && name_eq(src, toks, r1, r2) {
                    let m2 = arg_is_mut(src, toks, nodes, types, syms, cst, a2);
                    if m1 || m2 { cst[2] = 1; }
                };
                a2 = nodes[a2].next;
            }
        };
        a1 = nodes[a1].next;
    }
    if cst[2] != 0 { return -1; }
    let mut arg = nodes[n].b;
    let mut k = 0;
    while cst[2] == 0 && arg >= 0 {
        let at = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, arg);
        if cst[2] == 0 {
            if k >= sigs[si].n_params {
                cst[2] = 1;
            } else {
                let want = ptys[sigs[si].params + k];
                // a `&mut [T]` argument satisfies a `&[T]` parameter, not the other way round
                let ok = if same_ty(types, at, want) {
                    true
                } else if at >= 0 && want >= 0 && types[at].kind == 6 && types[want].kind == 6 {
                    types[at].mutable == 1 && types[want].mutable == 0 && same_ty(types, types[at].elem, types[want].elem)
                } else {
                    false
                };
                if !ok { cst[2] = 1; }
            }
        }
        k += 1;
        arg = nodes[arg].next;
    }
    if cst[2] == 0 && k != sigs[si].n_params { cst[2] = 1; }
    if cst[2] != 0 { return -1; }
    sigs[si].ret
}

// ---- statements and blocks ----

// a block's own scope is the symbol table's length: entering saves it, leaving restores it
fn check_block(src: &[u8], toks: &[Token], nodes: &[Node], types: &mut [Ty], syms: &mut [Sym],
               sigs: &[Sig], ptys: &[i64], strs: &[Str], flds: &[Fld], ntys: &mut [i64], cst: &mut [i64], n: i64) -> i64 {
    if cst[2] != 0 || n < 0 { return -1; }
    let saved = cst[1];
    let mut s = nodes[n].a;
    while cst[2] == 0 && s >= 0 {
        check_stmt(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, s);
        s = nodes[s].next;
    }
    let mut t = 4;
    if nodes[n].b >= 0 {
        t = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
    }
    cst[1] = saved;
    // recorded here rather than in `check_expr`'s wrapper: a function body, a loop body and an
    // `if` arm reach this directly, without being an expression themselves
    ntys[n] = t;
    t
}

fn check_stmt(src: &[u8], toks: &[Token], nodes: &[Node], types: &mut [Ty], syms: &mut [Sym],
              sigs: &[Sig], ptys: &[i64], strs: &[Str], flds: &[Fld], ntys: &mut [i64], cst: &mut [i64], n: i64) {
    let before = cst[2];
    check_stmt_inner(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, n);
    if cst[2] != 0 && before == 0 && cst[9] < 0 { cst[9] = n; }
}

fn check_stmt_inner(src: &[u8], toks: &[Token], nodes: &[Node], types: &mut [Ty], syms: &mut [Sym],
              sigs: &[Sig], ptys: &[i64], strs: &[Str], flds: &[Fld], ntys: &mut [i64], cst: &mut [i64], n: i64) {
    if cst[2] != 0 || n < 0 { return; }
    let k = nodes[n].kind;
    if k == 90 {
        let t = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].c);
        if cst[2] != 0 { return; }
        if t == 4 { cst[2] = 1; return; }
        if nodes[n].b >= 0 {
            let d = resolve_ty(src, toks, nodes, types, strs, cst, nodes[n].b);
            if cst[2] != 0 { return; }
            if !same_ty(types, d, t) { cst[2] = 1; return; }
        }
        // **`let ys = xs;` moves `xs`.** A bare variable is the only initialiser a move can name;
        // an array literal, a repeat or a byte string builds a fresh array and moves nothing.
        if types[t].kind == 5 && nodes[nodes[n].c].kind == 65 {
            let sv = sym_find(src, toks, syms, cst, nodes[nodes[n].c].a);
            if sv < 0 { cst[2] = 1; return; }
            // **moving inside a loop moves it again on the next lap.** One lexical occurrence
            // stands for every iteration, so a source declared before the loop cannot be moved in
            // it — which is `src < loop_start` in `types.rs`, and here the symbol table's length at
            // the loop's entry says the same thing.
            if cst[13] >= 0 && sv < cst[13] { cst[2] = 1; return; }
            // **A view of the source may not outlive the move and be read again.** The buffer is
            // the target's now, so a view still pointing into it reads memory that is no longer
            // what it was declared to view — and the emitter hands both to C as `restrict`
            // pointers. `resolve_moves` in `types.rs`.
            let mut vi = 0;
            while vi < cst[1] {
                let vt = syms[vi].ty;
                if vi != sv && vt >= 0 && types[vt].kind == 6
                    && name_eq(src, toks, syms[vi].root, syms[sv].root)
                    && used_after(src, toks, cst, syms[vi].name, nodes[nodes[n].c].a) {
                    cst[2] = 1;
                    return;
                };
                vi += 1;
            }
            moved_add(cst, syms[sv].name);
            if cst[2] != 0 { return; }
        };
        // `let v = &xs;` is a view of `xs`, and of whatever `xs` itself views
        let mut root = 0 - 1;
        let ini = nodes[n].c;
        if ini >= 0 && nodes[ini].kind == 73 && nodes[nodes[ini].a].kind == 65 {
            root = sym_root(src, toks, syms, cst, nodes[nodes[ini].a].a);
        } else if ini >= 0 && nodes[ini].kind == 65 && is_arrayish(types, t) {
            root = sym_root(src, toks, syms, cst, nodes[ini].a);
        };
        declare(syms, cst, nodes[n].a, t, nodes[n].ival, root);
        return;
    }
    if k == 91 {
        let tgt = nodes[n].a;
        let tk = nodes[tgt].kind;
        if tk == 65 {
            let s = sym_find(src, toks, syms, cst, nodes[tgt].a);
            if s < 0 { cst[2] = 1; return; }
            if syms[s].mutable == 0 { cst[2] = 1; return; }
            // the target is resolved here rather than through `check_expr`, so its type has to be
            // recorded here too: the emitter asks whether an assignment's target is an array
            ntys[tgt] = syms[s].ty;
            let v = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
            if cst[2] != 0 { return; }
            // `ys = xs` on whole arrays is M5's reassignment, and it is allowed. This slice has no
            // size variables (design §1), so it compares element types and not lengths: it accepts
            // a length mismatch the Rust checker refuses, which is a narrowing, not a difference
            // of opinion — nothing here decides in-place versus copy.
            if !same_ty(types, syms[s].ty, v) { cst[2] = 1; }
            if nodes[n].ival >= 0 && !is_numeric(types, syms[s].ty) { cst[2] = 1; }
            return;
        }
        if tk == 68 {
            if nodes[nodes[tgt].a].kind != 65 { cst[2] = 1; return; }
            let s = sym_find(src, toks, syms, cst, nodes[nodes[tgt].a].a);
            if s < 0 { cst[2] = 1; return; }
            let bt = syms[s].ty;
            if !is_arrayish(types, bt) { cst[2] = 1; return; }
            // the base is resolved here rather than through `check_expr`, so its type has to be
            // recorded here too — the cost pass asks what an assignment target's array holds
            ntys[nodes[tgt].a] = bt;
            // writing needs an owned `let mut` array or a `&mut [T]`
            if types[bt].kind == 5 && syms[s].mutable == 0 { cst[2] = 1; return; }
            if types[bt].kind == 6 && types[bt].mutable == 0 { cst[2] = 1; return; }
            let it = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[tgt].b);
            if cst[2] == 0 && it != 0 { cst[2] = 1; return; }
            let v = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
            if cst[2] != 0 { return; }
            if !same_ty(types, types[bt].elem, v) { cst[2] = 1; }
            return;
        }
        if tk == 69 {
            // writing a field needs the *place* to be writable: a `let mut` struct, or an element
            // of a writable array. Checking the base as an expression would not say which.
            let b0 = nodes[tgt].a;
            if nodes[b0].kind == 65 {
                let s = sym_find(src, toks, syms, cst, nodes[b0].a);
                if s < 0 { cst[2] = 1; return; }
                if syms[s].mutable == 0 { cst[2] = 1; return; }
            } else if nodes[b0].kind == 68 {
                if nodes[nodes[b0].a].kind != 65 { cst[2] = 1; return; }
                let s = sym_find(src, toks, syms, cst, nodes[nodes[b0].a].a);
                if s < 0 { cst[2] = 1; return; }
                let bt = syms[s].ty;
                if !is_arrayish(types, bt) { cst[2] = 1; return; }
                if types[bt].kind == 5 && syms[s].mutable == 0 { cst[2] = 1; return; }
                if types[bt].kind == 6 && types[bt].mutable == 0 { cst[2] = 1; return; }
                ntys[nodes[b0].a] = bt;
            } else {
                cst[2] = 1;
                return;
            }
            let ft = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, tgt);
            let v = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
            if cst[2] != 0 { return; }
            if !same_ty(types, ft, v) { cst[2] = 1; return; }
            if nodes[n].ival >= 0 && !is_numeric(types, ft) { cst[2] = 1; }
            return;
        }
        cst[2] = 1;
        return;
    }
    if k == 92 {
        let a = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
        let b = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].c);
        if cst[2] != 0 { return; }
        if a != 0 || b != 0 { cst[2] = 1; return; }
        let saved = cst[1];
        let sloop = cst[13];
        cst[13] = saved;
        declare(syms, cst, nodes[n].a, 0, 0, 0 - 1);
        cst[5] = cst[5] + 1;
        let t = check_block(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].d);
        cst[5] = cst[5] - 1;
        cst[13] = sloop;
        cst[1] = saved;
        if cst[2] == 0 && t != 4 { cst[2] = 1; }
        return;
    }
    if k == 93 {
        let c = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        if cst[2] == 0 && c != 2 { cst[2] = 1; return; }
        if nodes[n].b >= 0 {
            let m = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].b);
            if cst[2] == 0 && m != 0 { cst[2] = 1; return; }
        }
        let sloop = cst[13];
        cst[13] = cst[1];
        cst[5] = cst[5] + 1;
        let t = check_block(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].c);
        cst[5] = cst[5] - 1;
        cst[13] = sloop;
        if cst[2] == 0 && t != 4 { cst[2] = 1; }
        return;
    }
    if k == 94 {
        if cst[5] == 0 { cst[2] = 1; }
        return;
    }
    if k == 95 {
        let t = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        if cst[2] == 0 && is_arrayish(types, t) { cst[2] = 1; }
        return;
    }
    if k == 96 {
        if nodes[n].a < 0 {
            if cst[6] != 4 { cst[2] = 1; }
            return;
        }
        let t = check_expr(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, nodes[n].a);
        if cst[2] == 0 && !same_ty(types, t, cst[6]) { cst[2] = 1; }
        return;
    }
    cst[2] = 1;
}

// ---- functions ----

// every signature first, so a call may name a function declared later
fn collect_sigs(src: &[u8], toks: &[Token], nodes: &[Node], types: &mut [Ty], sigs: &mut [Sig],
                ptys: &mut [i64], strs: &[Str], cst: &mut [i64], first: i64) {
    let mut f = first;
    while cst[2] == 0 && f >= 0 {
        // the item list interleaves functions, externs and structs in source order, so this skips
        // what `collect_structs` already read. An `extern fn` has a signature like any other and
        // is called like any other, so it takes a slot here; it just has no body to check.
        cst[10] = f;
        if nodes[f].kind == 110 || nodes[f].kind == 116 {
            let si = cst[3];
            sigs[si].name = nodes[f].a;
            sigs[si].ext = if nodes[f].kind == 116 { 1 } else { 0 };
            sigs[si].params = cst[4];
            let mut np = 0;
            let mut p = nodes[f].b;
            while cst[2] == 0 && p >= 0 {
                let t = resolve_ty(src, toks, nodes, types, strs, cst, nodes[p].b);
                ptys[cst[4]] = t;
                cst[4] = cst[4] + 1;
                np += 1;
                p = nodes[p].next;
            }
            sigs[si].n_params = np;
            sigs[si].ret = resolve_ty(src, toks, nodes, types, strs, cst, nodes[f].c);
            cst[3] = si + 1;
        }
        f = nodes[f].next;
    }
    // a terminator, so a reader that has the table but not the count — the emitter — can stop
    sigs[cst[3]].name = -1;
}

fn check_func(src: &[u8], toks: &[Token], nodes: &[Node], types: &mut [Ty], syms: &mut [Sym],
              sigs: &[Sig], ptys: &[i64], strs: &[Str], flds: &[Fld], ntys: &mut [i64], cst: &mut [i64], f: i64, si: i64) {
    if cst[2] != 0 { return; }
    let saved = cst[1];
    // moves are per function: nothing a previous body moved is moved in this one
    cst[15] = if nodes[f].next >= 0 { nodes[nodes[f].next].a } else { 1000000000 };
    cst[12] = 0;
    cst[13] = 0 - 1;
    cst[14] = 0;
    let mut p = nodes[f].b;
    let mut k = 0;
    while p >= 0 {
        declare(syms, cst, nodes[p].a, ptys[sigs[si].params + k], 0, 0 - 1);
        k += 1;
        p = nodes[p].next;
    }
    cst[6] = sigs[si].ret;
    let body = nodes[f].d;
    let t = check_block(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, body);
    if cst[2] == 0 {
        if nodes[body].b >= 0 {
            // the body's value is its tail: it must be what the signature says
            if !same_ty(types, t, sigs[si].ret) { cst[2] = 1; }
        } else if sigs[si].ret != 4 && !ends_in_return(nodes, body) {
            cst[2] = 1;
        }
    }
    cst[1] = saved;
}

// the last statement of a block is a `return`
fn ends_in_return(nodes: &[Node], body: i64) -> bool {
    let mut s = nodes[body].a;
    let mut last = -1;
    while s >= 0 {
        last = s;
        s = nodes[s].next;
    }
    last >= 0 && nodes[last].kind == 96
}

// returns 0 when the program checks, 1 when it does not
fn check_program(src: &[u8], toks: &[Token], nodes: &[Node], types: &mut [Ty], syms: &mut [Sym],
                 sigs: &mut [Sig], ptys: &mut [i64], strs: &mut [Str], flds: &mut [Fld],
                 ntys: &mut [i64], cst: &mut [i64], first: i64) -> i64 {
    cst[9] = -1;
    intern_scalars(types, cst);
    collect_structs(src, toks, nodes, types, strs, flds, cst, first);
    collect_sigs(src, toks, nodes, types, sigs, ptys, strs, cst, first);
    let mut f = first;
    let mut si = 0;
    while cst[2] == 0 && f >= 0 {
        cst[10] = f;
        if nodes[f].kind == 110 {
            check_func(src, toks, nodes, types, syms, sigs, ptys, strs, flds, ntys, cst, f, si);
            si += 1;
        } else if nodes[f].kind == 116 {
            si += 1;
        }
        f = nodes[f].next;
    }
    cst[2]
}
