// prelude additions (iteration, numeric vs/sv, formatting, dates, statistics, collections) and encode.nt
tsection "iteration"
teq["prior -"; prior[-;1 5 20]; 1 4 15]
teq["prior one"; prior[-;1#3]; ,3]
teq["prior join"; prior[{x,y};"abc"]; ("a";"ba";"cb")]
teq["converge"; converge[{_x%2};100]; 0]
teq["converges"; converges[{_x%2};100]; 100 50 25 12 6 3 1 0]
teq["iterate"; iterate[3;{x*2};1]; 8]
teq["iterates"; iterates[3;{x*2};1]; 1 2 4 8]
teq["iterates list"; iterates[2;{x,`z};`a`b]; (`a`b;`a`b`z;`a`b`z`z)]

tsection "numeric vs sv"
teq["2 vs"; 2 vs 13; 1 1 0 1]
teq["vs zero"; 2 vs 0; ,0]
teq["256 vs"; 256 vs 1000; 3 232]
teq["fixed widths"; 24 60 60 vs 3723; 1 2 3]
teq["bits"; `int$0b vs 5; (61#0),1 0 1]
teq["bytes"; 0x00 vs 258; 0x0000000000000102]
teq["vector rows"; 256 vs 1 300 70000; (0 0 1;0 1 44;1 17 112)]
