teq["sv widths"; 24 60 60 sv 1 2 3; 3723]
teq["sv bytes"; 256 sv 0x0102; 258]
teq["sv bools"; 2 sv 101b; 5]
teq["string vs still"; "," vs "a,b,c"; (,"a";,"b";,"c")]
teq["string sv still"; "," sv ("a";"b"); "a,b"]

tsection "formatting"
teq["lpad"; lpad[5;"ab"]; "   ab"]
teq["rpad"; rpad[5;"ab"]; "ab   "]
teq["lpad int"; lpad[5;42]; "   42"]
teq["lpad no trunc"; lpad[1;"abc"]; "abc"]
teq["lpad0 neg"; lpad0[5;-42]; "-0042"]
teq["fixed"; fixed[2;3.14159]; "3.14"]
teq["fixed half up"; fixed[0;2.5]; ,"3"]
teq["fixed int"; fixed[3;2]; "2.000"]
teq["fixed vec"; fixed[2;1 2.5 3.333]; ("1.00";"2.50";"3.33")]
teq["commas"; commas 1234567; "1,234,567"]
teq["commas neg frac"; commas[-1234567.5]; "-1,234,567.5"]
teq["commas short"; commas 123; "123"]
teq["fmt specs"; fmt["%s has %d items (%5.1f%%)"; ("bob";3;42.25)]; "bob has 3 items ( 42.3%)"]
teq["fmt align"; fmt["[%-6s][%6s][%05d][%.3s]"; ("ab";"cd";42;"abcdef")]; "[ab    ][    cd][00042][abc]"]
teq["fmt bare"; fmt["% and %"; (1;2)]; "1 and 2"]
teq["fmt one string"; fmt["hi %"; "bob"]; "hi bob"]
teq["fmt one atom"; fmt["n=%d"; 7]; "n=7"]
teq["fmt f default"; fmt["%f|%.2f|%-8.2f|"; (1%3; 2; 2.5)]; "0.333333|2.00|2.50    |"]

