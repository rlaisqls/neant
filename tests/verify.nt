// Certificate path validation: hostname matching, chain verification and the trust store in
// src/neant/crypto/verify.nt, and the two TLS 1.3 handshake messages in tls.nt that use them.
// None of the ten modules is in the boot image, so they are loaded on demand here exactly as a
// program would load them — by name rather than through tlsclient.nt, so that this file keeps
// saying what the dependency order actually is. What stays in Rust (mod verify in src/main.rs) is
// only what needs the host: an `openssl s_server` to handshake against, and the timings.
//
// The fixture PKI is built by tests/data/pki-gen.sh (RSA), tests/data/pki-ec-gen.sh (P-256) and
// tests/data/pki-p384-gen.sh (SHA-384 and P-384), which record the exact openssl commands and pin
// every date, so pki-expired.pem stays expired and pki-leaf.pem stays valid. Every certificate in
// them is one specific way a chain can be right or wrong. The curve arithmetic itself is tested in
// tests/p256.nt and tests/p384.nt, and the hashes in tests/crypto.nt; this file is about the wiring.
tsection "verify"
{load "src/neant/crypto/",x} each ("bignum.nt";"sha512.nt";"rsa.nt";"der.nt";"ec.nt";"p256.nt"
  ;"p384.nt";"x509.nt";"verify.nt";"tls.nt")

vfyP: {[f] x509Parse (pemLoad "tests/data/",f,".pem")[0]}
vfyRoots: x509LoadRoots "tests/data/pki-root.pem"          // the fixture root, and nothing else
vfyNow: (2026.09.16; 12:00:00.000)                         // inside every good window, outside the bad
vfyChain: {[c;h] x509VerifyChain[c; vfyRoots; h; vfyNow]}
// the subjects, spelled the way x509.nt's RFC 2253 `subject spells them
vfyL: "CN=leaf.neant.test,O=neant fixtures,C=US"
vfyI: "CN=neant fixture intermediate,O=neant fixtures,C=US"
vfyR: "CN=neant fixture root,O=neant fixtures,C=US"

// ---- hostnames. RFC 6125, and only the part of it every modern verifier keeps: SAN entries,
// never the CN. Every fixture below has CN=leaf.neant.test, so a case that passed on the CN would
// show up here as a wrong answer rather than as nothing at all.
vfyHosts: (("pki-leaf";"leaf.neant.test";1b;"the dNSName, exactly")
  ;("pki-leaf";"LEAF.NEANT.TEST";1b;"DNS names are case-insensitive")
  ;("pki-leaf";"leaf.neant.test.";1b;"one trailing root dot is not part of the name")
  ;("pki-leaf";"other.neant.test";0b;"a name nobody attested to")
  ;("pki-leaf";"leaf.neant.test.evil.example";0b;"a prefix is not a match")
  ;("pki-leaf";"eaf.neant.test";0b;"nor is a suffix")
  ;("pki-leaf";"127.0.0.1";1b;"the iPAddress SAN, for an address literal")
  ;("pki-leaf";"127.0.0.2";0b;"a different address")
  ;("pki-leaf";"127.000.000.001";0b;"a leading zero is refused, not read as octal")
  ;("pki-leaf";"::1";0b;"an IPv6 literal is never matched here")
  ;("pki-selfsigned";"127.0.0.1";1b;"an address literal never falls through to a dNSName")
  ;("pki-wildcard";"a.wild.neant.test";1b;"* is the whole leftmost label")
  ;("pki-wildcard";"A.WiLd.NeAnT.TeSt";1b;"and still case-insensitive")
  ;("pki-wildcard";"wild.neant.test";0b;"* stands for one label, never zero")
  ;("pki-wildcard";"a.b.wild.neant.test";0b;"and never two")
  ;("pki-wildcard";"host.two.neant.test";1b;"the plain second SAN entry")
  ;("pki-wrong-host";"leaf.neant.test";0b;"CN says leaf, SAN says other: the SAN wins"))
{[t] teq["host: ",(t[3])," (",(t[1]),")"; x509CheckHost[vfyP t[0]; t[1]]; t[2]]} each vfyHosts
terrLike["host: an empty name"; {[] x509CheckHost[vfyP "pki-leaf"; ""]}; "x509: an empty hostname"]

// a pattern is matched, never re-read: these are the wildcards that are not wildcards. Reading
// "w*.a.test" as a wildcard is how a certificate for "w*.com" becomes one for a whole TLD.
vfyPats: (("*.a.test";"x.a.test";1b);("w*.a.test";"wx.a.test";0b);("*.*.a.test";"x.y.a.test";0b)
  ;("*";"a";0b);("a.*.test";"a.x.test";0b);("*.a.test";".a.test";0b);("a.test";"a.test";1b))
{[t] teq["wildcard: ",(t[0])," vs ",t[1]; x509DnsMatch[t[0];t[1]]; t[2]]} each vfyPats

// ---- the chains that must verify
teq["chain: leaf, intermediate, trusted root"; vfyChain[(vfyP "pki-leaf"; vfyP "pki-int"); "leaf.neant.test"]; 1b]
teq["chain: the same one by address"; vfyChain[(vfyP "pki-leaf"; vfyP "pki-int"); "127.0.0.1"]; 1b]
// a server that also sends the root: an anchor is trusted by identity, so a chain that already
// ends in one simply ends there rather than looking for something above it
teq["chain: the server sent the root too"; vfyChain[(vfyP "pki-leaf"; vfyP "pki-int"; vfyP "pki-root"); "leaf.neant.test"]; 1b]
teq["chain: a wildcard leaf"; vfyChain[(vfyP "pki-wildcard"; vfyP "pki-int"); "a.wild.neant.test"]; 1b]
// pinning: a trust store may hold the leaf itself, which is the one case where a self-signed
// certificate is allowed to verify
vfyPin: x509LoadRoots "tests/data/pki-selfsigned.pem"
teq["chain: a self-signed certificate that is itself trusted"; x509VerifyChain[enlist vfyP "pki-selfsigned"; vfyPin; "leaf.neant.test"; vfyNow]; 1b]

// ---- and every way one can be wrong, each with the sentence a caller would have to act on. The
// point of asserting the exact text is that these stay *distinguishable*: a verifier that answered
// "refused" to all of them would pass a test that only looked for a signal.
vfyBad: (("the chain in an order the server should not have sent"
    ;{[] vfyChain[(vfyP "pki-int"; vfyP "pki-leaf"); "leaf.neant.test"]}
    ;"x509: ",vfyI," was not issued by the next certificate in the chain, ",vfyL,"; the server sent them in the wrong order or left one out")
  ;("the intermediate left out"
    ;{[] vfyChain[enlist vfyP "pki-leaf"; "leaf.neant.test"]}
    ;"x509: no trusted root named ",vfyI,", which issued ",vfyL)
  ;("a leaf that signed itself"
    ;{[] vfyChain[enlist vfyP "pki-selfsigned"; "leaf.neant.test"]}
    ;"x509: ",vfyL," signed itself and is not in the trust store")
  ;("an expired leaf"
    ;{[] vfyChain[(vfyP "pki-expired"; vfyP "pki-int"); "leaf.neant.test"]}
    ;"x509: ",vfyL," expired on 2021.01.01T00:00:00.000")
  ;("a leaf that is not valid yet"
    ;{[] vfyChain[(vfyP "pki-future"; vfyP "pki-int"); "leaf.neant.test"]}
    ;"x509: ",vfyL," is not valid until 2035.01.01T00:00:00.000")
  ;("a SAN for a different host"
    ;{[] vfyChain[(vfyP "pki-wrong-host"; vfyP "pki-int"); "leaf.neant.test"]}
    ;"x509: ",vfyL," is not valid for leaf.neant.test (subjectAltName: other.neant.test)")
  ;("a wildcard reaching one label too far"
    ;{[] vfyChain[(vfyP "pki-wildcard"; vfyP "pki-int"); "a.b.wild.neant.test"]}
    ;"x509: ",vfyL," is not valid for a.b.wild.neant.test (subjectAltName: *.wild.neant.test,host.two.neant.test)")
  ;("an intermediate with basicConstraints CA:FALSE"
    ;{[] vfyChain[(vfyP "pki-under-notca"; vfyP "pki-notca"); "leaf.neant.test"]}
    ;"x509: CN=neant fixture not-a-ca,O=neant fixtures,C=US is not a CA (no basicConstraints cA) and may not have issued the certificate below it")
  ;("one CA too many under a pathlen:0 intermediate"
    ;{[] vfyChain[(vfyP "pki-deep"; vfyP "pki-int2"; vfyP "pki-int"); "leaf.neant.test"]}
    ;"x509: ",vfyI," has pathLenConstraint 0 but 1 certificates hang below it")
  ;("a critical extension nobody models"
    ;{[] vfyChain[(vfyP "pki-critical"; vfyP "pki-int"); "leaf.neant.test"]}
    ;"x509: ",vfyL," has a critical extension this verifier does not model: 1.3.6.1.4.1.99999.1")
  ;("a flipped bit in the leaf's signature"
    ;{[] c: vfyP "pki-leaf"; c[`sig]: (255#c`sig),bnot (c`sig)[255]; vfyChain[(c; vfyP "pki-int"); "leaf.neant.test"]}
    ;"x509: the signature on ",vfyL," does not verify with ",vfyI,"'s key")
  ;("a trust store that does not hold the root"
    ;{[] x509VerifyChain[(vfyP "pki-leaf"; vfyP "pki-int"); x509LoadRoots "tests/data/selfsigned-rsa.pem"; "leaf.neant.test"; vfyNow]}
    ;"x509: no trusted root named ",vfyR,", which issued ",vfyI)
  ;("an empty chain"; {[] vfyChain[(); "leaf.neant.test"]}; "x509: an empty certificate chain"))
{[t] terrLike["chain: ",t[0]; t[1]; t[2]]} each vfyBad

// ---- the ECDSA fixture PKI (tests/data/pki-ec-gen.sh): a P-256 leaf under a P-256 root, both
// signed with ecdsa-with-SHA256, which is what src/neant/crypto/p256.nt was written for.
vfyEcRoots: x509LoadRoots "tests/data/pki-ec-root.pem"
vfyEcChain: {[c;h] x509VerifyChain[c; vfyEcRoots; h; vfyNow]}
teq["chain: an ECDSA P-256 leaf under an ECDSA P-256 root"; vfyEcChain[enlist vfyP "pki-ec-leaf"; "leaf.neant.test"]; 1b]
teq["chain: the same one with the root sent too"; vfyEcChain[(vfyP "pki-ec-leaf"; vfyP "pki-ec-root"); "leaf.neant.test"]; 1b]
teq["chain: the same one by address"; vfyEcChain[enlist vfyP "pki-ec-leaf"; "127.0.0.1"]; 1b]
teq["sig: the EC root signed itself, and it checks out"; x509SigVerify[vfyP "pki-ec-root"; (vfyP "pki-ec-root")`spki]; 1b]
teq["sig: a self-signed P-256 certificate from elsewhere"; x509SigVerify[vfyP "selfsigned-ec"; (vfyP "selfsigned-ec")`spki]; 1b]
// ---- the SHA-384 fixture PKI (tests/data/pki-p384-gen.sh): a P-384 leaf under a P-384 root, both
// signed ecdsa-with-SHA384. Before src/neant/crypto/{sha512,ec,p384}.nt neither link could be
// checked at all, and this whole chain was refused by algorithm at its first link.
vfyP384Roots: x509LoadRoots "tests/data/pki-p384-root.pem"
vfyP384Chain: {[c;h] x509VerifyChain[c; vfyP384Roots; h; vfyNow]}
teq["chain: an ECDSA P-384 leaf under an ECDSA P-384 root"; vfyP384Chain[enlist vfyP "pki-p384-leaf"; "leaf.neant.test"]; 1b]
teq["chain: the same one with the root sent too"; vfyP384Chain[(vfyP "pki-p384-leaf"; vfyP "pki-p384-root"); "leaf.neant.test"]; 1b]
teq["chain: the same one by address"; vfyP384Chain[enlist vfyP "pki-p384-leaf"; "127.0.0.1"]; 1b]
teq["sig: the P-384 root signed itself with SHA-384, and it checks out"; x509SigVerify[vfyP "pki-p384-root"; (vfyP "pki-p384-root")`spki]; 1b]
vfyP384Alg: ((vfyP "pki-p384-leaf")`sigAlg; ((vfyP "pki-p384-root")`spki)`curve)
teq["sig: and it really is ecdsaSha384 on a P-384 key"; vfyP384Alg; (`ecdsaSha384; `p384)]
vfyP384Bad: {[] c: vfyP "pki-p384-leaf"; n: count c`sig; c[`sig]: ((n-1)#c`sig),bnot (c`sig)[n-1]
  vfyP384Chain[enlist c; "leaf.neant.test"]}
vfyP384Bmsg: "x509: the signature on ",vfyL," does not verify with CN=neant fixture p384 ca"
terrLike["chain: a flipped bit in a P-384 signature"; vfyP384Bad; vfyP384Bmsg]

// ---- the RSA SHA-384 leaves, issued by the same RSA intermediate as pki-leaf: only the signature
// algorithm differs, so these are exactly rsa.nt's SHA-384 DigestInfo and its MGF1-SHA384 under a
// real certificate rather than a hand-built block.
teq["chain: sha384WithRSAEncryption"; vfyChain[(vfyP "pki-sha384-leaf"; vfyP "pki-int"); "leaf.neant.test"]; 1b]
teq["chain: RSASSA-PSS over SHA-384"; vfyChain[(vfyP "pki-pss384-leaf"; vfyP "pki-int"); "leaf.neant.test"]; 1b]
vfy384Alg: ((vfyP "pki-sha384-leaf")`sigAlg; (vfyP "pki-pss384-leaf")`sigAlg)
teq["sig: the two algorithms really are what they claim"; vfy384Alg; (`rsaPkcs1Sha384; `rsaPssSha384)]
// the PSS parameters have to be MGF1 over the same hash with a salt of the hash length, or x509.nt
// leaves the algorithm `unknown and it is refused rather than guessed at
vfy384Pss: `hash`mgfHash`saltLen!(`sha384;`sha384;48)
teq["sig: the PSS parameters are SHA-384 throughout"; (vfyP "pki-pss384-leaf")`sigParams; vfy384Pss]
vfy384Bad: {[] c: vfyP "pki-sha384-leaf"; n: count c`sig; c[`sig]: ((n-1)#c`sig),bnot (c`sig)[n-1]
  vfyChain[(c; vfyP "pki-int"); "leaf.neant.test"]}
vfy384Bmsg: "x509: the signature on ",vfyL," does not verify with ",vfyI,"'s key"
terrLike["chain: a flipped bit in a SHA-384 RSA signature"; vfy384Bad; vfy384Bmsg]
// the digest really is SHA-384 and not SHA-256 under a SHA-384 name: a verifier that hashed with
// the wrong one would fail the two chains above, so the positive cases already say it — but this
// says it without a signature in the way at all
vfyDgOk: ((x509Digest[`rsaPkcs1Sha384; 0x61]) ~ sha384 0x61; (x509Digest[`ecdsaSha256; 0x61]) ~ sha256 0x61)
teq["sig: x509Digest picks the hash the algorithm names"; vfyDgOk; 11b]

// ---- and the pairings this build refuses. An ECDSA algorithm is tied to ONE curve here, because
// verifying a mismatched pair means FIPS 186-4 6.4's digest truncation, which ec.nt does not do.
// Both directions are fixtures, and both are refused with the algorithm AND the curve named: a
// verifier that read "an EC key" as one thing would either accept these or call them bad signatures.
vfyEc384: x509LoadRoots "tests/data/pki-ec384-root.pem"
vfyEc384msg: "x509: ",vfyL," is signed with ecdsaSha256 by a key on p384; this build checks ecdsaSha256 on P-256 only"
vfyEc384f: {[] x509VerifyChain[enlist vfyP "pki-ec384-leaf"; vfyEc384; "leaf.neant.test"; vfyNow]}
terrLike["chain: ecdsaSha256 signed by a P-384 key"; vfyEc384f; vfyEc384msg]
vfyEc384v: x509SigVerify[vfyP "pki-ec384-leaf"; (vfyP "pki-ec384-root")`spki]
teq["sig: a mismatched curve answers 0b rather than signalling out of x509SigVerify"; vfyEc384v; 0b]
vfyP256xmsg: "x509: ",vfyL," is signed with ecdsaSha384 by a key on p256; this build checks ecdsaSha384 on P-384 only"
vfyP256xf: {[] x509VerifyChain[enlist vfyP "pki-p256x-leaf"; vfyEcRoots; "leaf.neant.test"; vfyNow]}
terrLike["chain: ecdsaSha384 signed by a P-256 key"; vfyP256xf; vfyP256xmsg]
teq["sig: and that one is 0b too"; x509SigVerify[vfyP "pki-p256x-leaf"; (vfyP "pki-ec-root")`spki]; 0b]
// P-521 has no verifier here at all, so a key on it is refused by the curve's own name
vfyP521: `alg`curve`oid`point!(`ec; `p521; "1.3.132.0.35"; 0x04, 132#0x00)
vfyP521msg: "x509: ",vfyL," is signed with ecdsaSha384 by a key on p521; this build checks ecdsaSha384 on P-384 only"
teq["sig: a P-521 key, named"; x509KeyWhy[vfyP "pki-p384-leaf"; vfyP521]; vfyP521msg]
vfyUnk: `alg`curve`oid`point!(`ec; `unknown; "1.3.36.3.3.2.8.1.1.7"; 0x04, 64#0x00)
vfyUnkmsg: "x509: ",vfyL," is signed with ecdsaSha256 by a key on the unnamed curve 1.3.36.3.3.2.8.1.1.7; this build checks ecdsaSha256 on P-256 only"
teq["sig: a curve x509.nt could not name"; x509KeyWhy[vfyP "pki-ec-leaf"; vfyUnk]; vfyUnkmsg]
// SHA-512 and SHA-1 have no dispatch here, so a certificate signed with one is refused by algorithm
// before any key is looked at — x509.nt names them, and naming is not checking
teq["sig: ecdsaSha512 is not a thing this build checks"; x509SigOk (enlist `sigAlg)!enlist `ecdsaSha512; 0b]
teq["sig: nor rsaPkcs1Sha512"; x509SigOk (enlist `sigAlg)!enlist `rsaPkcs1Sha512; 0b]
teq["sig: nor rsaPkcs1Sha1"; x509SigOk (enlist `sigAlg)!enlist `rsaPkcs1Sha1; 0b]
teq["sig: nor ed25519"; x509SigOk (enlist `sigAlg)!enlist `ed25519; 0b]

// a flipped bit in an ECDSA signature is refused the same way a flipped RSA bit is
vfyEcBad: {[] c: vfyP "pki-ec-leaf"; n: count c`sig; c[`sig]: ((n-1)#c`sig),bnot (c`sig)[n-1]
  vfyEcChain[enlist c; "leaf.neant.test"]}
vfyEcBmsg: "x509: the signature on ",vfyL," does not verify with CN=neant fixture ec root"
terrLike["chain: a flipped bit in an ECDSA signature"; vfyEcBad; vfyEcBmsg]

// ---- a real chain off the public web, and the reason this whole task existed.
// tests/data/chain-google.pem is www.google.com, WE2 and GTS Root R4 as they arrived. The leaf is
// P-256 signed ecdsa-with-SHA256 and verified before this change; WE2 is signed ecdsa-with-SHA384
// by a P-384 key and did not, and that one refusal was what kept this client off Google,
// Cloudflare, GitHub, Wikipedia, example.com and news.ycombinator.com all at once. BOTH links
// verify now. Nothing here is checked against a clock — the captured leaf has since expired — so
// these verify the SIGNATURES directly rather than going through x509VerifyChain.
vfyG: x509Parse each pemLoad "tests/data/chain-google.pem"
teq["google: the leaf really is ECDSA-SHA256 on P-256"; ((vfyG[0])`sigAlg; ((vfyG[1])`spki)`curve); (`ecdsaSha256; `p256)]
teq["google: www.google.com is signed by WE2, and it verifies"; x509SigVerify[vfyG[0]; (vfyG[1])`spki]; 1b]
vfyGbad: {[] c: vfyG[0]; n: count c`sig; c[`sig]: ((n-1)#c`sig),bnot (c`sig)[n-1]
  x509SigVerify[c; (vfyG[1])`spki]}
teq["google: one flipped bit in that signature and it does not"; vfyGbad[]; 0b]
teq["google: the leaf against the root two links up"; x509SigVerify[vfyG[0]; (vfyG[2])`spki]; 0b]
// the link that used to be the wall
teq["google: WE2 is signed ecdsa-with-SHA384 by a P-384 key"; ((vfyG[1])`sigAlg; ((vfyG[2])`spki)`curve); (`ecdsaSha384; `p384)]
teq["google: which x509SigOk now accepts"; x509SigOk vfyG[1]; 1b]
teq["google: and WE2 verifies against GTS Root R4"; x509SigVerify[vfyG[1]; (vfyG[2])`spki]; 1b]
vfyGbad2: {[] c: vfyG[1]; n: count c`sig; c[`sig]: ((n-1)#c`sig),bnot (c`sig)[n-1]
  x509SigVerify[c; (vfyG[2])`spki]}
teq["google: one flipped bit in THAT signature and it does not"; vfyGbad2[]; 0b]
// so the chain is whole: every link of the captured chain verifies, leaf to root, with x509Link —
// which is x509VerifyChain's step 4 with the clock and the trust store left out
teq["google: both links, through x509Link"; (x509Link[vfyG[0]; (vfyG[1])`spki]; x509Link[vfyG[1]; (vfyG[2])`spki]); 11b]

// and the whole capture verified the way a browser would: both links AND the trust store AND a
// clock. `now` is pinned inside the captured leaf's window (Sep 4 -- Nov 27 2026) so this keeps
// meaning the same thing after the certificate expires; everything above checks the two signatures
// on their own, with no clock and no store, so a missing system bundle only costs this case and
// not those. Before P-384 the second link was refused by algorithm and there was no chain at all.
vfySys: @[{[x] x509SystemRoots[]}; 0; {`none}]
if[vfySys~`none; print "  (no system CA bundle on this machine, skipping the Google chain)"]
vfyGnow: (2026.10.01; 12:00:00.000)
vfyGevil: {[] x509VerifyChain[vfyG; vfySys; "www.evil.example"; vfyGnow]}
if[~vfySys~`none
  teq["google: the captured chain verifies to the system trust store"; x509VerifyChain[vfyG; vfySys; "www.google.com"; vfyGnow]; 1b]
  // and the leaf must not be trusted for a name it does not carry
  terrLike["google: nor for a host it does not carry"; vfyGevil; "x509: CN=www.google.com is not valid for"]]


// the same certificate against the wrong key, with nothing else changed
teq["sig: the wrong issuer's key"; x509SigVerify[vfyP "pki-leaf"; (vfyP "pki-root")`spki]; 0b]
// and an RSA certificate offered an EC key to check it with, which is refused before any arithmetic
vfyRsaEc: "x509: ",vfyL," is signed with rsaPkcs1Sha256 but ",vfyI,"'s key is not an RSA key"
teq["sig: an RSA signature against an EC key"; x509SigVerify[vfyP "pki-leaf"; (vfyP "pki-ec-root")`spki]; 0b]
teq["sig: and x509KeyWhy says so in as many words"; x509KeyWhy[vfyP "pki-leaf"; (vfyP "pki-ec-root")`spki]; vfyRsaEc]

// ---- the trust store itself
vfyRgot: (count vfyRoots`certs; vfyRoots`skipped; count x509Find[vfyRoots; (vfyP "pki-root")`subjectCanon])
teq["roots: one root, found by the subject a chain comes looking with"; vfyRgot; 1 0 1]
teq["roots: a subject no root has"; count x509Find[vfyRoots; "2.5.4.3=nobody"]; 0]

// ---- the TLS 1.3 Certificate message (RFC 8446 4.4.2), built here and taken apart again
vfyDs: (pemLoad "tests/data/pki-leaf.pem"), pemLoad "tests/data/pki-int.pem"
// context(1) | lp24 [ lp24 cert | lp16 extensions ]*
vfyMsg: 0x00, wlp24 raze {(wlp24 x), wlp16 0x} each vfyDs
teq["Certificate: round-trips"; (parseCerts vfyMsg) ~ vfyDs; 1b]
// a per-entry extension — an SCT, a stapled OCSP response — is read past and dropped, which is
// exactly what the tls.nt header says happens to it
teq["Certificate: entry extensions are read past"; (parseCerts 0x00, wlp24 raze {(wlp24 x), wlp16 0x0005000100} each vfyDs) ~ vfyDs; 1b]
vfyCertBad: (("a certificate_request_context"; {[] parseCerts 0x01ff, wdrop[1;vfyMsg]}
    ;"tls: the server sent a certificate_request_context, which 4.4.2 forbids")
  ;("an empty message"; {[] parseCerts 0x}; "tls: an empty Certificate message")
  ;("a truncated header"; {[] parseCerts 0x000000}; "tls: a truncated Certificate message")
  ;("a list length that lies"; {[] parseCerts 0x00, (wu24 1+wbe vfyMsg[1 2 3]), wdrop[4;vfyMsg]}
    ;"tls: the certificate_list length does not match the Certificate message")
  ;("a certificate running off the end"; {[] parseCerts 0x00, wlp24 (wu24 999), (wu16 0), 0x00}
    ;"tls: a certificate runs past the end of the Certificate message")
  ;("a zero-length certificate"; {[] parseCerts 0x00, wlp24 (wu24 0), wu16 0}
    ;"tls: an empty certificate in the chain")
  ;("an entry with no extensions"; {[] parseCerts 0x00, wlp24 (wlp24 0x05), 0x00}
    ;"tls: a certificate entry with no extensions")
  ;("extensions running off the end"; {[] parseCerts 0x00, wlp24 (wlp24 0x05), wu16 9}
    ;"tls: a certificate entry's extensions run past the end of the message")
  ;("no certificates at all"; {[] parseCerts 0x00, wu24 0}; "tls: the server sent no certificates"))
{[t] terrLike["Certificate: ",t[0]; t[1]; t[2]]} each vfyCertBad

// ---- CertificateVerify (RFC 8446 4.4.3). The signature covers 64 octets of 0x20, the context
// string, one 0x00 and the transcript hash; the vector below is that content with the transcript
// hash fixed at 00..1f, signed by the fixture leaf's key:
//   python3 -c 'import sys; sys.stdout.buffer.write(b"\x20"*64 \
//     + b"TLS 1.3, server CertificateVerify" + b"\x00" + bytes(range(32)))' > cv.bin
//   openssl dgst -sha256 -sigopt rsa_padding_mode:pss -sigopt rsa_pss_saltlen:32 \
//     -sign tests/data/pki-leaf.key -out cv.sig cv.bin              (OpenSSL 3.6.2)
// It is tied to pki-leaf.key as committed, so re-running tests/data/pki-gen.sh means re-running
// these two as well.
vfyCtx: (count TLSCVCTX; `char$TLSCVCTX[64+til 33]; TLSCVCTX[97])
teq["CertificateVerify: the context, byte for byte"; vfyCtx; (98;"TLS 1.3, server CertificateVerify";0x00)]
vfyK: (vfyP "pki-leaf")`spki
vfySig: unhex ""
vfyTh: `byte$til 32
teq["CertificateVerify: openssl's rsa_pss_rsae_sha256"; certVerify[(vfyK; 2052; vfySig; vfyTh)]; 1b]
// The same content signed with the fixture's ECDSA key, which is scheme 1027:
//   openssl dgst -sha256 -sign tests/data/pki-ec-leaf.key -out cvec.sig cv.bin     (OpenSSL 3.6.2)
// ECDSA picks a random k, so re-running gives a different signature that verifies just as well.
vfyEcK: (vfyP "pki-ec-leaf")`spki
vfyEcSig: unhex "304502200796b915539397ad993d00f06ff44b5432d8e3faf988658f48152d78a400480c022100f15843c85b1b5eff25fccba0ddac93c3276c3c6b393c14e77bae0c62bc7f6a2b"
teq["CertificateVerify: openssl's ecdsa_secp256r1_sha256"; certVerify[(vfyEcK; 1027; vfyEcSig; vfyTh)]; 1b]
// and the two SHA-384 schemes, over the same cv.bin. 1283 is ecdsa_secp384r1_sha384 and 2053 is
// rsa_pss_rsae_sha384; both hash the context and the transcript with SHA-384, never SHA-256, so a
// certVerify that reached for the wrong hash would fail here and pass everywhere above.
//   openssl dgst -sha384 -sign tests/data/pki-p384-leaf.key -out cv384.sig cv.bin
//   openssl dgst -sha384 -sigopt rsa_padding_mode:pss -sigopt rsa_pss_saltlen:48 \
//     -sign tests/data/pki-leaf.key -out cvpss384.sig cv.bin                      (OpenSSL 3.6.2)
vfyP384K: (vfyP "pki-p384-leaf")`spki
vfyP384Sig: unhex "306402300f7af62d2c58c4db510cc9818077e43d76e8b7c08766b873a68aff7ce9e186f342683b8c00eb11f8f01a4a6095210c3902304826b70d6017273518b864b8a92ebee9ba8ec131c056f1f3be5f3f6e64e8680d1784d91b60559b91fe7fca2d8404ff15"
vfyPss384Sig: unhex ""
teq["CertificateVerify: openssl's ecdsa_secp384r1_sha384"; certVerify[(vfyP384K; 1283; vfyP384Sig; vfyTh)]; 1b]
teq["CertificateVerify: openssl's rsa_pss_rsae_sha384"; certVerify[(vfyK; 2053; vfyPss384Sig; vfyTh)]; 1b]
// 1025 is rsa_pkcs1_sha256, which 4.4.3 forbids in a handshake signature whoever holds the key —
// those code points are for certificates only. Everything else here is a signature that is simply
// wrong, or a key of a kind the scheme the server picked cannot be checked with.
vfyCvBad: (("rsa_pkcs1_sha256, which 4.4.3 forbids here"; {[] certVerify[(vfyK; 1025; vfySig; vfyTh)]}
    ;"tls: CertificateVerify uses signature scheme 1025, which this build cannot verify")
  ;("ed25519"; {[] certVerify[(vfyK; 2055; vfySig; vfyTh)]}
    ;"tls: CertificateVerify uses signature scheme 2055, which this build cannot verify")
  ;("ecdsa_secp521r1_sha512, a curve and a hash both out of reach"
    ;{[] certVerify[(vfyEcK; 1539; vfyEcSig; vfyTh)]}
    ;"tls: CertificateVerify uses signature scheme 1539, which this build cannot verify")
  ;("rsa_pkcs1_sha384, which 4.4.3 forbids here just as it forbids 1025"
    ;{[] certVerify[(vfyK; 1281; vfySig; vfyTh)]}
    ;"tls: CertificateVerify uses signature scheme 1281, which this build cannot verify")
  ;("a different transcript"; {[] certVerify[(vfyK; 2052; vfySig; 32#0x00)]}
    ;"tls: the server's CertificateVerify did not verify")
  ;("a flipped signature bit"; {[] certVerify[(vfyK; 2052; (255#vfySig),bnot vfySig[255]; vfyTh)]}
    ;"tls: the server's CertificateVerify did not verify")
  ;("the wrong server's key"; {[] certVerify[((vfyP "pki-int")`spki; 2052; vfySig; vfyTh)]}
    ;"tls: the server's CertificateVerify did not verify")
  ;("an ECDSA one against a different transcript"; {[] certVerify[(vfyEcK; 1027; vfyEcSig; 32#0x00)]}
    ;"tls: the server's CertificateVerify did not verify")
  ;("an ECDSA one with a flipped signature bit"
    ;{[] n: count vfyEcSig; certVerify[(vfyEcK; 1027; ((n-1)#vfyEcSig),bnot vfyEcSig[n-1]; vfyTh)]}
    ;"tls: the server's CertificateVerify did not verify")
  ;("an ECDSA one against the wrong EC key"
    ;{[] certVerify[((vfyP "pki-ec-root")`spki; 1027; vfyEcSig; vfyTh)]}
    ;"tls: the server's CertificateVerify did not verify")
  ;("a PSS scheme with a key that is not RSA"; {[] certVerify[(vfyEcK; 2052; vfySig; vfyTh)]}
    ;"tls: CertificateVerify uses signature scheme 2052, but the server's key is not an RSA key")
  ;("1027 with a key that is not EC"; {[] certVerify[(vfyK; 1027; vfyEcSig; vfyTh)]}
    ;"tls: CertificateVerify uses ecdsa_secp256r1_sha256, but the server's key is not an EC key")
  ;("1027 with an EC key on the wrong curve"
    ;{[] certVerify[((vfyP "pki-ec384-root")`spki; 1027; vfyEcSig; vfyTh)]}
    ;"tls: CertificateVerify uses ecdsa_secp256r1_sha256, but the server's key is on p384")
  ;("1283 with an EC key on the wrong curve, the same refusal the other way round"
    ;{[] certVerify[(vfyEcK; 1283; vfyP384Sig; vfyTh)]}
    ;"tls: CertificateVerify uses ecdsa_secp384r1_sha384, but the server's key is on p256")
  ;("1283 with a key that is not EC"; {[] certVerify[(vfyK; 1283; vfyP384Sig; vfyTh)]}
    ;"tls: CertificateVerify uses ecdsa_secp384r1_sha384, but the server's key is not an EC key")
  ;("a P-384 signature checked as SHA-256, which is a different digest entirely"
    ;{[] certVerify[(vfyP384K; 1283; vfyP384Sig; 32#0x00)]}
    ;"tls: the server's CertificateVerify did not verify")
  ;("2053 against the SHA-256 PSS signature"; {[] certVerify[(vfyK; 2053; vfySig; vfyTh)]}
    ;"tls: the server's CertificateVerify did not verify"))
{[t] terrLike["CertificateVerify: ",t[0]; t[1]; t[2]]} each vfyCvBad

// ---- the ClientHello. The two ECDSA schemes come first: between them they are what the public
// web serves, and every scheme in the list is one certVerify above can actually check.
// the body is 0x01 lp24 [ version(2) random(32) lp8 session_id cipher_suites(lp16) compression(2)
// lp16 extensions ], so with a 32-byte session id the extensions start at 4+2+32+1+32+4+2+2 = 79
vfyCh: clientHello["a.test"; 32#0x01; 32#0x02; 32#0x03]
vfySa: findExt[wdrop[47+`int$vfyCh[38]; vfyCh]; 13]
// lp16 over 1027 (0x0403), 1283 (0x0503), 2052 (0x0804), 2053 (0x0805), 1025 (0x0401), 1281 (0x0501)
teq["ClientHello: signature_algorithms, the two ECDSA schemes first"; hex vfySa; "000c040305030804080504010501"]
