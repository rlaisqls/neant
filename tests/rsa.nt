// RSA signature verification: src/neant/crypto/rsa.nt — the mod rsa tests that used to be in
// src/main.rs, minus the two bignum ones (tests/bignum.nt) and the timing, which needs the host and
// stays in Rust. Nothing else here needed Rust: `rsaVerifyPkcs1`/`rsaVerifyPss` answer 1b or 0b and
// a signal is a signal, all three of which `teq`/`terrLike` say directly. None of the three modules
// is in the boot image, so they are loaded on demand in dependency order.
//
// Every vector was made on this machine with the command quoted above it and can be regenerated
// from it; the key is throwaway and its private half only ever existed to forge the blocks that
// must NOT verify.
tsection "rsa"
{load "src/neant/crypto/",x} each ("bignum.nt";"sha512.nt";"rsa.nt")

// openssl genrsa -out rsa2048.pem 2048            (OpenSSL 3.6.2)
// openssl rsa -in rsa2048.pem -noout -modulus     — the exponent is the default 65537
rsatN: unhex ""
rsatE: 0x010001
// printf 'neant rsa test vector\n' > msg.txt && openssl dgst -sha256 msg.txt
rsatDg: unhex "d4663dfa5e7a0c65e3c005537874a194dbd6735b382cc18a6c297908f1faef9d"
// openssl dgst -sha256 -sign rsa2048.pem -out sig.bin msg.txt
rsatPkcs1: unhex ""
// openssl dgst -sha256 -sigopt rsa_padding_mode:pss -sigopt rsa_pss_saltlen:<32|20|0> \
//   -sign rsa2048.pem -out sig.bin msg.txt
rsatPss32: unhex ""
rsatPss20: unhex ""
rsatPss0: unhex ""
// The forgeries. openssl will not produce a bad block, so these are `pow(EM, d, n)` in python over
// the d that `openssl rsa -in rsa2048.pem -noout -text` prints, with EM built by hand.
// rsatBleichEm is 0x00 0x01 <eight 0xFF> 0x00 DigestInfo <0xAA filler>: the right digest, the right
// DigestInfo, and 245 bytes of garbage where the padding should be — Bleichenbacher '06.
rsatBleichSig: unhex ""
rsatBleichEm: unhex ""
// A hand-built PSS block (salt 00 01 .. 1f) and three corruptions of it, all signed the same way.
rsatPssHand: unhex ""
rsatPssTrail: unhex ""      // 0xbc trailer turned into 0xbb
rsatPssTopbit: unhex ""    // top bit of maskedDB set, which emBits forbids
rsatPssPs: unhex ""            // a 0x07 in DB's zero padding, before the 0x01
// With e = 1 the "signature" is the encoded message itself — this is a correct PKCS#1 block.
rsatE1Sig: unhex ""

// ---- the signatures openssl made over msg.txt, with the salt length recovered from the encoding
// rather than told to the verifier: 32, 20 and 0 all have to work.
teq["verify: pkcs1-v1_5"; rsaVerifyPkcs1[rsatN;rsatE;`sha256;rsatDg;rsatPkcs1]; 1b]
teq["verify: pss salt 32"; rsaVerifyPss[rsatN;rsatE;`sha256;rsatDg;rsatPss32]; 1b]
teq["verify: pss salt 20"; rsaVerifyPss[rsatN;rsatE;`sha256;rsatDg;rsatPss20]; 1b]
teq["verify: pss salt 0"; rsaVerifyPss[rsatN;rsatE;`sha256;rsatDg;rsatPss0]; 1b]
teq["verify: pss hand-built, salt 32"; rsaVerifyPss[rsatN;rsatE;`sha256;rsatDg;rsatPssHand]; 1b]

// ---- a verifier's whole job. One flipped bit anywhere, a signature that is not exactly k bytes, a
// scheme confusion, an unknown hash, a digest of the wrong length, and e = 1. Every one is 0b: a
// bad signature is an answer, not an error.
rsatBadDg: (31#rsatDg),bnot rsatDg[31]
teq["reject: flipped last bit of the pkcs1 signature"; rsaVerifyPkcs1[rsatN;rsatE;`sha256;rsatDg;(255#rsatPkcs1),bnot rsatPkcs1[255]]; 0b]
teq["reject: flipped first bit of the pkcs1 signature"; rsaVerifyPkcs1[rsatN;rsatE;`sha256;rsatDg;(bnot rsatPkcs1[0]),1 _ rsatPkcs1]; 0b]
teq["reject: flipped bit in the digest"; rsaVerifyPkcs1[rsatN;rsatE;`sha256;rsatBadDg;rsatPkcs1]; 0b]
teq["reject: signature one byte short"; rsaVerifyPkcs1[rsatN;rsatE;`sha256;rsatDg;255#rsatPkcs1]; 0b]
teq["reject: signature one byte long"; rsaVerifyPkcs1[rsatN;rsatE;`sha256;rsatDg;rsatPkcs1,0x00]; 0b]
teq["reject: e = 1 over a correct pkcs1 block"; rsaVerifyPkcs1[rsatN;0x01;`sha256;rsatDg;rsatE1Sig]; 0b]
teq["reject: unknown hash symbol"; rsaVerifyPkcs1[rsatN;rsatE;`sha1;rsatDg;rsatPkcs1]; 0b]
teq["reject: digest of the wrong length"; rsaVerifyPkcs1[rsatN;rsatE;`sha256;31#rsatDg;rsatPkcs1]; 0b]
teq["reject: a pss signature offered to the pkcs1 verifier"; rsaVerifyPkcs1[rsatN;rsatE;`sha256;rsatDg;rsatPss32]; 0b]
teq["reject: flipped last bit of the pss signature"; rsaVerifyPss[rsatN;rsatE;`sha256;rsatDg;(255#rsatPss32),bnot rsatPss32[255]]; 0b]
teq["reject: flipped bit in the digest, pss"; rsaVerifyPss[rsatN;rsatE;`sha256;rsatBadDg;rsatPss32]; 0b]
teq["reject: pss signature one byte short"; rsaVerifyPss[rsatN;rsatE;`sha256;rsatDg;255#rsatPss32]; 0b]
teq["reject: a pkcs1 signature offered to the pss verifier"; rsaVerifyPss[rsatN;rsatE;`sha256;rsatDg;rsatPkcs1]; 0b]
teq["reject: an even modulus, 0b and not the signal bnModExp would raise"; rsaVerifyPkcs1[(255#rsatN),0x00;rsatE;`sha256;rsatDg;rsatPkcs1]; 0b]
// 32776 bits is 1261 limbs, past the 1023 bnMul insists on — rsaRecover's width cap has to turn
// that into 0b before bnMul gets the chance to signal, or a certificate could make the verifier
// raise instead of answering.
teq["reject: a 32776-bit modulus with a signature to match"; rsaVerifyPkcs1[(4096#0xff),0x01;rsatE;`sha256;rsatDg;4097#0x02]; 0b]

// ---- Bleichenbacher '06: the block really does carry the right DigestInfo for the right digest,
// and a verifier that scans for it instead of checking the whole encoding accepts it. The first two
// assertions prove the vector is the attack and not just noise — the recovered block is
// byte-for-byte the crafted one — and the third is the check that has to say no.
// the leading 0x00 of the block is not in bnModExp's minimal byte form
teq["bleichenbacher: the recovered block is the crafted one"; (bnModExp[rsatBleichSig;rsatE;rsatN]) ~ 1 _ rsatBleichEm; 1b]
rsatBleichParts: (rsatBleichEm[til 11] ~ 0x0001ffffffffffffffff00; rsatBleichEm[11+til 51] ~ (unhex "3031300d060960864801650304020105000420"),rsatDg)
teq["bleichenbacher: which carries the right padding head and DigestInfo"; rsatBleichParts; 11b]
teq["bleichenbacher: and it is rejected anyway"; rsaVerifyPkcs1[rsatN;rsatE;`sha256;rsatDg;rsatBleichSig]; 0b]

// ---- the three PSS encoding rules that are easy to skip, each one broken on its own in a block
// that is otherwise exactly rsatPssHand — which verifies above, so the broken bit is the only change.
teq["pss rule: the 0xbc trailer"; rsaVerifyPss[rsatN;rsatE;`sha256;rsatDg;rsatPssTrail]; 0b]
teq["pss rule: the leftmost 8*emLen-emBits bits of maskedDB"; rsaVerifyPss[rsatN;rsatE;`sha256;rsatDg;rsatPssTopbit]; 0b]
teq["pss rule: the zero padding before DB's 0x01 separator"; rsaVerifyPss[rsatN;rsatE;`sha256;rsatDg;rsatPssPs]; 0b]

// ---- a bad signature is an answer (0b); a missing key is a bug at the call site, and signals.
terrLike["signals: an empty modulus"; {[] rsaVerifyPkcs1[0x;rsatE;`sha256;rsatDg;rsatPkcs1]}; "rsa: modulus is empty"]
terrLike["signals: an empty exponent"; {[] rsaVerifyPss[rsatN;0x;`sha256;rsatDg;rsatPss32]}; "rsa: exponent is empty"]
