// A column walk against the TLB (cost-model § Time, pages): `rows` rows `stride` elements apart,
// every access on a page of its own when `stride · 8 ≥ 4096`. Mode 0 walks one column `reps` times,
// its lines resident, so what a lap waits for is the translation; mode 1 walks column after column,
// eight elements apart, so every line is new and a page is reused while its rows fit the TLB; mode
// 2 is mode 0 summed into four, so that no add chain paces it.
// Prints nanoseconds an access.
//
//     neant run tests/kernels/pagewalk.nt -- MODE ROWS STRIDE REPS

use "std/text.nt";
use "std/os.nt";

fn walk_one(rows: i64, stride: i64, reps: i64, a: &[f64]) -> f64 {
    let mut s = 0.0;
    for r in 0..reps {
        for i in 0..rows {
            s += a[i * stride];
        }
    }
    s
}

fn walk_cols(rows: i64, stride: i64, cols: i64, a: &[f64]) -> f64 {
    let mut s = 0.0;
    for c in 0..cols {
        for i in 0..rows {
            s += a[i * stride + c * 8];
        }
    }
    s
}


// four sums over the walk, so that no add chain paces it: what is left is the loads' translation
fn walk_four(rows: i64, stride: i64, reps: i64, a: &[f64]) -> f64 {
    let mut s0 = 0.0;
    let mut s1 = 0.0;
    let mut s2 = 0.0;
    let mut s3 = 0.0;
    for r in 0..reps {
        for q in 0..rows / 4 {
            let i = 4 * q;
            s0 += a[i * stride];
            s1 += a[(i + 1) * stride];
            s2 += a[(i + 2) * stride];
            s3 += a[(i + 3) * stride];
        }
    }
    s0 + s1 + s2 + s3
}

fn main() {
    let a0 = arg(0);
    let mode = parse_int(&a0, 0).v;
    let a1 = arg(1);
    let rows = parse_int(&a1, 0).v;
    let a2 = arg(2);
    let stride = parse_int(&a2, 0).v;
    let a3 = arg(3);
    let reps = parse_int(&a3, 0).v;
    let mut a = [1.0; rows * stride];
    for i in 0..rows * stride { a[i] = (i % 7) as f64; }
    let t0 = os_now();
    let mut s = 0.0;
    let mut n = 0;
    if mode == 0 {
        s = walk_one(rows, stride, reps, &a);
        n = rows * reps;
    } else if mode == 2 {
        s = walk_four(rows, stride, reps, &a);
        n = rows / 4 * 4 * reps;
    } else {
        let cols = min(reps, stride / 8);
        s = walk_cols(rows, stride, cols, &a);
        n = rows * cols;
    }
    let dt = os_now() - t0;
    println(dt as f64 / n as f64);
    println(s);
}
