// the same product in 64×64 tiles; n must be a multiple of 64
fn matmul(n: i64, a: &[f64], b: &[f64], c: &mut [f64]) {
    let t = 64;
    for ii in 0..n / t {
        for jj in 0..n / t {
            for kk in 0..n / t {
                for i in ii * t..ii * t + t {
                    for j in jj * t..jj * t + t {
                        let mut acc = c[i * n + j];
                        for k in kk * t..kk * t + t {
                            acc += a[i * n + k] * b[k * n + j];
                        }
                        c[i * n + j] = acc;
                    }
                }
            }
        }
    }
}

fn main() {
    let n = @N@;
    let mut a = [0.0; n * n];
    let mut b = [0.0; n * n];
    let mut c = [0.0; n * n];
    for i in 0..n * n {
        a[i] = (i % 7) as f64;
        b[i] = (i % 5) as f64;
    }
    for r in 0..@R@ {
        matmul(n, &a, &b, &mut c);
    }
    println(c[n + 1]);
}
