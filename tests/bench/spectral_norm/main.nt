// The Benchmarks Game's spectral-norm: the largest singular value of the infinite matrix
// A(i, j) = 1/((i + j)(i + j + 1)/2 + i + 1), by ten power iterations of AᵀA on n entries.

use "std/math.nt";
use "std/text.nt";

fn eval_a(i: i64, j: i64) -> f64 {
    1.0 / (((i + j) * (i + j + 1) / 2 + i + 1) as f64)
}

fn times(v: &[f64], out: &mut [f64]) {
    for i in 0..out.len() {
        let mut s = 0.0;
        for j in 0..v.len() {
            s += eval_a(i, j) * v[j];
        }
        out[i] = s;
    }
}

fn times_transp(v: &[f64], out: &mut [f64]) {
    for i in 0..out.len() {
        let mut s = 0.0;
        for j in 0..v.len() {
            s += eval_a(j, i) * v[j];
        }
        out[i] = s;
    }
}

fn a_times_transp(v: &[f64], tmp: &mut [f64], out: &mut [f64]) {
    times(v, tmp);
    times_transp(tmp, out);
}

fn main() {
    let a0 = arg(0);
    let n = parse_int(&a0, 0).v;
    let mut u = [1.0; n];
    let mut v = [0.0; n];
    let mut tmp = [0.0; n];
    for k in 0..10 {
        a_times_transp(&u, &mut tmp, &mut v);
        a_times_transp(&v, &mut tmp, &mut u);
    }
    let mut vbv = 0.0;
    let mut vv = 0.0;
    for i in 0..n {
        vbv += u[i] * v[i];
        vv += v[i] * v[i];
    }
    println(sqrt(vbv / vv));
}
