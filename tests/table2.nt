// table.nt additions: schema, csv, fby, update/delete/distinct/insert
tsection "table: schema"
tt: tbl[`name`dept`pay; (`ann`bob`cy`dan; `eng`ops`eng`ops; 120 80 100 90)]
teq["meta"; meta tt; tbl[`c`t; (`name`dept`pay; `syms`syms`ints)]]
teq["meta list col"; (meta tbl[`s; enlist ("ab";"c")])[`t]; ,`list]
teq["tcols"; tcols tt; `name`dept`pay]
teq["xcol dict"; key xcol[`pay`dept!`p`d; tt]; `name`d`p]
teq["xcol list"; key xcol[`a`b; tt]; `a`b`pay]
teq["xcol keeps values"; value xcol[`a`b; tt]; value tt]
teq["xcols"; key xcols[`pay; tt]; `pay`name`dept]
teq["xcols two"; key xcols[`pay`dept; tt]; `pay`dept`name]

tsection "table: csv"
teq["tcsv"; tcsv tbl[`a`b; (1 2; `x`y)]; "a,b\n1,x\n2,y"]
teq["tcsv empty"; tcsv tbl[`a`b; (0#0; 0#`)]; "a,b"]
teq["tcsv quoting"; tcsv tbl[`s`n; (("a,b";"say \"hi\"";"plain"); 1 2 3)]; "s,n\n\"a,b\",1\n\"say \"\"hi\"\"\",2\nplain,3"]
teq["rcsv text"; rcsv["SI"; ","; "a,b\nx,1\ny,2"]; tbl[`a`b; (`x`y; 1 2)]]
teq["rcsv roundtrip quoted"; (rcsv["XI"; ","; tcsv tbl[`s`n; (("a,b";"say \"hi\"";"plain"); 1 2 3)]])[`s]; ("a,b";"say \"hi\"";"plain")]
teq["rcsv null cell"; (rcsv["IS"; ","; "a,b\n1,x\n,y\n3,z"])[`a]; 1 0N 3]
teq["rcsv file still"; count rcsv["SSI";",";"tests/data/people.csv"]; 3]
wcsv["/tmp/claude-1000/-home-rlaisqls-work-neant/7ea84255-0739-4a41-a46f-35ba0211a2ba/scratchpad/wcsv_test.csv"; tt]
teq["wcsv then rcsv"; rcsv["SSI"; ","; "/tmp/claude-1000/-home-rlaisqls-work-neant/7ea84255-0739-4a41-a46f-35ba0211a2ba/scratchpad/wcsv_test.csv"]; tt]

tsection "table: fby, update, delete"
teq["fby avg"; fby[avg;`pay;`dept;tt]; 110 85 110 85.0]
teq["fby sel"; tsel[tt; tt[`pay] > fby[avg;`pay;`dept;tt]]; tbl[`name`dept`pay; (`ann`dan; `eng`ops; 120 90)]]
teq["fby empty"; fby[sum;`pay;`dept; tsel[tt; 4#0b]]; ()]
teq["tupd fn masked"; (tupd[tt; tt[`dept]=`ops; (,`pay)!enlist {x[`pay]+5}])[`pay]; 120 85 100 95]
teq["tupd atom all"; (tupd[tt; (); (,`n)!enlist 0])[`n]; 0 0 0 0]
teq["tupd new col masked"; (tupd[tt; tt[`pay]>100; (,`big)!enlist 1])[`big]; 1 0N 0N 0N]
teq["tupd vector"; (tupd[tt; (); (,`pay)!enlist 1 2 3 4])[`pay]; 1 2 3 4]
teq["tupd untouched"; tupd[tt; 4#0b; (,`pay)!enlist 0]; tt]
teq["tdel rows"; tdel[tt; tt[`pay]<90]; tbl[`name`dept`pay; (`ann`cy`dan; `eng`eng`ops; 120 100 90)]]
teq["tdel col"; key tdel[tt;`dept]; `name`pay]
teq["tdel cols"; key tdel[tt;`name`dept]; ,`pay]
teq["tdistinct"; tdistinct tbl[`a`b; (1 1 2 1; `x`x`y`x)]; tbl[`a`b; (1 2; `x`y)]]
teq["tdistinct empty"; tdistinct tbl[`a; enlist 0#0]; tbl[`a; enlist 0#0]]
teq["tinsert list"; tcount tinsert[tt; (`eve;`ops;70)]; 5]
teq["tinsert dict"; (tinsert[tt; `pay`name`dept!(70;`eve;`ops)])[`name]; `ann`bob`cy`dan`eve]
teq["tinsert string col"; (tinsert[tbl[`s; enlist ("ab";"c")]; enlist "de"])[`s]; ("ab";"c";"de")]
