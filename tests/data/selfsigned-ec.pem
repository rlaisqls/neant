A self-signed P-256 certificate, ecdsa-with-SHA256: the EC branch of x509Spki, a one-octet serial,
a single-entry SAN, and a BasicConstraints whose CA:FALSE is (correctly) an empty SEQUENCE in DER.

openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -keyout /dev/null -noenc -sha256 \
  -not_before 20260101000000Z -not_after 20360101000000Z -set_serial 0x2a \
  -subj "/C=US/O=neant/CN=ec.neant.test" \
  -addext "subjectAltName=DNS:ec.neant.test" \
  -addext "basicConstraints=critical,CA:FALSE" \
  -addext "keyUsage=critical,digitalSignature" \
  -out tests/data/selfsigned-ec.pem

