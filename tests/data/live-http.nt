// The HTTPS client against the real web. Not loaded by tests/run.nt: it needs the network and a
// working system trust store, and it measures rather than asserts. Run it by hand.
//   ./target/release/neant tests/data/live-http.nt
load "src/neant/crypto/tlsclient.nt"
load "src/neant/net/http.nt"
lhT: {[f] t0: now`time; r: f[]; (`int$now[`time]-t0; r)}
lhOne: {[url]
  a: @[{[u] lhT {httpGet u}}; url; {[e] (0; `err`msg!(1b;e))}]
  r: a 1
  $[`err in key r; print fmt["%-32s FAILED  %s"; (url; r`msg)]
    print fmt["%-32s %5dms  %d  %6d bytes  %s"; (url; a 0; r`status; count r`body; httpVal[r`headers; `$"content-type"; "-"])]]}
lhOne each ("https://example.com/"; "https://www.google.com/"; "https://www.amazon.com/"; "http://example.com/")

// what the reuse is worth: one handshake, then requests that pay only the round trip
u: urlParse "https://example.com/"
c0: lhT {httpConnect u}
c: c0 1
r1: lhT {httpExchange[c; u; "GET"; "/"; ()!(); ""]}
r2: lhT {httpExchange[c; u; "GET"; "/"; ()!(); ""]}
(c 2)[]
print fmt["reuse: handshake %dms, then %dms and %dms on the same connection"; (c0 0; r1 0; r2 0)]
