// Revocation against the real web: read the distribution point out of a certificate a real CA
// issued, fetch the list over HTTP, verify its signature with the issuer's key, and ask whether the
// certificate is on it. Not loaded by tests/run.nt — it needs the network. Run it by hand:
//   ./target/release/neant tests/data/live-crl.nt
load "src/neant/crypto/tlsclient.nt"
load "src/neant/crypto/crl.nt"
load "src/neant/net/http.nt"
lcT: {[f] t0: now`time; r: f[]; (`int$now[`time]-t0; r)}
lcCh: pemLoad "tests/data/chain-google.pem"
lcLeaf: x509Parse lcCh[0]
lcCa: x509Parse lcCh[1]
lcU: first crlUrls lcCh[0]
print fmt["distribution point: %s"; lcU]
lcF: lcT {httpGet lcU}
print fmt["fetched %6d bytes in %4dms   (%s)"; (count (lcF 1)`body; lcF 0; httpVal[(lcF 1)`headers; `$"content-type"; "-"])]
lcP: lcT {crlParse (lcF 1)`body}
lcCrl: lcP 1
print fmt["parsed  %6d serials in %4dms   issuer %s"; (count lcCrl`serials; lcP 0; lcCrl`issuer)]
print fmt["window  %s to %s, signed %s"; (iso (lcCrl`thisUpdate)[0]; iso (lcCrl`nextUpdate)[0]; string lcCrl`sigAlg)]
lcV: lcT {crlSigOk[lcCrl; lcCa]}
print fmt["signature verifies: %s  (%dms)"; ($[lcV 1; "yes"; "NO"]; lcV 0)]
lcW: crlCheck[lcCrl; lcLeaf; lcCa; (now`date; now`time)]
print fmt["this leaf: %s"; $[0=count lcW; "not revoked"; lcW]]
// and a serial the list really does carry, so a "no" above is not just a comparison that never fires
print fmt["a serial the list carries (%s): %s"; (hex first lcCrl`serials; $[crlHas[lcCrl; first lcCrl`serials]; "found"; "NOT FOUND"])]
