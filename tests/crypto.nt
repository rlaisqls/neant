// SHA-512, SHA-384 and the Ed25519 group law against their published vectors — the ed_vm tests that
// used to be in src/main.rs. Neither module is in the boot image, so both are loaded on demand,
// exactly as a script would; sha512.nt comes first because ed25519.nt's RFC 8032 hash lives there
// now, beside the SHA-384 that made it worth a file of its own.
tsection "crypto"
load "src/neant/crypto/sha512.nt"
load "src/neant/crypto/ed25519.nt"
ctev: {[s] @[{[s] repr nrun s}; s; {"'",x}]}

// `badd` is what makes SHA-512 possible: a word may be any bit pattern, including the one `+` reads as 0N.
teq["sha512 empty"; hex sha512 0x; "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"]
teq["sha512 abc"; hex sha512 `byte$"abc"; "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"]
// two blocks, and a length that forces a padding block of its own
teq["sha512 two blocks"; hex sha512 `byte$"abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"; "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909"]
teq["sha512 200 a"; hex sha512 `byte$ 200#"a"; "4b11459c33f52a22ee8236782714c150a3b2c60994e9acee17fe68947a3e6789f31e7668394592da7bef827cddca88c4e6f86e4df7ed1ae6cba71f3e98faee9f"]

// SHA-384 (FIPS 180-4 5.3.4 / 6.5): the same compression function, another IV, truncated to 48
// bytes. The first three are the standard's own examples; every one of these also comes back from
//   printf '<the message>' | openssl dgst -sha384                                  (OpenSSL 3.6.2)
teq["sha384 empty"; hex sha384 0x; "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b"]
teq["sha384 abc"; hex sha384 `byte$"abc"; "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"]
teq["sha384 two blocks"; hex sha384 `byte$"abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"; "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039"]
teq["sha384 200 a"; hex sha384 `byte$ 200#"a"; "0691b6e978614b67d60557b2a2cddd53406508522efa21c624dbbfa8ab6e726d5c586b489c7c09f24109a64c10211d48"]
// 111 and 112 bytes are the two sides of the padding boundary: at 112 the length no longer fits in
// the block and sha512Pad has to add a whole one. Both hashes share that padding code, so getting
// it wrong would break SHA-512 too -- these are here because SHA-384 is the one a certificate uses.
teq["sha384 111 a, the last length that pads in place"; hex sha384 `byte$ 111#"a"; "3c37955051cb5c3026f94d551d5b5e2ac38d572ae4e07172085fed81f8466b8f90dc23a8ffcdea0b8d8e58e8fdacc80a"]
teq["sha384 112 a, the first that needs a second block"; hex sha384 `byte$ 112#"a"; "187d4e07cb306103c69967bf544d0dfbe9042577599c73c330abc0cb64c61236d5ed565ee19119d8c31779a38f791fcd"]
teq["sha384 is 48 bytes"; count sha384 `byte$"abc"; 48]
// and it is NOT SHA-512 cut short: the IV is what differs, so a sha384 that forgot sha384H0 would
// agree with this and be wrong on every vector above
teq["sha384 is not the first 48 bytes of sha512"; (hex sha384 `byte$"abc") ~ 96#hex sha512 `byte$"abc"; 0b]
teq["badd vs + on the null bit pattern"; ctev "mn: 1 shl 63; (mn badd 1; mn + 1)"; "-0W 0N"]

// the curve: encoding round-trips, the addition law, the identity, inverses, and scalar reduction
teq["edEncode matches fencode"; (edEncode EDB) ~ fencode EDBY; 1b]
teq["edDecode round-trips"; (edEncode edDecode edEncode EDB) ~ edEncode EDB; 1b]
teq["add is double on equal points"; (edEncode edAdd[EDB;EDB]) ~ edEncode edDbl EDB; 1b]
teq["zero is the identity"; (edEncode edAdd[EDZERO;EDB]) ~ edEncode EDB; 1b]
teq["a point plus its negation is zero"; (edEncode edAdd[EDB;edNeg EDB]) ~ edEncode EDZERO; 1b]
teq["scalar 2 is a double"; (edEncode edMul[253#scBits scFromBytes 0x02,31#0x00; EDB]) ~ edEncode edDbl EDB; 1b]
teq["L reduces to zero"; scMod bitsBE unhex "1000000000000000000000000000000014def9dea2f79cd65812631a5cf5d3ed"; 12#0]
teq["one reduces to one"; scMod bitsBE (31#0x00),0x01; 1,11#0]
