// tests for src/neant/stdlib/regex.nt (in the boot image); loaded by tests/run.nt
tsection "regex"
rt: teq
err: {[p] @[{rxc x}; p; {x}]}   // the error message, or the compiled pattern when it compiled

// literals, .
rt["lit"; rx["b";"abc"]; 1 1]
rt["lit string"; rx["bc";"abcd"]; 1 2]
rt["lit none"; rx["x";"abc"]; ()]
rt["test"; rxTest["b";"abc"]; 1b]
rt["test none"; rxTest["x";"abc"]; 0b]
rt["dot"; rx["a.c";"xabcx"]; 1 3]
rt["dot no newline"; rxTest["a.c";"a\nc"]; 0b]
// escapes
rt["esc dot"; rx["a\\.c";"abc a.c"]; 4 3]
rt["esc backslash"; rx["\\\\";"a\\b"]; 1 1]
rt["esc n"; rx["\\n";"a\nb"]; 1 1]
rt["esc t"; rx["\\t";"a\tb"]; 1 1]
rt["esc r"; rx["\\r";"a\rb"]; 1 1]
rt["esc d"; rx["\\d+";"ab12c"]; 2 2]
rt["esc D"; rx["\\D+";"12ab3"]; 2 2]
rt["esc w"; rx["\\w+";"  ab_1 "]; 2 4]
rt["esc W"; rx["\\W+";"ab, c"]; 2 2]
rt["esc s"; rx["\\s+";"ab \t\nc"]; 2 3]
rt["esc S"; rx["\\S+";"  ab  "]; 2 2]
rt["esc other"; rx["\\-\\(";"a-(b"]; 1 2]
// classes
rt["class"; rx["[abc]+";"xxcabx"]; 2 3]
rt["class range"; rx["[a-z0-9_]+";"AB c_9 D"]; 3 3]
rt["class negated"; rx["[^a-z]+";"abXY9z"]; 2 3]
rt["class shorthand"; rx["[\\d\\s]+";"ab1 2c"]; 2 3]
rt["class neg shorthand"; rx["[^\\w]+";"ab, c"]; 2 2]
rt["class nset inside"; rx["[\\D]+";"12ab3"]; 2 2]
rt["class literal ]"; rx["[]a]+";"x]a]"]; 1 3]
rt["class literal -"; rx["[a-]+";"x-a-"]; 1 3]
rt["class escaped ]"; rx["[\\]]";"a]"]; 1 1]
// anchors
rt["bol"; rx["^ab";"abab"]; 0 2]
rt["bol none"; rxTest["^b";"ab"]; 0b]
rt["eol"; rx["ab$";"abab"]; 2 2]
rt["eol none"; rxTest["a$";"ab"]; 0b]
rt["both"; rxTest["^abc$";"abc"]; 1b]
rt["both none"; rxTest["^abc$";"abcd"]; 0b]
rt["empty anchors"; rx["^$";""]; 0 0]
// groups and alternation
rt["alt"; rxAll["cat|dog";"dog cat"]; (0 3;4 3)]
rt["alt in group"; rx["a(b|cd)e";"xacde"]; 1 4]
rt["alt in group 2"; rxAll["(ab|a)c";"ac abc"]; (0 2;3 3)]
rt["non-capturing"; rxCaps["(?:ab)+(c)";"ababc"]; ("ababc";,"c")]
rt["empty alternative"; rx["a(b|)c";"ac"]; 0 2]
// quantifiers, greedy and lazy
rt["star"; rx["ab*";"abbbc"]; 0 4]
rt["star lazy"; rx["ab*?";"abbbc"]; 0 1]
rt["plus"; rx["ab+";"abbbc"]; 0 4]
rt["plus none"; rxTest["ab+";"ac"]; 0b]
rt["plus lazy"; rx["ab+?";"abbbc"]; 0 2]
rt["opt"; rx["ab?";"abb"]; 0 2]
rt["opt lazy"; rx["ab??";"abb"]; 0 1]
rt["dot star"; rx["a.*b";"aXXbYYb"]; 0 7]
rt["dot star lazy"; rx["a.*?b";"aXXbYYb"]; 0 4]
rt["exact"; rxAll["\\d{2}";"1 12 123"]; (2 2;5 2)]
rt["at least"; rx["a{2,}";"a aa aaaa"]; 2 2]
rt["at least greedy"; rxAll["a{2,}";"a aa aaaa"]; (2 2;5 4)]
rt["at least lazy"; rxAll["a{2,}?";"a aa aaaa"]; (2 2;5 2;7 2)]
rt["range"; rxAll["\\d{2,3}";"1 12 123 1234"]; (2 2;5 3;9 3)]
rt["range lazy"; rxAll["\\d{2,3}?";"1 12 123 1234"]; (2 2;5 2;9 2;11 2)]
rt["group star"; rx["(ab)*c";"xababc"]; 1 5]
rt["group star lazy"; rxCaps["(ab)*?(ab)";"abab"]; ("ab";"";"ab")]
rt["group plus"; rx["(ab)+";"xabab"]; 1 4]
rt["group opt"; rxCaps["(ab)?c";"c"]; (,"c";"")]
rt["group range"; rxAll["(ab){2,3}";"ab abab ababab abababab"]; (3 4;8 6;15 6)]
rt["group range lazy"; rx["(ab){2,3}?";"ababab"]; 0 4]
rt["group exact"; rx["(?:ab){2}";"abab"]; 0 4]
rt["backtrack"; rx["a*ab";"aaab"]; 0 4]
rt["backtrack group"; rx["(a|ab)(c|bcd)";"abcd"]; 0 4]
rt["empty loop"; rx["(a*)*b";"aaab"]; 0 4]
rt["empty loop 2"; rx["(a*)*$";"aaa"]; 0 3]
rt["literal brace"; rx["a{";"a{"]; 0 2]
rt["literal brace 2"; rx["{a";"{a"]; 0 2]
// captures
rt["caps"; rxCaps["(\\w+)@(\\w+)";"to bob@ex now"]; ("bob@ex";"bob";"ex")]
rt["caps nested"; rxCaps["((a)(b(c)))d";"xabcd"]; ("abcd";"abc";,"a";"bc";,"c")]
rt["caps unused"; rxCaps["(a)|(b)";"b"]; (,"b";"";,"b")]
rt["caps last iteration"; rxCaps["(a|b)+";"abba"]; ("abba";,"a")]
rt["caps none"; rxCaps["x";"abc"]; ()]
rt["caps no groups"; rxCaps["b+";"abbc"]; enlist "bb"]
// rxAll, rxSub, rxSplit
rt["all"; rxAll["a";"banana"]; (1 1;3 1;5 1)]
rt["all none"; rxAll["x";"banana"]; ()]
rt["all empty match"; rxAll["x*";"axb"]; (0 0;1 1;2 0;3 0)]
rt["all empty pattern"; rxAll["";"abc"]; (0 0;1 0;2 0;3 0)]
rt["all anchored"; rxAll["^a";"aaa"]; enlist 0 1]
rt["sub"; rxSub["a";"o";"banana"]; "bonono"]
rt["sub groups"; rxSub["(\\w+)@(\\w+)";"$2:$1";"bob@ex, al@io"]; "ex:bob, io:al"]
rt["sub whole"; rxSub["\\d+";"<$0>";"a1b22"]; "a<1>b<22>"]
rt["sub dollar"; rxSub["a";"$$";"aba"]; "$b$"]
rt["sub missing group"; rxSub["(a)";"$1$2";"ab"]; "ab"]
rt["sub empty match"; rxSub["x*";"-";"axb"]; "-a--b-"]
rt["sub none"; rxSub["x";"y";"abc"]; "abc"]
rt["split"; rxSplit[", *";"a, b,c"]; (,"a";,"b";,"c")]
rt["split words"; rxSplit["\\s+";"ab cd  ef"]; ("ab";"cd";"ef")]
rt["split one char pieces"; rxSplit[",";"a,b"]; (,"a";,"b")]
rt["split edges"; rxSplit["-";"-a-"]; ("";,"a";"")]
rt["split none"; rxSplit["x";"abc"]; enlist "abc"]
rt["split empty pattern"; rxSplit["";"ab"]; ("";,"a";,"b";"")]
// empty pattern, char atoms as arguments
rt["empty pattern"; rx["";"abc"]; 0 0]
rt["empty pattern empty subject"; rxTest["";""]; 1b]
rt["char atom args"; rx["a";"a"]; 0 1]
rt["empty subject"; rx["a";""]; ()]
// long inputs: a single-char quantifier counts its run, a group loop uses the explicit stack
big: 10000#"a"
rt["big class star"; rx["[a-z]*";big]; 0 10000]
rt["big class star all"; rxAll["[a-z]*";big]; (0 10000;10000 0)]
rt["big class star anchored"; rxTest["^[a-z]*$";big]; 1b]
big2: 10000#"ab"
rt["big group star"; rx["(ab)*";big2]; 0 10000]
rt["big group star caps"; rxCaps["(ab)*$";big2]; (big2;"ab")]
rt["big group plus lazy"; rx["(ab)+?$";big2]; 0 10000]
rt["big digits"; rx["\\d+";(10000#"x"),"123"]; 10000 3]
// malformed patterns
rt["err ("; err "(ab"; "regex: unbalanced ("]
rt["err ( nested"; err "a(b(c)"; "regex: unbalanced ("]
rt["err )"; err "ab)"; "regex: unbalanced )"]
rt["err ["; err "[abc"; "regex: unbalanced ["]
rt["err [ escape"; err "[a\\"; "regex: unbalanced ["]
rt["err * start"; err "*a"; "regex: nothing to repeat"]
rt["err + after ("; err "(+a)"; "regex: nothing to repeat"]
rt["err ? after |"; err "a|?"; "regex: nothing to repeat"]
rt["err double"; err "a**"; "regex: nothing to repeat"]
rt["err double lazy"; err "a*?+"; "regex: nothing to repeat"]
rt["err {n} start"; err "{2}"; "regex: nothing to repeat"]
rt["err {} unclosed"; err "a{2"; "regex: bad {}"]
rt["err {} junk"; err "a{2,x}"; "regex: bad {}"]
rt["err {} order"; err "a{3,2}"; "regex: bad {}"]
rt["err range"; err "[z-a]"; "regex: bad range"]
rt["err trailing \\"; err "ab\\"; "regex: trailing \\"]
