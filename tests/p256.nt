// ECDSA P-256 in src/neant/crypto/p256.nt: the field, the group law against published multiples of
// the base point, and every way a signature can be wrong. p256.nt is loaded on demand (it is not in
// the boot image), exactly as a program would load it. What stays in Rust (mod p256 in
// src/main.rs) is only the one thing that needs the host: the timing.
//
// The vectors are made from tests/data/pki-ec-leaf.key, which is committed, so these regenerate
// exactly — except (r,s) itself: ECDSA signing picks a random k, so re-running the signature
// command below gives a *different* pair that verifies just as well against the same key and the
// same digest. The pair pinned here is the one this machine produced.
//   printf 'neant p256 vector' > v.bin
//   openssl dgst -sha256 -binary v.bin                                   -> PVDG
//   openssl dgst -sha256 -sign tests/data/pki-ec-leaf.key -out v.sig v.bin   -> PVSIG
//   openssl ec -in tests/data/pki-ec-leaf.key -pubout -outform DER | tail -c 65   -> PVPUB
//   openssl ec -in tests/data/pki-ec-leaf.key -pubout -outform DER -conv_form compressed \
//     | tail -c 33                                                       -> PVPUBC
// (OpenSSL 3.6.2.)
tsection "p256"
{load "src/neant/crypto/",x} each ("bignum.nt";"der.nt";"p256.nt")

PVPUB:  unhex "04d80beadaa91bcac982be71619c25106a5d257a6537d2233e689e2c72e6615843873e23bee15467e76c55be95400a63d44cc891a45adbcf74785bf675ebc7da45"
PVPUBC: unhex "03d80beadaa91bcac982be71619c25106a5d257a6537d2233e689e2c72e6615843"
PVDG:   unhex "ddf5bf46337c63b4cef6f1dbfac137cb3e0a8a6e00313db0f98d3d8f9872782d"
PVSIG:  unhex "3046022100b561094b230ffe88c2f54eeb4dea56d3ddc4c0c0086ad91939a667e88be6373c022100f090ab3512ae71e1c2af3ca720f081e79bb11deb367652e23a8e5fd7e804e8b4"
PVR:    unhex "b561094b230ffe88c2f54eeb4dea56d3ddc4c0c0086ad91939a667e88be6373c"
PVS:    unhex "f090ab3512ae71e1c2af3ca720f081e79bb11deb367652e23a8e5fd7e804e8b4"
PVNB:   unhex "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"   // n
PVPB:   unhex "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff"   // p

// ---- the field. Montgomery form in, Montgomery form out, so every value is checked by going back
// through fpFrom rather than by looking at the limbs.
pvHex: {[v] hex bnBytesN[fpFrom v; 32]}
pvNum: {[h] fpTo bnFromBytes unhex h}
PM1: "ffffffff00000001000000000000000000000000fffffffffffffffffffffffe"     // p-1
pvField: (("fpTo/fpFrom round-trip"
    ; pvHex pvNum "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    ; "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
  ;("fpFrom undoes fpTo on 1"; pvHex FP1; (63#"0"),"1")
  ;("the stored form of 1 really is R mod p"; hex bnBytesN[FP1;32]
    ; "0000000fffffffeffffffffffffffffffffffff0000000000000000000000010")
  ;("fpAdd wraps at p"; pvHex fpAdd[pvNum PM1; FP1]; 64#"0")
  ;("fpSub borrows p"; pvHex fpSub[FP0; FP1]; PM1)
  ;("fpAdd of p-1 and p-1"; pvHex fpAdd[pvNum PM1; pvNum PM1]
    ; "ffffffff00000001000000000000000000000000fffffffffffffffffffffffd")
  ;("fpInv is the inverse"; pvHex fpMul[pvNum "07"; fpInv pvNum "07"]; pvHex FP1)
  ;("fpInv of 1 is 1"; pvHex fpInv FP1; pvHex FP1))
{[t] teq["field: ",t[0]; t[1]; t[2]]} each pvField

// ---- the group. The doubles of G below are FIPS 186-4's own; they also fall straight out of
//   python3 -c "..."  with a textbook affine ladder, which is how they were cross-checked here.
pvAff: {[P] a: p256ToAffine P; $[0=count a; "infinity"; (pvHex a[0]),"/",pvHex a[1]]}
PVG: (P256G[0]; P256G[1]; FP1)
PVGB: 0x04, (bnBytesN[fpFrom P256G[0];32]), bnBytesN[fpFrom P256G[1];32]   // G as SEC 1 bytes
teq["G is on the curve"; 0 < count p256Point PVGB; 1b]
PV2G: "7cf27b188d034f7e8a52380304b51ac3c08969e277f21b35a60b48fc47669978/07775510db8ed040293d9ac69f7430dbba7dade63ce982299e04b79d227873d1"
PV3G: "5ecbe4d1a6330a44c8f7ef951d4bf165e6c6b721efada985fb41661bc6e7fd6c/8734640c4998ff7e374b06ce1a64a2ecd82ab036384fb83d9a79b127a27d5032"
teq["2G, by doubling"; pvAff p256Dbl PVG; PV2G]
// the addition law has to agree with the doubling on equal points, which is exactly the degenerate
// case madd-2007-bl cannot compute and p256MAdd hands to p256Dbl instead
teq["G+G is 2G"; pvAff p256MAdd[PVG; P256G]; PV2G]
teq["3G"; pvAff p256MAdd[p256Dbl PVG; P256G]; PV3G]
teq["G + (-G) is the point at infinity"; pvAff p256MAdd[PVG; (P256G[0]; fpSub[FP0; P256G[1]])]; "infinity"]
teq["doubling the point at infinity leaves it there"; pvAff p256Dbl P256INF; "infinity"]
teq["infinity + G is G"; pvAff p256MAdd[P256INF; P256G]; pvAff PVG]
// nG = infinity is the one assertion that says the base point really has the order the standard
// claims, and so that every scalar below was reduced against the right n
pvMulG: {[k] p256Shamir[p256Bits k; P256G; p256Bits BNZERO; P256G]}
teq["1G"; pvAff pvMulG bnFromBytes 0x01; pvAff PVG]
teq["2G, through the ladder"; pvAff pvMulG bnFromBytes 0x02; pvAff p256Dbl PVG]
teq["nG is the point at infinity"; pvAff pvMulG P256N; "infinity"]
PVNEGG: (pvHex P256G[0]),"/",pvHex fpSub[FP0; P256G[1]]
teq["(n-1)G is -G"; pvAff pvMulG bnSub[P256N; ,1]; PVNEGG]

// ---- the point encoding. Anything that is not the 65-octet uncompressed SEC 1 form is not a key.
teq["a real point parses"; 0 < count p256Point PVPUB; 1b]
pvBadPts: (("a compressed point, which this build refuses"; PVPUBC)
  ;("the point at infinity's encoding"; 0x00)
  ;("64 bytes with the 0x04 left off"; 1_PVPUB)
  ;("one byte too many"; PVPUB,0x00)
  ;("a hybrid 0x06 prefix"; 0x06, 1_PVPUB)
  ;("y off the curve by one bit"; (64#PVPUB), bnot PVPUB[64])
  ;("x at p, which is not a canonical coordinate"; (0x04, PVPB), 32#PVPUB[33+til 32])
  ;("y at p"; (0x04, 32#PVPUB[1+til 32]), PVPB)
  ;("all zeroes: (0,0) is not on this curve"; 0x04, 64#0x00))
{[t] teq["point: ",t[0]; count p256Point t[1]; 0]} each pvBadPts

// ---- the signature itself
teq["the openssl vector verifies"; ecdsaVerifyP256[PVPUB; PVDG; PVR; PVS]; 1b]
teq["and through its DER"; ecdsaVerifyP256Der[PVPUB; PVDG; PVSIG]; 1b]
// ECDSA IS MALLEABLE and this is NOT a bug: (r, n-s) is a second, genuinely valid signature by the
// same key over the same message, because negating s negates u1 and u2 and so negates R, whose x is
// unchanged. A verifier's question is "did this key sign this message", and the answer is still
// yes; anything that needs a signature to be a unique token has to say so itself, and a certificate
// and a CertificateVerify do not. Asserting 0b here would be asserting a bug.
PVNS: bnBytes bnSub[bnFromBytes PVNB; bnFromBytes PVS]                      // n - s
teq["(r, n-s) is a second valid signature and must verify"; ecdsaVerifyP256[PVPUB; PVDG; PVR; PVNS]; 1b]

// ---- the final comparison, which is the single most likely thing to be wrong in a from-scratch
// ECDSA verifier: the test is (R.x mod n) = r, with R.x a value mod p and r a value mod n. For
// P-256 p - n is only 0x4319055358e8617b0c46353d039cdaae, 127 bits against a 256-bit field, so a
// signature whose R.x actually reaches n turns up about once in 2^129 — which means every vector
// openssl will ever hand you has R.x < n already and a verifier that drops the reduction passes
// all of them. The vector below is built rather than sampled, by tests/data/p256-rx-ge-n.py, which
// picks a curve point with x >= n and then solves for the key and the signature that recover it.
// Checked against a deliberately broken copy of p256Verify with the bnMod taken out: it answers 1b
// to the openssl vector above and 0b to this one, so this case really is the one that catches it.
// (r has sixteen leading zero bytes because r = R.x - n is below p - n, and always will be.)
PVXPUB: unhex "04425419302e392f41daff51b5a643e7b559ab10c0cd6269f2d33be4d7db886a9cb72831ebd815e82ea0113f630b74e1ed81abf8fef4c39b10e09f3f7a716dfdc6"
PVXDG:  unhex "dfca759ec6b364a9562d2161635fe2dcc5c0b31dac75bc845b9f0de61d54af2d"
PVXR:   unhex "000000000000000000000000000000002b3e964a5562b92cbe850cd3e43f7cf3"
PVXS:   unhex "5edb82e2616d6cfb93e03cda4fecce3da94951f5ed1a8704a352a1733ed008c9"
PVXRX:  unhex "ffffffff00000000ffffffffffffffffe82590f7fc7a57b1b23ed796e0a2a244"   // R.x itself
teq["R.x >= n: the reduction is done, so it verifies"; ecdsaVerifyP256[PVXPUB; PVXDG; PVXR; PVXS]; 1b]
// and the other half of the same mistake: R.x itself is not a legal r, because it is >= n. A
// verifier that dropped the reduction AND the range check would take this one instead.
teq["R.x >= n: R.x itself is out of range for an r"; ecdsaVerifyP256[PVXPUB; PVXDG; PVXRX; PVXS]; 0b]
teq["R.x >= n: and it is genuinely a different number from r"; PVXR ~ PVXRX; 0b]

// ---- and every way it can be wrong. r and s out of [1, n-1] first: each of these is a forgery
// against a verifier that skips the range check, because s = 0 makes s^-1 meaningless and r = 0
// takes the public key out of the equation entirely.
pvBadSig: (("r = 0"; 0x00; PVS)
  ;("s = 0"; PVR; 0x00)
  ;("r empty"; 0x; PVS)
  ;("s empty"; PVR; 0x)
  ;("r = n"; PVNB; PVS)
  ;("s = n"; PVR; PVNB)
  ;("r = n+1"; bnBytes bnAdd[bnFromBytes PVNB; ,1]; PVS)
  ;("s = n+1"; PVR; bnBytes bnAdd[bnFromBytes PVNB; ,1])
  ;("r and s swapped"; PVS; PVR)
  ;("a flipped bit in r"; (31#PVR), bnot PVR[31]; PVS)
  ;("a flipped bit in s"; PVR; (31#PVS), bnot PVS[31]))
{[t] teq["sig: ",t[0]; ecdsaVerifyP256[PVPUB; PVDG; t[1]; t[2]]; 0b]} each pvBadSig
teq["sig: a flipped digest bit"; ecdsaVerifyP256[PVPUB; (31#PVDG), bnot PVDG[31]; PVR; PVS]; 0b]
teq["sig: a 31-byte digest"; ecdsaVerifyP256[PVPUB; 31#PVDG; PVR; PVS]; 0b]
teq["sig: a 33-byte digest"; ecdsaVerifyP256[PVPUB; PVDG,0x00; PVR; PVS]; 0b]
teq["sig: an empty digest"; ecdsaVerifyP256[PVPUB; 0x; PVR; PVS]; 0b]
teq["sig: a key that is not on the curve"; ecdsaVerifyP256[(64#PVPUB), bnot PVPUB[64]; PVDG; PVR; PVS]; 0b]
teq["sig: a compressed key"; ecdsaVerifyP256[PVPUBC; PVDG; PVR; PVS]; 0b]
teq["sig: the wrong key, G itself"; ecdsaVerifyP256[PVGB; PVDG; PVR; PVS]; 0b]

// ---- the DER wrapper. der.nt is what is strict here; these check that ecdsaVerifyP256Der really
// goes through it and really turns its signals into an answer of no rather than letting them out.
pvInt: {[m] b: $[127 < `int$ m[0]; 0x00,m; m]; 0x02, (`byte$ count b), b}
pvSeq: {[b] 0x30, (`byte$ count b), b}
pvBadDer: (("truncated in the middle of s"; (-1)_PVSIG)
  ;("truncated to nothing"; 0x)
  ;("one byte after the SEQUENCE"; PVSIG,0x00)
  ;("a length that claims more than is there"; (0x30, 0x7f), 2_PVSIG)
  ;("a non-minimal INTEGER: a second 0x00 that is not needed"
    ; pvSeq (0x02, (`byte$ 2+count PVR), 0x0000, PVR), pvInt PVS)
  ;("r encoded as a negative INTEGER"; pvSeq (0x02, (`byte$ count PVR), PVR), pvInt PVS)
  ;("three INTEGERs"; pvSeq (pvInt PVR), (pvInt PVS), pvInt PVR)
  ;("one INTEGER"; pvSeq pvInt PVR)
  ;("a SET where the SEQUENCE should be"; 0x31, 1_PVSIG)
  ;("an OCTET STRING holding the two INTEGERs"; 0x04, 1_PVSIG)
  ;("an indefinite length, which is BER and not DER"; (0x30, 0x80), 2_PVSIG))
{[t] teq["der: ",t[0]; ecdsaVerifyP256Der[PVPUB; PVDG; t[1]]; 0b]} each pvBadDer
// the same bytes rebuilt by hand still verify, so the cases above fail for the reason they name
teq["der: rebuilt by hand, it still verifies"; ecdsaVerifyP256Der[PVPUB; PVDG; pvSeq (pvInt PVR), pvInt PVS]; 1b]
