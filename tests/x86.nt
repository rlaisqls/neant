// src/neant/jit/x86.nt: the x86-64 backend for both JIT tiers. This machine is AArch64, so
// **nothing here executes a single byte the backend emits** — see docs/compiler.md "Stage 2"'s x86-64
// subsection for what that does and does not leave proven. What these tests can check, and do:
//
//   - every instruction encoder, byte for byte, against `nasm`'s own output for the same
//     mnemonic and operands (see the section comment below for the exact command);
//   - the two-pass branch resolution, by computing where a displacement has to land from the
//     encoders' own lengths and reading the four bytes that were patched in;
//   - that the compilability walk still says the same thing it says for AArch64 — the two
//     backends share it (jitClassifySlots, jitLocalSlots, jitDyadKind, jitTraceTouched, ...), so
//     every accept and every reject is asserted against `jitCompile`/`jitCompileTrace` on the
//     same input rather than against a hardcoded expectation;
//   - that the same input twice gives byte-identical output.
//
// Loaded unconditionally: the file is a boot file, but recompiling it from source here also keeps
// this suite runnable before it is wired into the image.
load "src/neant/jit/x86.nt"

// This file reports on its own only when nothing else has run before it (a direct
// `./target/release/neant tests/x86.nt`); inside tests/run.nt the run's own treport covers it.
xjAlone: 0=tpass

// A hex string per byte, joined: `hex` itself prints a one-element Bytes vector as ",0x53".
xjH: {[bs] raze {2_string x} each `byte$bs}
// A signed 32-bit little-endian field, as the patched displacement it is.
xjRel: {[bs;off]
  v: 0 {(256*x)+y}/ `int$ reverse bs[off+til 4]
  $[v>2147483647; v-4294967296; v]}

// A lambda's source -> the `(opcodes;args;consts;arity;nlocals)` src/jit.rs hands the codegen.
// The front end already produces exactly this (`compileFn`, src/neant/core/compile.nt); only the
// const table needs the same translation `load_const` (src/prims.rs) does at run time, which for
// the compilable subset means a verb entry becoming the primitive value itself. A global entry
// becomes a slot number, and any slot will do here — the walk only checks that it is an int.
xjPrim: {[c] exec (`int$0 16; `int$0 0; enlist (`p;c); `int$0 0)}
xjConst: {[e] t: e[0]; $[t=`k; e[1]; t=`p; xjPrim e[1]; 0]}
xjIn: {[src]
  u: first ncompile src
  c: (u[2][0])[1]
  arity: count c[4]
  nl: $[(c[5])<arity; arity; c[5]]
  (`int$c[0]; `int$c[1]; xjConst each c[2]; arity; nl)}
// Stand-in trampoline addresses: the codegen only ever loads them as constants.
xjTramp: 1000 2000 3000
xjX: {[src] jitCompileX86[xjIn src; xjTramp]}
xjA: {[src] jitCompile[xjIn src; xjTramp]}

tsection "x86: instruction encoders against nasm"
// Every expectation below is `nasm -f bin` output for the same instruction, read out of a listing:
//   printf 'BITS 64\nmov rsi,[rbx+0x1234]\n' > /tmp/x.asm
//   nasm -f bin -l /tmp/x.lst -o /tmp/x.bin /tmp/x.asm && cat /tmp/x.lst
// The memory and immediate forms are checked with a displacement of 0x1234 because nasm shortens
// anything that fits in a byte and this backend deliberately does not (see x86.nt's header): the
// form is what is being pinned, and the four displacement bytes are pinned by the branch tests.
teq["mov rax, imm64"; xjH jitxMovRI[0;jitW 0x1122334455667788]; "48b88877665544332211"]
teq["mov rbp, -1"; xjH jitxMovRI[5;-1]; "48bdffffffffffffffff"]
teq["mov r13, the int-null sentinel"; xjH jitxMovRI[13;0N]; "49bd0000000000000080"]
teq["mov r15, 1"; xjH jitxMovRI[15;1]; "49bf0100000000000000"]
teq["mov rbx, rdi"; xjH jitxMovRR[3;7]; "4889fb"]
teq["mov r13, rsi"; xjH jitxMovRR[13;6]; "4989f5"]
teq["mov rax, r11"; xjH jitxMovRR[0;11]; "4c89d8"]
teq["mov rsi, [rbx+disp32]"; xjH jitxLoad[6;3;jitW 0x1234]; "488bb334120000"]
teq["mov rcx, [rsp+disp32] (SIB)"; xjH jitxLoad[1;4;jitW 0x1234]; "488b8c2434120000"]
teq["mov r9, [r13+disp32]"; xjH jitxLoad[9;13;jitW 0x1234]; "4d8b8d34120000"]
teq["mov r10, [r12+disp32] (SIB)"; xjH jitxLoad[10;12;jitW 0x1234]; "4d8b942434120000"]
teq["mov [rbx+disp32], rsi"; xjH jitxStore[3;jitW 0x1234;6]; "4889b334120000"]
teq["mov [rsp+disp32], r11 (SIB)"; xjH jitxStore[4;jitW 0x1234;11]; "4c899c2434120000"]
teq["add rsi, rdi"; xjH jitxAddRR[6;7]; "4801fe"]
teq["sub rsi, r11"; xjH jitxSubRR[6;11]; "4c29de"]
teq["imul rsi, rdi"; xjH jitxImulRR[6;7]; "480faff7"]
teq["and rsi, rax"; xjH jitxAndRR[6;0]; "4821c6"]
teq["or r11, r12"; xjH jitxOrRR[11;12]; "4d09e3"]
teq["cmp r8, rbp"; xjH jitxCmpRR[8;5]; "4939e8"]
teq["test rcx, rcx"; xjH jitxTestRR[1;1]; "4885c9"]
teq["cmp rsi, 0"; xjH jitxCmpRI8[6;0]; "4883fe00"]
teq["sub r11, 1"; xjH jitxSubRI8[11;1]; "4983eb01"]
teq["sub rsp, imm32"; xjH jitxSubSP[jitW 0x1234]; "4881ec34120000"]
teq["add rsp, imm32"; xjH jitxAddSP[jitW 0x1234]; "4881c434120000"]
teq["lea r9, [rsp+disp32]"; xjH jitxLeaSP[9;jitW 0x1234]; "4c8d8c2434120000"]
teq["setl sil (REX for the low byte)"; xjH jitxSetcc[jitxCcL;6]; "400f9cc6"]
teq["setl al (no REX below register 4)"; xjH jitxSetcc[jitxCcL;0]; "0f9cc0"]
teq["setnp al"; xjH jitxSetcc[jitxCcNP;0]; "0f9bc0"]
teq["setg sil"; xjH jitxSetcc[jitxCcG;6]; "400f9fc6"]
teq["sete sil"; xjH jitxSetcc[jitxCcE;6]; "400f94c6"]
teq["seta sil"; xjH jitxSetcc[jitxCcA;6]; "400f97c6"]
teq["setle r11b"; xjH jitxSetcc[jitxCcLE;11]; "410f9ec3"]
teq["movzx rsi, sil"; xjH jitxMovzx[6;6]; "480fb6f6"]
teq["movzx r8, r8b"; xjH jitxMovzx[8;8]; "4d0fb6c0"]
teq["cmovl rsi, rdi"; xjH jitxCmovcc[jitxCcL;6;7]; "480f4cf7"]
teq["cmovg rax, r15"; xjH jitxCmovcc[jitxCcG;0;15]; "490f4fc7"]
teq["jmp rel32"; xjH jitxJmp[]; "e900000000"]
teq["je rel32"; xjH jitxJcc jitxCcE; "0f8400000000"]
teq["jne rel32"; xjH jitxJcc jitxCcNE; "0f8500000000"]
teq["jle rel32"; xjH jitxJcc jitxCcLE; "0f8e00000000"]
teq["jg rel32"; xjH jitxJcc jitxCcG; "0f8f00000000"]
teq["call rax"; xjH jitxCallR 0; "ffd0"]
teq["call r11"; xjH jitxCallR 11; "41ffd3"]
teq["push rbx"; xjH jitxPush 3; "53"]
teq["push r12"; xjH jitxPush 12; "4154"]
teq["pop rbp"; xjH jitxPop 5; "5d"]
teq["pop r15"; xjH jitxPop 15; "415f"]
teq["ret"; xjH jitxRet[]; "c3"]
teq["movsd xmm8, xmm9"; xjH jitxMovsdRR[8;9]; "f2450f10c1"]
teq["movsd xmm3, xmm3 (no REX)"; xjH jitxMovsdRR[3;3]; "f20f10db"]
teq["movsd xmm0, xmm13"; xjH jitxMovsdRR[0;13]; "f2410f10c5"]
teq["addsd xmm0, xmm7"; xjH jitxAddsd[0;7]; "f20f58c7"]
teq["addsd xmm8, xmm9"; xjH jitxAddsd[8;9]; "f2450f58c1"]
teq["subsd xmm2, xmm13"; xjH jitxSubsd[2;13]; "f2410f5cd5"]
teq["mulsd xmm1, xmm0"; xjH jitxMulsd[1;0]; "f20f59c8"]
teq["divsd xmm8, xmm9"; xjH jitxDivsd[8;9]; "f2450f5ec1"]
teq["ucomisd xmm8, xmm9"; xjH jitxUcomisd[8;9]; "66450f2ec1"]
teq["ucomisd xmm0, xmm13"; xjH jitxUcomisd[0;13]; "66410f2ec5"]
teq["movsd xmm13, [rsp+disp32]"; xjH jitxMovsdLoad[13;4;jitW 0x1234]; "f2440f10ac2434120000"]
teq["movsd xmm0, [rdi+disp32]"; xjH jitxMovsdLoad[0;7;jitW 0x1234]; "f20f108734120000"]
teq["movsd [rdi+disp32], xmm8"; xjH jitxMovsdStore[7;jitW 0x1234;8]; "f2440f118734120000"]
teq["movsd [rsp+disp32], xmm13"; xjH jitxMovsdStore[4;jitW 0x1234;13]; "f2440f11ac2434120000"]
teq["movq xmm8, rax"; xjH jitxMovqXR[8;0]; "664c0f6ec0"]
teq["movq xmm13, r11"; xjH jitxMovqXR[13;11]; "664d0f6eeb"]
teq["movq rax, xmm8"; xjH jitxMovqRX[0;8]; "664c0f7ec0"]
teq["movq r11, xmm0"; xjH jitxMovqRX[11;0]; "66490f7ec3"]

tsection "x86: little-endian fields and the patch pass"
teq["LE32"; jitxLE32 jitW 0x12345678; 120 86 52 18]
teq["LE32 of a negative"; jitxLE32[-2]; 254 255 255 255]
teq["LE64 of the int-null sentinel"; jitxLE64 0N; 0 0 0 0 0 0 0 128]
// A displacement is measured from the end of its own instruction: a `jmp` whose 4-byte field sits
// at offset 1 and whose target is byte 20 must hold 20-(1+4) = 15.
teq["patch a forward displacement"; xjH jitxPatch32[jitxJmp[];1;20]; "e90f000000"]
teq["patch a backward displacement"; xjH jitxPatch32[jitxJmp[];1;0]; "e9fbffffff"]

tsection "x86: the whole-function tier compiles what the walk accepts"
// One per shape the subset covers; the agreement section below then pins each of these against
// what the AArch64 backend says about the same input.
tok["arithmetic"; not null~xjX "{[x] x+1}"]
tok["multiply and compare"; not null~xjX "{[x;y] (x*y)<(x+y)}"]
tok["min, max and equals"; not null~xjX "{[x;y] (x&y)|(x=y)}"]
tok["a while loop"; not null~xjX "{[x;y] while[x<y; x: x+1]; x}"]
tok["a do loop"; not null~xjX "{[n] s: 0; do[n; s: s+2]; s}"]
tok["nested do loops"; not null~xjX "{[n] s: 0; do[n; do[n; s: s+1]]; s}"]
tok["an if"; not null~xjX "{[x] $[x<1; 0; x-1]}"]
tok["a recursive call"; not null~xjX "{[x] $[x<1; 0; 1+hh[x-1]]}"]
tok["a two-argument call"; not null~xjX "{[x;y] hh[x;y]}"]
tok["more locals than registers"; not null~xjX "{[a;b;c;d;e;f] ((((a+b)+c)+d)+e)+f}"]
teq["a vector read classifies its slot"; (xjX "{[v;i] v[i]}")[1]; `int$enlist 0]
teq["a vector write classifies its slot"; (xjX "{[v;i] v[i]: 7; i}")[1]; `int$enlist 0]
teq["no vector slot when there is no indexing"; (xjX "{[x] x+1}")[1]; ()]

tsection "x86: the whole-function tier rejects what the walk rejects"
tok["a float"; null~xjX "{[x] x+1.0}"]
tok["a float constant alone"; null~xjX "{[x] 1.5}"]
tok["a division"; null~xjX "{[x] x%2}"]
tok["a global read"; null~xjX "{[x] x+gg}"]
tok["a closure"; null~xjX "{[x] {[y] x+y}}"]
tok["a monadic verb"; null~xjX "{[x] - x}"]
// `count x` is a *global* applied to one argument, which is the shape a compiled call takes: what
// the callee actually turns out to hold — a primitive here, so not compilable — is `jit_call`'s
// run-time check (src/jit.rs), not the walk's, and that call deopts. So this one is accepted, and
// the agreement section below pins that it is accepted on both backends.
tok["a call to a global that holds a primitive is a run-time deopt, not a reject"; not null~xjX "{[x] 1+count x}"]
tok["a list"; null~xjX "{[x] (x;x)}"]
// A call is only ever compiled as a plain one- or two-argument application of a global, which is
// what src/jit.rs's `jit_call` can prove pure at run time; three arguments is not that shape.
tok["an arity the call path cannot take"; null~xjX "{[x] hh[1;2;3]}"]
tok["an operand stack deeper than jitMAXDEPTH"; null~xjX "{[x] ((((((((x+x)+x)+x)+x)+x)+x)+x)+x)}"]
tok["a vector slot also used as a plain int"; null~xjX "{[v;i] v[i]: 7; v}"]
tok["the int-null constant"; null~xjX "{[x] 0N+x}"]
// Not reachable from source (the front end never allocates a slot this high), so it goes in as
// bytecode directly: `LoadL 5000`, whose displacement the shared walk refuses.
tok["a local slot past the walk's limit"; null~jitCompileX86[(`int$3 16; `int$5000 0; (); 1; 1); xjTramp]]

tsection "x86: both backends accept and reject exactly the same functions"
// The compilability walk is arm64.nt's, called from x86.nt rather than copied, and this is what
// says so: one assertion per source, over every shape above.
xjSrcs: ()
xjSrcs,: enlist "{[x] x+1}"
xjSrcs,: enlist "{[x;y] (x*y)<(x+y)}"
xjSrcs,: enlist "{[x;y] (x&y)|(x=y)}"
xjSrcs,: enlist "{[x;y] while[x<y; x: x+1]; x}"
xjSrcs,: enlist "{[n] s: 0; do[n; s: s+2]; s}"
xjSrcs,: enlist "{[n] s: 0; do[n; do[n; s: s+1]]; s}"
xjSrcs,: enlist "{[x] $[x<1; 0; x-1]}"
xjSrcs,: enlist "{[x] $[x<1; 0; 1+hh[x-1]]}"
xjSrcs,: enlist "{[x;y] hh[x;y]}"
xjSrcs,: enlist "{[a;b;c;d;e;f] ((((a+b)+c)+d)+e)+f}"
xjSrcs,: enlist "{[v;i] v[i]}"
xjSrcs,: enlist "{[v;i] v[i]: 7; i}"
xjSrcs,: enlist "{[v;i;n] j: 0; while[j<n; v[j]: (v[j])+1; j: j+1]; j}"
xjSrcs,: enlist "{[x] x+1.0}"
xjSrcs,: enlist "{[x] 1.5}"
xjSrcs,: enlist "{[x] x%2}"
xjSrcs,: enlist "{[x] x+gg}"
xjSrcs,: enlist "{[x] {[y] x+y}}"
xjSrcs,: enlist "{[x] - x}"
xjSrcs,: enlist "{[x] 1+count x}"
xjSrcs,: enlist "{[x] (x;x)}"
xjSrcs,: enlist "{[x] hh[1;2;3]}"
xjSrcs,: enlist "{[x] ((((((((x+x)+x)+x)+x)+x)+x)+x)+x)}"
xjSrcs,: enlist "{[x] 0N+x}"
xjAgree: 1b
xjSame: 1b
xjI: 0
while[xjI<count xjSrcs
  xjQ: xjIn xjSrcs[xjI]
  xjAr: jitCompile[xjQ;xjTramp]
  xjXr: jitCompileX86[xjQ;xjTramp]
  if[not (null~xjAr)=null~xjXr; xjAgree: 0b; print "  disagreed on ",xjSrcs[xjI]]
  if[not (null~xjAr)|(null~xjXr); if[not (xjAr[1])~xjXr[1]; xjSame: 0b]]
  xjI: xjI+1]
tok["every source: the same verdict as the AArch64 backend"; xjAgree]
tok["every source: the same classified vector slots"; xjSame]
// The one shape the two deliberately part company on: a function that *returns* the vector it
// filled is AArch64-only (see "the vector a compiled function leaves behind" in arm64.nt), so the
// x86-64 walk meets a classified slot where it expects an index and refuses the whole function —
// fail-closed, as every disagreement here has to be. Giving x86-64 the same shape needs the
// inlined vector access first; until then this stays a one-sided accept.
xjVecRet: "{[v;i] v[i]: 7; v}"
tok["a vector return compiles on AArch64"; not null~xjA xjVecRet]
tok["a vector return is refused on x86-64"; null~xjX xjVecRet]

tsection "x86: the same input twice is byte-identical"
xjTwice: {[src] (first xjX src)~first xjX src}
tok["arithmetic"; xjTwice "{[x] x+1}"]
tok["a while loop"; xjTwice "{[x;y] while[x<y; x: x+1]; x}"]
tok["a call"; xjTwice "{[x;y] hh[x;y]}"]
tok["vector indexing"; xjTwice "{[v;i;n] j: 0; while[j<n; v[j]: (v[j])+1; j: j+1]; j}"]

tsection "x86: two-pass branch resolution lands the displacement"
// Both offsets below are derived from the encoders' own lengths, not measured from a dump, so a
// change in any of them moves the expectation with the code. The prologue is six pushes, the frame,
// the three incoming pointers and the sentinel; these two inputs touch no local, so it ends there.
xjPro: ((count raze jitxPush each jitxSAVED)+(count jitxSubSP jitxFRAME))+((3*count jitxMovRR[3;7])+(count jitxMovRI[5;0N]))
// `Push 5; Jmp 2` — the jump's target is the op after the last one, which is exactly where the
// trailing return lands, so the displacement is zero and the `jmp` falls through to it.
xjFwd: first jitCompileX86[(`int$0 9; `int$0 2; enlist 5; 1; 1); xjTramp]
teq["a forward jump to the next instruction"; xjH xjFwd[(xjPro+10)+til 5]; "e900000000"]
// `Push 5; Push 5; Pop; Jmp 1` — back to the second push, 15 bytes above the end of the `jmp`.
xjBwd: first jitCompileX86[(`int$0 0 11 9; `int$0 0 0 1; enlist 5; 1; 1); xjTramp]
teq["a backward jump over two instructions"; xjH xjBwd[(xjPro+20)+til 5]; "e9f1ffffff"]
// A deopt branch, which is patched from the other list: the `je` after `cmp dst, rbp` has to reach
// past the function's whole return sequence to the deopt block, which is the same sequence without
// the `mov rax, <result>`.
xjRet: (((count jitxMovRR[0;6])+(count jitxMovRI[1;1]))+((count jitxStore[13;0;1])+(count jitxAddSP jitxFRAME)))+((count raze jitxPop each jitxSAVED)+(count jitxRet[]))
xjDp: xjRet-(count jitxMovRR[0;6])
xjAdd: first xjX "{[x] x+1}"
xjJe: (count xjAdd)-((xjDp+xjRet)+4)
teq["the deopt branch is a je"; xjH xjAdd[(xjJe-2)+til 2]; "0f84"]
teq["the deopt branch reaches the deopt block"; xjRel[xjAdd;xjJe]; xjRet]
teq["a compiled function opens with the six callee-saved pushes"; xjH xjAdd[til 10]; "53554154415541564157"]
teq["and closes with the matching pops"; xjH xjAdd[((count xjAdd)-11)+til 11]; "415f415e415d415c5d5bc3"]

tsection "x86: the tracing tier"
// Real recorded traces, not hand-built ones: `jitCompileTrace` is what src/jit.rs calls with a
// trace, so wrapping it captures exactly the input the x86-64 tier would be handed for the same
// loop. The wrapper delegates, so the AArch64 trace is still compiled and run as usual, and it is
// put back before the first assertion below.
xjCapOrig: jitCompileTrace
xjCap: ()
jitCompileTrace:: {[i] xjCap:: xjCap,enlist i; xjCapOrig i}
xjLwhile: {[n] i: 0; s: 0; while[i<n; s: s+i; i: i+1]; s}
xjLdo: {[n] s: 0; do[n; s: s+2]; s}
xjLnest: {[n] s: 0; do[n; do[3; s: s+1]]; s}
xjLif: {[n] i: 0; s: 0; while[i<n; if[i<50; s: s+1]; i: i+1]; s}
xjDbl: {[a] a*2}
xjLcall: {[n] i: 0; s: 0; while[i<n; s: s+xjDbl i; i: i+1]; s}
xjSgn: {[a] $[a<3; a; 0-a]}
xjLrewind: {[n] i: 0; s: 0; while[i<n; s: s+xjSgn i; i: i+1]; s}
xjLfloat: {[n] i: 0; s: 0.0; while[i<n; s: s+1.5; i: i+1]; s}
xjLfcmp: {[n] i: 0; s: 1.0; t: 0.0; while[i<n; t: s*2.0; if[t<9.0; s: s+1.0]; i: i+1]; s}
xjLfmin: {[n] i: 0; s: 1.0; while[i<n; s: s&2.0; i: i+1]; s}
xjLwide: {[n] a: 0; b: 0; c: 0; d: 0; e: 0; g: 0; i: 0; while[i<n; a: a+1; b: b+2; c: c+3; d: d+4; e: e+5; g: g+6; i: i+1]; a+g}
// 200 iterations is well past the 64 a header needs to go hot, and each loop records once.
xjOne: {[f] xjCap:: (); f 200; $[1=count xjCap; first xjCap; null]}
// A `do` nested in a `do` makes two hot headers, so that one records two traces — the inner loop's
// and, once it has been through enough iterations, the outer's. Both have to compile.
xjTwo: {[f] xjCap:: (); f 200; $[2=count xjCap; xjCap; null]}
xjTwhile: xjOne xjLwhile
xjTdo: xjOne xjLdo
xjNest: xjTwo xjLnest
xjTif: xjOne xjLif
xjTcall: xjOne xjLcall
xjTrewind: xjOne xjLrewind
xjTfloat: xjOne xjLfloat
xjTfcmp: xjOne xjLfcmp
xjTfmin: xjOne xjLfmin
xjTwide: xjOne xjLwide
jitCompileTrace:: xjCapOrig

tok["a while loop recorded one trace"; not null~xjTwhile]
tok["a do loop recorded one trace"; not null~xjTdo]
tok["nested do loops recorded two traces"; not null~xjNest]
tok["a loop with an if recorded one trace"; not null~xjTif]
tok["a loop with a call recorded one trace"; not null~xjTcall]
tok["a loop with a branching callee recorded one trace"; not null~xjTrewind]
tok["a float loop recorded one trace"; not null~xjTfloat]
tok["a float comparison recorded one trace"; not null~xjTfcmp]
tok["a float min recorded one trace"; not null~xjTfmin]
tok["a wide loop recorded one trace"; not null~xjTwide]

// For a trace that compiles, everything src/jit.rs reads back — the touched slots, their types,
// where the stack area starts and the whole exits table — has to be what the AArch64 backend
// decides for the same input: it is the same walk, and the buffer layout is the contract with the
// other half of the JIT.
xjTraceOk: {[name;t]
  if[null~t; :tok[name," was recorded"; 0b]]
  b: jitCompileTraceX86 t
  a: jitCompileTrace t
  tok[name," compiles"; not null~b]
  if[null~b; :0b]
