// stdlib tests: ./target/release/neant tests/run.nt   exits with the failure count
// There is no directory listing builtin, so every test file is loaded by name.
load "tests/lang.nt"
load "tests/prelude.nt"
load "tests/stdlib2.nt"
load "tests/json.nt"
load "tests/table.nt"
load "tests/table2.nt"
load "tests/regex.nt"
ntFailures: treport[]
// exit ends the whole process, so the cargo test (nt_tests in src/main.rs) sets ntExit: 0b and reads the count as this file's value
if[@[{[x] ntExit};0;{1b}]; exit ntFailures]
ntFailures
