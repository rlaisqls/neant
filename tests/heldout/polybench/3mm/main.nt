// PolyBench/C 4.2.1 linear-algebra/kernels/3mm: G := (A·B)·(C·D).
// Arguments: ni nj nk nl nm.

use "std/text.nt";

fn init_array(ni: i64, nj: i64, nk: i64, nl: i64, nm: i64, a: &mut [f64], b: &mut [f64], c: &mut [f64], d: &mut [f64]) {
    for i in 0..ni {
        for j in 0..nk {
            a[i * nk + j] = ((i * j + 1) % ni) as f64 / (5 * ni) as f64;
        }
    }
    for i in 0..nk {
        for j in 0..nj {
            b[i * nj + j] = ((i * (j + 1) + 2) % nj) as f64 / (5 * nj) as f64;
        }
    }
    for i in 0..nj {
        for j in 0..nm {
            c[i * nm + j] = (i * (j + 3) % nl) as f64 / (5 * nl) as f64;
        }
    }
    for i in 0..nm {
        for j in 0..nl {
            d[i * nl + j] = ((i * (j + 2) + 2) % nk) as f64 / (5 * nk) as f64;
        }
    }
}

fn print_array(g: &[f64]) {
    println(g.iter().sum());
}

fn kernel_3mm(ni: i64, nj: i64, nk: i64, nl: i64, nm: i64, e: &mut [f64], a: &[f64], b: &[f64], f: &mut [f64], c: &[f64], d: &[f64], g: &mut [f64]) {
    for i in 0..ni {
        for j in 0..nj {
            e[i * nj + j] = 0.0;
            for k in 0..nk {
                e[i * nj + j] += a[i * nk + k] * b[k * nj + j];
            }
        }
    }
    for i in 0..nj {
        for j in 0..nl {
            f[i * nl + j] = 0.0;
            for k in 0..nm {
                f[i * nl + j] += c[i * nm + k] * d[k * nl + j];
            }
        }
    }
    for i in 0..ni {
        for j in 0..nl {
            g[i * nl + j] = 0.0;
            for k in 0..nj {
                g[i * nl + j] += e[i * nj + k] * f[k * nl + j];
            }
        }
    }
}

fn main() {
    let a0 = arg(0);
    let ni = parse_int(&a0, 0).v;
    let a1 = arg(1);
    let nj = parse_int(&a1, 0).v;
    let a2 = arg(2);
    let nk = parse_int(&a2, 0).v;
    let a3 = arg(3);
    let nl = parse_int(&a3, 0).v;
    let a4 = arg(4);
    let nm = parse_int(&a4, 0).v;
    let mut e = [0.0; ni * nj];
    let mut a = [0.0; ni * nk];
    let mut b = [0.0; nk * nj];
    let mut f = [0.0; nj * nl];
    let mut c = [0.0; nj * nm];
    let mut d = [0.0; nm * nl];
    let mut g = [0.0; ni * nl];
    init_array(ni, nj, nk, nl, nm, &mut a, &mut b, &mut c, &mut d);
    kernel_3mm(ni, nj, nk, nl, nm, &mut e, &a, &b, &mut f, &c, &d, &mut g);
    print_array(&g);
}
