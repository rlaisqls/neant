// PolyBench/C 4.2.1 linear-algebra/solvers/durbin: Toeplitz system by Durbin's recursion.
// Arguments: n. kernel_durbin's z[N] is a local array of n there; its scalars are `let`s where
// first assigned rather than declared at the top.

use "std/text.nt";

fn init_array(n: i64, r: &mut [f64]) {
    for i in 0..n {
        r[i] = (n + 1 - i) as f64;
    }
}

fn print_array(y: &[f64]) {
    println(y.iter().sum());
}

fn kernel_durbin(n: i64, r: &[f64], y: &mut [f64]) {
    let mut z = [0.0; n];
    y[0] = -r[0];
    let mut beta = 1.0;
    let mut alpha = -r[0];
    for k in 1..n {
        beta = (1.0 - alpha * alpha) * beta;
        let mut sum = 0.0;
        for i in 0..k {
            sum += r[k - i - 1] * y[i];
        }
        alpha = -(r[k] + sum) / beta;
        for i in 0..k {
            z[i] = y[i] + alpha * y[k - i - 1];
        }
        for i in 0..k {
            y[i] = z[i];
        }
        y[k] = alpha;
    }
}

fn main() {
    let a0 = arg(0);
    let n = parse_int(&a0, 0).v;
    let mut r = [0.0; n];
    let mut y = [0.0; n];
    init_array(n, &mut r);
    kernel_durbin(n, &r, &mut y);
    print_array(&y);
}
