is_space         work 7                            moves 0                            exact
skip_space       work 2·xs.len() − 2·at + 12       moves xs.len() − at + 2·B          exact
                 footprint        xs: [0, xs.len()) (whole array)   no residue claimed
parse_int        work 333                          moves 37·B                         exact
                 footprint        xs: [0, xs.len()) (whole array)   no residue claimed
parse_float      work 681                          moves 73·B                         exact
                 footprint        xs: [0, xs.len()) (whole array)   no residue claimed
format_int       work 406                          moves 24·B + 19                    exact
                 footprint        out: [0, out.len()) (whole array)   no residue claimed
format_float     work 716                          moves 44·B + 19                    exact
                 footprint        out: [0, out.len()) (whole array)   no residue claimed
init_array       work 11·m·n + 7·n + 7·m           moves                              exact  (2 regimes)
                                               moves ≈ 8·m·n                      if ≈ 8·m < M
                                               moves ≈ 8·m·n                      if ≈ 8·m ≥ M
                 lower bound      moves 8·m·n + 8·n + 8·m            (footprint, every distinct element crosses once)   gap 1× if ≈ 8·m < M; 1× if ≈ 8·m ≥ M at M = 2 MiB, B = 64
                 footprint        a: [0, 8·m·n)  r: [0, 8·n)  p: [0, 8·m)   resident after if ≈ 8·m·n < M
print_array      work 4·q.len() + 4·s.len() + 2    moves 8·q.len() + 8·s.len() + 2·B  exact, io
                 lower bound      moves 8·q.len() + 8·s.len()        (footprint, every distinct element crosses once)   gap 1× at M = 2 MiB, B = 64
                 footprint        s: [0, 8·s.len())  q: [0, 8·q.len())   resident after if ≈ 8·q.len() + 8·s.len() < M
kernel_bicg      work 18·m·n + 3·n + 3·m           moves                              exact  (2 regimes)
                                               moves ≈ 24·m·n                     if ≈ 24·m ≥ M
                                               moves ≈ 8·m·n                      if ≈ 24·m < M
                 lower bound      moves 8·m·n + 16·n + 16·m          (footprint, every distinct element crosses once)   gap 3× if ≈ 24·m ≥ M; 1× if ≈ 24·m < M at M = 2 MiB, B = 64
                 footprint        a: [0, 8·m·n)  s: [0, 8·m)  q: [0, 8·n)  p: [0, 8·m)  r: [0, 8·n)   resident after if ≈ 8·m·n < M
