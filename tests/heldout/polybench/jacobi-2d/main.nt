// PolyBench/C 4.2.1 stencils/jacobi-2d: 2-D Jacobi stencil, 5 points.
// Arguments: tsteps n.

use "std/text.nt";

fn init_array(n: i64, a: &mut [f64], b: &mut [f64]) {
    for i in 0..n {
        for j in 0..n {
            a[i * n + j] = (i as f64 * (j + 2) as f64 + 2.0) / n as f64;
            b[i * n + j] = (i as f64 * (j + 3) as f64 + 3.0) / n as f64;
        }
    }
}

fn print_array(a: &[f64]) {
    println(a.iter().sum());
}

fn kernel_jacobi_2d(tsteps: i64, n: i64, a: &mut [f64], b: &mut [f64]) {
    for t in 0..tsteps {
        for i in 1..n - 1 {
            for j in 1..n - 1 {
                b[i * n + j] = 0.2 * (a[i * n + j] + a[i * n + j - 1] + a[i * n + 1 + j] + a[(1 + i) * n + j] + a[(i - 1) * n + j]);
            }
        }
        for i in 1..n - 1 {
            for j in 1..n - 1 {
                a[i * n + j] = 0.2 * (b[i * n + j] + b[i * n + j - 1] + b[i * n + 1 + j] + b[(1 + i) * n + j] + b[(i - 1) * n + j]);
            }
        }
    }
}

fn main() {
    let a0 = arg(0);
    let tsteps = parse_int(&a0, 0).v;
    let a1 = arg(1);
    let n = parse_int(&a1, 0).v;
    let mut a = [0.0; n * n];
    let mut b = [0.0; n * n];
    init_array(n, &mut a, &mut b);
    kernel_jacobi_2d(tsteps, n, &mut a, &mut b);
    print_array(&a);
}
