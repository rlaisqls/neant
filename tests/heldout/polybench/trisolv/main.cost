struct Int       layout AoS  the model does not decide: no function's moves differ
struct Float     layout AoS  the model does not decide: no function's moves differ
is_digit         work 3                            moves 0                            exact
is_space         work 7                            moves 0                            exact
skip_space       work 2·xs.len() − 2·at + 12       moves xs.len() − at + 2·B          exact
                 footprint        xs: [0, xs.len()) (whole array)   no residue claimed
parse_int        work 333                          moves 37·B                         exact
                 footprint        xs: [0, xs.len()) (whole array)   no residue claimed
parse_float      work 681                          moves 73·B                         exact
                 footprint        xs: [0, xs.len()) (whole array)   no residue claimed
format_int       work 406                          moves 24·B + 19                    exact
                 footprint        out: [0, out.len()) (whole array)   no residue claimed
format_float     work 716                          moves 44·B + 19                    exact
                 footprint        out: [0, out.len()) (whole array)   no residue claimed
init_array       work 6·n² + 13·n                  moves                              exact  (2 regimes)
                                               moves 4·n² + 3·B·n + 4·n           if ≈ 8·n ≥ M
                                               moves ≈ 4·n²                       if ≈ 8·n < M
                 lower bound      moves 16·n                         (footprint, every distinct element crosses once)
                 footprint        l: [0, 8·n²)  x: [0, 8·n)  b: [0, 8·n)   resident after if ≈ 8·n² < M
print_array      work 4·x.len() + 1                moves 8·x.len() + B                exact, io
                 lower bound      moves 8·x.len()                    (footprint, every distinct element crosses once)   gap 1× at M = 2 MiB, B = 64
                 footprint        x: [0, 8·x.len())   resident after if 8·x.len() < M
kernel_trisolv   work 5·n² + 5·n                   moves                              exact  (2 regimes)
                                               moves ≈ 4·n²                       if ≈ 16·n < M
                                               moves 8·n² + 6·B·n − 8·n           if ≈ 16·n ≥ M
                 lower bound      moves 24·n                         (footprint, every distinct element crosses once)
                 footprint        l: [0, 8·n²)  x: [0, 8·n)  b: [0, 8·n)   resident after if ≈ 8·n² < M
main             work ≈ 12·n²                      moves                              exact, io  (8 regimes)
                                               moves ≈ 16·n²                      if ≈ 8·n ≥ M and ≈ 16·n < M and ≈ 8·n² ≥ M
                                               moves ≈ 16·n²                      if ≈ 8·n < M and ≈ 16·n < M and ≈ 8·n² ≥ M
                                               moves ≈ 12·n²                      if ≈ 8·n ≥ M and ≈ 16·n < M and ≈ 8·n² < M
                                               moves ≈ 12·n²                      if ≈ 8·n ≥ M and ≈ 16·n ≥ M and ≈ 8·n² < M
                                               moves ≈ 20·n²                      if ≈ 8·n ≥ M and ≈ 16·n ≥ M and ≈ 8·n² ≥ M
                                               moves ≈ 12·n²                      if ≈ 8·n < M and ≈ 16·n < M and ≈ 8·n² < M
                                               moves ≈ 12·n²                      if ≈ 8·n < M and ≈ 16·n ≥ M and ≈ 8·n² < M
                                               moves ≈ 20·n²                      if ≈ 8·n < M and ≈ 16·n ≥ M and ≈ 8·n² ≥ M
                 rests on         arg (declared, extern)
arg              work ≤ result.len()               moves ≤ result.len()               declared, io
