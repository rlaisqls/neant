// PolyBench/C 4.2.1 linear-algebra/kernels/doitgen: A[r][q][·] := A[r][q][·]·C4, through sum.
// Arguments: nq nr np (the header's order).

use "std/text.nt";

fn init_array(nr: i64, nq: i64, np: i64, a: &mut [f64], c4: &mut [f64]) {
    for i in 0..nr {
        for j in 0..nq {
            for k in 0..np {
                a[i * nq * np + j * np + k] = ((i * j + k) % np) as f64 / np as f64;
            }
        }
    }
    for i in 0..np {
        for j in 0..np {
            c4[i * np + j] = (i * j % np) as f64 / np as f64;
        }
    }
}

fn print_array(a: &[f64]) {
    println(a.iter().sum());
}

fn kernel_doitgen(nr: i64, nq: i64, np: i64, a: &mut [f64], c4: &[f64], sum: &mut [f64]) {
    for r in 0..nr {
        for q in 0..nq {
            for p in 0..np {
                sum[p] = 0.0;
                for s in 0..np {
                    sum[p] += a[r * nq * np + q * np + s] * c4[s * np + p];
                }
            }
            for p in 0..np {
                a[r * nq * np + q * np + p] = sum[p];
            }
        }
    }
}

fn main() {
    let a0 = arg(0);
    let nq = parse_int(&a0, 0).v;
    let a1 = arg(1);
    let nr = parse_int(&a1, 0).v;
    let a2 = arg(2);
    let np = parse_int(&a2, 0).v;
    let mut a = [0.0; nr * nq * np];
    let mut sum = [0.0; np];
    let mut c4 = [0.0; np * np];
    init_array(nr, nq, np, &mut a, &mut c4);
    kernel_doitgen(nr, nq, np, &mut a, &c4, &mut sum);
    print_array(&a);
}
