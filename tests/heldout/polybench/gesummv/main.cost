struct Int       layout AoS  the model does not decide: no function's moves differ
struct Float     layout AoS  the model does not decide: no function's moves differ
is_digit         work 3                            moves 0                            exact
is_space         work 7                            moves 0                            exact
skip_space       work 2·xs.len() − 2·at + 12       moves xs.len() − at + 2·B          exact
                 footprint        xs: [0, xs.len()) (whole array)   no residue claimed
parse_int        work 333                          moves 37·B                         exact
                 footprint        xs: [0, xs.len()) (whole array)   no residue claimed
parse_float      work 681                          moves 73·B                         exact
                 footprint        xs: [0, xs.len()) (whole array)   no residue claimed
format_int       work 406                          moves 24·B + 19                    exact
                 footprint        out: [0, out.len()) (whole array)   no residue claimed
format_float     work 716                          moves 44·B + 19                    exact
                 footprint        out: [0, out.len()) (whole array)   no residue claimed
init_array       work 20·n² + 7·n                  moves                              exact  (2 regimes)
                                               moves ≈ 16·n²                      if ≈ 16·n < M
                                               moves 16·n² + 3·B·n                if ≈ 16·n ≥ M
                 lower bound      moves 16·n² + 8·n                  (footprint, every distinct element crosses once)   gap 1× if ≈ 16·n < M; 1× if ≈ 16·n ≥ M at M = 2 MiB, B = 64
                 footprint        a: [0, 8·n²)  b: [0, 8·n²)  x: [0, 8·n)   resident after if ≈ 16·n² < M
print_array      work 4·y.len() + 1                moves 8·y.len() + B                exact, io
                 lower bound      moves 8·y.len()                    (footprint, every distinct element crosses once)   gap 1× at M = 2 MiB, B = 64
                 footprint        y: [0, 8·y.len())   resident after if 8·y.len() < M
kernel_gesummv   work 18·n² + 10·n                 moves                              exact  (2 regimes)
                                               moves ≈ 16·n²                      if ≈ 24·n < M
                                               moves 24·n² + 7·B·n                if ≈ 24·n ≥ M
                 lower bound      moves 16·n² + 24·n                 (footprint, every distinct element crosses once)   gap 1× if ≈ 24·n < M; 2× if ≈ 24·n ≥ M at M = 2 MiB, B = 64
                 footprint        a: [0, 8·n²)  b: [0, 8·n²)  tmp: [0, 8·n)  x: [0, 8·n)  y: [0, 8·n)   resident after if ≈ 16·n² < M
main             work ≈ 40·n²                      moves                              exact, io  (4 regimes)
                                               moves ≈ 56·n²                      if ≈ 16·n ≥ M
                                               moves ≈ 32·n²                      if ≈ 16·n² < M
                                               moves ≈ 56·n²                      if ≈ 16·n < M and ≈ 24·n ≥ M
                                               moves ≈ 48·n²                      if ≈ 24·n < M and ≈ 16·n² ≥ M
                 rests on         arg (declared, extern)
arg              work ≤ result.len()               moves ≤ result.len()               declared, io
