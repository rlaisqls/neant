// PolyBench/C 4.2.1 linear-algebra/blas/gesummv: y := alpha·A·x + beta·B·x.
// Arguments: n. alpha and beta, which init_array sets through pointers, are set in main.

use "std/text.nt";

fn init_array(n: i64, a: &mut [f64], b: &mut [f64], x: &mut [f64]) {
    for i in 0..n {
        x[i] = (i % n) as f64 / n as f64;
        for j in 0..n {
            a[i * n + j] = ((i * j + 1) % n) as f64 / n as f64;
            b[i * n + j] = ((i * j + 2) % n) as f64 / n as f64;
        }
    }
}

fn print_array(y: &[f64]) {
    println(y.iter().sum());
}

fn kernel_gesummv(n: i64, alpha: f64, beta: f64, a: &[f64], b: &[f64], tmp: &mut [f64], x: &[f64], y: &mut [f64]) {
    for i in 0..n {
        tmp[i] = 0.0;
        y[i] = 0.0;
        for j in 0..n {
            tmp[i] = a[i * n + j] * x[j] + tmp[i];
            y[i] = b[i * n + j] * x[j] + y[i];
        }
        y[i] = alpha * tmp[i] + beta * y[i];
    }
}

fn main() {
    let a0 = arg(0);
    let n = parse_int(&a0, 0).v;
    let alpha = 1.5;
    let beta = 1.2;
    let mut a = [0.0; n * n];
    let mut b = [0.0; n * n];
    let mut tmp = [0.0; n];
    let mut x = [0.0; n];
    let mut y = [0.0; n];
    init_array(n, &mut a, &mut b, &mut x);
    kernel_gesummv(n, alpha, beta, &a, &b, &mut tmp, &x, &mut y);
    print_array(&y);
}
