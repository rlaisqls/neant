// PolyBench/C 4.2.1 medley/nussinov: RNA secondary-structure folding by dynamic programming.
// Arguments: n. DATA_TYPE is int (the header's default), so table is i64 and the dump is its i64
// sum; base (char) is i64. The macros match and max_score are the functions of those names.
// The downward loop `for (i = n-1; i >= 0; i--)` is a `while` counting down, since a `for` range
// only counts up. print_array dumps only the upper triangle (j from i), summed by an explicit loop.

use "std/text.nt";

fn match_(b1: i64, b2: i64) -> i64 {
    if b1 + b2 == 3 { 1 } else { 0 }
}

fn max_score(s1: i64, s2: i64) -> i64 {
    if s1 >= s2 { s1 } else { s2 }
}

fn init_array(n: i64, seq: &mut [i64], table: &mut [i64]) {
    for i in 0..n {
        seq[i] = (i + 1) % 4;
    }
    for i in 0..n {
        for j in 0..n {
            table[i * n + j] = 0;
        }
    }
}

fn print_array(n: i64, table: &[i64]) {
    let mut s = 0;
    for i in 0..n {
        for j in i..n {
            s += table[i * n + j];
        }
    }
    println(s);
}

fn kernel_nussinov(n: i64, seq: &[i64], table: &mut [i64]) {
    let mut i = n - 1;
    while i >= 0 {
        for j in i + 1..n {
            if j - 1 >= 0 {
                table[i * n + j] = max_score(table[i * n + j], table[i * n + j - 1]);
            }
            if i + 1 < n {
                table[i * n + j] = max_score(table[i * n + j], table[(i + 1) * n + j]);
            }
            if j - 1 >= 0 && i + 1 < n {
                if i < j - 1 {
                    table[i * n + j] = max_score(table[i * n + j], table[(i + 1) * n + j - 1] + match_(seq[i], seq[j]));
                } else {
                    table[i * n + j] = max_score(table[i * n + j], table[(i + 1) * n + j - 1]);
                }
            }
            for k in i + 1..j {
                table[i * n + j] = max_score(table[i * n + j], table[i * n + k] + table[(k + 1) * n + j]);
            }
        }
        i -= 1;
    }
}

fn main() {
    let a0 = arg(0);
    let n = parse_int(&a0, 0).v;
    let mut seq = [0; n];
    let mut table = [0; n * n];
    init_array(n, &mut seq, &mut table);
    kernel_nussinov(n, &seq, &mut table);
    print_array(n, &table);
}
