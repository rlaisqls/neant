// PolyBench/C 4.2.1 linear-algebra/blas/trmm: B := alpha·Aᵀ·B, A unit lower triangular.
// Arguments: m n. alpha, which init_array sets through a pointer, is set in main.

use "std/text.nt";

fn init_array(m: i64, n: i64, a: &mut [f64], b: &mut [f64]) {
    for i in 0..m {
        for j in 0..i {
            a[i * m + j] = ((i + j) % m) as f64 / m as f64;
        }
        a[i * m + i] = 1.0;
        for j in 0..n {
            b[i * n + j] = ((n + (i - j)) % n) as f64 / n as f64;
        }
    }
}

fn print_array(b: &[f64]) {
    println(b.iter().sum());
}

fn kernel_trmm(m: i64, n: i64, alpha: f64, a: &[f64], b: &mut [f64]) {
    for i in 0..m {
        for j in 0..n {
            for k in i + 1..m {
                b[i * n + j] += a[k * m + i] * b[k * n + j];
            }
            b[i * n + j] = alpha * b[i * n + j];
        }
    }
}

fn main() {
    let a0 = arg(0);
    let m = parse_int(&a0, 0).v;
    let a1 = arg(1);
    let n = parse_int(&a1, 0).v;
    let alpha = 1.5;
    let mut a = [0.0; m * m];
    let mut b = [0.0; m * n];
    init_array(m, n, &mut a, &mut b);
    kernel_trmm(m, n, alpha, &a, &mut b);
    print_array(&b);
}
