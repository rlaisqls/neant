// PolyBench/C 4.2.1 linear-algebra/solvers/ludcmp: LU decomposition, then forward and back
// substitution. Arguments: n. init_array's temporary B is a local array there. A C loop
// `j <= i` is `0..i + 1` (a range is half-open); the back substitution's downward loop
// `for (i = n-1; i >= 0; i--)` is a `while` with the same bounds (a range only counts up).
// Renamed: init_array's local `fn` is `fn_` (`fn` is a keyword) and its temporary `B` is `bb`
// (arrays are lower-case here, and `b` is already the parameter). `w` is a `let` at each
// assignment that starts it rather than one declaration at the top.

use "std/text.nt";

fn init_array(n: i64, a: &mut [f64], b: &mut [f64], x: &mut [f64], y: &mut [f64]) {
    let fn_ = n as f64;
    for i in 0..n {
        x[i] = 0.0;
        y[i] = 0.0;
        b[i] = (i + 1) as f64 / fn_ / 2.0 + 4.0;
    }
    for i in 0..n {
        for j in 0..i + 1 {
            a[i * n + j] = (-j % n) as f64 / n as f64 + 1.0;
        }
        for j in i + 1..n {
            a[i * n + j] = 0.0;
        }
        a[i * n + i] = 1.0;
    }
    let mut bb = [0.0; n * n];
    for r in 0..n {
        for s in 0..n {
            bb[r * n + s] = 0.0;
        }
    }
    for t in 0..n {
        for r in 0..n {
            for s in 0..n {
                bb[r * n + s] += a[r * n + t] * a[s * n + t];
            }
        }
    }
    for r in 0..n {
        for s in 0..n {
            a[r * n + s] = bb[r * n + s];
        }
    }
}

fn print_array(x: &[f64]) {
    println(x.iter().sum());
}

fn kernel_ludcmp(n: i64, a: &mut [f64], b: &[f64], x: &mut [f64], y: &mut [f64]) {
    for i in 0..n {
        for j in 0..i {
            let mut w = a[i * n + j];
            for k in 0..j {
                w -= a[i * n + k] * a[k * n + j];
            }
            a[i * n + j] = w / a[j * n + j];
        }
        for j in i..n {
            let mut w = a[i * n + j];
            for k in 0..i {
                w -= a[i * n + k] * a[k * n + j];
            }
            a[i * n + j] = w;
        }
    }
    for i in 0..n {
        let mut w = b[i];
        for j in 0..i {
            w -= a[i * n + j] * y[j];
        }
        y[i] = w;
    }
    let mut i = n - 1;
    while i >= 0 {
        let mut w = y[i];
        for j in i + 1..n {
            w -= a[i * n + j] * x[j];
        }
        x[i] = w / a[i * n + i];
        i -= 1;
    }
}

fn main() {
    let a0 = arg(0);
    let n = parse_int(&a0, 0).v;
    let mut a = [0.0; n * n];
    let mut b = [0.0; n];
    let mut x = [0.0; n];
    let mut y = [0.0; n];
    init_array(n, &mut a, &mut b, &mut x, &mut y);
    kernel_ludcmp(n, &mut a, &b, &mut x, &mut y);
    print_array(&x);
}
