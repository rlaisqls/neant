// PolyBench/C 4.2.1 datamining/correlation: the correlation matrix of n samples of m variables.
// Arguments: m n. float_n, which init_array sets through a pointer, is set in main.
// `x <= eps ? 1.0 : x` is an `if` expression; `*float_n = (DATA_TYPE)N` uses the size argument n.

use "std/math.nt";
use "std/text.nt";

fn init_array(m: i64, n: i64, data: &mut [f64]) {
    for i in 0..n {
        for j in 0..m {
            data[i * m + j] = (i * j) as f64 / m as f64 + i as f64;
        }
    }
}

fn print_array(corr: &[f64]) {
    println(corr.iter().sum());
}

fn kernel_correlation(m: i64, n: i64, float_n: f64, data: &mut [f64], corr: &mut [f64], mean: &mut [f64], stddev: &mut [f64]) {
    let eps = 0.1;
    for j in 0..m {
        mean[j] = 0.0;
        for i in 0..n {
            mean[j] += data[i * m + j];
        }
        mean[j] /= float_n;
    }
    for j in 0..m {
        stddev[j] = 0.0;
        for i in 0..n {
            stddev[j] += (data[i * m + j] - mean[j]) * (data[i * m + j] - mean[j]);
        }
        stddev[j] /= float_n;
        stddev[j] = sqrt(stddev[j]);
        stddev[j] = if stddev[j] <= eps { 1.0 } else { stddev[j] };
    }
    for i in 0..n {
        for j in 0..m {
            data[i * m + j] -= mean[j];
            data[i * m + j] /= sqrt(float_n) * stddev[j];
        }
    }
    for i in 0..m - 1 {
        corr[i * m + i] = 1.0;
        for j in i + 1..m {
            corr[i * m + j] = 0.0;
            for k in 0..n {
                corr[i * m + j] += data[k * m + i] * data[k * m + j];
            }
            corr[j * m + i] = corr[i * m + j];
        }
    }
    corr[(m - 1) * m + (m - 1)] = 1.0;
}

fn main() {
    let a0 = arg(0);
    let m = parse_int(&a0, 0).v;
    let a1 = arg(1);
    let n = parse_int(&a1, 0).v;
    let float_n = n as f64;
    let mut data = [0.0; n * m];
    let mut corr = [0.0; m * m];
    let mut mean = [0.0; m];
    let mut stddev = [0.0; m];
    init_array(m, n, &mut data);
    kernel_correlation(m, n, float_n, &mut data, &mut corr, &mut mean, &mut stddev);
    print_array(&corr);
}
