// PolyBench/C 4.2.1 linear-algebra/blas/gemver: a rank-2 update of A, then x := beta·Aᵀ·y + z and
// w := alpha·A·x. Arguments: n. alpha and beta, which init_array sets through pointers, are set in main.
// init_array's local `fn` is named `fn_`, `fn` being a keyword.

use "std/text.nt";

fn init_array(n: i64, a: &mut [f64], u1: &mut [f64], v1: &mut [f64], u2: &mut [f64], v2: &mut [f64], w: &mut [f64], x: &mut [f64], y: &mut [f64], z: &mut [f64]) {
    let fn_ = n as f64;
    for i in 0..n {
        u1[i] = i as f64;
        u2[i] = ((i + 1) as f64 / fn_) / 2.0;
        v1[i] = ((i + 1) as f64 / fn_) / 4.0;
        v2[i] = ((i + 1) as f64 / fn_) / 6.0;
        y[i] = ((i + 1) as f64 / fn_) / 8.0;
        z[i] = ((i + 1) as f64 / fn_) / 9.0;
        x[i] = 0.0;
        w[i] = 0.0;
        for j in 0..n {
            a[i * n + j] = (i * j % n) as f64 / n as f64;
        }
    }
}

fn print_array(w: &[f64]) {
    println(w.iter().sum());
}

fn kernel_gemver(n: i64, alpha: f64, beta: f64, a: &mut [f64], u1: &[f64], v1: &[f64], u2: &[f64], v2: &[f64], w: &mut [f64], x: &mut [f64], y: &[f64], z: &[f64]) {
    for i in 0..n {
        for j in 0..n {
            a[i * n + j] = a[i * n + j] + u1[i] * v1[j] + u2[i] * v2[j];
        }
    }
    for i in 0..n {
        for j in 0..n {
            x[i] = x[i] + beta * a[j * n + i] * y[j];
        }
    }
    for i in 0..n {
        x[i] = x[i] + z[i];
    }
    for i in 0..n {
        for j in 0..n {
            w[i] = w[i] + alpha * a[i * n + j] * x[j];
        }
    }
}

fn main() {
    let a0 = arg(0);
    let n = parse_int(&a0, 0).v;
    let alpha = 1.5;
    let beta = 1.2;
    let mut a = [0.0; n * n];
    let mut u1 = [0.0; n];
    let mut v1 = [0.0; n];
    let mut u2 = [0.0; n];
    let mut v2 = [0.0; n];
    let mut w = [0.0; n];
    let mut x = [0.0; n];
    let mut y = [0.0; n];
    let mut z = [0.0; n];
    init_array(n, &mut a, &mut u1, &mut v1, &mut u2, &mut v2, &mut w, &mut x, &mut y, &mut z);
    kernel_gemver(n, alpha, beta, &mut a, &u1, &v1, &u2, &v2, &mut w, &mut x, &y, &z);
    print_array(&w);
}
