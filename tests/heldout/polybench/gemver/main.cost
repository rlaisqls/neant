struct Int       layout AoS  the model does not decide: no function's moves differ
struct Float     layout AoS  the model does not decide: no function's moves differ
is_digit         work 3                            moves 0                            exact
is_space         work 7                            moves 0                            exact
skip_space       work 2·xs.len() − 2·at + 12       moves xs.len() − at + 2·B          exact
                 footprint        xs: [0, xs.len()) (whole array)   no residue claimed
parse_int        work 333                          moves 37·B                         exact
                 footprint        xs: [0, xs.len()) (whole array)   no residue claimed
parse_float      work 681                          moves 73·B                         exact
                 footprint        xs: [0, xs.len()) (whole array)   no residue claimed
format_int       work 406                          moves 24·B + 19                    exact
                 footprint        out: [0, out.len()) (whole array)   no residue claimed
format_float     work 716                          moves 44·B + 19                    exact
                 footprint        out: [0, out.len()) (whole array)   no residue claimed
init_array       work 10·n² + 31·n + 1             moves                              exact  (2 regimes)
                                               moves ≈ 8·n²                       if ≈ 8·n < M
                                               moves 8·n² + 9·B·n                 if ≈ 8·n ≥ M
                 lower bound      moves 8·n² + 64·n                  (footprint, every distinct element crosses once)   gap 1× if ≈ 8·n < M; 1× if ≈ 8·n ≥ M at M = 2 MiB, B = 64
                 footprint        a: [0, 8·n²)  u1: [0, 8·n)  v1: [0, 8·n)  u2: [0, 8·n)  v2: [0, 8·n)  w: [0, 8·n)  x: [0, 8·n)  y: [0, 8·n)  z: [0, 8·n)   resident after if ≈ 8·n² < M
print_array      work 4·w.len() + 1                moves 8·w.len() + B                exact, io
                 lower bound      moves 8·w.len()                    (footprint, every distinct element crosses once)   gap 1× at M = 2 MiB, B = 64
                 footprint        w: [0, 8·w.len())   resident after if 8·w.len() < M
kernel_gemver    work 38·n² + 12·n                 moves                              exact  (4 regimes)
                                               moves ≈ B·n² + 48·n²               if ≈ 16·n ≥ M
                                               moves ≈ 24·n²                      if ≈ B·n + 8·n < M
                                               moves ≈ B·n² + 40·n²               if ≈ 16·n < M and ≈ 24·n ≥ M
                                               moves ≈ B·n² + 24·n²               if ≈ B·n + 8·n ≥ M and ≈ 24·n < M
                 lower bound      moves 8·n² + 64·n                  (footprint, every distinct element crosses once)   gap 14× if ≈ 16·n ≥ M; 3× if ≈ B·n + 8·n < M; 13× if ≈ 16·n < M and ≈ 24·n ≥ M; 11× if ≈ B·n + 8·n ≥ M and ≈ 24·n < M at M = 2 MiB, B = 64
                 footprint        a: [0, 8·n²)  u1: [0, 8·n)  v1: [0, 8·n)  u2: [0, 8·n)  v2: [0, 8·n)  w: [0, 8·n)  x: [0, 8·n)  y: [0, 8·n)  z: [0, 8·n)   resident after if ≈ 8·n² < M
main             work ≈ 49·n²                      moves                              exact, io  (6 regimes)
                                               moves ≈ B·n² + 64·n²               if ≈ 8·n ≥ M
                                               moves ≈ 16·n²                      if ≈ 8·n² < M
                                               moves ≈ B·n² + 64·n²               if ≈ 16·n ≥ M and ≈ 8·n < M
                                               moves ≈ B·n² + 56·n²               if ≈ 16·n < M and ≈ 24·n ≥ M
                                               moves ≈ B·n² + 40·n²               if ≈ B·n + 8·n ≥ M and ≈ 24·n < M
                                               moves ≈ 40·n²                      if ≈ B·n + 8·n < M and ≈ 8·n² ≥ M
                 rests on         arg (declared, extern)
arg              work ≤ result.len()               moves ≤ result.len()               declared, io
