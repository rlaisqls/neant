init_array       work 11·w·h + 2·w                 moves                              exact  (2 regimes)
                                               moves 8·w·h + B·w                  if ≈ 8·h < M
                                               moves 8·w·h + B·w                  if ≈ 8·h ≥ M
                 lower bound      moves 8·w·h                        (footprint, every distinct element crosses once)   gap 1× if ≈ 8·h < M; 1× if ≈ 8·h ≥ M at M = 2 MiB, B = 64
                 footprint        img_in: [0, 8·w·h)   resident after if 8·w·h < M
print_array      work 4·img_out.len() + 1          moves 8·img_out.len() + B          exact, io
                 lower bound      moves 8·img_out.len()              (footprint, every distinct element crosses once)   gap 1× at M = 2 MiB, B = 64
                 footprint        img_out: [0, 8·img_out.len())   resident after if 8·img_out.len() < M
kernel_deriche   work ≈ 104·w·h                    moves                              exact  (6 regimes)
                                               moves 4·B·w·h + 80·w·h + 10·B·w    if ≈ 24·h < M and 2·B·w ≥ M
                                               moves 4·B·w·h + 80·w·h + 10·B·w    if ≈ 16·h ≥ M and 2·B·w ≥ M
