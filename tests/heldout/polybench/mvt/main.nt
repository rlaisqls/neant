// PolyBench/C 4.2.1 linear-algebra/kernels/mvt: x1 += A·y_1, x2 += Aᵀ·y_2.
// Arguments: n.

use "std/text.nt";

fn init_array(n: i64, x1: &mut [f64], x2: &mut [f64], y_1: &mut [f64], y_2: &mut [f64], a: &mut [f64]) {
    for i in 0..n {
        x1[i] = (i % n) as f64 / n as f64;
        x2[i] = ((i + 1) % n) as f64 / n as f64;
        y_1[i] = ((i + 3) % n) as f64 / n as f64;
        y_2[i] = ((i + 4) % n) as f64 / n as f64;
        for j in 0..n {
            a[i * n + j] = (i * j % n) as f64 / n as f64;
        }
    }
}

fn print_array(x1: &[f64], x2: &[f64]) {
    println(x1.iter().sum());
    println(x2.iter().sum());
}

fn kernel_mvt(n: i64, x1: &mut [f64], x2: &mut [f64], y_1: &[f64], y_2: &[f64], a: &[f64]) {
    for i in 0..n {
        for j in 0..n {
            x1[i] = x1[i] + a[i * n + j] * y_1[j];
        }
    }
    for i in 0..n {
        for j in 0..n {
            x2[i] = x2[i] + a[j * n + i] * y_2[j];
        }
    }
}

fn main() {
    let a0 = arg(0);
    let n = parse_int(&a0, 0).v;
    let mut a = [0.0; n * n];
    let mut x1 = [0.0; n];
    let mut x2 = [0.0; n];
    let mut y_1 = [0.0; n];
    let mut y_2 = [0.0; n];
    init_array(n, &mut x1, &mut x2, &mut y_1, &mut y_2, &mut a);
    kernel_mvt(n, &mut x1, &mut x2, &y_1, &y_2, &a);
    print_array(&x1, &x2);
}
