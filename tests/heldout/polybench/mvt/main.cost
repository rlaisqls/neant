struct Int       layout AoS  the model does not decide: no function's moves differ
struct Float     layout AoS  the model does not decide: no function's moves differ
is_digit         work 3                            moves 0                            exact
is_space         work 7                            moves 0                            exact
skip_space       work 2·xs.len() − 2·at + 12       moves xs.len() − at + 2·B          exact
                 footprint        xs: [0, xs.len()) (whole array)   no residue claimed
parse_int        work 333                          moves 37·B                         exact
                 footprint        xs: [0, xs.len()) (whole array)   no residue claimed
parse_float      work 681                          moves 73·B                         exact
                 footprint        xs: [0, xs.len()) (whole array)   no residue claimed
format_int       work 406                          moves 24·B + 19                    exact
                 footprint        out: [0, out.len()) (whole array)   no residue claimed
format_float     work 716                          moves 44·B + 19                    exact
                 footprint        out: [0, out.len()) (whole array)   no residue claimed
init_array       work 10·n² + 25·n                 moves                              exact  (2 regimes)
                                               moves ≈ 8·n²                       if ≈ 8·n < M
                                               moves 8·n² + 5·B·n                 if ≈ 8·n ≥ M
                 lower bound      moves 8·n² + 32·n                  (footprint, every distinct element crosses once)   gap 1× if ≈ 8·n < M; 1× if ≈ 8·n ≥ M at M = 2 MiB, B = 64
                 footprint        x1: [0, 8·n)  x2: [0, 8·n)  y_1: [0, 8·n)  y_2: [0, 8·n)  a: [0, 8·n²)   resident after if ≈ 8·n² < M
print_array      work 4·x2.len() + 4·x1.len() + 2  moves 8·x2.len() + 8·x1.len() + 2·B exact, io
                 lower bound      moves 8·x2.len() + 8·x1.len()      (footprint, every distinct element crosses once)   gap 1× at M = 2 MiB, B = 64
                 footprint        x1: [0, 8·x1.len())  x2: [0, 8·x2.len())   resident after if ≈ 8·x2.len() + 8·x1.len() < M
kernel_mvt       work 20·n² + 4·n                  moves                              exact  (3 regimes)
                                               moves ≈ 16·n²                      if ≈ B·n + 8·n < M
                                               moves B·n² + 24·n² + 5·B·n         if ≈ 16·n ≥ M
                                               moves ≈ B·n² + 16·n²               if ≈ B·n + 8·n ≥ M and ≈ 16·n < M
                 lower bound      moves 8·n² + 32·n                  (footprint, every distinct element crosses once)   gap 2× if ≈ B·n + 8·n < M; 11× if ≈ 16·n ≥ M; 10× if ≈ B·n + 8·n ≥ M and ≈ 16·n < M at M = 2 MiB, B = 64
                 footprint        x1: [0, 8·n)  x2: [0, 8·n)  y_1: [0, 8·n)  y_2: [0, 8·n)  a: [0, 8·n²)   resident after if ≈ 8·n² < M
main             work ≈ 31·n²                      moves                              exact, io  (5 regimes)
                                               moves ≈ B·n² + 40·n²               if ≈ 8·n ≥ M
                                               moves ≈ 16·n²                      if ≈ 8·n² < M
                                               moves ≈ B·n² + 40·n²               if ≈ 16·n ≥ M and ≈ 8·n < M
                                               moves ≈ B·n² + 32·n²               if ≈ B·n + 8·n ≥ M and ≈ 16·n < M
                                               moves ≈ 32·n²                      if ≈ B·n + 8·n < M and ≈ 8·n² ≥ M
                 rests on         arg (declared, extern)
arg              work ≤ result.len()               moves ≤ result.len()               declared, io
