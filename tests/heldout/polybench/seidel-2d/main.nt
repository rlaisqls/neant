// PolyBench/C 4.2.1 stencils/seidel-2d: 2-D Gauss-Seidel stencil, 9 points, in place.
// Arguments: tsteps n. The inclusive bounds `t <= tsteps - 1` and `i <= n - 2` are the exclusive
// ranges 0..tsteps and 1..n - 1.

use "std/text.nt";

fn init_array(n: i64, a: &mut [f64]) {
    for i in 0..n {
        for j in 0..n {
            a[i * n + j] = (i as f64 * (j + 2) as f64 + 2.0) / n as f64;
        }
    }
}

fn print_array(a: &[f64]) {
    println(a.iter().sum());
}

fn kernel_seidel_2d(tsteps: i64, n: i64, a: &mut [f64]) {
    for t in 0..tsteps {
        for i in 1..n - 1 {
            for j in 1..n - 1 {
                a[i * n + j] = (a[(i - 1) * n + j - 1] + a[(i - 1) * n + j] + a[(i - 1) * n + j + 1]
                    + a[i * n + j - 1] + a[i * n + j] + a[i * n + j + 1]
                    + a[(i + 1) * n + j - 1] + a[(i + 1) * n + j] + a[(i + 1) * n + j + 1]) / 9.0;
            }
        }
    }
}

fn main() {
    let a0 = arg(0);
    let tsteps = parse_int(&a0, 0).v;
    let a1 = arg(1);
    let n = parse_int(&a1, 0).v;
    let mut a = [0.0; n * n];
    init_array(n, &mut a);
    kernel_seidel_2d(tsteps, n, &mut a);
    print_array(&a);
}
