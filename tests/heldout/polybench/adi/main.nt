// PolyBench/C 4.2.1 stencils/adi: alternating-direction implicit solver, 2-D.
// Arguments: tsteps n. The downward loops `for (j = n-2; j >= 1; j--)` are a `while` counting
// down, since a `for` range only counts up; `t <= tsteps` is the range 1..tsteps + 1.

use "std/text.nt";

fn init_array(n: i64, u: &mut [f64]) {
    for i in 0..n {
        for j in 0..n {
            u[i * n + j] = (i + n - j) as f64 / n as f64;
        }
    }
}

fn print_array(u: &[f64]) {
    println(u.iter().sum());
}

fn kernel_adi(tsteps: i64, n: i64, u: &mut [f64], v: &mut [f64], p: &mut [f64], q: &mut [f64]) {
    let dx = 1.0 / n as f64;
    let dy = 1.0 / n as f64;
    let dt = 1.0 / tsteps as f64;
    let b1 = 2.0;
    let b2 = 1.0;
    let mul1 = b1 * dt / (dx * dx);
    let mul2 = b2 * dt / (dy * dy);
    let a = -mul1 / 2.0;
    let b = 1.0 + mul1;
    let c = a;
    let d = -mul2 / 2.0;
    let e = 1.0 + mul2;
    let f = d;
    for t in 1..tsteps + 1 {
        // Column Sweep
        for i in 1..n - 1 {
            v[0 * n + i] = 1.0;
            p[i * n + 0] = 0.0;
            q[i * n + 0] = v[0 * n + i];
            for j in 1..n - 1 {
                p[i * n + j] = -c / (a * p[i * n + j - 1] + b);
                q[i * n + j] = (-d * u[j * n + i - 1] + (1.0 + 2.0 * d) * u[j * n + i] - f * u[j * n + i + 1] - a * q[i * n + j - 1]) / (a * p[i * n + j - 1] + b);
            }
            v[(n - 1) * n + i] = 1.0;
            let mut j = n - 2;
            while j >= 1 {
                v[j * n + i] = p[i * n + j] * v[(j + 1) * n + i] + q[i * n + j];
                j -= 1;
            }
        }
        // Row Sweep
        for i in 1..n - 1 {
            u[i * n + 0] = 1.0;
            p[i * n + 0] = 0.0;
            q[i * n + 0] = u[i * n + 0];
            for j in 1..n - 1 {
                p[i * n + j] = -f / (d * p[i * n + j - 1] + e);
                q[i * n + j] = (-a * v[(i - 1) * n + j] + (1.0 + 2.0 * a) * v[i * n + j] - c * v[(i + 1) * n + j] - d * q[i * n + j - 1]) / (d * p[i * n + j - 1] + e);
            }
            u[i * n + n - 1] = 1.0;
            let mut j = n - 2;
            while j >= 1 {
                u[i * n + j] = p[i * n + j] * u[i * n + j + 1] + q[i * n + j];
                j -= 1;
            }
        }
    }
}

fn main() {
    let a0 = arg(0);
    let tsteps = parse_int(&a0, 0).v;
    let a1 = arg(1);
    let n = parse_int(&a1, 0).v;
    let mut u = [0.0; n * n];
    let mut v = [0.0; n * n];
    let mut p = [0.0; n * n];
    let mut q = [0.0; n * n];
    init_array(n, &mut u);
    kernel_adi(tsteps, n, &mut u, &mut v, &mut p, &mut q);
    print_array(&u);
}
