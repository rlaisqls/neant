// src/neant/stdlib/table.nt: a table is a dict of columns.  The people table is the README's.
people: tbl[`name`dept`pay; (`ann`bob`cy; `eng`ops`eng; 120 80 100)]
tsection "table: build, show"
teq["tbl is a dict"; people; `name`dept`pay!(`ann`bob`cy;`eng`ops`eng;120 80 100)]
teq["column"; people`pay; 120 80 100]
teq["tcount"; tcount people; 3]
teq["tcount empty"; tcount tbl[`a;enlist ()]; 0]
teq["row"; row[people;1]; `name`dept`pay!(`bob;`ops;80)]
teq["row keeps a one-row table's shape"; row[tbl[`a;enlist 1 2 3];0]; `a!,1]
teq["rows"; rows[people;0 2]; `name`dept`pay!(`ann`cy;`eng`eng;120 100)]
teq["rows reorder"; rows[people;2 0]; `name`dept`pay!(`cy`ann;`eng`eng;100 120)]
teq["t[i] is a row"; people[1]; row[people;1]]
teq["t[idx] is rows"; people[0 2]; rows[people;0 2]]
teq["t[where ...]"; people[where people[`pay]>90]; rows[people;0 2]]
teq["tappend table"; tappend[people; tbl[`name`dept`pay; (`dee`eve; `ops`eng; 90 110)]]; `name`dept`pay!(`ann`bob`cy`dee`eve;`eng`ops`eng`ops`eng;120 80 100 90 110)]
teq["tappend row"; tappend[people; `name`dept`pay!(`dee;`ops;90)]; `name`dept`pay!(`ann`bob`cy`dee;`eng`ops`eng`ops;120 80 100 90)]
teq["tappend count"; tcount tappend[people;people]; 6]
teq["tpad"; tpad["ab";4]; "ab  "]
teq["tline"; tline[("ab";"c");3 2]; "ab  c "]
tok["tshow prints and returns null"; null~tshow people]

tsection "table: query"
teq["tsel"; tsel[people; people[`pay]>90]; `name`dept`pay!(`ann`cy;`eng`eng;120 100)]
teq["tsel none"; tcount tsel[people; people[`pay]>200]; 0]
teq["tsort"; tsort[people;`pay]; `name`dept`pay!(`bob`cy`ann;`ops`eng`eng;80 100 120)]
teq["tsort already sorted"; tsort[people;`name]; people]
teq["tby sum"; tby[people;`dept;`pay;sum]; `eng`ops!220 80]
teq["tby count"; tby[people;`dept;`pay;count]; `eng`ops!2 1]
teq["tby avg"; tby[people;`dept;`pay;avg]; `eng`ops!110 80.0]
teq["tby first"; tby[people;`dept;`name;first]; `eng`ops!`ann`bob]
teq["xasc"; xasc[`pay;people]; tsort[people;`pay]]
teq["xdesc"; xdesc[`pay;people]; `name`dept`pay!(`ann`cy`bob;`eng`eng`ops;120 100 80)]
teq["xasc two columns"; xasc[`dept`pay;people]; `name`dept`pay!(`cy`ann`bob;`eng`eng`ops;100 120 80)]
teq["xdesc two columns"; xdesc[`dept`pay;people]; `name`dept`pay!(`bob`ann`cy;`ops`eng`eng;80 120 100)]
teq["ungroup"; ungroup tbl[`a`b; (1 2; (10 20; 30 40 50))]; `a`b!(1 1 2 2 2;10 20 30 40 50)]
teq["ungroup strings"; ungroup tbl[`a`b; (1 2; ("xy"; "z"))]; `a`b!(1 1 2;"xyz")]

tsection "table: select"
teq["select by where"; select total: sum pay, n: count pay by dept from people where pay>90; `dept`total`n!(,`eng;,220;,2)]
teq["select by"; select total: sum pay, n: count pay by dept from people; `dept`total`n!(`eng`ops;220 80;2 1)]
teq["select where"; select from people where pay>90; rows[people;0 2]]
teq["select columns where"; select name, pay from people where pay>90; `name`pay!(`ann`cy;120 100)]
teq["select aggregate"; select total: sum pay from people; enlist[`total]!enlist enlist 300]
teq["select all"; select from people; people]
teq["select computed"; select pay2: pay*2 from people where dept=`eng; enlist[`pay2]!enlist 240 200]
teq["select by two keys"; select n: count name by dept, pay from people; `dept`pay`n!(`eng`ops`eng;120 80 100;1 1 1)]
teq["qsel directly"; qsel[people; {x[`pay]>90}; (); `n!enlist {count x`pay}]; `n!enlist enlist 2]   // the key stays the atom it was given

tsection "table: joins"
t: tbl[`id`a; (1 2 3; 10 20 30)]
u: tbl[`id`b; (3 1 9; 300 100 900)]
us: tbl[`id`b; (3 1 9; `c`a`z)]
teq["lj"; lj[t;`id;u]; `id`a`b!(1 2 3;10 20 30;100 0N 300)]
teq["lj fills a sym null"; lj[t;`id;us]; `id`a`b!(1 2 3;10 20 30;`a``c)]
teq["ij"; ij[t;`id;u]; `id`a`b!(1 3;10 30;100 300)]
teq["ij syms"; ij[t;`id;us]; `id`a`b!(1 3;10 30;`a`c)]
teq["uj"; uj[t;u]; `id`a`b!(1 2 3 3 1 9;10 20 30 0N 0N 0N;0N 0N 0N 300 100 900)]
teq["uj same columns"; uj[tbl[`id`a; (1 2; 10 20)]; tbl[`id`a; (3 4; 30 40)]]; `id`a!(1 2 3 4;10 20 30 40)]
t2: tbl[`k1`k2`a; (1 1 2; `x`y`x; 10 20 30)]
u2: tbl[`k1`k2`b; (1 2; `y`x; 100 200)]
teq["lj two keys"; lj[t2;`k1`k2;u2]; `k1`k2`a`b!(1 1 2;`x`y`x;10 20 30;0N 100 200)]
teq["ij two keys"; ij[t2;`k1`k2;u2]; `k1`k2`a`b!(1 2;`y`x;20 30;100 200)]
trades: tbl[`sym`time`px; (`a`b`a; 10 20 30; 1.0 2.0 3.0)]
quotes: tbl[`sym`time`bid; (`a`a`b; 5 25 15; 0.9 2.9 1.9)]
teq["aj"; aj[`sym`time;trades;quotes]; `sym`time`px`bid!(`a`b`a;10 20 30;1 2 3.0;0.9 1.9 2.9)]
teq["aj no key column"; aj[`time; tbl[`time`px; (10 20 30; 1.0 2.0 3.0)]; tbl[`time`bid; (5 25; 0.9 2.9)]]; `time`px`bid!(10 20 30;1 2 3.0;0.9 0.9 2.9)]
teq["aj before first quote is null"; aj[`time; tbl[`time`px; (10 20 30; 1.0 2.0 3.0)]; tbl[`time`bid; (15 25; 0.9 2.9)]]; `time`px`bid!(10 20 30;1 2 3.0;0n 0.9 2.9)]

tsection "table: keyed"
kt: xkey[`name;people]
teq["xkey"; kt; `ann`bob`cy!`dept`pay!(`eng`ops`eng;120 80 100)]
teq["keyed lookup"; kt`bob; `dept`pay!(`ops;80)]
tok["keyed lookup miss is null"; null~kt`zed]
teq["unkey names the key k"; unkey kt; `k`dept`pay!(`ann`bob`cy;`eng`ops`eng;120 80 100)]
tok["unkey does not restore the name"; not (unkey kt)~people]
ki: xkey[`id;t]
teq["xkey int key"; ki 3; enlist[`a]!enlist 30]
teq["unkey int key"; unkey ki; `k`a!(1 2 3;10 20 30)]
kt2: xkey[`name`dept;people]
teq["xkey two columns"; key kt2; (`ann`eng;`bob`ops;`cy`eng)]
teq["keyed lookup two columns"; kt2[(`bob;`ops)]; enlist[`pay]!enlist 80]
tok["keyed lookup two columns miss"; null~kt2[(`cy;`ops)]]
terrLike["unkey two columns (suspected bug: string 1 2 is one string, so k1 k k2)"; {[] unkey kt2}; "length"]

tsection "table: csv"
teq["rcsv SSI"; rcsv["SSI";",";"tests/data/people.csv"]; people]
teq["rcsv F"; rcsv["SSF";",";"tests/data/people.csv"]`pay; 120 80 100.0]
teq["rcsv keeps strings"; rcsv["SS*";",";"tests/data/people.csv"]`pay; ("120";"80";"100")]
