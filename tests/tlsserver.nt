// src/neant/crypto/tlsserver.nt: the TLS 1.3 server handshake, and src/neant/net/http.nt's
// httpsServe on top of it. Everything here is this process talking to itself over a socket it
// opened — the check that a *real* implementation accepts what this server sends is
// `openssl_client_completes_our_handshake` in src/main.rs, which needs a subprocess and so stays
// in Rust.
tsection "tls server"
{load "src/neant/crypto/",x} each ("bignum.nt";"sha512.nt";"rsa.nt";"der.nt";"ec.nt";"p256.nt"
  ;"p384.nt";"x509.nt";"verify.nt";"tls.nt";"sign.nt";"tlsserver.nt")
load "src/neant/net/http.nt"

tssPort: 19000+first 1 rand 3000
tssNext: {[] tssPort:: tssPort+1; "127.0.0.1:",string tssPort}
tssCerts: pemLoad "tests/data/pki-sha512-leaf.pem"
tssKey: rsaKeyLoad "tests/data/pki-sha512-leaf.key"
tssRoots: x509LoadRoots "tests/data/pki-sha512-root.pem"
tssOpts: `roots`now!(tssRoots; (2026.09.16; 12:00:00.000))

// one connection, then stop: a listener left open in an accept loop makes every later run of this
// file fail on the port, which is the lesson tests/http.nt already carries
tssServe: {[handler]
  a: tssNext[]
  l: hlisten a
  h: spawn {c: accept l; r: @[{[b] handler tlsAccept[b 0; b 1; b 2]}; (c;tssCerts;tssKey); {"TLS SERVER FAILED: ",x}]; hclose l; r}
  (a; h)}

// ---- a full round trip, both directions, with the chain verified by our own client
tssEcho: {[h] m: tlsRecv h; tlsSend[h; (`byte$"echo:"),m]; tlsClose h; `char$m}
tss1: tssServe tssEcho
tssC: tlsConnectOpts["127.0.0.1"; `int$last ":" vs tss1 0; tssOpts]
tlsSend[tssC; "ping"]
teq["the server answers over the negotiated keys"; `char$tlsRecv tssC; "echo:ping"]
tlsClose tssC
teq["and it saw what the client sent"; join tss1 1; "ping"]

// the handle tlsAccept returns is an ordinary tls.nt handle, which is why tlsSend and tlsRecv work
// on it unchanged: the only difference between the ends is which secret writes and which reads
tss2: tssServe {[h] tlsSend[h; `byte$"server speaks first"]; m: tlsRecv h; tlsClose h; `char$m}
tssC: tlsConnectOpts["127.0.0.1"; `int$last ":" vs tss2 0; tssOpts]
teq["the server may speak first"; `char$tlsRecv tssC; "server speaks first"]
tlsSend[tssC; "then the client"]
tlsClose tssC
teq["and read after"; join tss2 1; "then the client"]

// ---- what it refuses, by name
tssRaw: {[bytes]
  a: tssNext[]
  l: hlisten a
  h: spawn {c: accept l; r: @[{[b] tlsAccept[b 0; b 1; b 2]}; (c;tssCerts;tssKey); {x}]; hclose l; $[`int=@r; "connected"; r]}
  k: hopen a
  hsend[k; bytes]
  @[{[x] hrecv[x;4096]}; k; {0x}]
  @[hclose; k; {0}]
  join h}
// a ClientHello offering only TLS_AES_128_GCM_SHA256 (0x1301), which crypto.nt has no AES for
tssRec: {[ctype;body] (wu8 ctype), 0x0303, wlp16 body}
tssCh: {[suites;exts] body: 0x0303, (32#0x01), (wlp8 32#0x02), (wlp16 suites), 0x0100, wlp16 exts
  0x01, wlp24 body}
tssStdExts: (wext[43; wlp8 wu16 772]), (wext[13; wlp16 wu16 2052]), wext[51; wlp16 (wu16 29), wlp16 32#0x03]
tok["a client with no ChaCha20-Poly1305 is refused by name"; 0<count (tssRaw tssRec[22; tssCh[wu16 4865; tssStdExts]]) ss "no TLS_CHACHA20_POLY1305_SHA256"]
tok["a client with no TLS 1.3 is refused by name"; 0<count (tssRaw tssRec[22; tssCh[wu16 4867; (wext[13; wlp16 wu16 2052]), wext[51; wlp16 (wu16 29), wlp16 32#0x03]]]) ss "no supported_versions"]
tok["a client with no x25519 share is refused by name"; 0<count (tssRaw tssRec[22; tssCh[wu16 4867; (wext[43; wlp8 wu16 772]), (wext[13; wlp16 wu16 2052]), wext[51; wlp16 (wu16 23), wlp16 32#0x03]]]) ss "no x25519 key_share"]
tok["a record that is not a handshake is refused"; 0<count (tssRaw tssRec[23; 0x0102]) ss "expected a handshake record"]

// ---- HTTPS: httpServe's transport swapped for tlsAccept's, and nothing else
tssH: tssNext[]
tssL: hlisten tssH
tssS: spawn {c: accept tssL; h: tlsAccept[c; tssCerts; tssKey]; httpServeConn[httpTls h; {[req] (200;"OK";()!(); "you asked for ",req`path)}]; tlsClose h; hclose tssL; 1}
tssHC: httpTls tlsConnectOpts["127.0.0.1"; `int$last ":" vs tssH; tssOpts]
tssU: urlParse "https://leaf.neant.test/"
teq["https: a request over TLS"; `char$(httpExchange[tssHC; tssU; "GET"; "/hello%20there"; ()!(); ""])`body; "you asked for /hello there"]
teq["https: and a second on the same connection"; `char$(httpExchange[tssHC; tssU; "GET"; "/again"; ()!(); ""])`body; "you asked for /again"]
(tssHC 2)[]
teq["https: the server loop ended with the connection"; join tssS; 1]
