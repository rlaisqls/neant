// The two DER readers, held to each other. src/neant/crypto/der.nt has the strict one — derTLV
// builds a dict per element and derKids walks the children one at a time — and the columnar one,
// derScan, which finds every element of every buffer in one breadth-first sweep of whole-vector
// operations and hands back columns. x509.nt parses a certificate out of either: x509Parse out of
// the dicts, x509ParseMany out of the columns.
//
// The columnar reader exists for speed (tests/x509bench.nt has the numbers, and docs/performance.md the
// comparison with OpenSSL). This file is what says it did not buy that speed by checking less. It
// asserts three things: that derScan finds exactly the elements derTLV and derKids find, element
// for element and octet for octet, over every certificate in the repository; that x509ParseMany
// returns exactly what x509Parse returns, field for field, over the same; and that everything
// either reader must refuse, both still refuse.
tsection "x509"
{load "src/neant/crypto/",x} each ("der.nt";"x509.nt")

// terrLike calls its argument with no arguments, so the thing under test goes in a closure
x5thunk: {[d] {[] x509Parse d}}
x5batch: {[d] {[] x509ParseMany enlist d}}
x5scan: {[d] {[] derScan enlist d}}
x5parse: {[d] {[] derParse d}}

X5FILES: ("chain-google";"critical-unknown-ext";"pki-critical";"pki-deep";"pki-ec384-leaf")
X5FILES,: ("pki-ec384-root";"pki-ec-leaf";"pki-ec-root";"pki-expired";"pki-future";"pki-int2")
X5FILES,: ("pki-int";"pki-leaf";"pki-notca";"pki-p256x-leaf";"pki-p384-leaf";"pki-p384-root")
X5FILES,: ("pki-pss384-leaf";"pki-root";"pki-selfsigned";"pki-sha384-leaf";"pki-under-notca")
X5FILES,: ("pki-wildcard";"pki-wrong-host";"selfsigned-ec";"selfsigned-pss";"selfsigned-rsa")
x5ders: raze {[f] pemLoad "tests/data/",f,".pem"} each X5FILES
teq["fixtures: every PEM block in tests/data parses"; 0<count x5ders; 1b]

// ---- derScan finds exactly what derTLV and derKids find
x5old: {[nd] out: enlist nd; if[nd`cons; out,: raze x5old each derKids nd]; out}
x5new: {[s;k] out: enlist k; if[(s`cons)[k]; out,: raze x5new[s;] each dsKids[s;k]]; out}
x5S: derScan x5ders
x5no: raze {[d] x5old derParse d} each x5ders
x5nn: raze x5new[x5S;] each x5S`root
teq["derScan: the same number of elements as derTLV"; count x5nn; count x5no]
// class, tag, the constructed bit, the content length, the whole TLV and the content octets
x5cols: {[s;k] (DERCLS[(s`cls)[k]]; (s`tag)[k]; (s`cons)[k]; (s`len)[k]; dsRaw[s;k]; dsV[s;k])}
x5dict: {[a] (a`cls; a`tag; a`cons; a`len; a`raw; a`v)}
x5same: {[a;k] (x5cols[x5S;k]) ~ x5dict a}
teq["derScan: every element agrees, in document order"; count where not x5same'[x5no;x5nn]; 0]
x5span: {[k] (count dsRaw[x5S;k]) = (x5S`hlen)[k]+(x5S`len)[k]}
teq["derScan: `hlen+`len is the length of the whole element"
  count where not x5span each til count x5S`off; 0]

// ---- x509ParseMany returns exactly what x509Parse returns
X5KEYS: `ver`tbs`serial`sigAlg`sigAlgOid`sigParams`sig`issuer`issuerCanon`subject`subjectCanon
X5KEYS,: `notBefore`notAfter`spki`spkiRaw`san`eku`isCa`pathLen`keyUsage`critUnknown
x5a: x509Parse each x5ders
x5b: x509ParseMany x5ders
teq["x509ParseMany: the documented keys, in the documented order"; key x5b[0]; X5KEYS]
teq["x509ParseMany: every certificate, field for field"; count where not {x~y}'[x5a;x5b]; 0]
// the one field a verifier cannot be wrong about: `tbs is what the signature is over
teq["tbs is the tbsCertificate's own octets, byte for byte"
  count where not {[d;c] (c`tbs) ~ ((derKids derParse d)[0])`raw}'[x5ders;x5b]; 0]
teq["a single certificate through the batch reader"; (x509ParseMany enlist x5ders[0])[0]; x5a[0]]
teq["an empty batch"; x509ParseMany (); ()]

// ---- what both readers must refuse
// tests/data/malformed.pem, block by block, in the order tests/data/malformed.py writes them
X5BADMSG: ("der: length runs past the end of the input";"der: non-minimal length")
X5BADMSG,: ("der: indefinite length is not DER";"der: trailing bytes after the top-level element")
X5BADMSG,: ,"x509: signatureAlgorithm does not match the one inside tbsCertificate"
x5m: pemLoad "tests/data/malformed.pem"
teq["malformed.pem: five blocks"; count x5m; 5]
{[i] terrLike["malformed ",(string i),": the strict reader"; x5thunk x5m[i]; X5BADMSG[i]]} each til 5
{[i] terrLike["malformed ",(string i),": the columnar reader"; x5batch x5m[i]; X5BADMSG[i]]} each til 5

// the same rejections at the DER level, where both readers can be pointed straight at them
X5DER: (("an indefinite length, which is BER and not DER"; 0x30800000
    ;"der: indefinite length is not DER")
  ;("a long-form length that the short form could have said"; 0x30810102
    ;"der: non-minimal length")
  ;("a long-form length with a leading zero octet"; 0x30820080
    ;"der: non-minimal length")
  ;("a length that runs past the end of the input"; 0x300505
    ;"der: length runs past the end of the input")
  ;("an octet after the top-level element"; 0x300000
    ;"der: trailing bytes after the top-level element")
  ;("a length that does not fit an int"; 0x3085010203040506
    ;"der: length does not fit an int"))
{[t] terrLike["der: ",(t[0]),", strict"; x5parse t[1]; t[2]]} each X5DER
{[t] terrLike["der: ",(t[0]),", columnar"; x5scan t[1]; t[2]]} each X5DER
// the high-tag-number form: the strict reader decodes it and rejects a non-minimal one; the
// columnar reader does not read it at all, which is why x509ParseMany falls back to x509Parse
terrLike["der: a non-minimal high tag number"; x5parse 0x1f80010000; "der: non-minimal tag"]
terrLike["der: derScan refuses the high-tag-number form outright"; x5scan 0x1f81010000; DERSCANHTN]
teq["x509ParseMany falls back, so a high tag number is still the strict reader's answer"
  (tcatch x5batch 0x1f80010000)[1]; "der: non-minimal tag"]

// the typed readers: every check derInt, derBitStr, derBool, derNull, derStr and derOid make, made
// by dsIntB, dsBitStr, dsBool, dsNull, dsStr and dsOid too
// run the same accessor through both readers and insist they agree — then behave as whichever it
// was, so that terrLike sees the rejection and teq sees the value
x5typed: {[f;g;d] {[]
  r1: tcatch {[] f derParse d}
  r2: tcatch {[] g[derScan enlist d; 0]}
  if[not r1 ~ r2; signal "the readers disagree: ",(tfmt r1[1])," vs ",tfmt r2[1]]
  if[`ok=r1[0]; signal r1[1]]
  r1[1]}}
X5TYPED: (("a non-minimal INTEGER, a leading zero octet that is not needed"; 0x02020001
    ;"der: non-minimal INTEGER")
  ;("a non-minimal INTEGER, a leading 0xff that is not needed"; 0x0202ff80
    ;"der: non-minimal INTEGER")
  ;("an empty INTEGER"; 0x0200; "der: empty INTEGER")
  ;("a BIT STRING whose unused bits are not zero"; 0x030201ff
    ;"der: BIT STRING trailing bits are not zero")
  ;("a BIT STRING claiming nine unused bits"; 0x030209ff
    ;"der: BIT STRING unused-bit count out of range")
  ;("a BIT STRING with no octets that claims unused bits"; 0x030101
    ;"der: BIT STRING has no octets but claims unused bits")
  ;("an empty BIT STRING"; 0x0300; "der: empty BIT STRING"))
{[t] terrLike["der: ",t[0]; x5typed[derInt;dsIntB;t[1]]; t[2]]} each 3#X5TYPED
{[t] terrLike["der: ",t[0]; x5typed[derBitStr;dsBitStr;t[1]]; t[2]]} each 3_X5TYPED
terrLike["der: a NULL with content"; x5typed[derNull;dsNull;0x050100]; "der: NULL with content"]
terrLike["der: a BOOLEAN that is neither 0x00 nor 0xff"; x5typed[derBool;dsBool;0x010101]
  "der: BOOLEAN must be 0x00 or 0xff in DER"]
terrLike["der: a constructed string"; x5typed[derStr;dsStr;0x33020500]
  "der: a DER string must be primitive"]
terrLike["der: a PrintableString with a character outside its set"; x5typed[derStr;dsStr;0x13012a]
  "der: PrintableString has a character outside its set"]
terrLike["der: an OBJECT IDENTIFIER with a padded subidentifier"; x5typed[derOid;dsOid;0x06032a8001]
  "der: non-minimal OBJECT IDENTIFIER subidentifier"]
terrLike["der: an OBJECT IDENTIFIER that ends inside a subidentifier"; x5typed[derOid;dsOid;0x06022a80]
  "der: OBJECT IDENTIFIER ends inside a subidentifier"]
// and the ones both must accept, with the same answer
teq["der: a BOOLEAN of 0xff"; x5typed[derBool;dsBool;0x0101ff][]; 1b]
teq["der: the dotted form of rsaEncryption"; x5typed[derOid;dsOid;0x06092a864886f70d010101][]
  "1.2.840.113549.1.1.1"]
teq["der: the dotted form of an attribute type"; x5typed[derOid;dsOid;0x0603550403][]; "2.5.4.3"]
teq["der: a UTCTime"; x5typed[derTime;dsTime;0x170d3236303931363132303030305a][]
  (2026.09.16; 12:00:00.000)]

// ---- an unrecognised critical extension is reported, not dropped (RFC 5280 4.2)
x5crit: (pemLoad "tests/data/critical-unknown-ext.pem")[0]
teq["a critical extension this parser does not model is reported, by both readers"
  ((x509Parse x5crit)`critUnknown; ((x509ParseMany enlist x5crit)[0])`critUnknown)
  (,"1.3.6.1.4.1.99999.1"; ,"1.3.6.1.4.1.99999.1")]

// ---- PEM
// pemLines takes read0's lines and decodes every block's base64 in one pass; this is the loop it
// replaced, kept here as the thing to agree with
x5pemOld: {[ls]
  out: (); body: ""; open: 0; i: 0
  while[i<count ls
    l: trim ls[i] except "\r"
    if[l ~ X509PEMBEGIN
      if[open; signal "pem: a BEGIN CERTIFICATE inside a block"]
      open: 1; body: ""]
    if[l ~ X509PEMEND
      if[not open; signal "pem: an END CERTIFICATE with no BEGIN"]
      out: $[0=count out; enlist unb64 body; out,enlist unb64 body]
      open: 0]
    if[open & not l ~ X509PEMBEGIN; body,: l]
    i+:1]
  if[open; signal "pem: a BEGIN CERTIFICATE with no END"]
  out}
x5pemF: {[f] ls: read0 "tests/data/",f,".pem"; (pemLines ls) ~ x5pemOld ls}
teq["pemLines: the same DER as the line-at-a-time decoder, on every fixture"
  count where not x5pemF each X5FILES; 0]
teq["pemDecode splits on newlines the way `vs` does"
  count where not {[f] t: "\n" sv read0 "tests/data/",f,".pem"; (pemDecode t) ~ pemLines "\n" vs t} each X5FILES; 0]
X5ONE: "-----BEGIN CERTIFICATE-----\nBQA=\n-----END CERTIFICATE-----"
teq["pemDecode: anything outside the block is ignored"
  hex (pemDecode "junk\n",X5ONE,"\ntrailing junk")[0]; "0500"]
teq["pemDecode: two blocks"; count pemDecode X5ONE,"\n",X5ONE; 2]
teq["pemDecode: no blocks"; count pemDecode "nothing here"; 0]
terrLike["pemDecode: a BEGIN with no END"; {[] pemDecode X5ONE,"\n-----BEGIN CERTIFICATE-----"}
  "pem: a BEGIN CERTIFICATE with no END"]
terrLike["pemDecode: an END with no BEGIN"; {[] pemDecode "-----END CERTIFICATE-----"}
  "pem: an END CERTIFICATE with no BEGIN"]
terrLike["pemDecode: a BEGIN inside a block"
  {[] pemDecode "-----BEGIN CERTIFICATE-----\nBQA=\n-----BEGIN CERTIFICATE-----\nBQA=\n-----END CERTIFICATE-----"}
  "pem: a BEGIN CERTIFICATE inside a block"]
terrLike["pemDecode: a character base64 does not have"
  {[] pemDecode "-----BEGIN CERTIFICATE-----\nB!A=\n-----END CERTIFICATE-----"}; "b64: bad char"]
terrLike["pemDecode: an '=' before the end of a block"
  {[] pemDecode "-----BEGIN CERTIFICATE-----\nB=AA\n-----END CERTIFICATE-----"}; "b64: bad char"]

// ---- and what a certificate SAYS, field by field. This was der_decodes_every_type_a_certificate_uses,
// der_refuses_every_encoding_der_forbids, self_signed_rsa_matches_openssl,
// ec_and_pss_certificates_match_openssl, real_chain_parses_and_links,
// a_critical_extension_nobody_models_is_reported and malformed_certificates_signal in mod x509 in
// src/main.rs. None of them needed Rust: each is a neant expression and the value it must have, so
// `teq` compares the values here rather than the text the REPL would print for them. Every expected
// value was read off `openssl x509 -text -noout` (OpenSSL 3.6.2) for the same fixture, and each
// fixture under tests/data/ carries the command that generated it in its own header. The
// hand-written DER vectors are X.690's own encodings, small enough to read by eye. The keys are
// throwaway and a private half only ever existed to forge the blocks that must NOT verify.
// The globals here take an x5f prefix so that nothing clashes with the columnar suite above.
// `x5fd "hex"` parses one complete element; anything left over is already an error.
x5fd: {[s] derParse unhex s}

// ---- every universal type a certificate uses, decoded from its own encoding
// INTEGER is two's complement, so the sign is in the top bit of the first octet
teq["der: INTEGER 0"; derIntVal x5fd "020100"; 0]
teq["der: INTEGER 127"; derIntVal x5fd "02017f"; 127]
teq["der: INTEGER 128"; derIntVal x5fd "02020080"; 128]
teq["der: INTEGER -1"; derIntVal x5fd "0201ff"; -1]
teq["der: INTEGER -128"; derIntVal x5fd "020180"; -128]
teq["der: INTEGER -256 needs two octets: minimal"; hex derInt x5fd "0202ff00"; "ff00"]
teq["der: BOOLEAN true"; derBool x5fd "0101ff"; 1b]
teq["der: BOOLEAN false"; derBool x5fd "010100"; 0b]
teq["der: NULL"; derNull x5fd "0500"; 0x]
teq["der: OCTET STRING"; hex derOct x5fd "0403010203"; "010203"]
// the first octet packs two arcs as 40*a+b; { 2 999 3 } is X.690 8.19's own example
teq["der: OBJECT IDENTIFIER"; derOid x5fd "06092a864886f70d01010b"; "1.2.840.113549.1.1.11"]
teq["der: OBJECT IDENTIFIER 2.999.3"; derOid x5fd "0603883703"; "2.999.3"]
teq["der: a named OID"; derOidSym derOid x5fd "06092a864886f70d01010b"; `sha256WithRsa]
teq["der: an OID nobody names"; derOidSym derOid x5fd "0603883703"; `unknown]
teq["der: BIT STRING, 4 unused bits, all of them zero"; derBitStr x5fd "030304f0f0"; (4;0xf0f0)]
teq["der: BIT STRING as whole octets"; hex derBits x5fd "0303001234"; "1234"]
teq["der: PrintableString"; derStr x5fd "130461626364"; "abcd"]
teq["der: UTF8String, decoded as UTF-8"; derStr x5fd "0c04c3a9c3a8"; "éè"]
teq["der: T61String, decoded as latin-1"; derStr x5fd "140241e9"; "Aé"]
teq["der: UTCTime"; derTime x5fd "170d3236303130313032303330345a"; (2026.01.01;02:03:04.000)]
teq["der: GeneralizedTime"; derTime x5fd "180f32303236303130313030303030305a"; (2026.01.01;00:00:00.000)]
// RFC 5280 4.1.2.5.1: a two-digit year is 1950..2049, so 49 and 50 land a century apart
teq["der: UTCTime year 49 is 2049"; (derTime x5fd "170d3439303130313030303030305a")[0]; 2049.01.01]
teq["der: UTCTime year 50 is 1950"; (derTime x5fd "170d3530303130313030303030305a")[0]; 1950.01.01]
// structure: long-form length, the high-tag-number form, and a constructed element's kids
x5fLong: x5fd "3081c8",raze 200#enlist "00"
teq["der: long-form length"; (x5fLong[`tag];x5fLong[`hlen];x5fLong[`len]); 16 3 200]
x5fHigh: x5fd "5f1f0100"
teq["der: the high-tag-number form"; (x5fHigh[`cls];x5fHigh[`tag];x5fHigh[`cons]); (`app;31;0b)]
teq["der: a constructed element's kids"; count derKids x5fd "3006020101020102"; 2]
teq["der: an empty SET has none"; count derKids x5fd "3100"; 0]
// the span a node carries is the bytes it came from, not a re-encoding
teq["der: a kid's span is the bytes it came from"; hex (derKids x5fd "3006020101020102")[1][`raw]; "020102"]

// ---- everything that must not parse. A DER reader that shrugs at any of these hands a verifier an
// encoding whose meaning two implementations can disagree about, which is the whole attack.
x5fBad: (("indefinite length"; {[] x5fd "308005000000"}; "der: indefinite length is not DER")
  ;("trailing bytes"; {[] x5fd "050000"}; "der: trailing bytes after the top-level element")
  ;("non-minimal length"; {[] x5fd "3081050500"}; "der: non-minimal length")
  ;("length past the end"; {[] x5fd "30050500"}; "der: length runs past the end of the input")
  ;("truncated header"; {[] x5fd "05"}; "der: input ends inside an element")
  ;("length wider than an int"; {[] x5fd "3085010000000500"}; "der: length does not fit an int")
  ;("non-minimal tag"; {[] x5fd "5f800100"}; "der: non-minimal tag")
  ;("padded positive INTEGER"; {[] derInt x5fd "0202007f"}; "der: non-minimal INTEGER")
  ;("padded negative INTEGER"; {[] derInt x5fd "0202ffff"}; "der: non-minimal INTEGER")
  ;("empty INTEGER"; {[] derInt x5fd "0200"}; "der: empty INTEGER")
  ;("INTEGER wider than an i64"; {[] derIntVal x5fd "0209010000000000000000"}
    ;"der: INTEGER too large for an int")
  ;("BOOLEAN that is not 0x00/0xff"; {[] derBool x5fd "010101"}
    ;"der: BOOLEAN must be 0x00 or 0xff in DER")
  ;("two-octet BOOLEAN"; {[] derBool x5fd "0102ffff"}; "der: BOOLEAN must be one octet")
  ;("NULL with content"; {[] derNull x5fd "050100"}; "der: NULL with content")
  ;("padded OID subidentifier"; {[] derOid x5fd "06032a8001"}
    ;"der: non-minimal OBJECT IDENTIFIER subidentifier")
  ;("OID cut mid-subidentifier"; {[] derOid x5fd "06022a86"}
    ;"der: OBJECT IDENTIFIER ends inside a subidentifier")
  ;("empty OID"; {[] derOid x5fd "0600"}; "der: empty OBJECT IDENTIFIER")
  ;("BIT STRING with set unused bits"; {[] derBitStr x5fd "030304f0f1"}
    ;"der: BIT STRING trailing bits are not zero")
  ;("BIT STRING claiming 8 unused"; {[] derBitStr x5fd "03020800"}
    ;"der: BIT STRING unused-bit count out of range")
  ;("empty BIT STRING with unused bits"; {[] derBitStr x5fd "030101"}
    ;"der: BIT STRING has no octets but claims unused bits")
  ;("partial-octet key"; {[] derBits x5fd "030304f0f0"}
    ;"der: BIT STRING is not a whole number of octets")
  ;("PrintableString with @"; {[] derStr x5fd "130140"}
    ;"der: PrintableString has a character outside its set")
  ;("IA5String above ASCII"; {[] derStr x5fd "160180"}; "der: IA5String is not ASCII")
  ;("constructed string"; {[] derStr x5fd "3300"}; "der: a DER string must be primitive")
  ;("UTCTime without seconds"; {[] derTime x5fd "170b3236303130313030303030"}
    ;"der: UTCTime must be 13 characters")
  ;("UTCTime without Z"; {[] derTime x5fd "170d323630313031303030303030ff"}
    ;"der: UTCTime must end in Z")
  ;("month 13"; {[] derTime x5fd "170d3236313330313030303030305a"}
    ;"der: month out of range in UTCTime")
  ;("30 February"; {[] derTime x5fd "170d3236303233303030303030305a"}
    ;"der: day out of range in UTCTime")
  ;("second 60"; {[] derTime x5fd "170d3236303130313030303036305a"}
    ;"der: second out of range in UTCTime")
  ;("primitive SEQUENCE"; {[] derWant[x5fd "1000";16;1b]}; "der: SEQUENCE must be constructed")
  ;("kids of a primitive"; {[] derKids x5fd "0500"}
    ;"der: expected a constructed element, got a primitive one"))
{[t] terrLike["der refuses: ",t[0]; t[1]; t[2]]} each x5fBad

// ---- the self-signed RSA fixture, field by field. Its key is regenerated by the command in its
// header, so nothing here depends on the modulus' value — only on its size and on the fields the
// command itself fixes.
x5fC: x509Parse (pemLoad "tests/data/selfsigned-rsa.pem")[0]
teq["rsa cert: version"; x5fC`ver; 3]
teq["rsa cert: serial"; hex x5fC`serial; "0102030405060708"]        // openssl: serial=0102030405060708
teq["rsa cert: sigAlg"; x5fC`sigAlg; `rsaPkcs1Sha256]               // Signature Algorithm: sha256WithRSA
teq["rsa cert: sigAlgOid"; x5fC`sigAlgOid; "1.2.840.113549.1.1.11"]
teq["rsa cert: PKCS#1 v1.5 has no parameters"; x5fC`sigParams; ()!()]
// openssl x509 -noout -subject -issuer -nameopt RFC2253, verbatim
teq["rsa cert: subject"; x5fC`subject; "CN=selfsigned.neant.test,OU=crypto,O=neant,L=San Francisco,ST=California,C=US"]
teq["rsa cert: self-signed, so it is its own issuer"; (x5fC`issuer) ~ x5fC`subject; 1b]
teq["rsa cert: and canonically too"; (x5fC`issuerCanon) ~ x5fC`subjectCanon; 1b]
teq["rsa cert: subjectCanon"; x5fC`subjectCanon; "2.5.4.6=us,2.5.4.8=california,2.5.4.7=san francisco,2.5.4.10=neant,2.5.4.11=crypto,2.5.4.3=selfsigned.neant.test"]
teq["rsa cert: notBefore"; x5fC`notBefore; (2026.01.01;00:00:00.000)]   // Not Before: Jan  1 00:00:00 2026
teq["rsa cert: notAfter"; x5fC`notAfter; (2036.01.01;00:00:00.000)]     // Not After : Jan  1 00:00:00 2036
teq["rsa cert: spki alg"; (x5fC`spki)`alg; `rsa]
teq["rsa cert: Public-Key: (2048 bit)"; count (x5fC`spki)`n; 256]
teq["rsa cert: Exponent: 65537 (0x10001)"; hex (x5fC`spki)`e; "010001"]
teq["rsa cert: the sign octet is stripped"; 0=`int$((x5fC`spki)`n)[0]; 0b]
teq["rsa cert: san, with the IP: entry skipped"; x5fC`san; ("selfsigned.neant.test";"alt.neant.test")]
teq["rsa cert: eku is serverAuth, clientAuth"; x5fC`eku; ("1.3.6.1.5.5.7.3.1";"1.3.6.1.5.5.7.3.2")]
teq["rsa cert: CA:TRUE, pathlen:2"; (x5fC`isCa; x5fC`pathLen); (1b;2)]
teq["rsa cert: keyUsage"; x5fC`keyUsage; `digitalSignature`keyCertSign`cRLSign]
teq["rsa cert: both critical extensions are modelled"; x5fC`critUnknown; ()]
teq["rsa cert: signature length"; count x5fC`sig; 256]
// `tbs is the span, not a re-encoding: it is exactly the bytes at offset 4 of the file
x5fDer: (pemLoad "tests/data/selfsigned-rsa.pem")[0]
teq["rsa cert: tbs is the span the file holds"; (x5fC`tbs) ~ x5fDer[4+til count x5fC`tbs]; 1b]

// ---- the EC and RSASSA-PSS fixtures: the two spki shapes and the two signature-algorithm shapes
// the RSA fixture cannot reach. PSS names its hash in the parameters, not in the OID.
x5fE: x509Parse (pemLoad "tests/data/selfsigned-ec.pem")[0]
x5fP: x509Parse (pemLoad "tests/data/selfsigned-pss.pem")[0]
teq["ec cert: serial"; `int$(x5fE`serial)[0]; 42]                   // openssl: serial=2A
teq["ec cert: sigAlg"; x5fE`sigAlg; `ecdsaSha256]                   // ecdsa-with-SHA256
teq["ec cert: sigAlgOid"; x5fE`sigAlgOid; "1.2.840.10045.4.3.2"]
teq["ec cert: subject"; x5fE`subject; "CN=ec.neant.test,O=neant,C=US"]
teq["ec cert: spki alg"; (x5fE`spki)`alg; `ec]
teq["ec cert: NIST CURVE: P-256"; (x5fE`spki)`curve; `p256]
teq["ec cert: ASN1 OID: prime256v1"; (x5fE`spki)`oid; "1.2.840.10045.3.1.7"]
teq["ec cert: 0x04 and two 32-octet coordinates"; count (x5fE`spki)`point; 65]
teq["ec cert: san"; x5fE`san; enlist "ec.neant.test"]
// CA:FALSE is the DEFAULT, so DER encodes BasicConstraints as an empty SEQUENCE
teq["ec cert: CA:FALSE is the default"; (x5fE`isCa; x5fE`pathLen); (0b;0N)]
teq["ec cert: keyUsage"; x5fE`keyUsage; enlist `digitalSignature]
teq["pss cert: serial"; `int$(x5fP`serial)[0]; 123]                 // openssl: serial=7B
teq["pss cert: sigAlg"; x5fP`sigAlg; `rsaPssSha256]                 // Signature Algorithm: rsassaPss
teq["pss cert: sigAlgOid"; x5fP`sigAlgOid; "1.2.840.113549.1.1.10"]
// Hash Algorithm: sha256 / Mask Algorithm: mgf1 with sha256 / Salt Length: 0x20
teq["pss cert: sigParams"; x5fP`sigParams; `hash`mgfHash`saltLen!(`sha256;`sha256;32)]
teq["pss cert: spki alg"; (x5fP`spki)`alg; `rsa]
teq["pss cert: no keyUsage extension at all"; x5fP`keyUsage; ()]

// ---- a chain exactly as a server sends one. The point of `issuerCanon`/`subjectCanon` is here:
// chain building matches one certificate's issuer against another's subject, and it must be a
// comparison on a canonical form, not on the printable text.
x5fCs: x509Parse each pemLoad "tests/data/chain-google.pem"
teq["chain: leaf, intermediate, root"; count x5fCs; 3]
teq["chain: the leaf's subject"; (x5fCs[0])`subject; "CN=www.google.com"]
teq["chain: the leaf's issuer"; (x5fCs[0])`issuer; "CN=WE2,O=Google Trust Services,C=US"]
teq["chain: the leaf's serial"; hex (x5fCs[0])`serial; "465ba8f43add48190abbcabc0878c127"]
teq["chain: Not Before: Sep 4 08:06:59 2026"; (x5fCs[0])`notBefore; (2026.09.04;08:06:59.000)]
teq["chain: the leaf's notAfter"; (x5fCs[0])`notAfter; (2026.11.27;08:06:58.000)]
teq["chain: the leaf's sigAlg"; (x5fCs[0])`sigAlg; `ecdsaSha256]
teq["chain: the leaf's curve"; ((x5fCs[0])`spki)`curve; `p256]
teq["chain: the leaf's san"; (x5fCs[0])`san; enlist "www.google.com"]
teq["chain: the leaf is not a CA"; ((x5fCs[0])`isCa; (x5fCs[0])`pathLen); (0b;0N)]
teq["chain: the intermediate's subject"; (x5fCs[1])`subject; "CN=WE2,O=Google Trust Services,C=US"]
teq["chain: the intermediate's sigAlg"; (x5fCs[1])`sigAlg; `ecdsaSha384]
teq["chain: CA:TRUE, pathlen:0"; ((x5fCs[1])`isCa; (x5fCs[1])`pathLen); (1b;0)]
teq["chain: the root's subject"; (x5fCs[2])`subject; "CN=GTS Root R4,O=Google Trust Services LLC,C=US"]
teq["chain: the root's issuer"; (x5fCs[2])`issuer; "CN=GlobalSign Root CA,OU=Root CA,O=GlobalSign nv-sa,C=BE"]
teq["chain: an EC key cross-signed by RSA"; (x5fCs[2])`sigAlg; `rsaPkcs1Sha256]
teq["chain: the root's curve"; ((x5fCs[2])`spki)`curve; `p384]
teq["chain: CA:TRUE with no pathlen"; ((x5fCs[2])`isCa; (x5fCs[2])`pathLen); (1b;0N)]
teq["chain: nothing critical is unmodelled"; {x`critUnknown} each x5fCs; (();();())]
teq["chain: the leaf links to the intermediate"; (x5fCs[0])[`issuerCanon] ~ (x5fCs[1])`subjectCanon; 1b]
teq["chain: the intermediate links to the root"; (x5fCs[1])[`issuerCanon] ~ (x5fCs[2])`subjectCanon; 1b]
teq["chain: and the leaf does not link to the root"; (x5fCs[0])[`issuerCanon] ~ (x5fCs[2])`subjectCanon; 0b]
// the hashes a verifier will actually sign-check, over the spans the parser kept:
//   python3 -c 'import base64,hashlib,re,sys; ...' -- or equivalently
//   openssl asn1parse -in <one cert> -strparse 4 -noout -out - | sha256sum
teq["chain: sha256 of the leaf's tbs"; hex sha256 (x5fCs[0])`tbs; "68d4a9fb5c3da2814f42d61dd2558273479b5f75fd8ae13d7f9e715c3eae7306"]
teq["chain: sha256 of the intermediate's tbs"; hex sha256 (x5fCs[1])`tbs; "c3210337a3f77559f6371588cdc4894e3d084bb79f4c283f9320b7bd8cf16474"]
teq["chain: sha256 of the root's tbs"; hex sha256 (x5fCs[2])`tbs; "6e62a0efd60a04d93f2f864b54442717a666c038c8c70546af6319e4f46a2f73"]

// ---- RFC 5280 4.2: a critical extension a verifier does not understand means the certificate must
// be rejected. Dropping it silently is a way a verifier gets fooled, so it is reported instead.
x5fCrit: x509Parse (pemLoad "tests/data/critical-unknown-ext.pem")[0]
teq["critical: the unmodelled extension is named"; x5fCrit`critUnknown; enlist "1.3.6.1.4.1.99999.1"]
teq["critical: subject"; x5fCrit`subject; "CN=critical.neant.test"]
teq["critical: serial"; hex x5fCrit`serial; "1234"]

// ---- tests/data/malformed.pem, block by block, in the order tests/data/malformed.py writes them.
// The last one is the interesting one: two AlgorithmIdentifiers of the same length that say
// different things, which only RFC 5280 4.1.1.2's equality check catches.
x5fDs: pemLoad "tests/data/malformed.pem"
teq["malformed: five blocks"; count x5fDs; 5]
x5fMal: ((0; "der: length runs past the end of the input")
  ;(1; "der: non-minimal length")
  ;(2; "der: indefinite length is not DER")
  ;(3; "der: trailing bytes after the top-level element")
  ;(4; "x509: signatureAlgorithm does not match the one inside tbsCertificate"))
{[t] terrLike["malformed: block ",string t[0]; {[] x509Parse x5fDs[t[0]]}; t[1]]} each x5fMal
