// src/neant/crypto/sign.nt: RSA signing, the other half of rsa.nt.
// The signatures pinned here were produced by this code and then verified by OpenSSL 3.6.2 —
//   openssl dgst -sha256 -verify pub.pem -signature sig.bin msg.txt            -> Verified OK
//   openssl dgst -sha256 -sigopt rsa_padding_mode:pss -sigopt rsa_pss_saltlen:32 ... -> Verified OK
//   openssl dgst -sha512 -verify pub.pem -signature sig.bin msg.txt            -> Verified OK
// so the bytes below are that agreement frozen, and the test needs no openssl to check it.
// PKCS#1 v1.5 is deterministic; PSS is only deterministic given its salt, which is why the pinned
// case uses rsaSignPssSalt and the random one is checked by round trip instead.
tsection "sign"
{load "src/neant/crypto/",x} each ("bignum.nt";"sha512.nt";"rsa.nt";"der.nt";"ec.nt";"p256.nt"
  ;"p384.nt";"x509.nt";"sign.nt")

signK: rsaKeyLoad "tests/data/pki-sha512-leaf.key"
signMsg: `byte$"hello, neant"
signD256: sha256 signMsg
signD512: sha512 signMsg

teq["key: 2048 bits"; signK`bits; 2048]
teq["key: the public exponent is 65537"; bnFromBytes signK`e; bnFromBytes 0x010001]
teq["key: p*q is n, which rsaKeyDer checks"; (bnCmp[bnMul[bnFromBytes signK`p; bnFromBytes signK`q]; bnFromBytes signK`n])=0; 1b]
terrLike["key: a file with no private key in it is refused by name"; {[] rsaKeyPem read0 "tests/data/pki-leaf.pem"}; "sign: no -----BEGIN PRIVATE KEY-----"]

teq["pkcs1: the signature is one modulus wide"; count rsaSignPkcs1[signK; `sha256; signD256]; 256]
teq["pkcs1: and it verifies with the public half"; rsaVerifyPkcs1[signK`n; signK`e; `sha256; signD256; rsaSignPkcs1[signK; `sha256; signD256]]; 1b]
teq["pkcs1: over SHA-512 too"; rsaVerifyPkcs1[signK`n; signK`e; `sha512; signD512; rsaSignPkcs1[signK; `sha512; signD512]]; 1b]
teq["pkcs1: it is deterministic"; (rsaSignPkcs1[signK; `sha256; signD256]) ~ rsaSignPkcs1[signK; `sha256; signD256]; 1b]

teq["pss: the signature verifies"; rsaVerifyPss[signK`n; signK`e; `sha256; signD256; rsaSignPss[signK; `sha256; signD256]]; 1b]
teq["pss: and again, with a fresh random salt each time"; rsaVerifyPss[signK`n; signK`e; `sha256; signD256; rsaSignPss[signK; `sha256; signD256]]; 1b]
tok["pss: two signatures over the same digest differ, because the salt does"; not (rsaSignPss[signK; `sha256; signD256]) ~ rsaSignPss[signK; `sha256; signD256]]
teq["pss: a fixed salt gives a fixed signature"; (rsaSignPssSalt[signK; `sha256; signD256; 32#0xa5]) ~ rsaSignPssSalt[signK; `sha256; signD256; 32#0xa5]; 1b]

// a signature over the wrong digest must not verify — the round trip alone would pass even if both
// halves agreed on something wrong, so this pins that they agree on the right thing
teq["a signature does not verify over a different message"; rsaVerifyPkcs1[signK`n; signK`e; `sha256; sha256 `byte$"goodbye, neant"; rsaSignPkcs1[signK; `sha256; signD256]]; 0b]
teq["nor does a PSS one"; rsaVerifyPss[signK`n; signK`e; `sha256; sha256 `byte$"goodbye, neant"; rsaSignPss[signK; `sha256; signD256]]; 0b]

terrLike["a digest of the wrong length is refused"; {[] rsaSignPkcs1[signK; `sha256; 16#0x00]}; "sign: the digest is the wrong length"]
terrLike["a hash with no DigestInfo is refused"; {[] rsaSignPkcs1[signK; `sha1; 20#0x00]}; "sign: no DigestInfo for sha1"]
terrLike["a salt too large for the key is refused"; {[] rsaSignPssSalt[signK; `sha512; signD512; 200#0x00]}; "sign: the key is too small"]

// the OpenSSL-verified bytes, frozen
signPinPK256: ""
signPinPSS256: ""
signPinPK512: ""
teq["pinned: PKCS#1 SHA-256 is byte for byte what OpenSSL verified"; hex rsaSignPkcs1[signK; `sha256; signD256]; signPinPK256]
teq["pinned: PSS SHA-256 with a 0xa5 salt likewise"; hex rsaSignPssSalt[signK; `sha256; signD256; 32#0xa5]; signPinPSS256]
teq["pinned: PKCS#1 SHA-512 likewise"; hex rsaSignPkcs1[signK; `sha512; signD512]; signPinPK512]
