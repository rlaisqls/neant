// src/neant/stdlib/json.nt: jk parses, jj serializes.  null parses to :: — passing :: to a function makes a
// projection, so those cases go through tok and ~ instead of teq.
tsection "json: parse scalars"
teq["jk int"; jk "1"; 1]
teq["jk negative"; jk "-5"; -5]
teq["jk float"; jk "1.5"; 1.5]
teq["jk exponent"; jk "1e3"; 1000.0]
teq["jk negative exponent"; jk "-2.5e-1"; -0.25]
teq["jk true"; jk "true"; 1b]
teq["jk false"; jk "false"; 0b]
tok["jk null"; null~jk "null"]
teq["jk string"; jk "\"abc\""; "abc"]
teq["jk empty string"; jk "\"\""; ""]

tsection "json: parse containers"
teq["jk empty array"; jk "[]"; ()]
teq["jk empty object"; jk "{}"; ()!()]
teq["jk ints"; jk "[1, 2, 3]"; 1 2 3]
teq["jk mixed numbers are floats"; jk "[1, 2.5]"; 1 2.5]
teq["jk mixed list"; jk "[1, \"a\"]"; (1;,"a")]   // a JSON string is always a chars vector, never the char atom "a"
teq["jk bools"; jk "[true, false]"; 10b]
teq["jk strings"; jk "[\"a\", \"b\"]"; (,"a";,"b")]
teq["jk null in array"; jk "[null, 1]"; (null;1)]
teq["jk nested arrays"; jk "[1, [2, [3]]]"; (1;(2;,3))]
teq["jk object"; jk "{\"a\": [1, 2]}"; enlist[`a]!enlist 1 2]
teq["jk object mixed"; jk "{\"a\": 1, \"b\": \"x\"}"; `a`b!(1;,"x")]
nested: jk "{\"a\": {\"b\": {\"c\": [1, [2, 3]]}}}"
teq["jk nested objects"; nested[`a][`b][`c]; (1;2 3)]
teq["jk whitespace"; jk "  { \"a\" : 1 , \"b\" : [ 1 , 2 ] }  "; `a`b!(1;1 2)]
teq["jk null value"; type (jk "{\"a\": null}")[`a]; `null]
teq["jk object with null, bool, float"; jk "{\"a\": true, \"b\": null, \"c\": 1.5}"; `a`b`c!(1b;null;1.5)]
teq["jk keys"; key jk "{\"x\": 1, \"y\": 2}"; `x`y]
teq["jk lookup"; (jk "{\"a\": 1}")[`a]; 1]
teq["jk ints are typed"; type jk "[1,2]"; `ints]
teq["jk floats are typed"; type jk "[1.0,2]"; `floats]
teq["jk strings are a list"; type jk "[\"a\",\"b\"]"; `list]

tsection "json: escapes"
teq["jk newline"; jk "\"a\\nb\""; "a\nb"]
teq["jk tab"; jk "\"tab\\there\""; "tab\there"]
teq["jk quote"; jk "\"q\\\"q\""; "q\"q"]
teq["jk backslash"; jk "\"back\\\\slash\""; "back\\slash"]
teq["jk solidus"; jk "\"slash\\/x\""; "slash/x"]
teq["jk \\u ascii"; jk "\"\\u0041\""; ,"A"]
teq["jk \\u latin"; jk "\"\\u00e9\""; ,"é"]
teq["jk \\u is one char"; count jk "\"\\u00e9\""; 1]
teq["jk \\u run"; jk "\"\\u0041\\u0042\""; "AB"]

tsection "json: serialize"
teq["jj int"; jj 1; ,"1"]      // jj returns a string, so the one-digit case is ,"1", not the char atom
teq["jj negative"; jj[-5]; "-5"]
teq["jj float"; jj 1.5; "1.5"]
teq["jj whole float"; jj 2.0; ,"2"]
teq["jj true"; jj 1b; "true"]
teq["jj false"; jj 0b; "false"]
teq["jj int null"; jj 0N; "null"]
teq["jj float null"; jj 0n; "null"]
teq["jj null in list"; jj (1;null;2); "[1, null, 2]"]
teq["jj null in ints"; jj 1 0N; "[1, null]"]
teq["jj string"; jj "abc"; "\"abc\""]
teq["jj char"; jj "a"; "\"a\""]
teq["jj empty string"; jj ""; "\"\""]
teq["jj sym"; jj `abc; "\"abc\""]
teq["jj date"; jj 2026.01.01; "\"2026.01.01\""]
teq["jj time"; jj 12:30:00; "\"12:30:00.000\""]
teq["jj ints"; jj 1 2 3; "[1, 2, 3]"]
teq["jj floats"; jj 1.5 2.5; "[1.5, 2.5]"]
teq["jj bools"; jj 101b; "[true, false, true]"]
teq["jj empty list"; jj (); "[]"]
teq["jj empty dict"; jj ()!(); "{}"]
teq["jj dict"; jj `a`b!(1 2;"x"); "{\"a\": [1, 2], \"b\": \"x\"}"]
teq["jj one-key dict"; jj `a!enlist 1; "{\"a\": 1}"]
teq["jj mixed list"; jj (1;"a";1b); "[1, \"a\", true]"]
teq["jj nested"; jj `a`b!(`a!,1;(1 2;3 4)); "{\"a\": {\"a\": 1}, \"b\": [[1, 2], [3, 4]]}"]
teq["jj escapes quote"; jj "a\"b"; "\"a\\\"b\""]
teq["jj escapes backslash"; jj "a\\b"; "\"a\\\\b\""]
teq["jj escapes control"; jj "a\nb\tc"; "\"a\\nb\\tc\""]
terrLike["jj function"; {[] jj {x}}; "json: cannot serialize"]

tsection "json: round trips"
teq["round trip dict"; jk jj `a`b!(1 2;"x"); `a`b!(1 2;,"x")]   // the char atom comes back as a one-char string
teq["round trip nested"; jj jk "{\"a\": [1, {\"b\": null}], \"c\": \"d\\ne\"}"; "{\"a\": [1, {\"b\": null}], \"c\": \"d\\ne\"}"]
teq["round trip text"; jk jj "he said \"hi\"\n"; "he said \"hi\"\n"]
teq["round trip bools"; jk jj 101b; 101b]

tsection "json: malformed input"
terrLike["jk unclosed array"; {[] jk "[1, 2"}; "json: expected , or ]"]
terrLike["jk missing colon"; {[] jk "{\"a\" 1}"}; "json: expected :"]
terrLike["jk bare key"; {[] jk "{a: 1}"}; "json: expected key"]
terrLike["jk bad literal"; {[] jk "tru"}; "json: bad literal"]
terrLike["jk trailing comma"; {[] jk "[1,]"}; "json: unexpected ]"]
terrLike["jk trailing input"; {[] jk "1 2"}; "json: trailing input"]
terrLike["jk empty input"; {[] jk ""}; "json: unexpected end"]
terrLike["jk unterminated string"; {[] jk "\"abc"}; "json: unterminated string"]
terrLike["jk error carries position"; {[] jk "{\"a\": 1,}"}; "json: expected key at 8"]
terr["jk stray bracket"; {[] jk "]"}]
