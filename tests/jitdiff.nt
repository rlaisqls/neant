// A GENERATOR for the JIT, not a list of cases.
//
// Both of the wrong answers this tree's JIT has produced were found by accident, while measuring
// something else: `{x>3}` changed its result type once it got hot, and every `$[c; a; b]` whose arms
// ended the function returned the wrong arm. A wrong register is a wrong ANSWER and not a bail, so
// the fail-closed design that makes everything else here safe does nothing for this one class — and
// a hand-written list only ever covers the shapes somebody thought of. tests/jit.nt keeps those
// cases as regressions; this covers the class they came from.
//
// THE BASELINE. Each body is built twice: once as written, and once with a single integer literal
// wrapped in `(- - n)`. The pair has the same value for every input and differs only in that the
// second can never be compiled, because a monadic minus pair is outside the subset either tier will
// take. That is the only honest interpreter baseline available — since the tracing tier landed, a
// function's own first call is not one, because a loop inside it can be taken over partway through
// (tests/jit.nt's header says the same thing about its hand-written cases).
//
// The seed is fixed, so a failure is reproducible and prints the body that caused it.
tsection "jit: generated differential"
rseed 20260918

jdVar:  {$[0=rand[2]; "x"; "y"]}
jdLit:  {string rand[20]}                       // non-negative only: a bare `-3` after a verb lexes
jdAtom: {$[0=rand[2]; jdVar[]; jdLit[]]}        // as a monadic minus, which is not compilable at all
jdOp:   {,("+-*&|")[rand[5]]}
jdCmp:  {,("<>=")[rand[3]]}

// a fully parenthesised expression: this language has no precedence, so anything less is ambiguous
jdExpr: {[d]
  if[d<1; :jdAtom[]]
  r: rand[6]
  if[r=0; :"(",(jdExpr[d-1]),(jdOp[]),(jdExpr[d-1]),")"]
  if[r=1; :"($[",(jdExpr[d-1]),(jdCmp[]),(jdExpr[d-1]),"; ",(jdExpr[d-1]),"; ",(jdExpr[d-1]),"])"]
  if[r=2; :"(",(jdExpr[d-1])," band ",(jdExpr[d-1]),")"]
  if[r=3; :"(",(jdExpr[d-1])," bxor ",(jdExpr[d-1]),")"]
  if[r=4; :"(",(jdExpr[d-1])," shr ",(string rand[8]),")"]
  "(",(jdExpr[d-1])," badd ",(jdExpr[d-1]),")"}

// the same source with its first integer literal wrapped, which is what makes the twin uncompilable.
// A body of nothing but variables has no literal to wrap, and the twin would then be the same
// source and no baseline at all, so that case wraps the whole expression instead — `- - (e)` is the
// same pair of monadic minuses and equally outside the subset.
jdSlow: {[s]
  d: & s in "0123456789"
  if[0=count d; :"(- - (",s,"))"]
  a: first d
  b: a
  while[$[b<count s; (s[b]) in "0123456789"; 0b]; b+:1]
  (a#s),"(- - ",(s[a+til b-a]),")",b _ s}

// x and y at both ends of the range, around zero, and where a multiply overflows
jdArgs: ((0;0);(1;2);(5;3);(3;5);(0-7;4);(4;0-7);(1;0);(0;1);(1000000;7);(123456789;987654321))
// `@[h; v; handler]` hands h the whole of v as ONE argument, so h takes the pair and splits it
// `@[h; v; handler]` hands h the whole of v as ONE argument, so h takes the pair and splits it
jdCall:  {[f;a] @[{[p] (p 0)[(p 1) 0; (p 1) 1]}; (f;a); {"'",x}]}
jdApply: {[f] jdCall[f] each jdArgs}

// drive the method tier past its 64-call threshold with arguments that take both sides of a branch.
// A LOOP template needs far fewer: the tracing tier takes a hot loop over partway through a single
// call, so four is already past it, and the difference is the whole runtime of this file.
// the warm-up has to survive a body that signals — an index off the end does, on purpose
jdWarm: {[f;k] i: 0; while[i<k; jdCall[f; (i-100; 100-i)]; i+:1]}

// built together so the twin is the SAME body, not another draw from the generator
jdPair: {[mk;depth] body: jdExpr depth; (mk body; mk jdSlow body)}

// `mkf` is a maker, not a template: the templates below choose their own trip counts with `rand`,
// so the template has to be drawn ONCE per case and used for both halves of the pair. Calling the
// template maker twice gave the two halves different loop bounds, which is not a disagreement about
// anything.
jdRun: {[nm;mkf;depth;n;warm]
  bad: ()
  i: 0
  while[i<n
    p: jdPair[mkf[];depth]
    f: @[nrun; p 0; {`err}]
    g: @[nrun; p 1; {`err}]
    // `@` gives a symbol, never a numeric type code
    if[not (`sym=@f) | `sym=@g
      jdWarm[f;warm]
      if[not (jdApply f)~jdApply g; bad,: enlist p 0]]
    i+:1]
  // a failure prints the body that caused it, which with the fixed seed above reproduces exactly
  teq[nm," (",(string n)," bodies)"; $[0=count bad; "none"; first bad]; "none"]}

// the method tier: a whole function, compiled after 64 calls
jdMethod: {[b] "{[x;y] ",b,"}"}
jdRun["the method tier agrees with the interpreter"; {jdMethod}; 3; 400; 200]
jdRun["the method tier, deeper bodies"; {jdMethod}; 4; 200; 200]

// a body that ENDS in a conditional is the shape that was broken: the arm that falls through meets
// the other at a position the compiler's linear walk never visited
jdTail: {[b] "{[x;y] ($[x>y; ",b,"; ",b,"])}"}
jdRun["a conditional that ends the function"; {jdTail}; 2; 300; 200]

// the tracing tier: a loop hot enough to be taken over inside a single call
jdLoop: {[b] "{[x;y] s: 0; i: 0; while[i<120; s: (s badd ",b,"); x: (x+1); i: i+1]; s}"}
jdRun["the tracing tier agrees with the interpreter"; {jdLoop}; 3; 200; 4]
jdDo: {[b] "{[x;y] s: 0; do[120; s: (s badd ",b,"); x: (x+1)]; s}"}
jdRun["a do loop agrees with the interpreter"; {jdDo}; 3; 200; 4]

// ---- the tracing tier proper.
//
// A trace is one recorded path through a loop body, kept behind guards. What has to hold is that a
// guard which stops agreeing hands control back to the interpreter at exactly the right bytecode
// position, with every local and the whole operand stack as the interpreter would have had them.
// The two templates above only stress that incidentally, through `x: (x+1)` drifting a comparison
// over the iterations. These aim at it: trip counts that straddle the threshold, a branch that
// flips at a chosen iteration, several loop-carried locals, a stack that is not empty at the
// branch, nesting, a vector slot, an early return out of a loop, `break`, and arithmetic that
// reaches the int null mid-loop.
jdN: {(8; 40; 63; 64; 65; 100; 200)[rand[7]]}

jdFlipT: {[n;k;b] "{[x;y] s: 0; i: 0; while[i<",(string n),"; if[i>",(string k),"; s: (s badd ",b,")]; if[i<",(string k),"; s: (s bxor ",b,")]; x: (x+1); i: i+1]; s}"}
jdFlip: {n: jdN[]; jdFlipT[n; rand[1+n]]}
jdRun["a guard that stops agreeing partway"; jdFlip; 2; 250; 4]

jdCarryT: {[n;b] "{[x;y] a2: 1; b2: 2; c2: 3; i: 0; while[i<",(string n),"; a2: (a2 badd ",b,"); b2: (b2 bxor a2); c2: (c2 badd b2); x: (x+1); i: i+1]; ((a2 bxor b2) badd c2)}"}
jdCarry: {jdCarryT[jdN[]]}
jdRun["several loop-carried locals"; jdCarry; 2; 250; 4]

jdUnderLoopT: {[n;b] "{[x;y] s: 0; i: 0; while[i<",(string n),"; s: (s badd (($[x>y; ",b,"; ",b,"]) badd ",b,")); x: (x+1); i: i+1]; s}"}
jdUnderLoop: {jdUnderLoopT[jdN[]]}
jdRun["a branch with the stack not empty under it"; jdUnderLoop; 2; 250; 4]

jdNestT: {[n;m;b] "{[x;y] s: 0; i: 0; while[i<",(string n),"; j: 0; while[j<",(string m),"; s: (s badd ",b,"); j: j+1]; x: (x+1); i: i+1]; s}"}
jdNest: {jdNestT[jdN[]; jdN[]]}
jdRun["a loop inside a loop"; jdNest; 2; 120; 4]

jdRetLoopT: {[n;k;b] "{[x;y] s: 0; i: 0; while[i<",(string n),"; s: (s badd ",b,"); if[i>",(string k),"; :s]; i: i+1]; s}"}
jdRetLoop: {n: jdN[]; jdRetLoopT[n; rand[1+n]]}
jdRun["an early return out of a loop"; jdRetLoop; 2; 250; 4]

jdBreakT: {[n;k;b] "{[x;y] s: 0; i: 0; while[i<",(string n),"; s: (s badd ",b,"); if[i>",(string k),"; break]; x: (x+1); i: i+1]; s}"}
jdBreak: {n: jdN[]; jdBreakT[n; rand[1+n]]}
jdRun["a break out of a loop"; jdBreak; 2; 250; 4]

// a buffer the function makes for itself and returns, which is what jitVecAllocs added: the whole
// loop compiles, so these bodies are checked against an interpreter that really is one. The length
// is a literal and not a parameter on purpose — jdArgs reaches 123456789, and a generated body
// asking for a vector that long would be the twin allocating a gigabyte, not a test.
jdBufT: {[n;b] "{[x;y] r: ",(string n),"#0; i: 0; while[i<",(string n),"; r[i]: ",b,"; x: (x+1); i: i+1]; r}"}
jdBuf: {jdBufT[jdN[]]}
jdRun["a buffer the function makes"; jdBuf; 2; 250; 4]

// a vector slot written and read in the loop, which is its own mechanism in the codegen
jdVecT: {[n;b] "{[x;y] r: ",(string n),"#0; i: 0; while[i<",(string n),"; r[i]: ",b,"; x: (x+1); i: i+1]; (sum r)}"}
jdVec: {jdVecT[jdN[]]}
jdRun["a vector written in the loop"; jdVec; 2; 250; 4]
jdVecReadT: {[n;b] "{[x;y] v: ",(string n),"#til 7; s: 0; i: 0; while[i<",(string n),"; s: (s badd (v[i] badd ",b,")); i: i+1]; s}"}
jdVecRead: {jdVecReadT[jdN[]]}
jdRun["a vector read in the loop"; jdVecRead; 2; 250; 4]

// an index that walks off the end of the vector, so the bounds check has to deopt at the same
// iteration the interpreter would have signalled at — jdCall catches the error, so the two are
// compared on the message
jdVecOobT: {[n;b] "{[x;y] v: 5#til 7; s: 0; i: 0; while[i<",(string n),"; s: (s badd (v[i] badd ",b,")); i: i+1]; s}"}
jdVecOob: {jdVecOobT[jdN[]]}
jdRun["an index that runs off the end"; jdVecOob; 2; 250; 4]

// `+` rather than `badd`, starting where it reaches the int null: the sentinel is what the compiled
// path has to bail on, and it has to bail at the same point the interpreter notices
jdNullT: {[n;b] "{[x;y] s: 9223372036854775800; i: 0; while[i<",(string n),"; s: (s + ",b,"); x: (x+1); i: i+1]; s}"}
jdNull: {jdNullT[jdN[]]}
jdRun["arithmetic that reaches the int null"; jdNull; 2; 250; 4]

// the counter of a `do` taken from a local, and a trip count of zero
jdDoLocalT: {[n;b] "{[x;y] m: ",(string n),"; s: 0; do[m; s: (s badd ",b,"); x: (x+1)]; (s badd m)}"}
jdDoLocal: {jdDoLocalT[jdN[]]}
jdRun["a do counter from a local"; jdDoLocal; 2; 250; 4]

// an explicit `:` return, which is the one thing that puts a Ret in the middle of a body — both the
// merge handling and jitRetKind (src/neant/jit/arm64.nt) key off where those are
jdRet: {[b] "{[x;y] if[x>y; :",b,"]; ",b,"}"}
jdRun["an early return agrees with the interpreter"; {jdRet}; 3; 300; 200]
// several statements, so a value travels through a local rather than staying on the stack
jdStmts: {[b] "{[x;y] a2: ",b,"; b2: (a2 badd ",b,"); ($[a2>b2; a2; b2])}"}
jdRun["a value carried through locals"; {jdStmts}; 3; 300; 200]
// a conditional UNDER a pending operand, which is the shape that was broken
// LEFT operand: the other side is pushed first and waits under the branch. `(b) + ($[..])` has
// nothing underneath and was never broken.
jdUnder: {[b] "{[x;y] (($[x>y; ",b,"; ",b,"]) + (",b,"))}"}
jdRun["a conditional as a dyad's left operand"; {jdUnder}; 2; 300; 200]
