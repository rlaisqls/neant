// Certificate parsing against the clock, over the real system trust store. Like tests/bench.nt
// this asserts nothing — the numbers are the machine's, not the language's — so tests/run.nt does
// not load it. Run it by hand:
//   ./target/release/neant tests/x509bench.nt
// The reference to beat is OpenSSL doing the same work (PEM decode, DER parse, subject name,
// public key) over the same file through libcrypto: 2.8 ms for the bundle, 19 us a certificate.
{load "src/neant/crypto/",x} each ("bignum.nt";"sha512.nt";"rsa.nt";"der.nt";"ec.nt";"p256.nt";"p384.nt";"x509.nt";"verify.nt")

XBPATH: "/etc/ssl/certs/ca-certificates.crt"
xbms: {[f] t0: now`time; f[0]; `int$now[`time]-t0}
// three runs, the fastest kept: the first pays for whatever the allocator has not warmed up yet
xbbest: {[f] (xbms f) & (xbms f) & xbms f}
xbrow: {[nm;ms;n] print fmt["  %-28s %6d ms   %8.1f us/cert"; (nm; ms; (1000.0*ms)%1|n)]}

xblines: read0 XBPATH
xbders: pemLines xblines
xbn: count xbders
xbnodes: count (derScan xbders)`off
print fmt["%s: %d blocks, %d characters of base64, %d octets of DER, %d DER elements"; (XBPATH; xbn; sum count each xblines; sum count each xbders; xbnodes)]

print "the columnar reader"
xbrow["read0"; xbbest {[d] read0 XBPATH}; xbn]
xbrow["pemLines (PEM + base64)"; xbbest {[d] pemLines xblines}; xbn]
xbrow["derScan alone"; xbbest {[d] derScan xbders}; xbn]
xbrow["x509ParseMany"; xbbest {[d] x509ParseMany xbders}; xbn]
xbload: xbbest {[d] x509LoadRoots XBPATH}
xbrow["x509LoadRoots, end to end"; xbload; xbn]
print "for comparison"
xbrow["x509Parse each (one dict per element)"; xbbest {[d] x509Parse each xbders}; xbn]
print fmt["  %.1f DER elements a certificate"; ,(0.0+xbnodes)%1|xbn]
print fmt["  OpenSSL over the same file: 2.8 ms, 19.0 us/cert — this build is %.0fx slower"; ,(0.0+xbload)%2.8]
