// a particle system: the layout of the array is the compiler's to choose, and the three loops
// want different things from it
struct Particle { x: f64, y: f64, vx: f64, vy: f64 }

fn step(ps: &mut [Particle], dt: f64) {
    for i in 0..ps.len() {
        ps[i].x += ps[i].vx * dt;
        ps[i].y += ps[i].vy * dt;
    }
}

fn kinetic(ps: &[Particle]) -> f64 {
    let mut e = 0.0;
    for i in 0..ps.len() {
        e += ps[i].vx * ps[i].vx + ps[i].vy * ps[i].vy;
    }
    0.5 * e
}

fn centroid_x(ps: &[Particle]) -> f64 {
    let mut s = 0.0;
    for i in 0..ps.len() {
        s += ps[i].x;
    }
    s / (ps.len() as f64)
}

fn main() {
    let n = 64;
    let mut ps = [Particle { x: 0.0, y: 0.0, vx: 1.0, vy: 2.0 }; n];
    for i in 0..n {
        ps[i].x = i as f64;
        ps[i].vx = (i % 3) as f64;
    }
    step(&mut ps, 0.5);
    println(kinetic(&ps));
    println(centroid_x(&ps));
}
