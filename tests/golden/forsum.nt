fn sum_to(n: i64) -> i64 {
    let mut s = 0;
    for i in 0..n {
        s += i;
    }
    s
}

fn main() {
    println(sum_to(10));
    println(sum_to(0));
    let mut count = 0;
    for i in 0..4 {
        for j in i..4 {
            count += 1;
        }
    }
    println(count);
    let mut acc = 0.0;
    for i in 1..5 {
        acc += 1.0 / i as f64;
    }
    println(acc);
}
