// a stack machine: the program is data, so the loop has no bound the compiler can see;
// `fuel` is the declared measure and makes the cost exact in it
fn run(code: &[i64], stack: &mut [i64], fuel: i64) -> i64 {
    let mut pc = 0;
    let mut sp = 0;
    let mut left = fuel;
    while pc < code.len() && left > 0 decreasing left {
        let op = code[pc];
        pc += 1;
        left -= 1;
        if op == 0 {
            // push immediate
            stack[sp] = code[pc];
            pc += 1;
            sp += 1;
        } else if op == 1 {
            // add
            sp -= 1;
            stack[sp - 1] = stack[sp - 1] + stack[sp];
        } else if op == 2 {
            // mul
            sp -= 1;
            stack[sp - 1] = stack[sp - 1] * stack[sp];
        } else if op == 3 {
            // jump back if top > 0: a loop in the program
            if stack[sp - 1] > 0 {
                pc = code[pc];
            } else {
                pc += 1;
            }
        } else if op == 4 {
            // decrement top
            stack[sp - 1] = stack[sp - 1] - 1;
        } else {
            break;
        }
    }
    if sp > 0 { stack[sp - 1] } else { 0 }
}

fn main() {
    // (2 + 3) * 4
    let prog = [0, 2, 0, 3, 1, 0, 4, 2, 9];
    let mut st = [0; 16];
    println(run(&prog, &mut st, 100));
    // count down from 5 to 0: push 5; L: dec; jump L if > 0; halt
    let loop_prog = [0, 5, 4, 3, 2, 9];
    println(run(&loop_prog, &mut st, 100));
    println(run(&loop_prog, &mut st, 4));
}
