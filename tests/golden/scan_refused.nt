// Where a scan is refused: `i` grows only when the word is not empty, so a path through the body
// comes back without growing it — the loop may not end, and the rule says so.

fn word_end(xs: &[u8], start: i64) -> i64 {
    let mut i = start;
    while i < xs.len() && xs[i] != b' ' {
        i += 1;
    }
    i
}

fn words(xs: &[u8]) -> i64 {
    let mut n = 0;
    let mut i = 0;
    while i < xs.len() {
        let e = word_end(xs, i);
        if e > i {
            n += 1;
            i = e + 1;
        }
    }
    n
}

fn main() {
    let s = b"a b";
    println(words(&s));
}
