fn main() {
    let xs = [3, 1, 4, 1, 5];
    let ys = xs;
    println(ys.len());
    println(ys[0]);
    let mut total = 0;
    for i in 0..ys.len() {
        total += ys[i];
    }
    println(total);
    let mut i = 0;
    let mut acc = 0;
    while i < 3 {
        let zs = [1, 2, 3];
        let ws = zs;
        acc += ws[0];
        i += 1;
    }
    println(acc);
}
