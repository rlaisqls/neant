fn max(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn sign(x: f64) -> i64 {
    if x > 0.0 { 1 } else if x < 0.0 { -1 } else { 0 }
}

fn describe(n: i64) -> i64 {
    let k = if n % 2 == 0 {
        let h = n / 2;
        h * 10
    } else {
        n * 100
    };
    k + 1
}

fn main() {
    println(max(3, 9));
    println(max(-1, -5));
    println(sign(2.5));
    println(sign(-0.5));
    println(sign(0.0));
    println(describe(4));
    println(describe(3));
    if max(1, 2) == 2 {
        println(true);
    }
}
