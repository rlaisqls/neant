// self-recursion the calculus can solve, and the two it refuses
fn fact(n: i64) -> i64 {
    if n <= 1 { 1 } else { n * fact(n - 1) }
}

fn sum_from(xs: &[i64], i: i64) -> i64 {
    if i >= xs.len() { 0 } else { xs[i] + sum_from(xs, i + 1) }
}

fn msum(xs: &[f64], lo: i64, hi: i64) -> f64 {
    if hi - lo <= 1 {
        if lo < hi { xs[lo] } else { 0.0 }
    } else {
        let mid = (lo + hi) / 2;
        msum(xs, lo, mid) + msum(xs, mid, hi)
    }
}

fn bsearch(xs: &[i64], key: i64, lo: i64, hi: i64) -> i64 {
    if hi - lo <= 0 { return -1; }
    let mid = (lo + hi) / 2;
    if xs[mid] == key { mid }
    else if xs[mid] < key { bsearch(xs, key, mid + 1, hi) }
    else { bsearch(xs, key, lo, mid) }
}

fn fib(n: i64) -> i64 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn main() {
    println(fact(10));
    let xs = [1, 2, 3, 4, 5];
    println(sum_from(&xs, 0));
    let ys = [0.5, 1.5, 2.5, 3.5];
    println(msum(&ys, 0, ys.len()));
    let sorted = [1, 3, 5, 7, 9, 11];
    println(bsearch(&sorted, 7, 0, sorted.len()));
    println(bsearch(&sorted, 4, 0, sorted.len()));
    println(fib(15));
}
